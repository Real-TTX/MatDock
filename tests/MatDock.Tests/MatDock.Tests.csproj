<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="GitHubActionsTestLogger" Version="3.0.5" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <!-- The whole app in memory (the platform contract, the sign-in through MatIdentity, /api/v1 unchanged). -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <!-- Newer than what Mvc.Testing brings (10.0.11 has known vulnerabilities). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MatDock.Core\MatDock.Core.csproj" />
    <!-- The REST API (MatDock.Web/Api) is tested directly, without a test server; the platform contract with WebApplicationFactory. -->
    <ProjectReference Include="..\..\src\MatDock.Web\MatDock.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The icon sprite of MatUi (a copy of MatDesign src/MatUi/wwwroot/img/matui-icons.svg; MatDock has no MatUi yet):
         the icons a MatApiDefinition may name - Mattiverse draws them with it. -->
    <None Update="Fixtures\matui-icons.svg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
