@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<div class="status-card card">
    <div class="u-center card__body">
        <div class="status-icon"><icon name="alert" /></div>
        <h1>Something went wrong</h1>
        @if (Model.ShowRequestId)
        {
            <p class="mono text-muted">Request-ID: @Model.RequestId</p>
        }
        <a href="/" class="mat-btn mat-btn--primary"><icon name="dashboard" /><span>Go to dashboard</span></a>
    </div>
</div>
