@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<div class="card" style="max-width:560px;margin:40px auto;">
    <div class="card__body" style="text-align:center;">
        <div style="font-size:2.4rem;color:var(--danger);"><icon name="alert" /></div>
        <h1>Something went wrong</h1>
        @if (Model.ShowRequestId)
        {
            <p class="mono text-muted">Request-ID: @Model.RequestId</p>
        }
        <a href="/" class="mat-btn mat-btn--primary"><icon name="dashboard" /><span>Go to dashboard</span></a>
    </div>
</div>
