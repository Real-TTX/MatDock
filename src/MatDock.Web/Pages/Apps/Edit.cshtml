@page
@model MatDock.Web.Pages.Apps.EditModel
@{
    ViewData["Title"] = Model.IsEdit ? "Edit app" : "New app";
    ViewData["Crumbs"] = new List<(string Text, string? Url)> { ("Store", "/Apps") };
    ViewData["Width"] = "narrow";
}

<div class="mat-card">
    <div class="mat-card__body">
        <form method="post" class="mat-form">
            <input type="hidden" asp-for="Input.Id" />
            <partial name="_ValidationSummary" />

            <div class="mat-form__grid">
                <mat-field label="Name" asp-for="Input.Name">
                    <input asp-for="Input.Name" class="mat-input" placeholder="e.g. Nginx Web Server" />
                </mat-field>

                <mat-field label="Category" asp-for="Input.Category" hint="Optional.">
                    <input asp-for="Input.Category" class="mat-input" placeholder="e.g. Web, Database" />
                </mat-field>

                <mat-field label="Description" asp-for="Input.Description" class="mat-field--full">
                    <input asp-for="Input.Description" class="mat-input" placeholder="Optional" />
                </mat-field>

                <mat-field label="Icon URL" asp-for="Input.IconUrl" class="mat-field--full" hint="Optional.">
                    <input asp-for="Input.IconUrl" class="mat-input" placeholder="https://…/logo.png" />
                </mat-field>
            </div>

            <mat-field label="docker-compose.yml" asp-for="Input.ComposeYaml" hint="Template for new stacks.">
                <textarea asp-for="Input.ComposeYaml" class="mat-textarea mat-mono" rows="18" spellcheck="false" placeholder="services:&#10;  app:&#10;    image: nginx:alpine"></textarea>
            </mat-field>

            <mat-form-buttons>
                <button type="submit" asp-page-handler="Save" class="mat-btn mat-btn--primary"><icon name="save" /><span>Save</span></button>
                <a href="/Apps" class="mat-btn mat-btn--ghost"><icon name="back" /><span>Back</span></a>
                @if (Model.IsEdit)
                {
                    <span class="mat-btn-row__spacer"></span>
                    <button type="submit" form="delete-form" class="mat-btn mat-btn--danger" data-confirm="Delete app '@Model.Input.Name'?"><icon name="trash" /><span>Delete</span></button>
                }
            </mat-form-buttons>
        </form>
        @if (Model.IsEdit)
        {
            <form method="post" asp-page-handler="Delete" id="delete-form"><input type="hidden" name="id" value="@Model.Input.Id" /></form>
        }
    </div>
</div>
