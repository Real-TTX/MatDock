@page
@model MatDock.Web.Pages.Settings.ActivityModel
@{
    ViewData["Title"] = "Activity";
}

<partial name="_SystemTabs" />

<mat-table>
    <mat-table-toolbar>
        <form method="get" class="mat-row js-autosubmit md-toolbar-form">
            <div class="mat-input-icon mat-toolbar__search">
                <icon name="search" />
                <input type="search" name="Q" value="@Model.Q" class="mat-input" placeholder="Search (user, action, target, environment)…" aria-label="Search the activity" />
            </div>
            <select id="activity-failed" name="Failed" class="mat-select mat-w-auto" aria-label="Result">
                <option value="false" selected="@(!Model.Failed)">All</option>
                <option value="true" selected="@Model.Failed">Failed only</option>
            </select>
            <span class="mat-toolbar__spacer"></span>
            <span class="mat-toolbar__info">@Model.Pagination.TotalItems entries</span>
        </form>
    </mat-table-toolbar>

    <mat-table-body>
        @if (Model.Items.Count == 0)
        {
            <div class="mat-empty"><div class="mat-empty__icon"><icon name="clock" /></div><p class="mat-empty__title">@(string.IsNullOrWhiteSpace(Model.Q) && !Model.Failed ? "Nothing recorded yet" : "No entries match the filter")</p></div>
        }
        else
        {
            <div class="mat-table-wrap">
            <table class="mat-table">
                <thead><tr><th>Time</th><th>User</th><th>Action</th><th>Target</th><th>Environment</th><th>Result</th></tr></thead>
                <tbody>
                    @foreach (var e in Model.Items)
                    {
                        <tr>
                            <td class="mat-muted mat-nowrap" data-label="Time">@e.CreateDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss")</td>
                            <td class="mat-nowrap" data-label="User">@e.Actor@if (e.Source == "api") { <span class="mat-pill mat-pill--plain">API</span> }</td>
                            <td data-label="Action">@e.Action</td>
                            <td class="mat-mono mat-text-wrap" data-label="Target">@(e.Target ?? "–")</td>
                            <td class="mat-nowrap" data-label="Environment">@(e.Environment ?? "–")</td>
                            <td data-label="Result">
                                @if (e.Ok)
                                {
                                    <span class="mat-pill mat-pill--ok" title="@e.Message"><icon name="check-circle" /> OK</span>
                                }
                                else
                                {
                                    <span class="mat-pill mat-pill--error" title="@e.Message"><icon name="x-circle" /> Failed</span>
                                }
                                @if (!string.IsNullOrEmpty(e.Message))
                                {
                                    <small class="mat-muted mat-d-block mat-mt-1">@e.Message</small>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        }
    </mat-table-body>

    <mat-table-pagination>
        <pagination model="Model.Pagination" />
    </mat-table-pagination>
</mat-table>
