@page
@model MatDock.Web.Pages.Settings.ActivityModel
@{
    ViewData["Title"] = "Activity";
}

<partial name="_SystemTabs" />

<div class="page-head">
    <div class="page-head__title">
        <h1>Activity</h1>
    </div>
</div>

<mat-table>
    <mat-table-toolbar>
        <form method="get" class="u-contents js-autosubmit">
            <div class="search">
                <icon name="search" />
                <input type="search" name="Q" value="@Model.Q" class="mat-input" placeholder="Search (user, action, target, environment)…" />
            </div>
            <div class="toolbar-field">
                <label for="activity-failed"><icon name="filter" /></label>
                <select id="activity-failed" name="Failed" class="mat-select">
                    <option value="false" selected="@(!Model.Failed)">All</option>
                    <option value="true" selected="@Model.Failed">Failed only</option>
                </select>
            </div>
        </form>
        <span class="u-ml-auto text-muted">@Model.Pagination.TotalItems entries</span>
    </mat-table-toolbar>

    <mat-table-body>
        @if (Model.Items.Count == 0)
        {
            <div class="empty-state"><div><icon name="clock" /></div><p>@(string.IsNullOrWhiteSpace(Model.Q) && !Model.Failed ? "Nothing recorded yet." : "No entries match the filter.")</p></div>
        }
        else
        {
            <table class="data">
                <thead><tr><th>Time</th><th>User</th><th>Action</th><th>Target</th><th>Environment</th><th>Result</th></tr></thead>
                <tbody>
                    @foreach (var e in Model.Items)
                    {
                        <tr>
                            <td class="cell-sub nowrap" data-label="Time">@e.CreateDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss")</td>
                            <td class="nowrap" data-label="User">@e.Actor@if (e.Source == "api") { <span class="pill pill--unknown">API</span> }</td>
                            <td data-label="Action">@e.Action</td>
                            <td class="mono wrap" data-label="Target">@(e.Target ?? "–")</td>
                            <td class="nowrap" data-label="Environment">@(e.Environment ?? "–")</td>
                            <td data-label="Result">
                                @if (e.Ok)
                                {
                                    <span class="pill pill--online" title="@e.Message"><icon name="check-circle" /> OK</span>
                                }
                                else
                                {
                                    <span class="pill pill--error" title="@e.Message"><icon name="x-circle" /> Failed</span>
                                }
                                @if (!string.IsNullOrEmpty(e.Message))
                                {
                                    <div class="cell-sub">@e.Message</div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </mat-table-body>

    <mat-table-pagination>
        <pagination model="Model.Pagination" />
    </mat-table-pagination>
</mat-table>
