@page
@model MatDock.Web.Pages.Settings.Proxies.IndexModel
@{
    ViewData["Title"] = "Proxies";
}

<partial name="_SystemTabs" />

<partial name="_StatusMessage" model="(Model.StatusMessage, Model.IsError)" />

<mat-table>
    <mat-table-toolbar><partial name="_ListToolbar" model="Model.Toolbar" /></mat-table-toolbar>
    <mat-table-body>
    @if (Model.Connections.Count == 0)
    {
        <div class="mat-empty"><div class="mat-empty__icon"><icon name="route" /></div><p class="mat-empty__title">@(Model.Total == 0 ? "No reverse proxies yet." : "No reverse proxies found.")</p></div>
    }
    else
    {
    <div class="mat-table-wrap">
    <table class="mat-table">
        <thead>
            <tr><th>Name</th><th>Provider</th><th>URL</th><th>Status</th></tr>
        </thead>
        <tbody>
            @foreach (var c in Model.Connections)
            {
                <tr>
                    <td data-label="Name"><a href="/Settings/Proxies/Edit?id=@c.Id"><strong>@c.Name</strong></a></td>
                    <td data-label="Provider">@c.Provider</td>
                    <td class="mat-text-wrap" data-label="URL"><span class="mat-mono">@c.Url</span></td>
                    <td data-label="Status"><span class="mat-pill @(c.Enabled ? "mat-pill--ok" : "mat-pill--plain")">@(c.Enabled ? "enabled" : "disabled")</span></td>
                </tr>
            }
        </tbody>
    </table>
    </div>
    }
    </mat-table-body>
    <mat-table-actions>
        <a href="/Settings/Proxies/Edit" class="mat-btn mat-btn--primary"><icon name="plus" /><span>New proxy</span></a>
    </mat-table-actions>
</mat-table>
