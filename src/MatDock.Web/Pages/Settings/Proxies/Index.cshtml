@page
@model MatDock.Web.Pages.Settings.Proxies.IndexModel
@{
    ViewData["Title"] = "Proxies";
}

<partial name="_SystemTabs" />

<div class="page-head">
    <div class="page-head__title">
        <h1>Proxies</h1>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert @(Model.IsError ? "alert--error" : "alert--success")">
        <icon name="@(Model.IsError ? "x-circle" : "check-circle")" /><span>@Model.StatusMessage</span>
    </div>
}

<mat-table>
    <mat-table-body>
    @if (Model.Connections.Count == 0)
    {
        <div class="empty-state"><div><icon name="route" /></div><p>No reverse proxies yet.</p></div>
    }
    else
    {
    <table class="data">
        <thead>
            <tr><th>Name</th><th>Provider</th><th>URL</th><th>Status</th></tr>
        </thead>
        <tbody>
            @foreach (var c in Model.Connections)
            {
                <tr>
                    <td><a href="/Settings/Proxies/Edit?id=@c.Id"><strong>@c.Name</strong></a></td>
                    <td>@c.Provider</td>
                    <td class="wrap"><span class="mono">@c.Url</span></td>
                    <td>@(c.Enabled ? "enabled" : "disabled")</td>
                </tr>
            }
        </tbody>
    </table>
    }
    </mat-table-body>
    <mat-table-actions>
        <a href="/Settings/Proxies/Edit" class="mat-btn mat-btn--primary"><icon name="plus" /><span>New proxy</span></a>
    </mat-table-actions>
</mat-table>
