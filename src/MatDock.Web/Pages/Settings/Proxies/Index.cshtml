@page
@model MatDock.Web.Pages.Settings.Proxies.IndexModel
@{
    ViewData["Title"] = "Proxies";
}

<partial name="_SystemTabs" />

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="mat-alert @(Model.IsError ? "mat-alert--danger" : "mat-alert--success")">
        <icon name="@(Model.IsError ? "x-circle" : "check-circle")" /><div class="mat-alert__body">@Model.StatusMessage</div>
    </div>
}

<mat-table>
    <mat-table-body>
    @if (Model.Connections.Count == 0)
    {
        <div class="mat-empty"><div class="mat-empty__icon"><icon name="route" /></div><p>No reverse proxies yet.</p></div>
    }
    else
    {
    <table class="mat-table">
        <thead>
            <tr><th>Name</th><th>Provider</th><th>URL</th><th>Status</th></tr>
        </thead>
        <tbody>
            @foreach (var c in Model.Connections)
            {
                <tr>
                    <td><a href="/Settings/Proxies/Edit?id=@c.Id"><strong>@c.Name</strong></a></td>
                    <td>@c.Provider</td>
                    <td class="mat-text-wrap"><span class="mat-mono">@c.Url</span></td>
                    <td>@(c.Enabled ? "enabled" : "disabled")</td>
                </tr>
            }
        </tbody>
    </table>
    }
    </mat-table-body>
    <mat-table-actions>
        <a href="/Settings/Proxies/Edit" class="mat-btn mat-btn--primary"><icon name="plus" /><span>New proxy</span></a>
    </mat-table-actions>
</mat-table>
