@page
@model MatDock.Web.Pages.Settings.NotificationsModel
@{
    ViewData["Title"] = "Notifications";
}

<partial name="_SystemTabs" />

<partial name="_StatusMessage" model="(Model.StatusMessage, Model.IsError)" />

<form method="post" class="mat-stack md-narrow">
    <partial name="_ValidationSummary" />

    <div class="mat-card">
        <div class="mat-card__head"><icon name="bell" /><span class="mat-card__title">Triggers</span></div>
        <div class="mat-card__body mat-stack mat-stack--sm">
            <label class="mat-check">
                <input asp-for="Input.NotifyOnFailure" type="checkbox" />
                <span>Notify on failures</span>
            </label>
            <label class="mat-check">
                <input asp-for="Input.NotifyOnSuccess" type="checkbox" />
                <span>Also notify on success</span>
            </label>
        </div>
    </div>

    <div class="mat-card">
        <div class="mat-card__head"><icon name="mail" /><span class="mat-card__title">Email (SMTP)</span></div>
        <div class="mat-card__body mat-form">
            <label class="mat-check">
                <input asp-for="Input.SmtpEnabled" type="checkbox" />
                <span>Enabled</span>
            </label>
            @if (Model.Relay is { } relay)
            {
                <div class="mat-alert mat-alert--info"><icon name="server" /><div class="mat-alert__body">@relay.Description</div></div>
            }
            @* With MatSMTP the server fields are fixed: the fieldset disables them, so they are shown but not posted. *@
            <fieldset class="mat-fieldset mat-form" disabled="@(Model.Relay is not null)">
                <legend class="mat-sr-only">SMTP server</legend>
                <div class="mat-form__grid">
                    <mat-field label="SMTP host" asp-for="Input.SmtpHost">
                        <input asp-for="Input.SmtpHost" class="mat-input" placeholder="smtp.example.com" autocomplete="off" />
                    </mat-field>
                    <mat-field label="Port" asp-for="Input.SmtpPort">
                        <input asp-for="Input.SmtpPort" type="number" min="1" max="65535" class="mat-input" />
                    </mat-field>
                </div>
                <label class="mat-check">
                    <input asp-for="Input.SmtpUseTls" type="checkbox" />
                    <span>Use TLS/STARTTLS</span>
                </label>
                <div class="mat-form__grid">
                    <mat-field label="User" asp-for="Input.SmtpUsername">
                        <input asp-for="Input.SmtpUsername" class="mat-input" autocomplete="off" />
                    </mat-field>
                    <mat-field label="Password" asp-for="Input.SmtpPassword" hint="@(Model.Relay is null && Model.HasStoredPassword ? "Leave blank to keep the stored password." : null)">
                        <input asp-for="Input.SmtpPassword" type="password" class="mat-input" autocomplete="new-password" />
                    </mat-field>
                </div>
                <mat-field label="Sender (From)" asp-for="Input.SmtpFrom">
                    <input asp-for="Input.SmtpFrom" class="mat-input" placeholder="matdock@example.com" autocomplete="off" />
                </mat-field>
            </fieldset>
            <mat-field label="Recipients (To)" asp-for="Input.SmtpTo" hint="Separate multiple with commas.">
                <input asp-for="Input.SmtpTo" class="mat-input" placeholder="admin@example.com" autocomplete="off" />
            </mat-field>
        </div>
    </div>

    <div class="mat-card">
        <div class="mat-card__head"><icon name="plug" /><span class="mat-card__title">Webhook</span></div>
        <div class="mat-card__body mat-form">
            <label class="mat-check">
                <input asp-for="Input.WebhookEnabled" type="checkbox" />
                <span>Enabled</span>
            </label>
            <mat-field label="Webhook URL" asp-for="Input.WebhookUrl" hint="A JSON POST is sent.">
                <input asp-for="Input.WebhookUrl" class="mat-input" placeholder="https://hooks.example.com/…" autocomplete="off" />
            </mat-field>
        </div>
    </div>

    <mat-form-buttons>
        <button type="submit" asp-page-handler="Save" class="mat-btn mat-btn--primary"><icon name="save" /><span>Save</span></button>
        <button type="submit" asp-page-handler="Test" class="mat-btn mat-btn--secondary" title="Save before sending a test."><icon name="mail" /><span>Send test</span></button>
        <span class="mat-hint">Save before sending a test.</span>
    </mat-form-buttons>
</form>

<div class="mat-stack md-narrow mat-mt-6">
    <section class="mat-card">
        <div class="mat-card__head"><icon name="message-square" /><h2 class="mat-card__title">Channels</h2><span class="mat-badge">@Model.Channels.Count</span></div>
        @if (Model.Channels.Count > 0)
        {
            <div class="mat-table-wrap">
                <table class="mat-table">
                    <thead><tr><th>Name</th><th>Type</th><th>Status</th><th class="mat-table__cell-actions"><span class="mat-sr-only">Actions</span></th></tr></thead>
                    <tbody>
                        @foreach (var c in Model.Channels)
                        {
                            <tr>
                                <td data-label="Name"><a href="/Settings/ChannelEdit?id=@c.Id">@c.Name</a></td>
                                <td data-label="Type">@c.Type</td>
                                <td data-label="Status"><span class="mat-pill @(c.Enabled ? "mat-pill--ok" : "mat-pill--plain")">@(c.Enabled ? "On" : "Off")</span></td>
                                <td class="mat-table__cell-actions">
                                    <div class="mat-table__actions">
                                        <form method="post" asp-page="/Settings/ChannelEdit" asp-page-handler="Test">
                                            <input type="hidden" name="id" value="@c.Id" />
                                            <button type="submit" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" title="Send a test" aria-label="Send a test to @c.Name"><icon name="mail" /></button>
                                        </form>
                                        <a class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" href="/Settings/ChannelEdit?id=@c.Id" title="Edit" aria-label="Edit @c.Name"><icon name="edit" /></a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        <div class="mat-card__body">
            <div class="mat-actions">
                <a href="/Settings/ChannelEdit" class="mat-btn mat-btn--secondary"><icon name="plus" /><span>New channel</span></a>
            </div>
        </div>
    </section>

    <section class="mat-card">
        <div class="mat-card__head"><icon name="alert" /><h2 class="mat-card__title">Alerts</h2></div>
        <div class="mat-card__body">
            <form method="post" asp-page-handler="Alerts" class="mat-form">
                <p class="mat-hint">The limits apply to every host; an environment can have its own. Empty = no limit.</p>
                <div class="mat-form__grid">
                    <mat-field label="Disk %" asp-for="Alerts.Disk">
                        <input asp-for="Alerts.Disk" type="number" min="1" max="100" class="mat-input" />
                    </mat-field>
                    <mat-field label="Memory %" asp-for="Alerts.Mem" hint="Two readings in a row (10 min).">
                        <input asp-for="Alerts.Mem" type="number" min="1" max="100" class="mat-input" />
                    </mat-field>
                    <mat-field label="CPU %" asp-for="Alerts.Cpu" hint="Load per core, two readings in a row.">
                        <input asp-for="Alerts.Cpu" type="number" min="1" max="100" class="mat-input" />
                    </mat-field>
                </div>
                <div class="mat-form__grid">
                    <mat-field label="Restart loop: starts" asp-for="Alerts.RestartCount" hint="0 = not watched.">
                        <input asp-for="Alerts.RestartCount" type="number" min="0" max="50" class="mat-input" />
                    </mat-field>
                    <mat-field label="within minutes" asp-for="Alerts.RestartMinutes">
                        <input asp-for="Alerts.RestartMinutes" type="number" min="1" max="120" class="mat-input" />
                    </mat-field>
                </div>
                <fieldset class="mat-fieldset">
                    <legend class="mat-label">Send a notification on</legend>
                    @foreach (var (evt, label) in MatDock.Web.Pages.Settings.NotificationsModel.AlertEvents)
                    {
                        <label class="mat-check">
                            <input type="checkbox" name="Alerts.Notify" value="@evt" checked="@Model.Alerts.Notify.Contains(evt)" />
                            <span>@label</span>
                        </label>
                    }
                </fieldset>
                <mat-form-buttons>
                    <button type="submit" class="mat-btn mat-btn--primary"><icon name="save" /><span>Save</span></button>
                </mat-form-buttons>
            </form>
        </div>
    </section>
</div>
