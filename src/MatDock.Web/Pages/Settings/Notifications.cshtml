@page
@model MatDock.Web.Pages.Settings.NotificationsModel
@{
    ViewData["Title"] = "Benachrichtigungen";
}

<partial name="_SystemTabs" />

<div class="page-head">
    <div class="page-head__title">
        <h1>Benachrichtigungen</h1>
        <span class="page-head__subtitle">Email (SMTP) and webhook for backup/schedule results</span>
    </div>
    <div class="mat-buttons">
        <a href="/Settings" class="mat-btn mat-btn--ghost"><icon name="back" /><span>Back</span></a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert @(Model.IsError ? "alert--error" : "alert--success")">
        <icon name="@(Model.IsError ? "x-circle" : "check-circle")" /><span>@Model.StatusMessage</span>
    </div>
}

<form method="post">
    <div asp-validation-summary="All" class="mat-validation"></div>

    <div class="card" style="margin-bottom:16px;max-width:820px;">
        <div class="card__header"><icon name="alert" /><span>Triggers</span></div>
        <div class="card__body">
            <label class="mat-check">
                <input asp-for="Input.NotifyOnFailure" type="checkbox" />
                <span>Notify on failures</span>
            </label>
            <label class="mat-check">
                <input asp-for="Input.NotifyOnSuccess" type="checkbox" />
                <span>Also notify on success</span>
            </label>
            <p class="text-muted" style="font-size:.82rem;margin-top:6px;">Applies to scheduled backups (result per run) as well as manual and bulk backups.</p>
        </div>
    </div>

    <div class="card" style="margin-bottom:16px;max-width:820px;">
        <div class="card__header"><icon name="server" /><span>Email (SMTP)</span></div>
        <div class="card__body">
            <label class="mat-check">
                <input asp-for="Input.SmtpEnabled" type="checkbox" />
                <span>Email notification enabled</span>
            </label>
            <div class="mat-form">
                <mat-field label="SMTP host" asp-for="Input.SmtpHost">
                    <input asp-for="Input.SmtpHost" class="mat-input" placeholder="smtp.example.com" autocomplete="off" />
                </mat-field>
                <mat-field label="Port" asp-for="Input.SmtpPort">
                    <input asp-for="Input.SmtpPort" type="number" min="1" max="65535" class="mat-input" />
                </mat-field>
                <label class="mat-check">
                    <input asp-for="Input.SmtpUseTls" type="checkbox" />
                    <span>Use TLS/STARTTLS</span>
                </label>
                <mat-field label="User" asp-for="Input.SmtpUsername">
                    <input asp-for="Input.SmtpUsername" class="mat-input" autocomplete="off" />
                </mat-field>
                <mat-field label="Password" asp-for="Input.SmtpPassword" hint="@(Model.HasStoredPassword ? "Leave blank to keep the stored password." : null)">
                    <input asp-for="Input.SmtpPassword" type="password" class="mat-input" autocomplete="new-password" />
                </mat-field>
                <mat-field label="Sender (From)" asp-for="Input.SmtpFrom">
                    <input asp-for="Input.SmtpFrom" class="mat-input" placeholder="matdock@example.com" autocomplete="off" />
                </mat-field>
                <mat-field label="Recipients (To)" asp-for="Input.SmtpTo" hint="Separate multiple with commas.">
                    <input asp-for="Input.SmtpTo" class="mat-input" placeholder="admin@example.com" autocomplete="off" />
                </mat-field>
            </div>
        </div>
    </div>

    <div class="card" style="margin-bottom:16px;max-width:820px;">
        <div class="card__header"><icon name="plug" /><span>Webhook</span></div>
        <div class="card__body">
            <label class="mat-check">
                <input asp-for="Input.WebhookEnabled" type="checkbox" />
                <span>Webhook notification enabled</span>
            </label>
            <mat-field label="Webhook URL" asp-for="Input.WebhookUrl" hint="A JSON POST is sent.">
                <input asp-for="Input.WebhookUrl" class="mat-input" placeholder="https://hooks.example.com/…" autocomplete="off" />
            </mat-field>
        </div>
    </div>

    <mat-form-buttons>
        <button type="submit" asp-page-handler="Save" class="mat-btn mat-btn--primary"><icon name="save" /><span>Save</span></button>
        <button type="submit" asp-page-handler="Test" class="mat-btn"><icon name="plug" /><span>Send test</span></button>
        <a href="/Settings" class="mat-btn mat-btn--ghost"><icon name="back" /><span>Cancel</span></a>
    </mat-form-buttons>
    <p class="text-muted" style="font-size:.82rem;margin-top:8px;">"Send test" uses the most recently saved settings.</p>
</form>
