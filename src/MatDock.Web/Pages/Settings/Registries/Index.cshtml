@page
@model MatDock.Web.Pages.Settings.Registries.IndexModel
@{
    ViewData["Title"] = "Registries";
}

<partial name="_SystemTabs" />

<partial name="_StatusMessage" model="(Model.StatusMessage, Model.IsError)" />

<mat-table>
    <mat-table-body>
    @if (Model.Registries.Count == 0)
    {
        <div class="mat-empty"><div class="mat-empty__icon"><icon name="registry" /></div><p class="mat-empty__title">No registries yet.</p></div>
    }
    else
    {
    <div class="mat-table-wrap">
    <table class="mat-table">
        <thead>
            <tr><th>Name</th><th>Host</th><th>User</th><th>Status</th></tr>
        </thead>
        <tbody>
            @foreach (var r in Model.Registries)
            {
                <tr>
                    <td data-label="Name"><a href="/Settings/Registries/Edit?id=@r.Id"><strong>@r.Name</strong></a></td>
                    <td class="mat-text-wrap" data-label="Host"><span class="mat-mono">@r.Host</span></td>
                    <td data-label="User">@r.Username</td>
                    <td data-label="Status"><span class="mat-pill @(r.Enabled ? "mat-pill--ok" : "mat-pill--plain")">@(r.Enabled ? "enabled" : "disabled")</span></td>
                </tr>
            }
        </tbody>
    </table>
    </div>
    }
    </mat-table-body>
    <mat-table-actions>
        <a href="/Settings/Registries/Edit" class="mat-btn mat-btn--primary"><icon name="plus" /><span>New registry</span></a>
    </mat-table-actions>
</mat-table>
