@page
@model MatDock.Web.Pages.Settings.Registries.IndexModel
@{
    ViewData["Title"] = "Registries";
}

<partial name="_SystemTabs" />

<div class="page-head">
    <div class="page-head__title">
        <h1>Registries</h1>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert @(Model.IsError ? "alert--error" : "alert--success")">
        <icon name="@(Model.IsError ? "x-circle" : "check-circle")" /><span>@Model.StatusMessage</span>
    </div>
}

<mat-table>
    <mat-table-body>
    @if (Model.Registries.Count == 0)
    {
        <div class="empty-state"><div><icon name="registry" /></div><p>No registries yet.</p></div>
    }
    else
    {
    <table class="data">
        <thead>
            <tr><th>Name</th><th>Host</th><th>User</th><th>Status</th></tr>
        </thead>
        <tbody>
            @foreach (var r in Model.Registries)
            {
                <tr>
                    <td><a href="/Settings/Registries/Edit?id=@r.Id"><strong>@r.Name</strong></a></td>
                    <td class="wrap"><span class="mono">@r.Host</span></td>
                    <td>@r.Username</td>
                    <td>@(r.Enabled ? "enabled" : "disabled")</td>
                </tr>
            }
        </tbody>
    </table>
    }
    </mat-table-body>
    <mat-table-actions>
        <a href="/Settings/Registries/Edit" class="mat-btn mat-btn--primary"><icon name="plus" /><span>New registry</span></a>
    </mat-table-actions>
</mat-table>
