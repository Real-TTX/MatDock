@page
@model MatDock.Web.Pages.Settings.Registries.EditModel
@{
    ViewData["Title"] = Model.IsEdit ? "Edit registry" : "New registry";
}

<partial name="_SystemTabs" />

<div class="page-head">
    <div class="page-head__title">
        <h1>@ViewData["Title"]</h1>
    </div>
</div>

@if (Model.TestMessage is not null)
{
    <div class="alert @(Model.TestOk ? "alert--success" : "alert--error")">
        <icon name="@(Model.TestOk ? "check-circle" : "x-circle")" /><span>@Model.TestMessage</span>
    </div>
}

<div class="u-maxw card">
    <div class="card__body">
        <form method="post" class="mat-form">
            <input type="hidden" asp-for="Input.Id" />
            <div asp-validation-summary="ModelOnly"></div>

            <mat-field label="Name" asp-for="Input.Name">
                <input asp-for="Input.Name" class="mat-input" placeholder="e.g. GitHub Container Registry" />
            </mat-field>

            <div class="form-grid">
                <mat-field label="Host" asp-for="Input.Host" hint="Bare host[:port], e.g. ghcr.io, registry.example.com:5000 or docker.io">
                    <input asp-for="Input.Host" class="mat-input" placeholder="ghcr.io" />
                </mat-field>
                <mat-field label="Username" asp-for="Input.Username">
                    <input asp-for="Input.Username" class="mat-input" autocomplete="off" placeholder="user or org" />
                </mat-field>
                <mat-field label="Token / password" asp-for="Input.Token" hint="@(Model.IsEdit ? "Leave blank to keep the stored token" : "A PAT/token is recommended over a password")">
                    <input asp-for="Input.Token" type="password" class="mat-input" autocomplete="new-password" />
                </mat-field>
            </div>

            <label class="mat-check">
                <input asp-for="Input.Insecure" type="checkbox" />
                <span>Insecure (HTTP)</span>
            </label>
            <label class="mat-check">
                <input asp-for="Input.Enabled" type="checkbox" />
                <span>Enabled</span>
            </label>

            <mat-form-buttons>
                <button type="submit" asp-page-handler="Save" class="mat-btn mat-btn--primary"><icon name="save" /><span>Save</span></button>
                <button type="submit" asp-page-handler="Test" class="mat-btn" formnovalidate><icon name="plug" /><span>Test connection</span></button>
                <a href="/Settings/Registries" class="mat-btn mat-btn--ghost"><icon name="back" /><span>Back</span></a>
                @if (Model.IsEdit)
                {
                    <span class="mat-buttons__spacer"></span>
                    <button type="submit" form="delete-form" class="mat-btn mat-btn--danger" data-confirm="Delete registry '@Model.Input.Name'?"><icon name="trash" /><span>Delete</span></button>
                }
            </mat-form-buttons>
        </form>
        @if (Model.IsEdit)
        {
            <form method="post" asp-page-handler="Delete" id="delete-form"><input type="hidden" name="id" value="@Model.Input.Id" /></form>
        }
    </div>
</div>
