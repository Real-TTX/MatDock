@page
@model MatDock.Web.Pages.Settings.IndexModel
@{
    ViewData["Title"] = "System";
}

<partial name="_SystemTabs" />

<div class="page-head">
    <div class="page-head__title">
        <h1>System</h1>
        <span class="page-head__subtitle">General settings &amp; backup targets</span>
    </div>
</div>

<nav class="mat-tabs">
    <a class="mat-tabs__tab @(Model.IsBackupTab ? "" : "is-active")" href="/Settings?tab=general"><icon name="settings" /><span>General</span></a>
    <a class="mat-tabs__tab @(Model.IsBackupTab ? "is-active" : "")" href="/Settings?tab=backup"><icon name="save" /><span>Backup</span></a>
</nav>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert @(Model.IsError ? "alert--error" : "alert--success")">
        <icon name="@(Model.IsError ? "x-circle" : "check-circle")" /><span>@Model.StatusMessage</span>
    </div>
}

@if (!Model.IsBackupTab)
{
    <div class="card" style="margin-bottom:16px;max-width:820px;">
        <div class="card__header"><icon name="whale" /><span>MatDock</span></div>
        <div class="mat-table__scroll">
            <table class="data">
                <tbody>
                    <tr><th style="width:200px;">Version</th><td class="mono">@AppVersion.Informational</td></tr>
                    <tr><th>Local backup path</th><td class="mono">@Model.LocalPath</td></tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="card" style="max-width:820px;">
        <div class="card__header"><icon name="alert" /><span>Notifications</span></div>
        <div class="card__body">
            <p class="text-muted" style="margin-bottom:10px;">Email (SMTP) and webhook for backup/schedule results.</p>
            <a href="/Settings/Notifications" class="mat-btn"><icon name="alert" /><span>Configure notifications</span></a>
        </div>
    </div>
}
else
{
    <mat-table>
        <mat-table-toolbar>
            <strong>Backup targets</strong>
            <span class="toolbar-spacer"></span>
            <span class="text-muted">Where backups are written</span>
        </mat-table-toolbar>

        <mat-table-body>
            <table class="data">
                <thead>
                    <tr><th>Name</th><th>Type</th><th>Details</th><th>Default</th><th class="actions">Actions</th></tr>
                </thead>
                <tbody>
                    <tr>
                        <td><strong>Local (MatDock)</strong></td>
                        <td>Local</td>
                        <td class="cell-sub">@Model.LocalPath</td>
                        <td>
                            @if (Model.LocalIsDefault)
                            {
                                <span class="pill pill--online"><icon name="check-circle" /><span>Default</span></span>
                            }
                            else
                            {
                                <form method="post" asp-page-handler="LocalDefault" style="display:inline;">
                                    <button type="submit" class="mat-btn mat-btn--sm">Set as default</button>
                                </form>
                            }
                        </td>
                        <td class="actions"><span class="text-muted">–</span></td>
                    </tr>
                    @foreach (var t in Model.Targets)
                    {
                        <tr>
                            <td><strong>@t.Name</strong></td>
                            <td>@t.Type</td>
                            <td class="cell-sub">@(t.Type == MatDock.Core.Entities.BackupTargetType.Smb ? $"\\\\{t.SmbHost}\\{t.SmbShare}\\{t.SmbDirectory}" : "")</td>
                            <td>
                                @if (t.IsDefault)
                                {
                                    <span class="pill pill--online"><icon name="check-circle" /><span>Default</span></span>
                                }
                                else
                                {
                                    <form method="post" asp-page-handler="Default" style="display:inline;">
                                        <input type="hidden" name="id" value="@t.Id" />
                                        <button type="submit" class="mat-btn mat-btn--sm">Set as default</button>
                                    </form>
                                }
                            </td>
                            <td class="actions">
                                <div class="row-actions">
                                    <form method="post" asp-page-handler="Test" style="display:inline;">
                                        <input type="hidden" name="id" value="@t.Id" />
                                        <button type="submit" class="mat-btn mat-btn--sm" title="Test"><icon name="plug" /></button>
                                    </form>
                                    <a class="mat-btn mat-btn--sm" href="/Settings/BackupTargetEdit?id=@t.Id" title="Edit"><icon name="edit" /></a>
                                    <span style="width:8px;display:inline-block;"></span>
                                    <form method="post" asp-page-handler="Delete" data-confirm="Delete target @t.Name?" style="display:inline;">
                                        <input type="hidden" name="id" value="@t.Id" />
                                        <button type="submit" class="mat-btn mat-btn--sm mat-btn--danger" title="Delete"><icon name="trash" /></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </mat-table-body>

        <mat-table-actions>
            <a href="/Settings/BackupTargetEdit" class="mat-btn mat-btn--primary"><icon name="plus" /><span>New backup target (NAS/SMB)</span></a>
        </mat-table-actions>
    </mat-table>
}
