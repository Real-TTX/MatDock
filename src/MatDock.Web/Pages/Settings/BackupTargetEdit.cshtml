@page
@model MatDock.Web.Pages.Settings.BackupTargetEditModel
@{
    ViewData["Title"] = Model.IsEdit ? "Edit backup target" : "New backup target";
    var pwHint = Model.IsEdit ? "Leave blank to keep the stored password." : null;
}

<div class="page-head">
    <div class="page-head__title">
        <h1>@ViewData["Title"]</h1>
        <span class="page-head__subtitle">NAS / SMB share as a backup target</span>
    </div>
</div>

@if (Model.TestMessage is not null)
{
    <div class="alert @(Model.TestOk ? "alert--success" : "alert--error")">
        <icon name="@(Model.TestOk ? "check-circle" : "x-circle")" /><span>@Model.TestMessage</span>
    </div>
}

<div class="card" style="max-width:760px;">
    <div class="card__body">
        <form method="post" class="mat-form">
            <input type="hidden" asp-for="Input.Id" />
            <div asp-validation-summary="ModelOnly"></div>

            <mat-field label="Name" asp-for="Input.Name">
                <input asp-for="Input.Name" class="mat-input" placeholder="e.g. NAS backups" />
            </mat-field>

            <div class="form-grid">
                <mat-field label="Host (NAS)" asp-for="Input.SmbHost">
                    <input asp-for="Input.SmbHost" class="mat-input" placeholder="nas.local or 192.168.1.20" />
                </mat-field>
                <mat-field label="Share" asp-for="Input.SmbShare">
                    <input asp-for="Input.SmbShare" class="mat-input" placeholder="backups" />
                </mat-field>
                <mat-field label="Subfolder" asp-for="Input.SmbDirectory" hint="Optional, e.g. matdock/volumes">
                    <input asp-for="Input.SmbDirectory" class="mat-input" />
                </mat-field>
                <mat-field label="Domain" asp-for="Input.SmbDomain" hint="Optional">
                    <input asp-for="Input.SmbDomain" class="mat-input" />
                </mat-field>
                <mat-field label="User" asp-for="Input.SmbUsername">
                    <input asp-for="Input.SmbUsername" class="mat-input" autocomplete="off" />
                </mat-field>
                <mat-field label="Password" asp-for="Input.SmbPassword" hint="@pwHint">
                    <input asp-for="Input.SmbPassword" type="password" class="mat-input" autocomplete="new-password" />
                </mat-field>
            </div>

            <label class="mat-check">
                <input asp-for="Input.IsDefault" type="checkbox" />
                <span>Use as the default target for new backups</span>
            </label>

            <mat-form-buttons>
                <button type="submit" asp-page-handler="Save" class="mat-btn mat-btn--primary"><icon name="save" /><span>Save</span></button>
                <button type="submit" asp-page-handler="Test" class="mat-btn"><icon name="plug" /><span>Test connection</span></button>
                <a href="/Settings?tab=backup" class="mat-btn mat-btn--ghost"><icon name="back" /><span>Back</span></a>
            </mat-form-buttons>
        </form>
    </div>
</div>
