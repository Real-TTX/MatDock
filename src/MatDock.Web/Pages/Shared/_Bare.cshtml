@inject Toolkit Toolkit
@*
    A page without the menu: sign-in, first-run setup, an error. A centred card on the plain page background.
*@
@{
    var title = ViewData["Title"] as string;
}
<!DOCTYPE html>
<html lang="en" data-app="@Ui.App.Id">
<partial name="_Head" model="@(string.IsNullOrEmpty(title) ? Ui.App.Name : $"{title} · {Ui.App.Name}")" />
<body>
    <a class="mat-skip" href="#main">Skip to the content</a>
    @Html.Raw(Toolkit.Sprite)
    <main class="mat-auth" id="main">
        @RenderBody()
    </main>
    <script src="~/matui/matui.js" asp-append-version="true"></script>
    <script src="~/js/matdock.js" asp-append-version="true"></script>
    <script src="~/js/pwa.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
