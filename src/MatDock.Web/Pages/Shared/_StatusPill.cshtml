@model MatDock.Core.Entities.EnvironmentStatus
@* The status of an environment: the pill draws its own coloured dot. *@
@{
    var (tone, label) = Model switch
    {
        MatDock.Core.Entities.EnvironmentStatus.Online => ("mat-pill--ok", "Online"),
        MatDock.Core.Entities.EnvironmentStatus.Offline => ("mat-pill--warn", "Offline"),
        MatDock.Core.Entities.EnvironmentStatus.Error => ("mat-pill--error", "Error"),
        _ => ("mat-pill--plain", "Unknown")
    };
}
<span class="mat-pill @tone">@label</span>
