@model MatDock.Core.Entities.EnvironmentStatus
@{
    var (tone, icon, label) = Model switch
    {
        MatDock.Core.Entities.EnvironmentStatus.Online => ("mat-pill--ok", "check-circle", "Online"),
        MatDock.Core.Entities.EnvironmentStatus.Offline => ("mat-pill--warn", "clock", "Offline"),
        MatDock.Core.Entities.EnvironmentStatus.Error => ("mat-pill--error", "x-circle", "Error"),
        _ => ("mat-pill--plain", "clock", "Unknown")
    };
}
<span class="mat-pill @tone"><icon name="@icon" /><span>@label</span></span>
