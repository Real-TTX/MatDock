@{
    var bp = Context.Request.Path.Value ?? "";
    bool On(string s) => bp.StartsWith(s, StringComparison.OrdinalIgnoreCase);
    var onTargets = On("/Backups/Targets");
    var onHistory = On("/Backups") && !onTargets;
}
<nav class="mat-tabs">
    <a class="mat-tabs__tab @(On("/Schedules") ? "is-active" : "")" href="/Schedules"><icon name="clock" /><span>Jobs</span></a>
    <a class="mat-tabs__tab @(onHistory ? "is-active" : "")" href="/Backups"><icon name="save" /><span>History</span></a>
    <a class="mat-tabs__tab @(onTargets ? "is-active" : "")" href="/Backups/Targets"><icon name="server" /><span>Targets</span></a>
</nav>
