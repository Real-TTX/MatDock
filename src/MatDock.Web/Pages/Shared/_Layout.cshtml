@inject Toolkit Toolkit
@inject MatDock.Core.Environments.EnvironmentService EnvSvc
@inject MatDock.Core.Proxies.ProxyConnectionService ProxySvc
@inject MatDock.Core.Registries.RegistryService RegistrySvc
@*
    The shell of every signed-in page (MatUi): the menu on the left, the bar with the breadcrumb on top, the page with its heading.
    A page fills in: Title (also the heading), Heading (a heading other than the title), Sub (a line under the heading), Crumbs (the way back,
    a list of (Text, Url)), Width ("narrow" or "wide") and the section Actions (buttons in the top bar).
    A page without the menu (sign-in, setup, error) uses _Bare.
*@
@{
    var path = Context.Request.Path.Value ?? "/";
    bool IsActive(string prefix) => prefix == "/"
        ? path == "/"
        : path.Equals(prefix, StringComparison.OrdinalIgnoreCase) || path.StartsWith(prefix + "/", StringComparison.OrdinalIgnoreCase);
    var isAdmin = User.IsAdmin();

    var name = Ui.App.Name;
    var title = ViewData["Title"] as string ?? name;
    var heading = ViewData["Heading"] as string ?? title;
    var sub = ViewData["Sub"] as string;
    var width = ViewData["Width"] as string;
    var crumbs = ViewData["Crumbs"] as IReadOnlyList<(string Text, string? Url)> ?? [];
    var userName = User.GetDisplayName();
    var role = User.GetRole();

    var environments = await EnvSvc.GetEnabledAsync(Context.RequestAborted);
    var currentEnv = MatDock.Web.Support.EnvSelection.Current(Context);
    var currentEnvName = environments.FirstOrDefault(e => e.Id == currentEnv)?.Name ?? "All environments";
    // Proxy and Registry only appear once one is configured (admins only).
    var hasProxy = isAdmin && await ProxySvc.AnyAsync(Context.RequestAborted);
    var hasRegistry = isAdmin && await RegistrySvc.AnyAsync(Context.RequestAborted);

    var menu = new List<(string? Group, List<(string Href, string Icon, string Text, bool Active)> Items)>
    {
        (null, [
            ("/", "dashboard", "Dashboard", IsActive("/")),
            ("/Environments", "server", "Environments", IsActive("/Environments")),
            ("/Launchpad", "apps", "Apps", IsActive("/Launchpad")),
        ]),
    };
    var docker = new List<(string Href, string Icon, string Text, bool Active)>();
    if (isAdmin)
    {
        docker.Add(("/Stacks", "layers", "Stacks", IsActive("/Stacks") && !IsActive("/Stacks/SyncJobs")));
    }
    docker.Add(("/Containers", "box", "Containers", IsActive("/Containers")));
    docker.Add(("/Images", "image", "Images", IsActive("/Images")));
    docker.Add(("/Volumes", "volume", "Volumes", IsActive("/Volumes")));
    docker.Add(("/Networks", "network", "Networks", IsActive("/Networks")));
    menu.Add(("Docker", docker));
    if (isAdmin)
    {
        var operations = new List<(string Href, string Icon, string Text, bool Active)>
        {
            ("/Stacks/SyncJobs", "refresh", "Sync", IsActive("/Stacks/SyncJobs")),
            ("/Updates", "arrow-up", "Updates", IsActive("/Updates")),
            ("/Schedules", "clock", "Schedules", IsActive("/Schedules")),
            ("/Backups", "save", "Backups", IsActive("/Backups")),
        };
        if (hasProxy)
        {
            operations.Add(("/Proxy", "route", "Proxy", IsActive("/Proxy")));
        }
        if (hasRegistry)
        {
            operations.Add(("/Registry", "registry", "Registry", IsActive("/Registry")));
        }
        menu.Add(("Operations", operations));
        menu.Add(("Administration", [
            ("/Settings", "settings", "System", IsActive("/Settings") || IsActive("/Users") || IsActive("/GitCredentials") || IsActive("/GitRepos")),
        ]));
    }
}
<!DOCTYPE html>
<html lang="en" data-app="@Ui.App.Id">
<partial name="_Head" model="@(title == name ? name : $"{title} · {name}")" />
<body>
    <a class="mat-skip" href="#main">Skip to the content</a>
    @Html.Raw(Toolkit.Sprite)

    <div class="mat-app">
        <aside class="mat-nav" id="mat-nav">
            <div class="mat-nav__brand">
                <a href="/" aria-label="@name, dashboard">
                    @Ui.Logo()
                    <span>
                        <span class="mat-nav__name">@name</span>
                        <span class="mat-nav__tagline">@Ui.App.Tagline</span>
                    </span>
                </a>
                <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-nav__close" data-nav-close aria-label="Close the menu">@Ui.Icon("x")</button>
            </div>

            <div class="mat-nav__switch">
                <button type="button" class="mat-switcher" id="env-switch" data-menu-toggle="env-menu" aria-haspopup="menu" aria-expanded="false">
                    <span class="mat-switcher__icon">@Ui.Icon("server")</span>
                    <span class="mat-switcher__text">
                        <small>Environment</small>
                        <span class="mat-switcher__name">@currentEnvName</span>
                    </span>
                    @Ui.Icon("chevron-down", "mat-switcher__chev")
                </button>
            </div>

            <nav class="mat-nav__scroll" aria-label="Main">
                <ul class="mat-nav__list">
                    @foreach (var group in menu)
                    {
                        if (group.Group is not null)
                        {
                            <li class="mat-nav__group" role="presentation">@group.Group</li>
                        }

                        foreach (var item in group.Items)
                        {
                            <li>
                                <a class="mat-nav__item @(item.Active ? "is-active" : "")" href="@item.Href" aria-current="@(item.Active ? "page" : null)">
                                    @Ui.Icon(item.Icon)<span>@item.Text</span>
                                </a>
                            </li>
                        }
                    }
                </ul>
            </nav>

            <div class="mat-nav__foot">
                <div class="mat-nav__account">
                    <button type="button" class="mat-user" data-menu-toggle="user-menu" aria-haspopup="menu" aria-expanded="false">
                        <span class="mat-avatar" aria-hidden="true">@Ui.Initials(userName)</span>
                        <span class="mat-user__text">
                            <span class="mat-user__name">@userName</span>
                            <span class="mat-user__role">@role</span>
                        </span>
                        @Ui.Icon("chevron-up", "mat-user__chev")
                    </button>
                    <button type="button" class="mat-theme" data-theme-toggle data-theme-state="system" aria-label="Theme: System. Click for Light." title="Theme: System. Click for Light.">
                        <svg class="mat-icon" data-theme-icon="system" aria-hidden="true" focusable="false"><use href="#mat-i-monitor"></use></svg>
                        <svg class="mat-icon" data-theme-icon="light" aria-hidden="true" focusable="false"><use href="#mat-i-sun"></use></svg>
                        <svg class="mat-icon" data-theme-icon="dark" aria-hidden="true" focusable="false"><use href="#mat-i-moon"></use></svg>
                    </button>
                </div>
                <a class="mat-nav__version md-nav-version" href="/About" title="About @name" aria-current="@(IsActive("/About") ? "page" : null)">@name @AppVersion.Informational</a>
            </div>
        </aside>

        <div class="mat-main">
            <header class="mat-topbar">
                <button type="button" class="mat-burger" data-nav-toggle aria-label="Open the menu" aria-controls="mat-nav" aria-expanded="false">@Ui.Icon("menu")</button>
                <nav class="mat-crumbs" aria-label="Breadcrumb">
                    <ol>
                        @if (crumbs.Count == 0)
                        {
                            <li aria-current="page">@title</li>
                        }
                        else
                        {
                            @for (var i = 0; i < crumbs.Count; i++)
                            {
                                var c = crumbs[i];
                                if (c.Url is null)
                                {
                                    <li>@c.Text</li>
                                }
                                else
                                {
                                    <li><a href="@c.Url">@c.Text</a></li>
                                }
                            }
                            <li aria-current="page">@title</li>
                        }
                    </ol>
                </nav>
                @if (IsSectionDefined("Actions"))
                {
                    <div class="mat-topbar__actions">
                        @await RenderSectionAsync("Actions")
                    </div>
                }
            </header>

            <main class="mat-page @(width == "narrow" ? "mat-page--narrow" : width == "wide" ? "mat-page--wide" : "")" id="main">
                <div class="mat-page__head">
                    <div class="mat-page__title">
                        <h1>@heading</h1>
                        @if (!string.IsNullOrEmpty(sub))
                        {
                            <p class="mat-page__sub">@sub</p>
                        }
                    </div>
                </div>

                @RenderBody()
            </main>
        </div>
    </div>

    <div class="mat-menu" id="env-menu" role="menu" aria-label="Environment" hidden>
        <button type="button" class="mat-menu__item" role="menuitemradio" aria-checked="@(currentEnv is null ? "true" : "false")" data-env-set="0">@Ui.Icon("layers")<span>All environments</span>@Ui.Icon("check", "mat-menu__check")</button>
        @if (environments.Count > 0)
        {
            <div class="mat-menu__sep" role="separator"></div>
        }
        @foreach (var env in environments)
        {
            <button type="button" class="mat-menu__item" role="menuitemradio" aria-checked="@(currentEnv == env.Id ? "true" : "false")" data-env-set="@env.Id">@Ui.Icon("server")<span>@env.Name</span>@Ui.Icon("check", "mat-menu__check")</button>
        }
    </div>

    <div class="mat-menu" id="user-menu" role="menu" aria-label="@userName" hidden>
        <div class="mat-menu__head">
            <span class="mat-avatar" aria-hidden="true">@Ui.Initials(userName)</span>
            <div><strong>@userName</strong><small>@role</small></div>
        </div>
        <a class="mat-menu__item" role="menuitem" href="/Account/Profile">@Ui.Icon("user")<span>Profile</span></a>
        <div class="mat-menu__sep" role="separator"></div>
        <form method="post" asp-page="/Account/Logout">
            <button type="submit" class="mat-menu__item" role="menuitem">@Ui.Icon("logout")<span>Sign out</span></button>
        </form>
    </div>

    <script src="~/matui/matui.js" asp-append-version="true"></script>
    <script src="~/js/matdock.js" asp-append-version="true"></script>
    <script src="~/js/pwa.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
