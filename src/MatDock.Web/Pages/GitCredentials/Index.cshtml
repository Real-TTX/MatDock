@page
@model MatDock.Web.Pages.GitCredentials.IndexModel
@{
    ViewData["Title"] = "Git credentials";
}

<partial name="_SystemTabs" />

<partial name="_StatusMessage" model="(Model.StatusMessage, Model.IsError)" />

<mat-table>
    <mat-table-toolbar><partial name="_ListToolbar" model="Model.Toolbar" /></mat-table-toolbar>
    <mat-table-body>
    @if (Model.Credentials.Count == 0)
    {
        <div class="mat-empty"><div class="mat-empty__icon"><icon name="key" /></div><p class="mat-empty__title">@(Model.Total == 0 ? "No git credentials yet." : "No git credentials found.")</p></div>
    }
    else
    {
    <div class="mat-table-wrap">
    <table class="mat-table">
        <thead>
            <tr><th>Name</th><th>Type</th><th>User</th></tr>
        </thead>
        <tbody>
            @foreach (var c in Model.Credentials)
            {
                <tr>
                    <td data-label="Name"><a href="/GitCredentials/Edit?id=@c.Id"><strong>@c.Name</strong></a></td>
                    <td class="mat-muted" data-label="Type">@(c.AuthType == MatDock.Core.Entities.GitAuthType.SshKey ? "SSH key" : "HTTPS token")</td>
                    <td class="mat-muted" data-label="User">@(string.IsNullOrEmpty(c.Username) ? "–" : c.Username)</td>
                </tr>
            }
        </tbody>
    </table>
    </div>
    }
    </mat-table-body>
    <mat-table-actions>
        <a href="/GitCredentials/Edit" class="mat-btn mat-btn--primary"><icon name="plus" /><span>New git credential</span></a>
    </mat-table-actions>
</mat-table>
