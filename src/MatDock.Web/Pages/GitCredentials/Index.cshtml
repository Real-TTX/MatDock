@page
@model MatDock.Web.Pages.GitCredentials.IndexModel
@{
    ViewData["Title"] = "Git credentials";
}

<partial name="_SystemTabs" />

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="mat-alert @(Model.IsError ? "mat-alert--danger" : "mat-alert--success")">
        <icon name="@(Model.IsError ? "x-circle" : "check-circle")" /><div class="mat-alert__body">@Model.StatusMessage</div>
    </div>
}

<mat-table>
    <mat-table-body>
    @if (Model.Credentials.Count == 0)
    {
        <div class="mat-empty"><div class="mat-empty__icon"><icon name="key" /></div><p>No git credentials yet.</p></div>
    }
    else
    {
    <table class="mat-table">
        <thead>
            <tr><th>Name</th><th>Type</th><th>User</th></tr>
        </thead>
        <tbody>
            @foreach (var c in Model.Credentials)
            {
                <tr>
                    <td><a href="/GitCredentials/Edit?id=@c.Id"><strong>@c.Name</strong></a></td>
                    <td class="mat-muted">@(c.AuthType == MatDock.Core.Entities.GitAuthType.SshKey ? "SSH key" : "HTTPS token")</td>
                    <td class="mat-muted">@(string.IsNullOrEmpty(c.Username) ? "–" : c.Username)</td>
                </tr>
            }
        </tbody>
    </table>
    }
    </mat-table-body>
    <mat-table-actions>
        <a href="/GitCredentials/Edit" class="mat-btn mat-btn--primary"><icon name="plus" /><span>New git credential</span></a>
    </mat-table-actions>
</mat-table>
