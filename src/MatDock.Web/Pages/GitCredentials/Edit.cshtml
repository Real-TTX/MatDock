@page
@model MatDock.Web.Pages.GitCredentials.EditModel
@{
    ViewData["Title"] = Model.IsEdit ? "Edit git credential" : "New git credential";
    ViewData["Crumbs"] = new List<(string Text, string? Url)> { ("Git credentials", "/GitCredentials") };
}

<partial name="_SystemTabs" />

<div class="u-maxw card">
    <div class="card__body">
        <form method="post" class="mat-form">
            <input type="hidden" asp-for="Input.Id" />
            <partial name="_ValidationSummary" />

            <div class="form-grid">
                <mat-field label="Name" asp-for="Input.Name" class="span-2" hint="Display name, e.g. GitHub – Deploy.">
                    <input asp-for="Input.Name" class="mat-input" placeholder="e.g. GitHub – Deploy" />
                </mat-field>

                <mat-field label="Type" asp-for="Input.AuthType" class="span-2">
                    <select asp-for="Input.AuthType" id="GitAuthType" class="mat-select">
                        <option value="HttpsToken">HTTPS with a token</option>
                        <option value="SshKey">SSH with a key (ssh:// or git@host:org/repo.git)</option>
                    </select>
                </mat-field>
            </div>

            <div data-show-when="GitAuthType=HttpsToken">
                <div class="form-grid">
                    <mat-field label="User" asp-for="Input.Username" hint="Git username (for GitHub any value usually works, e.g. the account name).">
                        <input asp-for="Input.Username" class="mat-input" autocomplete="off" placeholder="e.g. your-github-name" />
                    </mat-field>

                    @{
                        var tokenHint = Model.IsEdit ? "Leave blank to keep the stored token." : "Personal access token (repo read access is enough).";
                        var keyHint = Model.IsEdit ? "Leave blank to keep the stored key." : "A deploy key with read access is enough.";
                    }
                    <mat-field label="Token" asp-for="Input.Token" hint="@tokenHint">
                        <input asp-for="Input.Token" type="password" class="mat-input" autocomplete="new-password" placeholder="ghp_… / glpat-…" />
                    </mat-field>
                </div>
            </div>

            <div data-show-when="GitAuthType=SshKey">
                <mat-field label="Private SSH key" asp-for="Input.PrivateKeyPem" hint="@keyHint">
                    <textarea asp-for="Input.PrivateKeyPem" class="mat-textarea mono" rows="6" spellcheck="false" placeholder="-----BEGIN OPENSSH PRIVATE KEY-----"></textarea>
                </mat-field>
                <div class="form-grid">
                    <mat-field label="Key passphrase" asp-for="Input.Passphrase" hint="Optional.">
                        <input asp-for="Input.Passphrase" type="password" class="mat-input" autocomplete="new-password" />
                    </mat-field>
                    <mat-field label="Host key of the Git server" asp-for="Input.HostKeyFingerprint" hint="SHA256:…; empty = saved at the first clone, another one is then refused.">
                        <input asp-for="Input.HostKeyFingerprint" class="mat-input mono" autocomplete="off" placeholder="SHA256:…" />
                    </mat-field>
                </div>
            </div>

            <mat-form-buttons>
                <button type="submit" asp-page-handler="Save" class="mat-btn mat-btn--primary"><icon name="save" /><span>Save</span></button>
                <a href="/GitCredentials" class="mat-btn mat-btn--ghost"><icon name="back" /><span>Back</span></a>
                @if (Model.IsEdit)
                {
                    <span class="mat-btn-row__spacer"></span>
                    <button type="submit" form="delete-form" class="mat-btn mat-btn--danger" data-confirm="Delete git credential '@Model.Input.Name'?"><icon name="trash" /><span>Delete</span></button>
                }
            </mat-form-buttons>
        </form>
        @if (Model.IsEdit)
        {
            <form method="post" asp-page-handler="Delete" id="delete-form"><input type="hidden" name="id" value="@Model.Input.Id" /></form>
        }
    </div>
</div>
