@page
@model MatDock.Web.Pages.GitCredentials.EditModel
@{
    ViewData["Title"] = Model.IsEdit ? "Edit git credential" : "New git credential";
}

<div class="page-head">
    <div class="page-head__title">
        <h1>@ViewData["Title"]</h1>
        <span class="page-head__subtitle">HTTPS access (user + personal access token) for cloning private repos</span>
    </div>
</div>

<div class="card" style="max-width:760px;">
    <div class="card__body">
        <form method="post" class="mat-form">
            <input type="hidden" asp-for="Input.Id" />
            <div asp-validation-summary="ModelOnly"></div>

            <div class="form-grid">
                <mat-field label="Name" asp-for="Input.Name" class="span-2" hint="Display name, e.g. GitHub – Deploy.">
                    <input asp-for="Input.Name" class="mat-input" placeholder="e.g. GitHub – Deploy" />
                </mat-field>

                <mat-field label="User" asp-for="Input.Username" hint="Git username (for GitHub any value usually works, e.g. the account name).">
                    <input asp-for="Input.Username" class="mat-input" autocomplete="off" placeholder="e.g. your-github-name" />
                </mat-field>

                @{
                    var tokenHint = Model.IsEdit ? "Leave blank to keep the stored token." : "Personal access token (repo read access is enough).";
                }
                <mat-field label="Token" asp-for="Input.Token" hint="@tokenHint">
                    <input asp-for="Input.Token" type="password" class="mat-input" autocomplete="new-password" placeholder="ghp_… / glpat-…" />
                </mat-field>
            </div>

            <mat-form-buttons>
                <button type="submit" asp-page-handler="Save" class="mat-btn mat-btn--primary"><icon name="save" /><span>Save</span></button>
                <a href="/GitCredentials" class="mat-btn mat-btn--ghost"><icon name="back" /><span>Back</span></a>
            </mat-form-buttons>
        </form>
    </div>
</div>
