@page
@using MatDock.Core.Containers
@model MatDock.Web.Pages.Containers.StackModel
@{
    ViewData["Title"] = "Stack";
    var ci = System.Globalization.CultureInfo.InvariantCulture;
    string Pct(double? v) => Math.Clamp(v ?? 0, 0, 100).ToString(ci);
}

<div class="page-head">
    <div class="page-head__title">
        <h1>@Model.Project</h1>
        <span class="page-head__subtitle">Stack on @Model.Environment?.Name</span>
    </div>
    <div class="mat-buttons">
        <a href="/Stacks?EnvId=@Model.EnvId" class="mat-btn mat-btn--ghost"><icon name="back" /><span>Back</span></a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert @(Model.IsError ? "alert--error" : "alert--success")"><icon name="@(Model.IsError ? "x-circle" : "check-circle")" /><span>@Model.StatusMessage</span></div>
}

@if (Model.Error is not null)
{
    <div class="alert alert--error"><icon name="x-circle" /><span>@Model.Error</span></div>
}
else
{
    var allRunning = Model.RunningCount == Model.TotalCount;
    var noneRunning = Model.RunningCount == 0;
    <div class="alert @(allRunning ? "alert--success" : noneRunning ? "alert--warning" : "alert--info")">
        <icon name="box" />
        <span><strong>@Model.RunningCount / @Model.TotalCount running</strong> — @(allRunning ? "Stack fully running" : noneRunning ? "Stack stopped" : "Stack partially running")</span>
    </div>

    <div class="card" style="padding:0;">
        <table class="data">
            <thead><tr><th>Container</th><th>Status</th><th>Ports</th><th>Resources</th><th class="actions">Actions</th></tr></thead>
            <tbody>
                @foreach (var c in Model.Containers.OrderBy(x => x.Service ?? x.Name, StringComparer.OrdinalIgnoreCase))
                {
                    var openUrl = MatDock.Web.Support.OpenUrls.Resolve(c.OpenUrlOverride, Model.Environment?.BaseUrl);
                    <tr>
                        <td class="wrap">
                            <a href="/Containers/ContainerDetail?envId=@Model.EnvId&id=@Uri.EscapeDataString(c.Id)"><strong>@c.Name</strong></a>
                            @if (!string.IsNullOrEmpty(c.Service)) { <div class="cell-sub">@c.Service</div> }
                        </td>
                        <td><container-status state="@c.State" status="@c.Status" /></td>
                        <td><container-ports ports="@c.Ports" host="@(Model.Environment is null ? null : MatDock.Web.Support.OpenUrls.PortLinkHost(Model.Environment))" /></td>
                        <td class="res-cell">
                            @if (c.CpuPercent is null && c.MemPercent is null && string.IsNullOrEmpty(c.MemUsage))
                            {
                                <span class="text-muted">–</span>
                            }
                            else
                            {
                                <div class="res">
                                    <div class="res__row" title="RAM: @(string.IsNullOrEmpty(c.MemUsage) ? "n/a" : c.MemUsage)@(c.MemPercent is { } mp ? $" ({mp.ToString("0.0", ci)}%)" : "")">
                                        <span class="res__k">RAM</span>
                                        <span class="ubar"><span class="ubar__fill" style="width:@(Pct(c.MemPercent))%"></span></span>
                                        <span class="res__v">@(c.MemPercent is { } m ? Math.Round(m).ToString(ci) + "%" : "–")</span>
                                    </div>
                                    <div class="res__row" title="CPU: @(c.CpuPercent is { } cp ? cp.ToString("0.0", ci) + "%" : "n/a")">
                                        <span class="res__k">CPU</span>
                                        <span class="ubar"><span class="ubar__fill" style="width:@(Pct(c.CpuPercent))%"></span></span>
                                        <span class="res__v">@(c.CpuPercent is { } cv ? cv.ToString("0.0", ci) + "%" : "–")</span>
                                    </div>
                                </div>
                            }
                        </td>
                        <td class="actions">
                            <div class="row-actions">
                                @if (openUrl is not null)
                                {
                                    <a class="mat-btn mat-btn--sm" href="@openUrl" target="_blank" rel="noopener noreferrer" title="Open"><icon name="external" /></a>
                                }
                                <a class="mat-btn mat-btn--sm" href="/Containers/Logs?EnvId=@Model.EnvId&id=@Uri.EscapeDataString(c.Id)" title="Logs"><icon name="eye" /></a>
                                @if (c.IsRunning)
                                {
                                    <form method="post" asp-page-handler="Action" style="display:inline;">
                                        <input type="hidden" name="envId" value="@Model.EnvId" /><input type="hidden" name="project" value="@Model.Project" /><input type="hidden" name="id" value="@c.Id" /><input type="hidden" name="action" value="Restart" />
                                        <button type="submit" class="mat-btn mat-btn--sm" title="Restart"><icon name="refresh" /></button>
                                    </form>
                                    <form method="post" asp-page-handler="Action" data-confirm="Stop '@c.Name'?" style="display:inline;">
                                        <input type="hidden" name="envId" value="@Model.EnvId" /><input type="hidden" name="project" value="@Model.Project" /><input type="hidden" name="id" value="@c.Id" /><input type="hidden" name="action" value="Stop" />
                                        <button type="submit" class="mat-btn mat-btn--sm mat-btn--danger" title="Stop"><icon name="stop" /></button>
                                    </form>
                                }
                                else
                                {
                                    <form method="post" asp-page-handler="Action" style="display:inline;">
                                        <input type="hidden" name="envId" value="@Model.EnvId" /><input type="hidden" name="project" value="@Model.Project" /><input type="hidden" name="id" value="@c.Id" /><input type="hidden" name="action" value="Start" />
                                        <button type="submit" class="mat-btn mat-btn--sm mat-btn--primary" title="Start"><icon name="play" /></button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
