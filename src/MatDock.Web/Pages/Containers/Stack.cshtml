@page
@using MatDock.Core.Containers
@model MatDock.Web.Pages.Containers.StackModel
@{
    ViewData["Title"] = "Stack";
    string CpuText(DockerContainer c) => c.CpuPercent is { } v ? $"{v:0.0}%" : "–";
}

<div class="page-head">
    <div class="page-head__title">
        <h1>@Model.Project</h1>
        <span class="page-head__subtitle">Stack auf @Model.Environment?.Name</span>
    </div>
    <div class="mat-buttons">
        <a href="/Containers?EnvId=@Model.EnvId&Tab=stacks" class="mat-btn mat-btn--ghost"><icon name="back" /><span>Zurück</span></a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert @(Model.IsError ? "alert--error" : "alert--success")"><icon name="@(Model.IsError ? "x-circle" : "check-circle")" /><span>@Model.StatusMessage</span></div>
}

@if (Model.Error is not null)
{
    <div class="alert alert--error"><icon name="x-circle" /><span>@Model.Error</span></div>
}
else
{
    var allRunning = Model.RunningCount == Model.TotalCount;
    var noneRunning = Model.RunningCount == 0;
    <div class="alert @(allRunning ? "alert--success" : noneRunning ? "alert--warning" : "alert--info")">
        <icon name="box" />
        <span><strong>@Model.RunningCount / @Model.TotalCount laufen</strong> — @(allRunning ? "Stack läuft vollständig" : noneRunning ? "Stack gestoppt" : "Stack läuft teilweise")</span>
    </div>

    <div class="card" style="padding:0;">
        <table class="data">
            <thead><tr><th>Container</th><th>Status</th><th>Ports</th><th>CPU</th><th>RAM</th><th class="actions">Aktionen</th></tr></thead>
            <tbody>
                @foreach (var c in Model.Containers.OrderBy(x => x.Service ?? x.Name, StringComparer.OrdinalIgnoreCase))
                {
                    var openUrl = MatDock.Web.Support.OpenUrls.Resolve(c.OpenUrlOverride, Model.Environment?.BaseUrl);
                    <tr>
                        <td class="wrap">
                            <a href="/Containers/ContainerDetail?envId=@Model.EnvId&id=@Uri.EscapeDataString(c.Id)"><strong>@c.Name</strong></a>
                            @if (!string.IsNullOrEmpty(c.Service)) { <div class="cell-sub">@c.Service</div> }
                        </td>
                        <td>@if (c.IsRunning) {<span class="pill pill--online"><icon name="check-circle" /><span>@c.Status</span></span>} else {<span class="pill pill--unknown">@c.Status</span>}</td>
                        <td class="cell-sub mono">@c.Ports</td>
                        <td class="num">@CpuText(c)</td>
                        <td class="num cell-sub">@(string.IsNullOrEmpty(c.MemUsage) ? "–" : c.MemUsage)</td>
                        <td class="actions">
                            <div class="row-actions">
                                @if (openUrl is not null)
                                {
                                    <a class="mat-btn mat-btn--sm" href="@openUrl" target="_blank" rel="noopener noreferrer" title="Öffnen"><icon name="external" /></a>
                                }
                                <a class="mat-btn mat-btn--sm" href="/Containers/Logs?EnvId=@Model.EnvId&id=@Uri.EscapeDataString(c.Id)" title="Logs"><icon name="eye" /></a>
                                @if (c.IsRunning)
                                {
                                    <form method="post" asp-page-handler="Action" style="display:inline;">
                                        <input type="hidden" name="envId" value="@Model.EnvId" /><input type="hidden" name="project" value="@Model.Project" /><input type="hidden" name="id" value="@c.Id" /><input type="hidden" name="action" value="Restart" />
                                        <button type="submit" class="mat-btn mat-btn--sm" title="Neustart"><icon name="refresh" /></button>
                                    </form>
                                    <form method="post" asp-page-handler="Action" data-confirm="„@c.Name“ stoppen?" style="display:inline;">
                                        <input type="hidden" name="envId" value="@Model.EnvId" /><input type="hidden" name="project" value="@Model.Project" /><input type="hidden" name="id" value="@c.Id" /><input type="hidden" name="action" value="Stop" />
                                        <button type="submit" class="mat-btn mat-btn--sm mat-btn--danger" title="Stop"><icon name="x-circle" /></button>
                                    </form>
                                }
                                else
                                {
                                    <form method="post" asp-page-handler="Action" style="display:inline;">
                                        <input type="hidden" name="envId" value="@Model.EnvId" /><input type="hidden" name="project" value="@Model.Project" /><input type="hidden" name="id" value="@c.Id" /><input type="hidden" name="action" value="Start" />
                                        <button type="submit" class="mat-btn mat-btn--sm mat-btn--primary" title="Start"><icon name="check-circle" /></button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
