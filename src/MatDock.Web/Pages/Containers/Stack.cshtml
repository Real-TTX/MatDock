@page
@using MatDock.Core.Containers
@model MatDock.Web.Pages.Containers.StackModel
@{
    ViewData["Title"] = Model.Project;
    ViewData["Crumbs"] = new List<(string Text, string? Url)> { ("Stacks", $"/Stacks?EnvId={Model.EnvId}") };
}

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    if (Model.IsError)
    {
        <div class="mat-alert mat-alert--danger" role="alert"><icon name="x-circle" /><div class="mat-alert__body">@Model.StatusMessage</div></div>
    }
    else
    {
        <div data-toast="@Model.StatusMessage" data-tone="success" hidden></div>
    }
}

<div id="live-stack" data-live="20" class="mat-stack">
@if (Model.Error is not null)
{
    <div class="mat-alert mat-alert--danger"><icon name="x-circle" /><div class="mat-alert__body">@Model.Error</div></div>
}
else
{
    var allRunning = Model.RunningCount == Model.TotalCount;
    var noneRunning = Model.RunningCount == 0;
    <div class="mat-alert @(allRunning ? "mat-alert--success" : noneRunning ? "mat-alert--warning" : "mat-alert--info")">
        <icon name="box" />
        <div class="mat-alert__body"><strong>@Model.RunningCount / @Model.TotalCount running</strong> — @(allRunning ? "Stack fully running" : noneRunning ? "Stack stopped" : "Stack partially running")</div>
    </div>

    <div class="mat-table-wrap">
        <table class="mat-table">
            <thead><tr><th>Container</th><th>Status</th><th>Ports</th><th>Resources</th><th class="mat-table__cell-actions"><span class="mat-sr-only">Actions</span></th></tr></thead>
            <tbody>
                @foreach (var c in Model.Containers.OrderBy(x => x.Service ?? x.Name, StringComparer.OrdinalIgnoreCase))
                {
                    var openUrl = MatDock.Web.Support.OpenUrls.Resolve(c.OpenUrlOverride, Model.Environment?.BaseUrl);
                    <tr>
                        <td data-label="Container">
                            <div class="mat-table__name">
                                <span>
                                    <a href="/Containers/ContainerDetail?envId=@Model.EnvId&id=@Uri.EscapeDataString(c.Id)">@c.Name</a>
                                    @if (!string.IsNullOrEmpty(c.Service)) { <small class="mat-mono">@c.Service</small> }
                                </span>
                            </div>
                        </td>
                        <td data-label="Status"><container-status state="@c.State" status="@c.Status" /></td>
                        <td data-label="Ports"><container-ports ports="@c.Ports" host="@(Model.Environment is null ? null : MatDock.Web.Support.OpenUrls.PortLinkHost(Model.Environment))" /></td>
                        <td data-label="Resources"><usage mem="@c.MemPercent" cpu="@c.CpuPercent" mem-text="@c.MemUsage" /></td>
                        <td class="mat-table__cell-actions">
                            <div class="mat-table__actions">
                                @if (openUrl is not null)
                                {
                                    <a class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" href="@openUrl" target="_blank" rel="noopener noreferrer" title="Open" aria-label="Open"><icon name="external" /></a>
                                }
                                <a class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" href="/Containers/Logs?EnvId=@Model.EnvId&id=@Uri.EscapeDataString(c.Id)" title="Logs" aria-label="Logs"><icon name="eye" /></a>
                                @if (c.IsRunning)
                                {
                                    <form method="post" asp-page-handler="Action">
                                        <input type="hidden" name="envId" value="@Model.EnvId" /><input type="hidden" name="project" value="@Model.Project" /><input type="hidden" name="id" value="@c.Id" /><input type="hidden" name="name" value="@c.Name" /><input type="hidden" name="action" value="Restart" />
                                        <button type="submit" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" title="Restart" aria-label="Restart"><icon name="refresh" /></button>
                                    </form>
                                    <form method="post" asp-page-handler="Action" data-confirm="Stop '@c.Name'?">
                                        <input type="hidden" name="envId" value="@Model.EnvId" /><input type="hidden" name="project" value="@Model.Project" /><input type="hidden" name="id" value="@c.Id" /><input type="hidden" name="name" value="@c.Name" /><input type="hidden" name="action" value="Stop" />
                                        <button type="submit" class="mat-btn mat-btn--danger mat-btn--icon mat-btn--sm" title="Stop" aria-label="Stop"><icon name="stop" /></button>
                                    </form>
                                }
                                else
                                {
                                    <form method="post" asp-page-handler="Action">
                                        <input type="hidden" name="envId" value="@Model.EnvId" /><input type="hidden" name="project" value="@Model.Project" /><input type="hidden" name="id" value="@c.Id" /><input type="hidden" name="name" value="@c.Name" /><input type="hidden" name="action" value="Start" />
                                        <button type="submit" class="mat-btn mat-btn--primary mat-btn--icon mat-btn--sm" title="Start" aria-label="Start"><icon name="play" /></button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
</div>

@section Actions {
    <a href="/Containers/Logs?EnvId=@Model.EnvId&stack=@Uri.EscapeDataString(Model.Project)" class="mat-btn mat-btn--secondary"><icon name="eye" /><span>Logs</span></a>
}
