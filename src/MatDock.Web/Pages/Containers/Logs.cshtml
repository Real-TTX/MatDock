@page
@model MatDock.Web.Pages.Containers.LogsModel
@{
    ViewData["Title"] = "Container Logs";
    var tail = Model.Tail <= 0 ? 200 : Model.Tail;
}

<div class="page-head">
    <div class="page-head__title">
        <h1>Logs</h1>
        <span class="page-head__subtitle mono">@Model.Id · @Model.Environment?.Name</span>
    </div>
    <div class="mat-buttons">
        <a href="/Containers?EnvId=@Model.EnvId" class="mat-btn mat-btn--ghost"><icon name="back" /><span>Back</span></a>
    </div>
</div>

<div class="logview" id="logview"
     data-envid="@Model.EnvId"
     data-container="@Model.Id"
     data-tail="@tail">
    <div class="logview__bar">
        <button type="button" class="mat-btn mat-btn--sm logview__live is-live" data-log-live title="Pause / resume live stream">
            <span class="logview__dot"></span><span data-log-live-label>Live</span>
        </button>
        <button type="button" class="mat-btn mat-btn--sm is-active" data-log-follow title="Auto-scroll to newest"><icon name="chevron-right" /><span>Follow</span></button>

        <span class="logview__group" role="group" aria-label="Lines">
            <span class="text-muted" style="font-size:.8rem;">Lines</span>
            @foreach (var n in new[] { 100, 200, 500, 1000 })
            {
                <button type="button" class="mat-btn mat-btn--sm @(tail == n ? "mat-btn--primary" : "")" data-log-tail="@n">@n</button>
            }
        </span>

        <span class="toolbar-spacer"></span>

        <span class="search logview__search">
            <icon name="filter" />
            <input type="search" class="mat-input" data-log-filter placeholder="Filter (live)…" autocomplete="off" />
        </span>
        <span class="search logview__search">
            <icon name="search" />
            <input type="search" class="mat-input" data-log-search placeholder="Search…" autocomplete="off" />
        </span>
        <span class="logview__matches text-muted" data-log-matches></span>
        <button type="button" class="mat-btn mat-btn--sm" data-log-prev title="Previous match"><icon name="chevron-left" /></button>
        <button type="button" class="mat-btn mat-btn--sm" data-log-next title="Next match"><icon name="chevron-right" /></button>

        <button type="button" class="mat-btn mat-btn--sm" data-log-wrap title="Toggle line wrap"><icon name="menu" /><span>Wrap</span></button>
        <button type="button" class="mat-btn mat-btn--sm" data-log-clear title="Clear"><icon name="trash" /></button>
        <button type="button" class="mat-btn mat-btn--sm" data-log-download title="Download"><icon name="download" /></button>
    </div>

    <div class="logview__status" data-log-status>Connecting…</div>
    <div class="logview__pane" data-log-pane><div class="logview__lines" data-log-lines></div></div>
</div>

@section Scripts {
    <script src="~/js/logs.js" asp-append-version="true"></script>
}
