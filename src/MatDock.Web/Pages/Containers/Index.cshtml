@page
@using MatDock.Core.Containers
@model MatDock.Web.Pages.Containers.IndexModel
@{
    ViewData["Title"] = "Containers";
    var isGallery = string.Equals(Model.View, "gallery", StringComparison.OrdinalIgnoreCase);
    var isAdmin = User.IsInRole("Admin");

    string SearchKey(MatDock.Web.Pages.Containers.IndexModel.ContainerRow r) => $"{r.Env.Name} {r.Container.Name} {r.Container.Image} {r.Container.Service} {r.Container.Project} {r.Container.Ports}".ToLowerInvariant();
    string State(DockerContainer c) => c.IsRunning ? "running" : "stopped";
    string ViewUrl(string v) => $"/Containers?view={v}";

    // Shared action buttons (used by both list rows and tiles). Async because it renders TagHelpers.
    async Task Actions(MatDock.Web.Pages.Containers.IndexModel.ContainerRow r)
    {
        var env = r.Env;
        var c = r.Container;
        var openUrl = MatDock.Web.Support.OpenUrls.Resolve(c.OpenUrlOverride, env.BaseUrl);
        if (openUrl is not null)
        {
            <a class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" href="@openUrl" target="_blank" rel="noopener noreferrer" title="Open app" aria-label="Open app"><icon name="external" /></a>
        }
        if (isAdmin && c.IsRunning)
        {
            <a class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" href="/Terminal?envId=@env.Id&container=@Uri.EscapeDataString(c.Id)&name=@Uri.EscapeDataString(c.Name)" title="Shell" aria-label="Shell"><icon name="terminal" /></a>
        }
        <a class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" href="/Containers/Logs?EnvId=@env.Id&id=@Uri.EscapeDataString(c.Id)" title="Logs" aria-label="Logs"><icon name="eye" /></a>
        <a class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" href="/Volumes?EnvId=@env.Id&Q=@Uri.EscapeDataString(c.Project ?? c.Name)" title="Volumes of this container's stack" aria-label="Volumes"><icon name="volume" /></a>
        var paused = string.Equals(c.State, "paused", StringComparison.OrdinalIgnoreCase);
        @if (c.IsRunning)
        {
            <form method="post" asp-page-handler="Action">
                <input type="hidden" name="envId" value="@env.Id" /><input type="hidden" name="id" value="@c.Id" /><input type="hidden" name="name" value="@c.Name" />
                <input type="hidden" name="action" value="Restart" />
                <button type="submit" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" title="Restart" aria-label="Restart"><icon name="refresh" /></button>
            </form>
            <form method="post" asp-page-handler="Action">
                <input type="hidden" name="envId" value="@env.Id" /><input type="hidden" name="id" value="@c.Id" /><input type="hidden" name="name" value="@c.Name" />
                <input type="hidden" name="action" value="Pause" />
                <button type="submit" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" title="Pause" aria-label="Pause"><icon name="pause" /></button>
            </form>
            <form method="post" asp-page-handler="Action" data-confirm="Stop container '@c.Name'?">
                <input type="hidden" name="envId" value="@env.Id" /><input type="hidden" name="id" value="@c.Id" /><input type="hidden" name="name" value="@c.Name" />
                <input type="hidden" name="action" value="Stop" />
                <button type="submit" class="mat-btn mat-btn--danger mat-btn--icon mat-btn--sm" title="Stop" aria-label="Stop"><icon name="stop" /></button>
            </form>
            <form method="post" asp-page-handler="Action" data-confirm="Kill container '@c.Name'? (SIGKILL, no graceful shutdown)">
                <input type="hidden" name="envId" value="@env.Id" /><input type="hidden" name="id" value="@c.Id" /><input type="hidden" name="name" value="@c.Name" />
                <input type="hidden" name="action" value="Kill" />
                <button type="submit" class="mat-btn mat-btn--danger mat-btn--icon mat-btn--sm" title="Kill" aria-label="Kill"><icon name="x-circle" /></button>
            </form>
        }
        else if (paused)
        {
            <form method="post" asp-page-handler="Action">
                <input type="hidden" name="envId" value="@env.Id" /><input type="hidden" name="id" value="@c.Id" /><input type="hidden" name="name" value="@c.Name" />
                <input type="hidden" name="action" value="Unpause" />
                <button type="submit" class="mat-btn mat-btn--primary mat-btn--icon mat-btn--sm" title="Unpause" aria-label="Unpause"><icon name="play" /></button>
            </form>
            <form method="post" asp-page-handler="Action" data-confirm="Stop container '@c.Name'?">
                <input type="hidden" name="envId" value="@env.Id" /><input type="hidden" name="id" value="@c.Id" /><input type="hidden" name="name" value="@c.Name" />
                <input type="hidden" name="action" value="Stop" />
                <button type="submit" class="mat-btn mat-btn--danger mat-btn--icon mat-btn--sm" title="Stop" aria-label="Stop"><icon name="stop" /></button>
            </form>
        }
        else
        {
            <form method="post" asp-page-handler="Action">
                <input type="hidden" name="envId" value="@env.Id" /><input type="hidden" name="id" value="@c.Id" /><input type="hidden" name="name" value="@c.Name" />
                <input type="hidden" name="action" value="Start" />
                <button type="submit" class="mat-btn mat-btn--primary mat-btn--icon mat-btn--sm" title="Start" aria-label="Start"><icon name="play" /></button>
            </form>
        }
    }
}

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    if (Model.IsError)
    {
        <div class="mat-alert mat-alert--danger" role="alert"><icon name="x-circle" /><div class="mat-alert__body">@Model.StatusMessage</div></div>
    }
    else
    {
        <div data-toast="@Model.StatusMessage" data-tone="success" hidden></div>
    }
}
@foreach (var err in Model.LoadErrors)
{
    <div class="mat-alert mat-alert--danger" role="alert"><icon name="x-circle" /><div class="mat-alert__body">@err</div></div>
}

<mat-table>
    <mat-table-toolbar>
        <div class="mat-input-icon mat-toolbar__search">
            <icon name="search" />
            <input type="search" id="container-filter" class="mat-input" placeholder="Filter (name, image, stack, env, port)…" aria-label="Filter the containers" autocomplete="off" data-shortcut="/" />
        </div>
        <label class="mat-sr-only" for="container-status">Status</label>
        <select id="container-status" class="mat-select mat-w-auto">
            <option value="">All statuses</option>
            <option value="running">Running</option>
            <option value="stopped">Stopped</option>
        </select>
        <span class="mat-toolbar__spacer"></span>
        <span class="mat-toolbar__info" aria-live="polite"><strong id="container-count">@Model.Rows.Count</strong> of <span id="container-total">@Model.Rows.Count</span></span>
        <div class="mat-toolbar__end">
            <div class="mat-btn-group" role="group" aria-label="View">
                <a href="@ViewUrl("list")" class="mat-btn mat-btn--sm mat-btn--icon @(isGallery ? "" : "is-active")" aria-current="@(isGallery ? null : "true")" title="List" aria-label="List"><icon name="list" /></a>
                <a href="@ViewUrl("gallery")" class="mat-btn mat-btn--sm mat-btn--icon @(isGallery ? "is-active" : "")" aria-current="@(isGallery ? "true" : null)" title="Tiles" aria-label="Tiles"><icon name="grid" /></a>
            </div>
        </div>
    </mat-table-toolbar>

    <mat-table-body>
        <div id="live-containers" data-live="20">
        @if (Model.Environments.Count == 0)
        {
            <div class="mat-empty mat-empty--framed"><div class="mat-empty__icon"><icon name="box" /></div><p>No active environment.</p></div>
        }
        else if (Model.Rows.Count == 0)
        {
            <div class="mat-empty mat-empty--framed"><div class="mat-empty__icon"><icon name="box" /></div><p>No containers found.</p></div>
        }
        else if (isGallery)
        {
            <div class="mat-grid md-tiles" id="container-grid">
                @foreach (var r in Model.Rows)
                {
                    var env = r.Env;
                    var c = r.Container;
                    <div class="mat-card md-tile" data-item data-state="@State(c)" data-search="@SearchKey(r)">
                        <div class="mat-card__head">
                            <div class="md-tile__title">
                                <a class="mat-card__title" href="/Containers/ContainerDetail?envId=@env.Id&id=@Uri.EscapeDataString(c.Id)">@c.Name</a>
                                <span class="mat-card__sub mat-mono" title="@c.Image">@c.Image</span>
                            </div>
                            <container-status state="@c.State" status="@c.Status" />
                        </div>
                        <div class="mat-card__body">
                            <usage mem="@c.MemPercent" cpu="@c.CpuPercent" mem-text="@c.MemUsage" large="true" />
                        </div>
                        <div class="mat-card__foot md-tile__foot">
                            <span class="mat-tag"><icon name="server" /> @env.Name</span>
                            @if (!string.IsNullOrEmpty(c.Project))
                            {
                                <span class="mat-tag"><icon name="layers" /> @c.Project</span>
                            }
                            <div class="mat-table__actions">@{ await Actions(r); }</div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="mat-table-wrap">
                <table class="mat-table" id="container-table">
                    <thead>
                        <tr>
                            <th>Environment</th><th>Container</th><th>Status</th><th>Ports</th><th>Resources</th><th class="mat-table__cell-actions"><span class="mat-sr-only">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.Rows)
                        {
                            var env = r.Env;
                            var c = r.Container;
                            <tr data-item data-state="@State(c)" data-search="@SearchKey(r)">
                                <td data-label="Environment" class="mat-nowrap">@env.Name</td>
                                <td data-label="Container">
                                    <div class="mat-table__name">
                                        <span>
                                            <a href="/Containers/ContainerDetail?envId=@env.Id&id=@Uri.EscapeDataString(c.Id)">@c.Name</a>
                                            @if (!string.IsNullOrEmpty(c.Project))
                                            {
                                                <small class="mat-mono">@c.Project@(string.IsNullOrEmpty(c.Service) ? "" : " / " + c.Service)</small>
                                            }
                                        </span>
                                    </div>
                                </td>
                                <td data-label="Status"><container-status state="@c.State" status="@c.Status" /></td>
                                <td data-label="Ports"><container-ports ports="@c.Ports" host="@MatDock.Web.Support.OpenUrls.PortLinkHost(env)" /></td>
                                <td data-label="Resources"><usage mem="@c.MemPercent" cpu="@c.CpuPercent" mem-text="@c.MemUsage" /></td>
                                <td class="mat-table__cell-actions">
                                    <div class="mat-table__actions">@{ await Actions(r); }</div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        </div>
    </mat-table-body>

    <mat-table-actions>
        @if (isAdmin)
        {
            <a href="/Containers/Create" class="mat-btn mat-btn--primary"><icon name="plus" /><span>New container</span></a>
        }
        <a href="@ViewUrl(Model.View ?? "list")" class="mat-btn mat-btn--secondary"><icon name="refresh" /><span>Refresh</span></a>
    </mat-table-actions>
</mat-table>
