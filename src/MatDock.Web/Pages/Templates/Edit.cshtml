@page
@model MatDock.Web.Pages.Templates.EditModel
@{
    ViewData["Title"] = Model.IsEdit ? "Vorlage bearbeiten" : "Neue Vorlage";
}

<div class="page-head">
    <div class="page-head__title">
        <h1>@ViewData["Title"]</h1>
        <span class="page-head__subtitle">Compose-Blueprint, den man als Stack installieren kann</span>
    </div>
</div>

<div class="card" style="max-width:900px;">
    <div class="card__body">
        <form method="post" class="mat-form">
            <input type="hidden" asp-for="Input.Id" />
            <div asp-validation-summary="ModelOnly"></div>

            <div class="form-grid">
                <mat-field label="Name" asp-for="Input.Name" hint="Anzeigename der App, z. B. „Nginx Web Server“.">
                    <input asp-for="Input.Name" class="mat-input" placeholder="z. B. Nginx Web Server" />
                </mat-field>

                <mat-field label="Kategorie" asp-for="Input.Category" hint="Optional, z. B. „Web“, „Datenbank“.">
                    <input asp-for="Input.Category" class="mat-input" placeholder="Optional" />
                </mat-field>

                <mat-field label="Beschreibung" asp-for="Input.Description" class="span-2">
                    <input asp-for="Input.Description" class="mat-input" placeholder="Optional" />
                </mat-field>
            </div>

            <mat-field label="docker-compose.yml" asp-for="Input.ComposeYaml" hint="Blueprint; beim Installieren wird daraus ein Stack vorbefüllt (Name &amp; Environment wählt man dann).">
                <textarea asp-for="Input.ComposeYaml" class="mat-textarea" rows="18" spellcheck="false" style="font-family:var(--mono);font-size:.85rem;" placeholder="services:&#10;  app:&#10;    image: nginx:alpine"></textarea>
            </mat-field>

            <mat-form-buttons>
                <button type="submit" asp-page-handler="Save" class="mat-btn mat-btn--primary"><icon name="save" /><span>Speichern</span></button>
                <a href="/Templates" class="mat-btn mat-btn--ghost"><icon name="back" /><span>Zurück</span></a>
            </mat-form-buttons>
        </form>
    </div>
</div>
