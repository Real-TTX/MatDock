@page
@model MatDock.Web.Pages.Registry.IndexModel
@{
    ViewData["Title"] = "Registry";
    ViewData["Heading"] = "Registry browser";
}

@if (Model.Registries.Count == 0)
{
    <div class="mat-empty mat-empty--framed">
        <div class="mat-empty__icon"><icon name="registry" /></div>
        <p>No registry configured. Add one under <a href="/Settings/Registries">System → Registries</a>.</p>
    </div>
    return;
}

@if (Model.Registries.Count > 1)
{
    <div class="mat-field mat-w-fit">
        <label class="mat-label" for="conn-picker">Registry</label>
        <select id="conn-picker" class="mat-select" data-nav-select="/Registry?ConnId={v}">
            @foreach (var r in Model.Registries)
            {
                <option value="@r.Id" selected="@(Model.Selected?.Id == r.Id)">@r.Name (@r.Host)</option>
            }
        </select>
    </div>
}

@if (Model.Selected is not null)
{
    <section class="mat-card">
        <div class="mat-card__head"><icon name="registry" /><h2 class="mat-card__title">Repositories on @Model.Selected.Host</h2></div>
        <div class="mat-card__body mat-stack">
            <form method="get" class="mat-form">
                <input type="hidden" name="ConnId" value="@Model.Selected.Id" />
                <mat-field label="Open a repository by name" for-id="repo-name" hint="e.g. library/nginx or myorg/app — needed for registries without a catalog (Docker Hub)">
                    <div class="mat-input-group">
                        <input id="repo-name" name="Repo" value="@Model.Repo" class="mat-input mat-mono" placeholder="library/nginx" />
                        <button type="submit" class="mat-btn mat-btn--secondary"><icon name="search" /><span>Tags</span></button>
                    </div>
                </mat-field>
            </form>

            @if (Model.Catalog?.Error is not null)
            {
                <div class="mat-alert mat-alert--warning"><icon name="alert" /><div class="mat-alert__body">@Model.Catalog.Error</div></div>
            }
            else if (Model.Catalog is not null)
            {
                <div class="mat-row">
                    <div class="mat-input-icon mat-toolbar__search">
                        <icon name="search" />
                        <input type="search" class="mat-input" placeholder="Filter repositories…" aria-label="Filter repositories" data-filter-table="#repo-list" />
                    </div>
                    <span class="mat-hint">@Model.Catalog.Repositories.Count repositories</span>
                </div>
                @if (Model.Catalog.Repositories.Count == 0)
                {
                    <div class="mat-empty"><div class="mat-empty__icon"><icon name="box" /></div><p>No repositories reported by this registry.</p></div>
                }
                else
                {
                    <div id="repo-list" class="md-repo-list">
                        @foreach (var repo in Model.Catalog.Repositories)
                        {
                            var current = string.Equals(Model.Repo, repo, StringComparison.Ordinal);
                            <a class="md-repo-list__item @(current ? "is-active" : "")" aria-current="@(current ? "true" : null)"
                               data-filter-row href="/Registry?ConnId=@Model.Selected.Id&Repo=@Uri.EscapeDataString(repo)">
                                <icon name="box" /><span class="mat-mono">@repo</span>
                            </a>
                        }
                    </div>
                }
            }
        </div>
    </section>

    @if (Model.Tags is not null)
    {
        <section class="mat-card">
            <div class="mat-card__head"><icon name="layers" /><h2 class="mat-card__title">Tags — <span class="mat-mono">@Model.Tags.Repository</span></h2></div>
            @if (Model.Tags.Error is not null)
            {
                <div class="mat-card__body">
                    <div class="mat-alert mat-alert--warning"><icon name="alert" /><div class="mat-alert__body">@Model.Tags.Error</div></div>
                </div>
            }
            else if (Model.Tags.Tags.Count == 0)
            {
                <div class="mat-empty"><div class="mat-empty__icon"><icon name="layers" /></div><p>No tags found for this repository.</p></div>
            }
            else
            {
                <div class="mat-table-wrap">
                    <table class="mat-table">
                        <thead><tr><th>Tag</th><th>Pull reference</th></tr></thead>
                        <tbody>
                            @foreach (var tag in Model.Tags.Tags)
                            {
                                <tr>
                                    <td data-label="Tag"><strong>@tag</strong></td>
                                    <td class="mat-mono mat-text-wrap" data-label="Pull reference">@Model.Selected.Host/@Model.Tags.Repository:@tag</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    }
}

@section Actions {
    <a href="/Settings/Registries" class="mat-btn mat-btn--secondary"><icon name="settings" /><span>Registries</span></a>
}
