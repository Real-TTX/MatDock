@page
@model MatDock.Web.Pages.Networks.MapModel
@{
    ViewData["Title"] = "Network map";
}

<div class="page-head">
    <div class="page-head__title">
        <h1>Network map</h1>
    </div>
    <div class="mat-buttons">
        <a href="/Networks" class="mat-btn mat-btn--ghost"><icon name="back" /><span>Back</span></a>
    </div>
</div>

@if (Model.Environments.Count > 1)
{
    <div class="u-mb">
        <select class="mat-select fs-volswitch" aria-label="Environment" data-nav-select="/Networks/Map?envId={v}">
            @foreach (var env in Model.Environments)
            {
                <option value="@env.Id" selected="@(env.Id == Model.Environment?.Id)">@env.Name</option>
            }
        </select>
    </div>
}

@if (Model.Environment is null)
{
    <div class="card"><div class="empty-state"><div><icon name="server" /></div><p>No active environment.</p></div></div>
}
else if (Model.Error is not null)
{
    <div class="alert alert--error"><icon name="x-circle" /><span>@Model.Error</span></div>
}
else if (Model.Map is { } map)
{
    if (map.Containers.Count == 0)
    {
        <div class="card"><div class="empty-state"><div><icon name="network" /></div><p>No container is attached to a network.</p></div></div>
    }
    else
    {
        <div class="card netmap">
            <svg class="netmap__svg" viewBox="0 0 @map.Width @map.Height" role="img" aria-label="Networks and their containers on @Model.Environment.Name">
                @foreach (var e in map.Edges)
                {
                    <path class="netmap__edge" d="@e.Path" data-net="@e.Network" data-con="@e.ContainerId" />
                }
                @foreach (var n in map.Networks)
                {
                    <a href="/Networks/Detail?envId=@Model.Environment.Id&network=@Uri.EscapeDataString(n.Key)">
                        <g class="netmap__node netmap__node--net" data-net="@n.Key">
                            <rect x="@n.X" y="@n.Y" width="@n.Width" height="@n.Height" rx="8" />
                            <text x="@(n.X + 12)" y="@(n.Y + 17)" class="netmap__label">@n.Label</text>
                            <text x="@(n.X + 12)" y="@(n.Y + 32)" class="netmap__sub">@n.Sub</text>
                        </g>
                    </a>
                }
                @foreach (var c in map.Containers)
                {
                    <a href="/Containers/ContainerDetail?envId=@Model.Environment.Id&id=@Uri.EscapeDataString(c.Key)">
                        <g class="netmap__node netmap__node--con @(c.State == "running" ? "" : "is-stopped") @(c.Links > 1 ? "is-bridge" : "")" data-con="@c.Key">
                            <rect x="@c.X" y="@c.Y" width="@c.Width" height="@c.Height" rx="8" />
                            <text x="@(c.X + 12)" y="@(c.Y + 17)" class="netmap__label">@c.Label</text>
                            <text x="@(c.X + 12)" y="@(c.Y + 32)" class="netmap__sub">@c.Sub</text>
                        </g>
                    </a>
                }
            </svg>
        </div>
        <p class="text-muted netmap__legend">A thick border: the container is on several networks.</p>
    }
}
