@page
@model MatDock.Web.Pages.Networks.IndexModel
@{
    ViewData["Title"] = "Networks";
    var isAdmin = User.IsInRole("Admin");
    const string BulkForm = "bulk-networks";
    var bulkBar = new BulkBar(BulkForm, [new BulkButton("Remove", "trash", "Delete", Danger: true, Confirm: "Delete the selected networks?")]);
}

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    if (Model.IsError)
    {
        <div class="mat-alert mat-alert--danger" role="alert"><icon name="x-circle" /><div class="mat-alert__body">@Model.StatusMessage</div></div>
    }
    else
    {
        <div data-toast="@Model.StatusMessage" data-tone="success" hidden></div>
    }
}

@if (Model.Errors.Count > 0)
{
    <div class="mat-alert mat-alert--warning">
        <icon name="alert" />
        <div class="mat-alert__body">Unreachable: @string.Join(" · ", Model.Errors.Select(e => $"{e.Environment} ({e.Message})"))</div>
    </div>
}

<mat-table data-selectable>
    <mat-table-toolbar>
        <form method="get" class="js-autosubmit md-contents">
            <div class="mat-input-icon mat-toolbar__search">
                <icon name="search" />
                <input type="search" name="Q" value="@Model.Q" class="mat-input" placeholder="Search (network, driver, environment)…" aria-label="Search networks" />
            </div>
            <span class="mat-toolbar__spacer"></span>
            <span class="mat-toolbar__info">@Model.Rows.Count networks</span>
        </form>
    </mat-table-toolbar>

    <mat-table-body>
        @if (Model.Rows.Count == 0)
        {
            <div class="mat-empty">
                <div class="mat-empty__icon"><icon name="network" /></div>
                <p>No networks found.@(Model.Environments.Count == 0 ? " Create an environment first." : "")</p>
            </div>
        }
        else
        {
            if (isAdmin)
            {
                <partial name="_BulkBar" model="bulkBar" />
            }
            <div class="mat-table-wrap">
                <table class="mat-table">
                    <thead>
                        <tr>
                            @if (isAdmin)
                            {
                                <th class="mat-table__select"><input type="checkbox" data-select-all aria-label="Select all networks" /></th>
                            }
                            <th>Environment</th>
                            <th>Network</th>
                            <th>Driver</th>
                            <th>Scope</th>
                            <th><span class="mat-sr-only">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Rows)
                        {
                            var detail = $"/Networks/Detail?envId={row.Environment.Id}&network={Uri.EscapeDataString(row.Network.Name)}";
                            var locked = row.Network.IsPredefined || !row.Unused;
                            <tr>
                                @if (isAdmin)
                                {
                                    <td class="mat-table__select"><input type="checkbox" data-select-row name="ids" value="@Bulk.Value(row.Environment.Id, row.Network.Name)" form="@BulkForm" disabled="@locked" title="@(row.Network.IsPredefined ? "Predefined" : locked ? "In use" : null)" aria-label="Select @row.Network.Name" /></td>
                                }
                                <td class="mat-nowrap" data-label="Environment">@row.Environment.Name</td>
                                <td class="mat-text-wrap" data-label="Network">
                                    <div class="mat-table__name">
                                        <span>
                                            <a href="@detail">@row.Network.Name</a>
                                            @if (row.Network.Internal)
                                            {
                                                <small>internal</small>
                                            }
                                        </span>
                                        @if (row.Network.IsPredefined)
                                        {
                                            <span class="mat-tag" title="Predefined Docker network">system</span>
                                        }
                                        else if (row.Unused)
                                        {
                                            <span class="mat-pill mat-pill--warn" title="Not used by any container">unused</span>
                                        }
                                    </div>
                                </td>
                                <td data-label="Driver">@row.Network.Driver</td>
                                <td class="mat-muted" data-label="Scope">@(row.Network.Scope ?? "–")</td>
                                <td class="mat-table__cell-actions">
                                    <div class="mat-table__actions">
                                        <a class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" href="@detail" title="Open" aria-label="Open @row.Network.Name"><icon name="external" /></a>
                                        @if (isAdmin && !row.Network.IsPredefined)
                                        {
                                            <form method="post" asp-page-handler="Remove"
                                                  data-confirm="Delete network &quot;@row.Network.Name&quot;?" data-confirm-danger>
                                                <input type="hidden" name="envId" value="@row.Environment.Id" />
                                                <input type="hidden" name="name" value="@row.Network.Name" />
                                                <button type="submit" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" title="Delete" aria-label="Delete @row.Network.Name"><icon name="trash" /></button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </mat-table-body>

    <mat-table-actions>
        @if (isAdmin && Model.Environments.Count > 0)
        {
            <a href="/Networks/Create?env=@Model.EnvId" class="mat-btn mat-btn--primary"><icon name="plus" /><span>New network</span></a>
        }
        <a href="/Networks/Map?envId=@Model.EnvId" class="mat-btn mat-btn--secondary"><icon name="network" /><span>Map</span></a>
        <a href="/Networks?EnvId=@Model.EnvId&Q=@Uri.EscapeDataString(Model.Q ?? string.Empty)&Refresh=true" class="mat-btn mat-btn--secondary"><icon name="refresh" /><span>Refresh</span></a>
        @if (isAdmin && Model.Environments.Count > 0)
        {
            <a href="/Networks/Prune?env=@Model.EnvId" class="mat-btn mat-btn--secondary mat-btn--end"><icon name="broom" /><span>Prune</span></a>
        }
    </mat-table-actions>
</mat-table>
@if (isAdmin)
{
    <form method="post" asp-page-handler="Bulk" id="@BulkForm"><input type="hidden" name="EnvId" value="@Model.EnvId" /><input type="hidden" name="Q" value="@Model.Q" /></form>
}
