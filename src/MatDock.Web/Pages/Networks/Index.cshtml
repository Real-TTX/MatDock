@page
@model MatDock.Web.Pages.Networks.IndexModel
@{
    ViewData["Title"] = "Networks";
    var isAdmin = User.IsInRole("Admin");
}

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="mat-alert @(Model.IsError ? "mat-alert--danger" : "mat-alert--success")">
        <icon name="@(Model.IsError ? "x-circle" : "check-circle")" /><div class="mat-alert__body">@Model.StatusMessage</div>
    </div>
}

@if (Model.Errors.Count > 0)
{
    <div class="mat-alert mat-alert--warning">
        <icon name="alert" />
        <span>Unreachable: @string.Join(" · ", Model.Errors.Select(e => $"{e.Environment} ({e.Message})"))</span>
    </div>
}

<mat-table>
    <mat-table-toolbar>
        <form method="get" class="u-contents js-autosubmit">
            <div class="mat-input-icon mat-toolbar__search">
                <icon name="search" />
                <input type="search" name="Q" value="@Model.Q" class="mat-input" placeholder="Search (network, driver, environment)…" />
            </div>
            <span class="mat-toolbar__spacer"></span>
            <span class="mat-muted"><strong>@Model.Rows.Count</strong> Networks</span>
        </form>
    </mat-table-toolbar>

    <mat-table-body>
        @if (Model.Rows.Count == 0)
        {
            <div class="mat-empty">
                <div><icon name="network" /></div>
                <p>No networks found.@(Model.Environments.Count == 0 ? " Create an environment first." : "")</p>
            </div>
        }
        else
        {
            <table class="mat-table">
                <thead>
                    <tr>
                        <th>Environment</th>
                        <th>Network</th>
                        <th>Driver</th>
                        <th>Scope</th>
                        <th class="mat-table__cell-actions">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        <tr>
                            <td class="mat-nowrap">@row.Environment.Name</td>
                            <td class="mat-text-wrap">
                                <a href="/Networks/Detail?envId=@row.Environment.Id&network=@Uri.EscapeDataString(row.Network.Name)"><strong>@row.Network.Name</strong></a>
                                @if (row.Network.IsPredefined)
                                {
                                    <span class="tag-system" title="Predefined Docker network">system</span>
                                }
                                else if (row.Unused)
                                {
                                    <span class="tag-unused" title="Not used by any container">unused</span>
                                }
                                @if (row.Network.Internal)
                                {
                                    <div class="cell-sub">internal</div>
                                }
                            </td>
                            <td>@row.Network.Driver</td>
                            <td class="cell-sub">@(row.Network.Scope ?? "–")</td>
                            <td class="mat-table__cell-actions">
                                <div class="mat-table__actions">
                                    <a class="mat-btn mat-btn--secondary mat-btn--sm" href="/Networks/Detail?envId=@row.Environment.Id&network=@Uri.EscapeDataString(row.Network.Name)" title="Open"><icon name="external" /></a>
                                    @if (isAdmin && !row.Network.IsPredefined)
                                    {
                                        <form method="post" asp-page-handler="Remove" class="mat-d-inline"
                                              data-confirm="Delete network &quot;@row.Network.Name&quot;?">
                                            <input type="hidden" name="envId" value="@row.Environment.Id" />
                                            <input type="hidden" name="name" value="@row.Network.Name" />
                                            <button type="submit" class="mat-btn mat-btn--secondary mat-btn--sm" title="Delete"><icon name="trash" /></button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </mat-table-body>

    <mat-table-actions>
        @if (isAdmin && Model.Environments.Count > 0)
        {
            <a href="/Networks/Prune?env=@Model.EnvId" class="mat-btn mat-btn--secondary"><icon name="broom" /><span>Prune</span></a>
        }
        <a href="/Networks/Map?envId=@Model.EnvId" class="mat-btn mat-btn--secondary"><icon name="network" /><span>Map</span></a>
        <a href="/Networks?EnvId=@Model.EnvId&Q=@Uri.EscapeDataString(Model.Q ?? string.Empty)&Refresh=true" class="mat-btn mat-btn--secondary"><icon name="refresh" /><span>Refresh</span></a>
    </mat-table-actions>
</mat-table>
