@page
@model MatDock.Web.Pages.Networks.DetailModel
@{
    var isAdmin = User.IsInRole("Admin");
    ViewData["Title"] = Model.NetworkName;
    ViewData["Crumbs"] = new List<(string Text, string? Url)> { ("Networks", $"/Networks?EnvId={Model.EnvId}") };
}

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    if (Model.IsError)
    {
        <div class="mat-alert mat-alert--danger" role="alert"><icon name="x-circle" /><div class="mat-alert__body">@Model.StatusMessage</div></div>
    }
    else
    {
        <div data-toast="@Model.StatusMessage" data-tone="success" hidden></div>
    }
}

@if (Model.Error is not null)
{
    <div class="mat-alert mat-alert--danger" role="alert"><icon name="x-circle" /><div class="mat-alert__body">@Model.Error</div></div>
}

@if (Model.Detail is null)
{
    <div class="mat-alert mat-alert--warning"><icon name="alert" /><div class="mat-alert__body">Network "@Model.NetworkName" was not found on this host.</div></div>
}
else
{
    var d = Model.Detail;

    <section class="mat-card">
        <div class="mat-card__head"><icon name="network" /><h2 class="mat-card__title">Details</h2></div>
        <div class="mat-card__body">
            <dl class="mat-kv">
                <dt>Name</dt><dd class="mat-mono">@d.Name</dd>
                <dt>ID</dt><dd class="mat-mono">@d.Id</dd>
                <dt>Driver</dt><dd>@d.Driver</dd>
                <dt>Scope</dt><dd>@(d.Scope ?? "–")</dd>
                <dt>Internal</dt><dd>@(d.Internal ? "yes" : "no")</dd>
                <dt>Attachable</dt><dd>@(d.Attachable ? "yes" : "no")</dd>
                <dt>IPv6</dt><dd>@(d.EnableIPv6 ? "yes" : "no")</dd>
                @if (d.Subnets.Count > 0)
                {
                    <dt>Subnets</dt><dd class="mat-mono">@string.Join(", ", d.Subnets)</dd>
                }
                <dt>Created</dt><dd>@(d.CreatedAt ?? "–")</dd>
            </dl>
        </div>
    </section>

    if (d.Options.Count > 0)
    {
        <section class="mat-card">
            <div class="mat-card__head"><icon name="settings" /><h2 class="mat-card__title">Options</h2></div>
            <div class="mat-card__body">
                <dl class="mat-kv">
                    @foreach (var kv in d.Options)
                    {
                        <dt class="mat-mono">@kv.Key</dt><dd class="mat-mono">@kv.Value</dd>
                    }
                </dl>
            </div>
        </section>
    }

    if (d.Labels.Count > 0)
    {
        <section class="mat-card">
            <div class="mat-card__head"><icon name="tag" /><h2 class="mat-card__title">Labels</h2></div>
            <div class="mat-card__body">
                <dl class="mat-kv">
                    @foreach (var kv in d.Labels)
                    {
                        <dt class="mat-mono">@kv.Key</dt><dd class="mat-mono">@kv.Value</dd>
                    }
                </dl>
            </div>
        </section>
    }

    <section class="mat-card">
        <div class="mat-card__head"><icon name="box" /><h2 class="mat-card__title">Connected containers</h2><span class="mat-badge">@d.Containers.Count</span></div>
        @if (d.Containers.Count == 0)
        {
            <div class="mat-empty"><div class="mat-empty__icon"><icon name="box" /></div><p>No container is connected to this network.</p></div>
        }
        else
        {
            <ul class="md-plain-list">
                @foreach (var c in d.Containers)
                {
                    <li class="md-inline-form">
                        <a href="/Containers/ContainerDetail?envId=@Model.EnvId&id=@Uri.EscapeDataString(c.Id)">@c.Name</a>
                        @if (isAdmin && !Model.IsPredefined)
                        {
                            <form method="post" asp-page-handler="Disconnect" data-confirm="Disconnect '@c.Name' from '@d.Name'?">
                                <input type="hidden" name="envId" value="@Model.EnvId" />
                                <input type="hidden" name="network" value="@d.Name" />
                                <input type="hidden" name="container" value="@c.Name" />
                                <button type="submit" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" title="Disconnect" aria-label="Disconnect @c.Name"><icon name="x-circle" /></button>
                            </form>
                        }
                    </li>
                }
            </ul>
        }
        @if (isAdmin && !Model.IsPredefined)
        {
            <div class="mat-card__body">
                <form method="post" asp-page-handler="Connect" class="md-inline-form">
                    <input type="hidden" name="envId" value="@Model.EnvId" />
                    <input type="hidden" name="network" value="@d.Name" />
                    <div class="mat-input-icon">
                        <icon name="box" />
                        <input type="text" name="container" class="mat-input" placeholder="container name or id…" aria-label="Container to connect" required />
                    </div>
                    <button type="submit" class="mat-btn mat-btn--secondary"><icon name="plus" /><span>Connect</span></button>
                </form>
            </div>
        }
    </section>

    if (isAdmin && !Model.IsPredefined)
    {
        var netInUse = d.Containers.Count > 0;
        <form method="post" asp-page-handler="Remove" data-confirm="Delete network &quot;@d.Name&quot;?" data-confirm-danger>
            <input type="hidden" name="envId" value="@Model.EnvId" />
            <input type="hidden" name="network" value="@d.Name" />
            <div class="mat-actions">
                <button type="submit" class="mat-btn mat-btn--danger" disabled="@netInUse"
                        title="@(netInUse ? $"In use by {d.Containers.Count} container(s)" : "Delete network")">
                    <icon name="trash" /><span>Delete network</span>
                </button>
            </div>
        </form>
    }
}
