@page
@model MatDock.Web.Pages.Networks.DetailModel
@{
    var isAdmin = User.IsInRole("Admin");
    ViewData["Title"] = Model.NetworkName;
    ViewData["Crumbs"] = new List<(string Text, string? Url)> { ("Networks", $"/Networks?EnvId={Model.EnvId}") };
}

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="mat-alert @(Model.IsError ? "mat-alert--danger" : "mat-alert--success")">
        <icon name="@(Model.IsError ? "x-circle" : "check-circle")" /><div class="mat-alert__body">@Model.StatusMessage</div>
    </div>
}

@if (Model.Error is not null)
{
    <div class="mat-alert mat-alert--danger"><icon name="x-circle" /><div class="mat-alert__body">@Model.Error</div></div>
}

@if (Model.Detail is null)
{
    <div class="mat-alert mat-alert--warning"><icon name="alert" /><div class="mat-alert__body">Network "@Model.NetworkName" was not found on this host.</div></div>
}
else
{
    var d = Model.Detail;

    @if (isAdmin && !Model.IsPredefined)
    {
        var netInUse = d.Containers.Count > 0;
        <div class="mat-mb-4 mat-btn-row">
            <form method="post" asp-page-handler="Remove" data-confirm="Delete network &quot;@d.Name&quot;?">
                <input type="hidden" name="envId" value="@Model.EnvId" />
                <input type="hidden" name="network" value="@d.Name" />
                <button type="submit" class="mat-btn mat-btn--danger" disabled="@netInUse"
                        title="@(netInUse ? $"In use by {d.Containers.Count} container(s)" : "Delete network")">
                    <icon name="trash" /><span>Delete network</span>
                </button>
            </form>
        </div>
    }

    <div class="mat-mb-4 mat-card">
        <div class="mat-card__head"><icon name="network" /><span>Details</span></div>
        <div class="mat-table-wrap">
            <table class="mat-table">
                <tbody>
                    <tr><th style="width:180px;">Name</th><td class="mat-mono">@d.Name</td></tr>
                    <tr><th>ID</th><td class="mat-mono">@d.Id</td></tr>
                    <tr><th>Driver</th><td>@d.Driver</td></tr>
                    <tr><th>Scope</th><td>@(d.Scope ?? "–")</td></tr>
                    <tr><th>Internal</th><td>@(d.Internal ? "yes" : "no")</td></tr>
                    <tr><th>Attachable</th><td>@(d.Attachable ? "yes" : "no")</td></tr>
                    <tr><th>IPv6</th><td>@(d.EnableIPv6 ? "yes" : "no")</td></tr>
                    @if (d.Subnets.Count > 0)
                    {
                        <tr><th>Subnets</th><td class="mat-mono">@string.Join(", ", d.Subnets)</td></tr>
                    }
                    <tr><th>Created</th><td>@(d.CreatedAt ?? "–")</td></tr>
                </tbody>
            </table>
        </div>
    </div>

    @if (d.Options.Count > 0)
    {
        <div class="mat-mb-4 mat-card">
            <div class="mat-card__head"><icon name="settings" /><span>Options</span></div>
            <div class="mat-table-wrap">
                <table class="mat-table">
                    <thead><tr><th style="width:280px;">Key</th><th>Value</th></tr></thead>
                    <tbody>
                        @foreach (var kv in d.Options)
                        {
                            <tr><td class="mat-mono">@kv.Key</td><td class="mat-mono">@kv.Value</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @if (d.Labels.Count > 0)
    {
        <div class="mat-mb-4 mat-card">
            <div class="mat-card__head"><icon name="filter" /><span>Labels</span></div>
            <div class="mat-table-wrap">
                <table class="mat-table">
                    <thead><tr><th style="width:280px;">Key</th><th>Value</th></tr></thead>
                    <tbody>
                        @foreach (var kv in d.Labels)
                        {
                            <tr><td class="mat-mono">@kv.Key</td><td class="mat-mono">@kv.Value</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <div class="mat-card">
        <div class="mat-card__head"><icon name="box" /><span>Connected containers</span><span class="mat-tag">@d.Containers.Count</span></div>
        @if (d.Containers.Count == 0)
        {
            <div class="mat-empty"><div class="mat-empty__icon"><icon name="box" /></div><p>No container is connected to this network.</p></div>
        }
        else
        {
            <div class="mat-table-wrap">
                <table class="mat-table">
                    <tbody>
                        @foreach (var c in d.Containers)
                        {
                            <tr><td><a href="/Containers/ContainerDetail?envId=@Model.EnvId&id=@Uri.EscapeDataString(c.Id)"><strong>@c.Name</strong></a></td></tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}
