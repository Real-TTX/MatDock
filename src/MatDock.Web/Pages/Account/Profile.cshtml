@page
@model MatDock.Web.Pages.Account.ProfileModel
@inject MatDock.Core.Notifications.WebPush.WebPushService Push
@{
    ViewData["Title"] = "Profile";
    ViewData["Width"] = "narrow";
    // Land on the password tab when a change is required or the last submit failed.
    var pwActive = Model.MustChange || !ViewData.ModelState.IsValid;
}

@if (Model.MustChange)
{
    <div class="mat-alert mat-alert--warning" role="alert">
        <icon name="alert" />
        <div class="mat-alert__body">Please set your own password before continuing.</div>
    </div>
}
<partial name="_StatusMessage" model="(Model.StatusMessage, Model.IsError)" />

<div class="mat-stack" data-tabs>
    <div class="mat-tabs" role="tablist" aria-label="Profile">
        <button type="button" class="mat-tab" role="tab" id="tab-general" aria-controls="panel-general" aria-selected="@(pwActive ? "false" : "true")" tabindex="@(pwActive ? "-1" : "0")"><icon name="user" /><span>General</span></button>
        <button type="button" class="mat-tab" role="tab" id="tab-password" aria-controls="panel-password" aria-selected="@(pwActive ? "true" : "false")" tabindex="@(pwActive ? "0" : "-1")"><icon name="key" /><span>Password</span></button>
    </div>

    <div class="mat-card" role="tabpanel" id="panel-general" aria-labelledby="tab-general" hidden="@(pwActive ? "hidden" : null)">
        <div class="mat-card__head"><icon name="user" /><span class="mat-card__title">Account</span></div>
        <div class="mat-card__body">
            <dl class="mat-kv">
                <dt>Username</dt><dd>@Model.Username</dd>
                <dt>Display name</dt><dd>@Model.DisplayName</dd>
                <dt>Role</dt><dd>@Model.Role</dd>
            </dl>
        </div>
    </div>

    <div class="mat-card" role="tabpanel" id="panel-password" aria-labelledby="tab-password" hidden="@(pwActive ? null : "hidden")">
        <div class="mat-card__head"><icon name="key" /><span class="mat-card__title">Change password</span></div>
        <div class="mat-card__body">
            <form method="post" class="mat-form">
                <partial name="_ValidationSummary" />

                <mat-field label="Current password" asp-for="Input.CurrentPassword" required="true">
                    <input asp-for="Input.CurrentPassword" type="password" class="mat-input" autocomplete="current-password" />
                </mat-field>
                <mat-field label="New password" asp-for="Input.NewPassword" required="true">
                    <input asp-for="Input.NewPassword" type="password" class="mat-input" autocomplete="new-password" />
                </mat-field>
                <mat-field label="Confirm new password" asp-for="Input.ConfirmPassword" required="true">
                    <input asp-for="Input.ConfirmPassword" type="password" class="mat-input" autocomplete="new-password" />
                </mat-field>

                <mat-form-buttons>
                    <button type="submit" class="mat-btn mat-btn--primary"><icon name="save" /><span>Save</span></button>
                </mat-form-buttons>
            </form>
        </div>
    </div>
</div>

@{
    var devices = await Push.OfUserAsync(MatDock.Web.Infrastructure.ClaimsPrincipalExtensions.GetUserId(User) ?? 0);
}
@* Notifications on this device (pwa.js): every notification of MatDock reaches the devices switched on here, also the installed app on a phone. *@
<section class="mat-card" data-push-device data-push-endpoints="@System.Text.Json.JsonSerializer.Serialize(devices.Select(d => d.Endpoint))">
    <div class="mat-card__head"><icon name="bell" /><span class="mat-card__title">Notifications on this device</span></div>
    <div class="mat-card__body mat-stack">
        <p data-push-state class="mat-muted">…</p>
        <div class="mat-row">
            <button type="button" class="mat-btn md-btn--go" data-push-enable hidden><icon name="bell" /><span>Turn on</span></button>
            <button type="button" class="mat-btn mat-btn--secondary" data-push-test hidden><icon name="play" /><span>Send a test</span></button>
            <button type="button" class="mat-btn mat-btn--danger" data-push-disable hidden><icon name="x" /><span>Turn off</span></button>
            <button type="button" class="mat-btn mat-btn--secondary" data-pwa-install hidden><icon name="download" /><span>Install the app</span></button>
        </div>
        @if (devices.Count > 0)
        {
            <ul class="md-devices">
                @foreach (var d in devices)
                {
                    <li>
                        <icon name="smartphone" />
                        <span>@d.Name</span>
                        <small class="mat-muted">@(d.LastUsedAt is { } used ? "last reached " + used.ToLocalTime().ToString("dd.MM.yyyy HH:mm") : "added " + d.CreateDate.ToLocalTime().ToString("dd.MM.yyyy"))</small>
                        <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" data-push-remove="@d.Id" aria-label="Remove @d.Name" data-tip="Remove"><icon name="trash" /></button>
                    </li>
                }
            </ul>
        }
    </div>
</section>
