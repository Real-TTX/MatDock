@page
@model MatDock.Web.Pages.Images.DetailModel
@{
    ViewData["Title"] = Model.Reference;
    string Fb(long b) => MatDock.Core.Volumes.VolumeMigrationResult.FormatBytes(b);
    ViewData["Crumbs"] = new List<(string Text, string? Url)> { ("Images", $"/Images?EnvId={Model.EnvId}") };
}

@if (Model.Error is not null)
{
    <div class="mat-alert mat-alert--danger"><icon name="x-circle" /><div class="mat-alert__body">@Model.Error</div></div>
}
else if (Model.Detail is { } d)
{
    <div class="mat-card">
        <div class="mat-card__head"><icon name="image" /><span>Details</span></div>
        <div class="mat-table-wrap">
            <table class="mat-table data--keyvalue">
                <tbody>
                    <tr><th>Environment</th><td>@Model.Environment!.Name</td></tr>
                    <tr><th>ID</th><td class="mat-mono">@d.Id</td></tr>
                    @if (d.Tags.Count > 0) { <tr><th>Tags</th><td class="mat-mono">@string.Join(", ", d.Tags)</td></tr> }
                    @if (d.Digests.Count > 0) { <tr><th>Digest</th><td class="mat-mono mat-text-wrap">@string.Join(", ", d.Digests)</td></tr> }
                    <tr><th>Created</th><td>@(d.CreatedUtc?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "–")</td></tr>
                    <tr><th>Size</th><td>@Fb(d.SizeBytes)</td></tr>
                    <tr><th>Platform</th><td>@d.Platform</td></tr>
                    @if (d.Entrypoint is not null) { <tr><th>Entrypoint</th><td class="mat-mono mat-text-wrap">@d.Entrypoint</td></tr> }
                    @if (d.Command is not null) { <tr><th>Command</th><td class="mat-mono mat-text-wrap">@d.Command</td></tr> }
                    @if (d.WorkingDir is not null) { <tr><th>Working dir</th><td class="mat-mono">@d.WorkingDir</td></tr> }
                    @if (d.User is not null) { <tr><th>User</th><td class="mat-mono">@d.User</td></tr> }
                    @if (d.ExposedPorts.Count > 0) { <tr><th>Ports</th><td class="mat-mono">@string.Join(", ", d.ExposedPorts)</td></tr> }
                </tbody>
            </table>
        </div>
    </div>

    @if (d.Labels.Count > 0)
    {
        <div class="mat-card">
            <div class="mat-card__head"><icon name="template" /><span>Labels</span></div>
            <div class="mat-table-wrap">
                <table class="mat-table data--keyvalue">
                    <tbody>
                        @foreach (var (key, value) in d.Labels)
                        {
                            <tr><th class="mat-mono">@key</th><td class="mat-mono mat-text-wrap">@value</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <div id="live-scan" class="mat-card" data-live="@(Model.Running is { IsFinished: false } ? "10" : null)">
        <div class="mat-card__head"><icon name="lock" /><span>Vulnerabilities</span></div>
        <div class="mat-card__body">
            @if (Model.Running is { } op)
            {
                var (text, _) = op.Read(0);
                if (!op.IsFinished)
                {
                    <p class="mat-hint">Scanning… The first scan on a host downloads the vulnerability database and takes a few minutes; this part refreshes itself.</p>
                }
                else if (op.Error is not null)
                {
                    <div class="mat-alert mat-alert--danger"><icon name="x-circle" /><div class="mat-alert__body">@op.Error</div></div>
                }
                <pre class="output-pre">@text</pre>
            }
            @if (Model.Scan is { } scan)
            {
                var findings = MatDock.Core.Images.ImageScanService.Findings(scan);
                <p>
                    <span class="mat-pill @(scan.Critical > 0 ? "mat-pill--error" : scan.High > 0 ? "mat-pill--warn" : "mat-pill--ok")">@scan.Critical critical · @scan.High high · @scan.Medium medium · @scan.Low low</span>
                    <span class="cell-sub">scanned @scan.ScannedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
                </p>
                @if (scan.Error is not null)
                {
                    <div class="mat-alert mat-alert--warning"><icon name="alert" /><div class="mat-alert__body">The last scan failed: @scan.Error</div></div>
                }
                @if (findings.Count > 0)
                {
                    <div class="mat-table-wrap">
                        <table class="mat-table">
                            <thead><tr><th>Severity</th><th>Vulnerability</th><th>Package</th><th>Installed</th><th>Fixed in</th></tr></thead>
                            <tbody>
                                @foreach (var f in findings)
                                {
                                    <tr>
                                        <td data-label="Severity"><span class="mat-pill @(f.Severity == "CRITICAL" ? "mat-pill--error" : f.Severity == "HIGH" ? "mat-pill--warn" : "mat-pill--plain")">@f.Severity.ToLowerInvariant()</span></td>
                                        <td class="mat-text-wrap" data-label="Vulnerability"><strong class="mat-mono">@f.Id</strong>@if (f.Title is not null) { <div class="cell-sub">@(f.Title.Length > 140 ? f.Title[..140] + "…" : f.Title)</div> }</td>
                                        <td class="mat-mono" data-label="Package">@f.Package</td>
                                        <td class="mat-mono cell-sub" data-label="Installed">@f.Installed</td>
                                        <td class="mat-mono" data-label="Fixed in">@(f.Fixed ?? "–")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (scan.Critical + scan.High + scan.Medium + scan.Low + scan.Unknown > findings.Count)
                    {
                        <p class="cell-sub">The @findings.Count most severe are listed.</p>
                    }
                }
            }
            else if (Model.Running is null)
            {
                <p class="mat-hint">Not scanned yet.</p>
            }
            @if (User.IsInRole("Admin") && Model.Running is not { IsFinished: false })
            {
                <form method="post" asp-page-handler="Scan">
                    <input type="hidden" name="envId" value="@Model.EnvId" />
                    <input type="hidden" name="reference" value="@Model.Reference" />
                    <mat-form-buttons>
                        <button type="submit" class="mat-btn mat-btn--secondary"><icon name="lock" /><span>Scan now</span></button>
                    </mat-form-buttons>
                </form>
            }
        </div>
    </div>

    <div class="mat-card">
        <div class="mat-card__head"><icon name="layers" /><span>Layers (@d.Layers.Count)</span></div>
        @if (d.Layers.Count == 0)
        {
            <div class="mat-empty"><div class="mat-empty__icon"><icon name="layers" /></div><p>No layer history.</p></div>
        }
        else
        {
            <div class="mat-table-wrap">
                <table class="mat-table">
                    <thead><tr><th>Instruction</th><th>Size</th><th>Created</th></tr></thead>
                    <tbody>
                        @foreach (var layer in d.Layers)
                        {
                            <tr>
                                <td class="mat-mono mat-text-wrap" data-label="Instruction">@layer.CreatedBy</td>
                                <td class="mat-nowrap" data-label="Size">@layer.Size</td>
                                <td class="cell-sub mat-nowrap" data-label="Created">@layer.CreatedSince</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}
