@page
@model MatDock.Web.Pages.Images.DetailModel
@{
    ViewData["Title"] = Model.Reference;
    string Fb(long b) => MatDock.Core.Volumes.VolumeMigrationResult.FormatBytes(b);
    ViewData["Crumbs"] = new List<(string Text, string? Url)> { ("Images", $"/Images?EnvId={Model.EnvId}") };
}

@if (Model.Error is not null)
{
    <div class="mat-alert mat-alert--danger" role="alert"><icon name="x-circle" /><div class="mat-alert__body">@Model.Error</div></div>
}
else if (Model.Detail is { } d)
{
    <section class="mat-card">
        <div class="mat-card__head"><icon name="image" /><h2 class="mat-card__title">Details</h2></div>
        <div class="mat-card__body">
            <dl class="mat-kv">
                <dt>Environment</dt><dd>@Model.Environment!.Name</dd>
                <dt>ID</dt><dd class="mat-mono">@d.Id</dd>
                @if (d.Tags.Count > 0) { <dt>Tags</dt><dd class="mat-mono">@string.Join(", ", d.Tags)</dd> }
                @if (d.Digests.Count > 0) { <dt>Digest</dt><dd class="mat-mono">@string.Join(", ", d.Digests)</dd> }
                <dt>Created</dt><dd>@(d.CreatedUtc?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "–")</dd>
                <dt>Size</dt><dd>@Fb(d.SizeBytes)</dd>
                <dt>Platform</dt><dd>@d.Platform</dd>
                @if (d.Entrypoint is not null) { <dt>Entrypoint</dt><dd class="mat-mono">@d.Entrypoint</dd> }
                @if (d.Command is not null) { <dt>Command</dt><dd class="mat-mono">@d.Command</dd> }
                @if (d.WorkingDir is not null) { <dt>Working dir</dt><dd class="mat-mono">@d.WorkingDir</dd> }
                @if (d.User is not null) { <dt>User</dt><dd class="mat-mono">@d.User</dd> }
                @if (d.ExposedPorts.Count > 0) { <dt>Ports</dt><dd class="mat-mono">@string.Join(", ", d.ExposedPorts)</dd> }
            </dl>
        </div>
    </section>

    @if (d.Labels.Count > 0)
    {
        <section class="mat-card">
            <div class="mat-card__head"><icon name="tag" /><h2 class="mat-card__title">Labels</h2></div>
            <div class="mat-card__body">
                <dl class="mat-kv">
                    @foreach (var (key, value) in d.Labels)
                    {
                        <dt class="mat-mono">@key</dt><dd class="mat-mono">@value</dd>
                    }
                </dl>
            </div>
        </section>
    }

    <section id="live-scan" class="mat-card" data-live="@(Model.Running is { IsFinished: false } ? "10" : null)">
        <div class="mat-card__head"><icon name="shield" /><h2 class="mat-card__title">Vulnerabilities</h2></div>
        <div class="mat-card__body mat-stack">
            @if (Model.Running is { } op)
            {
                var (text, _) = op.Read(0);
                if (!op.IsFinished)
                {
                    <p class="mat-hint">Scanning… The first scan on a host downloads the vulnerability database and takes a few minutes; this part refreshes itself.</p>
                }
                else if (op.Error is not null)
                {
                    <div class="mat-alert mat-alert--danger" role="alert"><icon name="x-circle" /><div class="mat-alert__body">@op.Error</div></div>
                }
                <pre class="mat-code md-output">@text</pre>
            }
            @if (Model.Scan is { } scan)
            {
                var findings = MatDock.Core.Images.ImageScanService.Findings(scan);
                <p class="mat-row">
                    <span class="mat-pill @(scan.Critical > 0 ? "mat-pill--error" : scan.High > 0 ? "mat-pill--warn" : "mat-pill--ok")">@scan.Critical critical · @scan.High high · @scan.Medium medium · @scan.Low low</span>
                    <small class="mat-muted">scanned @scan.ScannedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</small>
                </p>
                @if (scan.Error is not null)
                {
                    <div class="mat-alert mat-alert--warning"><icon name="alert" /><div class="mat-alert__body">The last scan failed: @scan.Error</div></div>
                }
                @if (findings.Count > 0)
                {
                    <div class="mat-table-wrap">
                        <table class="mat-table">
                            <thead><tr><th>Severity</th><th>Vulnerability</th><th>Package</th><th>Installed</th><th>Fixed in</th></tr></thead>
                            <tbody>
                                @foreach (var f in findings)
                                {
                                    <tr>
                                        <td data-label="Severity"><span class="mat-pill @(f.Severity == "CRITICAL" ? "mat-pill--error" : f.Severity == "HIGH" ? "mat-pill--warn" : "mat-pill--plain")">@f.Severity.ToLowerInvariant()</span></td>
                                        <td class="mat-text-wrap" data-label="Vulnerability">
                                            <div class="mat-table__name"><span><strong class="mat-mono">@f.Id</strong>@if (f.Title is not null) { <small>@(f.Title.Length > 140 ? f.Title[..140] + "…" : f.Title)</small> }</span></div>
                                        </td>
                                        <td class="mat-mono" data-label="Package">@f.Package</td>
                                        <td class="mat-mono mat-muted" data-label="Installed">@f.Installed</td>
                                        <td class="mat-mono" data-label="Fixed in">@(f.Fixed ?? "–")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (scan.Critical + scan.High + scan.Medium + scan.Low + scan.Unknown > findings.Count)
                    {
                        <p class="mat-hint">The @findings.Count most severe are listed.</p>
                    }
                }
            }
            else if (Model.Running is null)
            {
                <p class="mat-hint">Not scanned yet.</p>
            }
            @if (User.IsInRole("Admin") && Model.Running is not { IsFinished: false })
            {
                <form method="post" asp-page-handler="Scan">
                    <input type="hidden" name="envId" value="@Model.EnvId" />
                    <input type="hidden" name="reference" value="@Model.Reference" />
                    <mat-form-buttons>
                        <button type="submit" class="mat-btn mat-btn--secondary"><icon name="shield" /><span>Scan now</span></button>
                    </mat-form-buttons>
                </form>
            }
        </div>
    </section>

    <section class="mat-card">
        <div class="mat-card__head"><icon name="layers" /><h2 class="mat-card__title">Layers (@d.Layers.Count)</h2></div>
        @if (d.Layers.Count == 0)
        {
            <div class="mat-empty"><div class="mat-empty__icon"><icon name="layers" /></div><p>No layer history.</p></div>
        }
        else
        {
            <div class="mat-table-wrap">
                <table class="mat-table">
                    <thead><tr><th>Instruction</th><th>Size</th><th>Created</th></tr></thead>
                    <tbody>
                        @foreach (var layer in d.Layers)
                        {
                            <tr>
                                <td class="mat-mono mat-text-wrap" data-label="Instruction">@layer.CreatedBy</td>
                                <td class="mat-nowrap" data-label="Size">@layer.Size</td>
                                <td class="mat-nowrap mat-muted" data-label="Created">@layer.CreatedSince</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
}
