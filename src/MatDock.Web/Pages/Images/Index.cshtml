@page
@model MatDock.Web.Pages.Images.IndexModel
@{
    ViewData["Title"] = "Images";
    var isAdmin = User.IsInRole("Admin");
}

<div class="page-head">
    <div class="page-head__title">
        <h1>Images</h1>
        <span class="page-head__subtitle">@(Model.EnvId > 0 ? "Docker images of the selected environment" : "All Docker images across all environments")</span>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert @(Model.IsError ? "alert--error" : "alert--success")">
        <icon name="@(Model.IsError ? "x-circle" : "check-circle")" /><span>@Model.StatusMessage</span>
    </div>
}

@if (Model.Errors.Count > 0)
{
    <div class="alert alert--warning">
        <icon name="alert" />
        <span>Unreachable: @string.Join(" · ", Model.Errors.Select(e => $"{e.Environment} ({e.Message})"))</span>
    </div>
}

<mat-table>
    <mat-table-toolbar>
        <form method="get" class="js-autosubmit" style="display:contents;">
            <div class="search">
                <icon name="search" />
                <input type="search" name="Q" value="@Model.Q" class="mat-input" placeholder="Search (repository, tag, id, environment)…" />
            </div>
            <span class="toolbar-spacer"></span>
            <span class="text-muted"><strong>@Model.Rows.Count</strong> Images</span>
        </form>
    </mat-table-toolbar>

    <mat-table-body>
        @if (Model.Rows.Count == 0)
        {
            <div class="empty-state">
                <div><icon name="box" /></div>
                <p>No images found.@(Model.Environments.Count == 0 ? " Create an environment first." : "")</p>
            </div>
        }
        else
        {
            <table class="data">
                <thead>
                    <tr>
                        <th>Environment</th>
                        <th>Repository</th>
                        <th>Tag</th>
                        <th>Image ID</th>
                        <th>Size</th>
                        <th>Created</th>
                        <th class="actions">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        var img = row.Image;
                        <tr>
                            <td class="nowrap">@row.Environment.Name</td>
                            <td class="wrap">
                                <strong>@(img.Dangling ? "<none>" : img.Repository)</strong>
                                @if (img.Dangling)
                                {
                                    <span class="tag-unused" title="Dangling image (untagged)">dangling</span>
                                }
                            </td>
                            <td class="cell-sub">@(string.IsNullOrEmpty(img.Tag) || img.Tag == "<none>" ? "–" : img.Tag)</td>
                            <td class="mono cell-sub">@img.Id</td>
                            <td class="nowrap">@(img.Size ?? "–")</td>
                            <td class="cell-sub nowrap">@(img.CreatedSince ?? "–")</td>
                            <td class="actions">
                                <div class="row-actions">
                                    @if (isAdmin)
                                    {
                                        <form method="post" asp-page-handler="Remove" style="display:inline;"
                                              data-confirm="Remove image &quot;@img.Reference&quot;? (fails if a container still uses it)">
                                            <input type="hidden" name="envId" value="@row.Environment.Id" />
                                            <input type="hidden" name="reference" value="@(img.Dangling ? img.Id : img.Reference)" />
                                            <button type="submit" class="mat-btn mat-btn--sm" title="Remove"><icon name="trash" /></button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </mat-table-body>

    <mat-table-actions>
        <span class="toolbar-spacer"></span>
        @if (isAdmin && Model.EnvId > 0)
        {
            <form method="post" asp-page-handler="Prune" data-confirm="Remove all dangling (untagged) images in this environment?" style="display:inline;">
                <input type="hidden" name="envId" value="@Model.EnvId" />
                <button type="submit" class="mat-btn"><icon name="broom" /><span>Prune dangling</span></button>
            </form>
        }
        <a href="/Images?EnvId=@Model.EnvId&Q=@Uri.EscapeDataString(Model.Q ?? string.Empty)&Refresh=true" class="mat-btn"><icon name="refresh" /><span>Refresh</span></a>
    </mat-table-actions>
</mat-table>
