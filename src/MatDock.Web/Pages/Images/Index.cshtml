@page
@model MatDock.Web.Pages.Images.IndexModel
@inject MatDock.Core.Images.ImageScanService Scans
@{
    ViewData["Title"] = "Images";
    var isAdmin = User.IsInRole("Admin");
    var scans = await Scans.GetLatestAsync(Model.EnvId > 0 ? Model.EnvId : null);
}

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="mat-alert @(Model.IsError ? "mat-alert--danger" : "mat-alert--success")">
        <icon name="@(Model.IsError ? "x-circle" : "check-circle")" /><div class="mat-alert__body">@Model.StatusMessage</div>
    </div>
}

@if (Model.Errors.Count > 0)
{
    <div class="mat-alert mat-alert--warning">
        <icon name="alert" />
        <span>Unreachable: @string.Join(" · ", Model.Errors.Select(e => $"{e.Environment} ({e.Message})"))</span>
    </div>
}

<mat-table>
    <mat-table-toolbar>
        <form method="get" class="js-autosubmit" style="display:contents;">
            <div class="mat-input-icon mat-toolbar__search">
                <icon name="search" />
                <input type="search" name="Q" value="@Model.Q" class="mat-input" placeholder="Search (repository, tag, id, environment)…" />
            </div>
            <span class="mat-toolbar__spacer"></span>
            <span class="mat-muted"><strong>@Model.Rows.Count</strong> Images</span>
        </form>
    </mat-table-toolbar>

    <mat-table-body>
        @if (Model.Rows.Count == 0)
        {
            <div class="mat-empty">
                <div><icon name="box" /></div>
                <p>No images found.@(Model.Environments.Count == 0 ? " Create an environment first." : "")</p>
            </div>
        }
        else
        {
            <table class="mat-table">
                <thead>
                    <tr>
                        <th>Environment</th>
                        <th>Image</th>
                        <th>Size</th>
                        <th>Created</th>
                        <th>Status</th>
                        <th>Vulnerabilities</th>
                        <th class="mat-table__cell-actions">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        var img = row.Image;
                        <tr>
                            <td class="mat-nowrap">@row.Environment.Name</td>
                            <td class="mat-text-wrap">
                                <a href="/Images/Detail?envId=@row.Environment.Id&reference=@Uri.EscapeDataString(img.Dangling ? img.Id : img.Reference)"><strong>@img.Reference</strong></a>
                                @if (img.Dangling)
                                {
                                    <span class="tag-unused" title="Dangling image (untagged)">dangling</span>
                                }
                            </td>
                            <td class="mat-nowrap">@(img.Size ?? "–")</td>
                            <td class="cell-sub mat-nowrap">@(img.CreatedSince ?? "–")</td>
                            <td>
                                @if (row.InUse)
                                {
                                    <span class="mat-pill mat-pill--ok" title="Used by @string.Join(", ", row.UsedBy)"><icon name="check-circle" /> Used</span>
                                }
                                else
                                {
                                    <span class="mat-pill mat-pill--plain" title="No container uses this image"><icon name="alert" /> Unused</span>
                                }
                            </td>
                            <td data-label="Vulnerabilities">
                                @if (scans.TryGetValue((row.Environment.Id, img.Dangling ? img.Id : img.Reference), out var scan))
                                {
                                    <a class="mat-pill @(scan.Critical > 0 ? "mat-pill--error" : scan.High > 0 ? "mat-pill--warn" : "mat-pill--ok")"
                                       href="/Images/Detail?envId=@row.Environment.Id&reference=@Uri.EscapeDataString(img.Dangling ? img.Id : img.Reference)"
                                       title="Scanned @scan.ScannedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")">@(scan.Critical + scan.High == 0 ? "none critical/high" : $"{scan.Critical} critical · {scan.High} high")</a>
                                }
                                else
                                {
                                    <span class="cell-sub">–</span>
                                }
                            </td>
                            <td class="mat-table__cell-actions">
                                <div class="mat-table__actions">
                                    @if (isAdmin)
                                    {
                                        <form method="post" asp-page-handler="Remove" style="display:inline;"
                                              data-confirm="Delete image &quot;@img.Reference&quot;? (fails if a container still uses it)">
                                            <input type="hidden" name="envId" value="@row.Environment.Id" />
                                            <input type="hidden" name="reference" value="@(img.Dangling ? img.Id : img.Reference)" />
                                            <button type="submit" class="mat-btn mat-btn--secondary mat-btn--sm" title="Delete"><icon name="trash" /></button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </mat-table-body>

    <mat-table-actions>
        @if (isAdmin)
        {
            <form method="post" asp-page-handler="Prune" data-confirm="Delete all dangling (untagged) images in @(Model.EnvId > 0 ? "this environment" : "all environments")?" style="display:inline;">
                <input type="hidden" name="envId" value="@Model.EnvId" />
                <button type="submit" class="mat-btn mat-btn--secondary"><icon name="broom" /><span>Prune dangling</span></button>
            </form>
            <form method="post" asp-page-handler="Prune" data-confirm="Remove every image no container uses in @(Model.EnvId > 0 ? "this environment" : "all environments")? They are pulled again when needed." style="display:inline;">
                <input type="hidden" name="envId" value="@Model.EnvId" />
                <input type="hidden" name="all" value="true" />
                <button type="submit" class="mat-btn mat-btn--secondary"><icon name="broom" /><span>Prune unused</span></button>
            </form>
        }
        <a href="/Images?EnvId=@Model.EnvId&Q=@Uri.EscapeDataString(Model.Q ?? string.Empty)&Refresh=true" class="mat-btn mat-btn--secondary"><icon name="refresh" /><span>Refresh</span></a>
    </mat-table-actions>
</mat-table>
