@page
@model MatDock.Web.Pages.SetupModel
@{
    ViewData["Title"] = "Setup";
    Layout = "_Bare";
}

<div class="mat-auth__card">
    <div class="mat-auth__brand">
        @Ui.Logo("lg")
        <h1>Welcome to @Ui.App.Name</h1>
        <p class="mat-muted">Let's create your administrator account</p>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="mat-alert mat-alert--danger" role="alert"><icon name="x-circle" /><div class="mat-alert__body">@Model.ErrorMessage</div></div>
    }

    <form method="post" class="mat-form">
        <partial name="_ValidationSummary" />

        <h2 class="mat-form__section-head">Administrator</h2>
        <mat-field label="Username" asp-for="Input.Username" required="true">
            <input asp-for="Input.Username" class="mat-input" autocomplete="username" autofocus />
        </mat-field>
        <mat-field label="Display name" asp-for="Input.DisplayName">
            <input asp-for="Input.DisplayName" class="mat-input" />
        </mat-field>
        <mat-field label="Password" asp-for="Input.Password" required="true">
            <input asp-for="Input.Password" type="password" class="mat-input" autocomplete="new-password" />
        </mat-field>
        <mat-field label="Confirm password" asp-for="Input.ConfirmPassword" required="true">
            <input asp-for="Input.ConfirmPassword" type="password" class="mat-input" autocomplete="new-password" />
        </mat-field>

        <h2 class="mat-form__section-head">Maintenance schedules</h2>
        <label class="mat-check">
            <input asp-for="Input.PruneImages" type="checkbox" />
            <span>Prune dangling images regularly</span>
        </label>
        <label class="mat-check">
            <input asp-for="Input.PruneVolumes" type="checkbox" />
            <span>Prune unused volumes</span>
        </label>
        <label class="mat-check">
            <input asp-for="Input.PruneNetworks" type="checkbox" />
            <span>Prune unused networks</span>
        </label>
        <mat-field label="Frequency" asp-for="Input.Frequency">
            <select asp-for="Input.Frequency" class="mat-select">
                <option value="daily">Daily (03:00 UTC)</option>
                <option value="weekly" selected>Weekly (Sun 03:00 UTC)</option>
                <option value="monthly">Monthly (1st, 03:00 UTC)</option>
            </select>
        </mat-field>

        <button type="submit" class="mat-btn mat-btn--primary mat-btn--block">
            <icon name="check-circle" /><span>Create admin &amp; finish</span>
        </button>
    </form>
</div>
