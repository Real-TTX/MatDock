@page
@model MatDock.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Dashboard";
    var isAdmin = User.IsInRole("Admin");
    string Fb(long b) => MatDock.Core.Volumes.VolumeMigrationResult.FormatBytes(b);

    string Ago(DateTime utc)
    {
        if (utc == default) { return ""; }
        var d = DateTime.UtcNow - utc;
        if (d < TimeSpan.Zero) { d = TimeSpan.Zero; }
        if (d.TotalSeconds < 60) { return "just now"; }
        if (d.TotalMinutes < 60) { return $"{(int)d.TotalMinutes} min ago"; }
        if (d.TotalHours < 24) { return $"{(int)d.TotalHours} h ago"; }
        return $"{(int)d.TotalDays} d ago";
    }

    string InFuture(DateTime utc)
    {
        var d = utc - DateTime.UtcNow;
        if (d < TimeSpan.Zero) { return "due"; }
        if (d.TotalMinutes < 60) { return $"in {(int)d.TotalMinutes} min"; }
        if (d.TotalHours < 24) { return $"in {(int)Math.Round(d.TotalHours)} h"; }
        return $"in {(int)d.TotalDays} d";
    }

    // The dot of an event in the activity timeline: started/restarted green, stopped amber, the rest in the accent.
    string EventTone(string kind) => kind switch
    {
        "started" or "restarted" => "mat-timeline__ok",
        "stopped" => "mat-timeline__warn",
        _ => ""
    };

    var envSubParts = new List<string> { $"{Model.OnlineCount} online" };
    if (Model.AttentionCount > 0) { envSubParts.Add($"{Model.AttentionCount} offline"); }
    if (Model.DisabledCount > 0) { envSubParts.Add($"{Model.DisabledCount} disabled"); }
    var envSub = string.Join(" · ", envSubParts);
}

@* Everything below the head is read again every 30 s while the page is visible (data-live, matdock.js). *@
<div id="live-dashboard" data-live="30" class="mat-stack mat-stack--lg">
    @* ---- Key figures (clickable) ---- *@
    <div class="mat-grid">
        <a class="mat-card md-stat" href="/Environments">
            <span class="md-stat__icon @(Model.AttentionCount > 0 ? "md-stat__icon--warn" : "md-stat__icon--ok")"><icon name="server" /></span>
            <span class="mat-stat">
                <span class="mat-stat__value">@Model.TotalEnvironments</span>
                <span class="mat-stat__label">Environments</span>
                <span class="mat-stat__delta">@envSub</span>
            </span>
        </a>
        <a class="mat-card md-stat" href="/Stacks">
            <span class="md-stat__icon"><icon name="layers" /></span>
            <span class="mat-stat">
                <span class="mat-stat__value">@Model.StacksCount</span>
                <span class="mat-stat__label">Stacks</span>
            </span>
        </a>
        <a class="mat-card md-stat" href="/Containers">
            <span class="md-stat__icon"><icon name="box" /></span>
            <span class="mat-stat">
                <span class="mat-stat__value">@Model.RunningContainersTotal</span>
                <span class="mat-stat__label">Running containers</span>
            </span>
        </a>
    </div>

    @* ---- Apps (full width: tiles need room) ---- *@
    @if (Model.AppTiles.Count > 0)
    {
        <section class="mat-section">
            <div class="mat-row mat-row--between">
                <h2 class="md-section-title"><icon name="apps" /><span>Apps</span></h2>
                <a href="/Launchpad">All apps →</a>
            </div>
            <div class="mat-grid">
                @foreach (var t in Model.AppTiles)
                {
                    <partial name="_AppTile" model="t" />
                }
            </div>
        </section>
    }

    @* ---- Environments ---- *@
    <section class="mat-section">
        <div class="mat-row mat-row--between">
            <h2 class="md-section-title"><icon name="server" /><span>Environments</span></h2>
            <a href="/Environments">Manage →</a>
        </div>
        @if (Model.Environments.Count == 0)
        {
            <div class="mat-empty mat-empty--framed">
                <div class="mat-empty__icon"><icon name="server" /></div>
                <p>No enabled environments to show.</p>
                @if (isAdmin) { <a href="/Environments/Edit" class="mat-btn mat-btn--primary"><icon name="plus" /><span>Create your first environment</span></a> }
            </div>
        }
        else
        {
            <div class="mat-grid">
                @foreach (var env in Model.Environments)
                {
                    var st = Model.Stats.TryGetValue(env.Id, out var s) ? s : new MatDock.Core.Docker.HostStats();
                    var running = Model.RunningCounts.TryGetValue(env.Id, out var rc) ? rc : (st.RunningContainers ?? 0);
                    <partial name="_EnvCard" model="new EnvCardModel(env, st, running, OnDashboard: true)" />
                }
            </div>
        }
    </section>

    @* ---- Usage ---- *@
    <section class="mat-section">
        <div class="mat-row mat-row--between">
            <h2 class="md-section-title"><icon name="box" /><span>Usage</span></h2>
            <a href="/Containers">All containers →</a>
        </div>
        @if (Model.TopContainers.Count == 0)
        {
            <div class="mat-empty mat-empty--framed"><div class="mat-empty__icon"><icon name="box" /></div><p>No running containers.</p></div>
        }
        else
        {
            <div class="mat-table-wrap">
                <table class="mat-table">
                    <thead>
                        <tr><th>Container</th>@if (Model.IsAll) { <th>Environment</th> }<th class="mat-num">CPU</th><th class="mat-num">RAM</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var t in Model.TopContainers)
                        {
                            var c = t.Container;
                            <tr>
                                <td data-label="Container">
                                    <div class="mat-table__name">
                                        <span class="mat-min-w-0">
                                            <a href="/Containers/ContainerDetail?envId=@t.EnvId&id=@Uri.EscapeDataString(c.Id)">@c.Name</a>
                                            <small class="mat-mono">@c.Image</small>
                                        </span>
                                    </div>
                                </td>
                                @if (Model.IsAll)
                                {
                                    <td data-label="Environment" class="mat-muted">@t.EnvName</td>
                                }
                                <td data-label="CPU" class="mat-num">
                                    @if (c.CpuPercent is not null)
                                    {
                                        <div class="md-usage-cell">
                                            <span>@($"{c.CpuPercent:0.0}")%</span>
                                            <div class="mat-meter mat-meter--sm"><div class="mat-meter__fill" data-value="@EnvironmentView.Percent(c.CpuPercent)"></div></div>
                                        </div>
                                    }
                                    else { <span class="mat-muted">–</span> }
                                </td>
                                <td data-label="RAM" class="mat-num" title="@c.MemUsage">
                                    @if (c.MemPercent is not null)
                                    {
                                        <div class="md-usage-cell">
                                            <span>@($"{c.MemPercent:0.0}")%</span>
                                            <div class="mat-meter mat-meter--sm"><div class="mat-meter__fill" data-value="@EnvironmentView.Percent(c.MemPercent)"></div></div>
                                        </div>
                                    }
                                    else { <span class="mat-muted">–</span> }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    @* ---- Recent activity ---- *@
    <section class="mat-section">
        <h2 class="md-section-title"><icon name="clock" /><span>Recent activity</span></h2>
        @if (Model.RecentEvents.Count == 0)
        {
            <div class="mat-empty mat-empty--framed"><div class="mat-empty__icon"><icon name="clock" /></div><p>No recent container events.</p></div>
        }
        else
        {
            <div class="mat-card">
                <div class="mat-card__body">
                    <ul class="mat-timeline">
                        @foreach (var row in Model.RecentEvents)
                        {
                            var ev = row.Event;
                            <li class="@EventTone(ev.Kind)">
                                <strong>@ev.ContainerName</strong> <span class="mat-muted">@ev.Kind</span>
                                <span class="mat-timeline__time">@(Model.IsAll ? row.EnvName + " · " : "")@Ago(ev.TimeUtc)</span>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        }
    </section>

    @* ---- Backups ---- *@
    <section class="mat-section">
        <div class="mat-row mat-row--between">
            <h2 class="md-section-title"><icon name="download" /><span>Backups</span></h2>
            @if (isAdmin) { <a href="/Backups">History →</a> }
        </div>
        <div class="mat-card">
            <div class="mat-card__body md-metrics">
                <div class="mat-stat">
                    <span class="mat-stat__label">Backups</span>
                    <span class="mat-stat__value">@Model.BackupCount</span>
                </div>
                <div class="mat-stat">
                    <span class="mat-stat__label">Total size</span>
                    <span class="mat-stat__value">@Fb(Model.BackupBytes)</span>
                </div>
                <div class="mat-stat">
                    <span class="mat-stat__label">Last backup</span>
                    <span class="mat-stat__value">@(Model.LastBackupUtc is { } lb ? Ago(lb) : "–")</span>
                </div>
                <div class="mat-stat">
                    <span class="mat-stat__label">Next run</span>
                    <span class="mat-stat__value">@(Model.NextBackupUtc is { } nb ? InFuture(nb) : "–")</span>
                </div>
                <div class="mat-stat">
                    <span class="mat-stat__label">Last scheduled run@(Model.LastRunUtc is { } lr ? $" · {Ago(lr)}" : "")</span>
                    <span class="mat-stat__value">
                        @if (Model.LastRunUtc is null)
                        {
                            <span class="mat-muted">–</span>
                        }
                        else if (Model.LastRunOk == true)
                        {
                            <span class="mat-pill mat-pill--ok"><icon name="check-circle" /> OK</span>
                        }
                        else if (Model.LastRunOk == false)
                        {
                            <span class="mat-pill mat-pill--error"><icon name="x-circle" /> Failed</span>
                        }
                        else
                        {
                            <span class="mat-pill mat-pill--plain">@(string.IsNullOrWhiteSpace(Model.LastRunSummary) ? "Unknown" : Model.LastRunSummary)</span>
                        }
                    </span>
                </div>
            </div>
        </div>
    </section>
</div>

@section Actions {
    <a href="/" class="mat-btn mat-btn--ghost mat-btn--icon" data-tip="Refresh" aria-label="Refresh"><icon name="refresh" /></a>
}
