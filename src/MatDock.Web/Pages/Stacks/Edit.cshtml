@page
@model MatDock.Web.Pages.Stacks.EditModel
@{
    ViewData["Title"] = Model.IsEdit ? "Edit stack" : "New stack";
    ViewData["Crumbs"] = new List<(string Text, string? Url)> { ("Stacks", "/Stacks") };
}

@if (!string.IsNullOrEmpty(Model.FromTemplateName))
{
    <div class="mat-alert mat-alert--info">
        <icon name="template" /><div class="mat-alert__body">Prefilled from app '@Model.FromTemplateName'.</div>
    </div>
}
@if (ManagedBadgeTagHelper.DisplayName(Model.ManagedBy) is { } owner)
{
    <div class="mat-alert mat-alert--info">
        <icon name="plug" /><div class="mat-alert__body"><managed-badge value="@Model.ManagedBy" /> This stack was created by @owner. Manual changes may be overwritten the next time @owner updates it.</div>
    </div>
}
@if (Model.IsEdit && Model.Overrides.Count > 0)
{
    <div class="mat-alert mat-alert--info">
        <icon name="refresh" />
        <div class="mat-alert__body">
            MatDock runs other images than this file names:
            @foreach (var (service, over) in Model.Overrides)
            {
                <span class="mat-mono">@service: @over.Image</span><span class="mat-muted"> (file: @over.Base)</span>@(service == Model.Overrides.Keys.Last() ? "." : ";")
            }
            <a href="/Stacks/Update?id=@Model.Input.Id">Change</a>
        </div>
    </div>
}
@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    if (Model.IsError)
    {
        <div class="mat-alert mat-alert--danger" role="alert"><icon name="x-circle" /><div class="mat-alert__body">@Model.StatusMessage</div></div>
    }
    else
    {
        <div class="mat-alert mat-alert--success" role="status"><icon name="check-circle" /><div class="mat-alert__body">@Model.StatusMessage</div></div>
    }
}
@if (!string.IsNullOrEmpty(Model.DeployOutput))
{
    <pre class="mat-code md-output">@Model.DeployOutput</pre>
}

<div class="mat-card">
    <div class="mat-card__body">
        <form method="post" class="mat-form">
            <input type="hidden" asp-for="Input.Id" />
            <partial name="_ValidationSummary" />

            <div class="mat-form__grid">
                <mat-field label="Name" asp-for="Input.Name" hint="Compose project name.">
                    @if (Model.IsEdit)
                    {
                        <input asp-for="Input.Name" class="mat-input" readonly />
                    }
                    else
                    {
                        <input asp-for="Input.Name" class="mat-input" placeholder="e.g. media-stack" />
                    }
                </mat-field>

                <mat-field label="Environment" asp-for="Input.EnvironmentId">
                    <select asp-for="Input.EnvironmentId" class="mat-select">
                        <option value="">– select –</option>
                        @foreach (var env in Model.Environments)
                        {
                            <option value="@env.Id">@env.Name</option>
                        }
                    </select>
                </mat-field>

                <mat-field label="Source" asp-for="Input.Source">
                    <select asp-for="Input.Source" id="Source" class="mat-select">
                        <option value="inline">Compose editor</option>
                        <option value="store">From App Store</option>
                        <option value="git">Git repository</option>
                    </select>
                </mat-field>
            </div>

            <div class="mat-stack" data-show-if="#Source" data-show-value="store">
                @if (Model.Apps.Count == 0)
                {
                    <p class="mat-hint">No apps yet. Create one in the <a href="/Apps">Store</a>, then install it here.</p>
                }
                else
                {
                    <div class="mat-input-icon">
                        <icon name="search" />
                        <input type="search" id="app-search" class="mat-input" placeholder="Search apps…" aria-label="Search the apps" autocomplete="off" />
                    </div>
                    <div id="app-list" class="md-app-picker">
                        @foreach (var a in Model.Apps)
                        {
                            <button type="button" class="md-app-pick" title="@a.Description"
                                    data-slug="@MatDock.Core.Stacks.StackCommands.Slugify(a.Name)"
                                    data-compose="@a.ComposeYaml"
                                    data-search="@($"{a.Name} {a.Category}".ToLowerInvariant())">
                                <icon name="template" />
                                <span class="md-app-pick__name">@a.Name</span>
                                @if (!string.IsNullOrEmpty(a.Category))
                                {
                                    <span class="mat-tag">@a.Category</span>
                                }
                            </button>
                        }
                    </div>
                }
            </div>

            <div class="md-compose" data-show-if="#Source" data-show-value="inline">
                <mat-field label="docker-compose.yml" asp-for="Input.ComposeYaml">
                    <textarea asp-for="Input.ComposeYaml" class="mat-textarea" data-code="yaml" rows="18" spellcheck="false" wrap="off" placeholder="services:&#10;  app:&#10;    image: nginx:alpine&#10;    environment:&#10;      - TZ=${TZ}"></textarea>
                </mat-field>
                <mat-field label="Environment variables (.env)" asp-for="Input.EnvContent" hint="One KEY=value per line, used for ${VAR} substitution in the compose file.">
                    <textarea asp-for="Input.EnvContent" class="mat-textarea" data-code="env" rows="6" spellcheck="false" wrap="off" placeholder="TZ=Europe/Berlin&#10;PUID=1000"></textarea>
                </mat-field>
            </div>

            <div class="mat-stack" data-show-if="#Source" data-show-value="git">
                <div class="mat-form__grid">
                    @if (Model.SavedRepos.Count > 0)
                    {
                        <mat-field label="Use a saved repository (optional)" for-id="stack-repo-picker" full="true" hint="Prefills the URL, branch and credentials below.">
                            <select id="stack-repo-picker" class="mat-select" data-repo-picker>
                                <option value="">— manual entry —</option>
                                @foreach (var r in Model.SavedRepos)
                                {
                                    <option value="@r.Id" data-url="@r.Url" data-ref="@r.Reference" data-cred="@r.GitCredentialId">@r.Name</option>
                                }
                            </select>
                        </mat-field>
                    }
                    <mat-field label="Repository URL" asp-for="Input.GitRepoUrl" full="true">
                        <input asp-for="Input.GitRepoUrl" class="mat-input" placeholder="https://github.com/user/repo.git" />
                    </mat-field>

                    <mat-field label="Branch / Tag" asp-for="Input.GitReference" hint="Optional, default = default branch.">
                        <input asp-for="Input.GitReference" class="mat-input" placeholder="main" />
                    </mat-field>

                    <mat-field label="Compose path in repo" asp-for="Input.GitComposePath" hint="Optional, default = docker-compose.yml">
                        <input asp-for="Input.GitComposePath" class="mat-input" placeholder="docker-compose.yml" />
                    </mat-field>

                    <mat-field label="Git credentials" asp-for="Input.GitCredentialId" full="true" hint="Only for private repositories.">
                        <select asp-for="Input.GitCredentialId" class="mat-select">
                            <option value="">– public / no access –</option>
                            @foreach (var cred in Model.GitCredentials)
                            {
                                <option value="@cred.Id">@cred.Name</option>
                            }
                        </select>
                    </mat-field>
                </div>
            </div>

            <mat-form-buttons>
                <button type="submit" asp-page-handler="SaveDeploy" class="mat-btn mat-btn--primary"><icon name="check-circle" /><span>Save &amp; Deploy</span></button>
                <button type="submit" asp-page-handler="Save" class="mat-btn mat-btn--secondary"><icon name="save" /><span>Save</span></button>
                <button type="submit" asp-page-handler="Check" class="mat-btn mat-btn--secondary" formnovalidate title="Let compose on the environment check the file and the .env (nothing is saved or deployed)"><icon name="check-circle" /><span>Check</span></button>
                <a href="/Stacks" class="mat-btn mat-btn--ghost"><icon name="back" /><span>Back</span></a>
                @if (Model.IsEdit)
                {
                    <span class="mat-btn-row__spacer"></span>
                    <button type="submit" form="delete-form" class="mat-btn mat-btn--danger" data-confirm="Remove '@Model.Input.Name' from MatDock? Its containers keep running."><icon name="trash" /><span>Remove from MatDock</span></button>
                }
            </mat-form-buttons>
        </form>
        @if (Model.IsEdit)
        {
            <form method="post" asp-page-handler="Delete" id="delete-form"><input type="hidden" name="id" value="@Model.Input.Id" /></form>
        }
    </div>
</div>

@section Scripts {
    <script src="~/js/stack-forms.js" asp-append-version="true"></script>
}
