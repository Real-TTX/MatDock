@page
@model MatDock.Web.Pages.Stacks.EditModel
@{
    ViewData["Title"] = Model.IsEdit ? "Edit Stack" : "New Stack";
}

<div class="page-head">
    <div class="page-head__title">
        <h1>@ViewData["Title"]</h1>
        <span class="page-head__subtitle">Create a Compose stack &amp; deploy via <code>docker compose</code></span>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.FromTemplateName))
{
    <div class="alert alert--info">
        <icon name="template" /><span>From app "@Model.FromTemplateName" – name &amp; compose are prefilled. Select an environment and adjust.</span>
    </div>
}
@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert @(Model.IsError ? "alert--error" : "alert--success")">
        <icon name="@(Model.IsError ? "x-circle" : "check-circle")" /><span>@Model.StatusMessage</span>
    </div>
}
@if (!string.IsNullOrEmpty(Model.DeployOutput))
{
    <pre style="background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:12px;overflow:auto;max-height:320px;font-family:var(--mono);font-size:.8rem;white-space:pre-wrap;word-break:break-word;margin-bottom:16px;">@Model.DeployOutput</pre>
}

<div class="card" style="max-width:900px;">
    <div class="card__body">
        <form method="post" class="mat-form">
            <input type="hidden" asp-for="Input.Id" />
            <div asp-validation-summary="ModelOnly"></div>

            <div class="form-grid">
                <mat-field label="Name" asp-for="Input.Name" hint="Compose project name (defines the directory and container prefix). Do not change it after the first deploy.">
                    @if (Model.IsEdit)
                    {
                        <input asp-for="Input.Name" class="mat-input" readonly />
                    }
                    else
                    {
                        <input asp-for="Input.Name" class="mat-input" placeholder="e.g. media-stack" />
                    }
                </mat-field>

                <mat-field label="Environment" asp-for="Input.EnvironmentId">
                    <select asp-for="Input.EnvironmentId" class="mat-select">
                        <option value="">– select –</option>
                        @foreach (var env in Model.Environments)
                        {
                            <option value="@env.Id">@env.Name</option>
                        }
                    </select>
                </mat-field>

                <mat-field label="Source" asp-for="Input.Source" hint="Edit compose directly or pull from a Git repo (including config files).">
                    <select asp-for="Input.Source" id="Source" class="mat-select">
                        <option value="inline">Compose editor</option>
                        <option value="git">Git repository</option>
                    </select>
                </mat-field>
            </div>

            <div data-show-when="Source=inline">
                <mat-field label="docker-compose.yml" asp-for="Input.ComposeYaml" hint="Stored on the host at ~/.matdock/stacks/&lt;name&gt;/docker-compose.yml and deployed with 'docker compose up -d'.">
                    <textarea asp-for="Input.ComposeYaml" class="mat-textarea" rows="16" spellcheck="false" style="font-family:var(--mono);font-size:.85rem;" placeholder="services:&#10;  app:&#10;    image: nginx:alpine"></textarea>
                </mat-field>
            </div>

            <div data-show-when="Source=git">
                <div class="form-grid">
                    @if (Model.SavedRepos.Count > 0)
                    {
                        <mat-field label="Use a saved repository (optional)" class="span-2" hint="Prefills the URL, branch and credentials below.">
                            <select id="stack-repo-picker" class="mat-select">
                                <option value="">— manual entry —</option>
                                @foreach (var r in Model.SavedRepos)
                                {
                                    <option value="@r.Id" data-url="@r.Url" data-ref="@r.Reference" data-cred="@r.GitCredentialId">@r.Name</option>
                                }
                            </select>
                        </mat-field>
                    }
                    <mat-field label="Repository URL" asp-for="Input.GitRepoUrl" class="span-2" hint="HTTPS URL, e.g. https://github.com/user/repo.git">
                        <input asp-for="Input.GitRepoUrl" class="mat-input" placeholder="https://github.com/user/repo.git" />
                    </mat-field>

                    <mat-field label="Branch / Tag" asp-for="Input.GitReference" hint="Optional, default = default branch.">
                        <input asp-for="Input.GitReference" class="mat-input" placeholder="main" />
                    </mat-field>

                    <mat-field label="Compose path in repo" asp-for="Input.GitComposePath" hint="Optional, default = docker-compose.yml">
                        <input asp-for="Input.GitComposePath" class="mat-input" placeholder="docker-compose.yml" />
                    </mat-field>

                    <mat-field label="Git access" asp-for="Input.GitCredentialId" class="span-2" hint="Only needed for private repos. Manage credentials under 'Git access'.">
                        <select asp-for="Input.GitCredentialId" class="mat-select">
                            <option value="">– public / no access –</option>
                            @foreach (var cred in Model.GitCredentials)
                            {
                                <option value="@cred.Id">@cred.Name</option>
                            }
                        </select>
                    </mat-field>
                </div>
                <p class="mat-hint">On deploy the repo is cloned and the entire folder (including config files) is mirrored to the host; then <code>docker compose up -d</code> runs. Deploying again overwrites files but does not delete bind-mounted runtime data.</p>
            </div>

            <mat-form-buttons>
                <button type="submit" asp-page-handler="SaveDeploy" class="mat-btn mat-btn--primary"><icon name="check-circle" /><span>Save &amp; Deploy</span></button>
                <button type="submit" asp-page-handler="Save" class="mat-btn"><icon name="save" /><span>Save</span></button>
                <a href="/Stacks" class="mat-btn mat-btn--ghost"><icon name="back" /><span>Back</span></a>
            </mat-form-buttons>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var picker = document.getElementById('stack-repo-picker');
            if (!picker) { return; }
            picker.addEventListener('change', function () {
                var opt = picker.selectedOptions[0];
                if (!opt || !opt.value) { return; }
                var url = document.querySelector('[name="Input.GitRepoUrl"]');
                var ref = document.querySelector('[name="Input.GitReference"]');
                var cred = document.querySelector('[name="Input.GitCredentialId"]');
                if (url) { url.value = opt.getAttribute('data-url') || ''; }
                if (ref) { ref.value = opt.getAttribute('data-ref') || ''; }
                if (cred) { cred.value = opt.getAttribute('data-cred') || ''; }
            });
        })();
    </script>
}
