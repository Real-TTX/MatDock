@page
@model MatDock.Web.Pages.Stacks.IndexModel
@inject MatDock.Core.Updates.UpdateCheckCache UpdateChecks
@inject MatDock.Core.Execution.SelfContainer Self
@{
    ViewData["Title"] = "Stacks";
    var isGallery = !string.Equals(Model.View, "list", StringComparison.OrdinalIgnoreCase);
    // MatDock runs in this stack: no stop or down from here (StackService refuses them too).
    bool IsSelf(MatDock.Web.Pages.Stacks.IndexModel.StackRow r) => r.Containers.Any(c => Self.IsOn(r.EnvId, c.Id));

    string ViewUrl(string v) => $"/Stacks?view={v}"
        + $"&Q={Uri.EscapeDataString(Model.Q ?? string.Empty)}"
        + $"&Status={Uri.EscapeDataString(Model.Status ?? string.Empty)}"
        + $"&Type={Uri.EscapeDataString(Model.Type ?? string.Empty)}"
        + $"&Tag={Uri.EscapeDataString(Model.Tag ?? string.Empty)}";

    // The address of the list filtered by a tag (the tag name is appended).
    var TagFilter = $"/Stacks?view={Uri.EscapeDataString(Model.View)}&Tag=";

    string StatusPill(MatDock.Web.Pages.Stacks.IndexModel.StackRow r)
        => r.StatusKind switch { "running" => "mat-pill--ok", "partial" => "mat-pill--warn", _ => "mat-pill--plain" };

    (string Cls, string Label) StatusBadge(MatDock.Web.Pages.Stacks.IndexModel.StackRow r)
        => r.IsRunning ? ("mat-pill--ok", "running")
         : r.IsPartial ? ("mat-pill--warn", "partial")
         : ("mat-pill--plain", "stopped");

    // Aggregated CPU/RAM across a stack's containers (sum of per-container % of host); null when no container reports any.
    (double? Cpu, double? Mem) Agg(MatDock.Web.Pages.Stacks.IndexModel.StackRow r)
    {
        double cpu = 0, mem = 0; bool any = false;
        foreach (var c in r.Containers)
        {
            if (c.CpuPercent is { } cv) { cpu += cv; any = true; }
            if (c.MemPercent is { } mv) { mem += mv; any = true; }
        }
        return any ? (cpu, mem) : (null, null);
    }

    // The containers of a stack as compact rows (shared by the gallery cards and the list detail rows): state, name and image, ports, usage, actions.
    async Task RenderContainers(MatDock.Web.Pages.Stacks.IndexModel.StackRow r)
    {
        if (r.Containers.Count == 0)
        {
            <p class="mat-muted mat-small">No containers.</p>
            return;
        }

        <ul class="md-crows">
            @foreach (var c in r.Containers)
            {
                var label = string.IsNullOrEmpty(c.Service) ? c.Name : c.Service;
                var actions = new MatDock.Web.Support.ContainerActionsModel(r.EnvId, c, "ContainerAction", User.CanControl(), User.IsInRole("Admin"), Self.IsOn(r.EnvId, c.Id));
                <li class="md-crow">
                    <div class="md-crow__name">
                        <a href="/Containers/ContainerDetail?envId=@r.EnvId&id=@Uri.EscapeDataString(c.Id)" title="@c.Name">@label</a>
                        <span class="md-crow__image mat-mono" title="@c.Image">@c.Image</span>
                    </div>
                    <span class="md-crow__state"><container-status state="@c.State" status="@c.Status" /></span>
                    <container-ports ports="@c.Ports" urls="@MatDock.Core.Containers.ProxyUrls.From(c.Labels)" host="@r.EnvHost" max="3" />
                    <span class="md-crow__usage mat-small mat-muted">@(c.CpuPercent is { } cpu ? $"CPU {cpu:0.#} %" : null)@(c.MemPercent is { } mem ? $" · RAM {mem:0.#} %" : null)</span>
                    <partial name="_ContainerActions" model="actions" />
                </li>
            }
        </ul>
    }

    // The state of a container as a dot beside its service, in the head of a card.
    string Dot(MatDock.Core.Containers.DockerContainer c)
        => c.IsRunning ? "md-dot--ok" : string.Equals(c.State, "paused", StringComparison.OrdinalIgnoreCase) ? "md-dot--warn"
         : string.Equals(c.State, "exited", StringComparison.OrdinalIgnoreCase) && !(c.Status ?? string.Empty).Contains("(0)") ? "md-dot--error" : "md-dot--off";
}

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    if (Model.IsError)
    {
        <div class="mat-alert mat-alert--danger" role="alert"><icon name="x-circle" /><div class="mat-alert__body">@Model.StatusMessage</div></div>
    }
    else
    {
        <div data-toast="@Model.StatusMessage" data-tone="success" hidden></div>
    }
}
@if (!string.IsNullOrEmpty(Model.Output))
{
    <pre class="mat-code md-output">@Model.Output</pre>
}
@if (Model.Console is not null)
{
    <partial name="_OperationConsole" model="Model.Console" />
}
@foreach (var err in Model.LoadErrors)
{
    <div class="mat-alert mat-alert--danger" role="alert"><icon name="x-circle" /><div class="mat-alert__body">@err</div></div>
}

<form method="get" id="stack-filter" class="js-autosubmit" hidden>
    <input type="hidden" name="view" value="@Model.View" />
</form>

<mat-table>
    <mat-table-toolbar>
        <div class="mat-input-icon mat-toolbar__search">
            <icon name="search" />
            <input type="search" name="Q" form="stack-filter" value="@Model.Q" class="mat-input" placeholder="Search (name, environment)…" aria-label="Search the stacks" data-shortcut="/" />
        </div>
        <label class="mat-sr-only" for="filter-status">Status</label>
        <select id="filter-status" name="Status" form="stack-filter" class="mat-select mat-w-auto">
            <option value="">All statuses</option>
            <option value="running" selected="@(Model.Status == "running")">Running</option>
            <option value="partial" selected="@(Model.Status == "partial")">Partial</option>
            <option value="stopped" selected="@(Model.Status == "stopped")">Stopped</option>
        </select>
        <label class="mat-sr-only" for="filter-type">Type</label>
        <select id="filter-type" name="Type" form="stack-filter" class="mat-select mat-w-auto">
            <option value="">All types</option>
            <option value="managed" selected="@(Model.Type == "managed")">Managed</option>
            <option value="external" selected="@(Model.Type == "external")">External</option>
        </select>
        @if (Model.TotalTags.Count > 0)
        {
            <label class="mat-sr-only" for="filter-tag">Tag</label>
            <select id="filter-tag" name="Tag" form="stack-filter" class="mat-select mat-w-auto">
                <option value="">All tags</option>
                @foreach (var t in Model.TotalTags)
                {
                    <option value="@t" selected="@(string.Equals(Model.Tag, t, StringComparison.OrdinalIgnoreCase))">@t</option>
                }
            </select>
        }
        <span class="mat-toolbar__spacer"></span>
        <span class="mat-toolbar__info" aria-live="polite">@(Model.Rows.Count != Model.TotalCount ? $"{Model.Rows.Count} of {Model.TotalCount} stacks" : $"{Model.Rows.Count} stacks")</span>
        <div class="mat-toolbar__end">
            <div class="mat-btn-group" role="group" aria-label="View">
                <a href="@ViewUrl("gallery")" class="mat-btn mat-btn--sm mat-btn--icon @(isGallery ? "is-active" : "")" aria-current="@(isGallery ? "true" : null)" title="Tiles" aria-label="Tiles"><icon name="grid" /></a>
                <a href="@ViewUrl("list")" class="mat-btn mat-btn--sm mat-btn--icon @(isGallery ? "" : "is-active")" aria-current="@(isGallery ? null : "true")" title="List" aria-label="List"><icon name="list" /></a>
            </div>
        </div>
    </mat-table-toolbar>

    <mat-table-body>
        @if (Model.Rows.Count == 0)
        {
            <div class="mat-empty @(Model.TotalCount > 0 ? "" : "mat-empty--first")">
                <div class="mat-empty__icon"><icon name="layers" /></div>
                <p class="mat-empty__title">@(Model.TotalCount > 0 ? "No stacks match the filter." : "No stacks yet.")</p>
                @if (Model.TotalCount == 0)
                {
                    <a href="/Stacks/Edit" class="mat-btn mat-btn--primary"><icon name="plus" /><span>New stack</span></a>
        <a href="/Stacks/Import" class="mat-btn mat-btn--secondary"><icon name="folder-open" /><span>Import</span></a>
                }
            </div>
        }
        else if (isGallery)
        {
            <div class="mat-grid md-stacks">
                @foreach (var r in Model.Rows)
                {
                    var app = MatDock.Web.Support.AppView.Parse(r.AppMetaJson);
                    var agg = Agg(r);
                    var self = IsSelf(r);
                    <div class="md-stack-cell">
                        <details class="mat-card md-stack" open="@(Model.Rows.Count <= 2)">
                            <summary class="mat-card__head md-stack__head">
                                <icon name="chevron-right" class="md-stack__chev" />
                                @if (app?.Icon is not null)
                                {
                                    <partial name="_AppIcon" model="app" />
                                }
                                <div class="md-stack__title">
                                    <div class="md-stack__name">
                                        <span class="mat-card__title">@r.Name</span>
                                        @if (r.GitBacked)
                                        {
                                            <span class="mat-tag" title="Git-backed"><icon name="git" /> Git</span>
                                        }
                                        @{ var updates = UpdateChecks.Updates(r.EnvId, r.Name); }
                                        @if (updates.Count > 0 && r.ManagedId is { } uid)
                                        {
                                            <a class="mat-pill mat-pill--info" href="/Stacks/Update?id=@uid" title="@string.Join(", ", updates.Select(u => u.Image))">Update</a>
                                        }
                                        @if (self)
                                        {
                                            <span class="mat-pill mat-pill--accent" title="MatDock runs in this stack">This MatDock</span>
                                        }
                                        <managed-badge value="@r.ManagedBy" />
                                        <partial name="_TagList" model="(r.Tags, Model.TagColors, TagFilter)" />
                                        @if (r.Discovered)
                                        {
                                            <span class="mat-tag" title="Running on the host, not managed by MatDock">External</span>
                                        }
                                    </div>
                                    <span class="mat-card__sub"><icon name="server" /> @r.EnvName</span>
                                    @if (r.Containers.Count > 0)
                                    {
                                        <span class="md-stack__svcs">
                                            @foreach (var c in r.Containers.Take(8))
                                            {
                                                <span class="md-svc" title="@c.Name: @c.Status"><span class="md-dot @Dot(c)" aria-hidden="true"></span>@(string.IsNullOrEmpty(c.Service) ? c.Name : c.Service)</span>
                                            }
                                            @if (r.Containers.Count > 8)
                                            {
                                                <span class="md-svc mat-muted">+@(r.Containers.Count - 8)</span>
                                            }
                                        </span>
                                    }
                                </div>
                                @if (r.Total > 0)
                                {
                                    <span class="mat-pill @StatusPill(r)">@r.Running/@r.Total</span>
                                }
                                else
                                {
                                    <span class="mat-pill mat-pill--plain">idle</span>
                                }
                            </summary>

                            <div class="mat-card__body mat-stack">
                                @if (agg.Mem is not null)
                                {
                                    <usage mem="@agg.Mem" cpu="@agg.Cpu" mem-title="Aggregated RAM across the stack (% of host)" cpu-title="Aggregated CPU across the stack (% of host)" />
                                }
                                @{ await RenderContainers(r); }
                            </div>
                        </details>
                        <div class="md-stack__acts">
                            <partial name="_StackActions" model="(r, self, true)" />
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="mat-table-wrap">
                <table class="mat-table">
                    <thead>
                        <tr><th>Environment</th><th>Name</th><th>Status</th><th class="mat-num">Containers</th><th class="mat-num">Volumes</th><th>Resources</th><th class="mat-table__cell-actions"><span class="mat-sr-only">Actions</span></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.Rows)
                        {
                            var agg = Agg(r);
                            var self = IsSelf(r);
                            <tr>
                                <td data-label="Environment">@r.EnvName</td>
                                <td data-label="Name">
                                    <div class="mat-table__name">
                                        <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm md-row-toggle" data-toggle-row aria-expanded="false" aria-label="Show the containers of @r.Name"><icon name="chevron-right" /></button>
                                        @if (r.Managed && r.ManagedId is { } mid)
                                        {
                                            <a href="/Stacks/Edit?id=@mid">@r.Name</a>
                                        }
                                        else
                                        {
                                            <span>@r.Name</span>
                                        }
                                        @if (r.GitBacked)
                                        {
                                            <span class="mat-tag" title="Git-backed"><icon name="git" /> Git</span>
                                        }
                                        @if (r.Discovered)
                                        {
                                            <span class="mat-tag" title="Running on the host, not managed by MatDock">External</span>
                                        }
                                        @{ var updates = UpdateChecks.Updates(r.EnvId, r.Name); }
                                        @if (updates.Count > 0 && r.ManagedId is { } uid)
                                        {
                                            <a class="mat-pill mat-pill--info" href="/Stacks/Update?id=@uid" title="@string.Join(", ", updates.Select(u => u.Image))">Update</a>
                                        }
                                        @if (self)
                                        {
                                            <span class="mat-pill mat-pill--accent" title="MatDock runs in this stack">This MatDock</span>
                                        }
                                        <managed-badge value="@r.ManagedBy" />
                                        <partial name="_TagList" model="(r.Tags, Model.TagColors, TagFilter)" />
                                    </div>
                                </td>
                                <td data-label="Status">
                                    @if (r.Total > 0)
                                    {
                                        var sb = StatusBadge(r);
                                        <span class="mat-pill @sb.Cls">@sb.Label</span>
                                    }
                                    else if (r.Managed)
                                    {
                                        <span class="mat-muted">@(r.LastStatus ?? "idle")</span>
                                    }
                                    else
                                    {
                                        <span class="mat-muted">–</span>
                                    }
                                </td>
                                <td class="mat-num" data-label="Containers"><a href="/Containers/Stack?envId=@r.EnvId&project=@Uri.EscapeDataString(r.Name)" title="Containers of this stack">@r.Running/@r.Total</a></td>
                                <td class="mat-num" data-label="Volumes"><a href="/Volumes?EnvId=@r.EnvId&Q=@Uri.EscapeDataString(r.Name)" title="Volumes of this stack">@r.VolumeCount</a></td>
                                <td data-label="Resources"><usage mem="@agg.Mem" cpu="@agg.Cpu" mem-title="Aggregated RAM across the stack (% of host)" cpu-title="Aggregated CPU across the stack (% of host)" /></td>
                                <td class="mat-table__cell-actions">
                                    <partial name="_StackActions" model="(r, self, false)" />
                                </td>
                            </tr>
                            <tr class="md-stack-detail" hidden>
                                <td colspan="7">@{ await RenderContainers(r); }</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </mat-table-body>

    <mat-table-actions>
        <a href="/Stacks/Edit" class="mat-btn mat-btn--primary"><icon name="plus" /><span>New stack</span></a>
        <a href="/Stacks/Import" class="mat-btn mat-btn--secondary"><icon name="folder-open" /><span>Import</span></a>
        <a href="@ViewUrl(Model.View)" class="mat-btn mat-btn--secondary"><icon name="refresh" /><span>Refresh</span></a>
    </mat-table-actions>
</mat-table>

@section Scripts {
    @if (Model.Console is not null)
    {
        <script src="~/js/console.js" asp-append-version="true"></script>
    }
}
