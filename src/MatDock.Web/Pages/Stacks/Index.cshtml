@page
@model MatDock.Web.Pages.Stacks.IndexModel
@inject MatDock.Core.Updates.UpdateCheckCache UpdateChecks
@{
    ViewData["Title"] = "Stacks";
    var isGallery = !string.Equals(Model.View, "list", StringComparison.OrdinalIgnoreCase);

    string ViewUrl(string v) => $"/Stacks?view={v}"
        + $"&Q={Uri.EscapeDataString(Model.Q ?? string.Empty)}"
        + $"&Status={Uri.EscapeDataString(Model.Status ?? string.Empty)}"
        + $"&Type={Uri.EscapeDataString(Model.Type ?? string.Empty)}";

    string StatusPill(MatDock.Web.Pages.Stacks.IndexModel.StackRow r)
        => r.StatusKind switch { "running" => "mat-pill--ok", "partial" => "mat-pill--warn", _ => "mat-pill--plain" };

    (string Cls, string Label) StatusBadge(MatDock.Web.Pages.Stacks.IndexModel.StackRow r)
        => r.IsRunning ? ("mat-pill--ok", "running")
         : r.IsPartial ? ("mat-pill--warn", "partial")
         : ("mat-pill--plain", "stopped");

    // Aggregated CPU/RAM across a stack's containers (sum of per-container % of host); null when no container reports any.
    (double? Cpu, double? Mem) Agg(MatDock.Web.Pages.Stacks.IndexModel.StackRow r)
    {
        double cpu = 0, mem = 0; bool any = false;
        foreach (var c in r.Containers)
        {
            if (c.CpuPercent is { } cv) { cpu += cv; any = true; }
            if (c.MemPercent is { } mv) { mem += mv; any = true; }
        }
        return any ? (cpu, mem) : (null, null);
    }

    // Container tiles for an expanded stack (shared by the gallery cards and the list detail rows).
    async Task RenderTiles(MatDock.Web.Pages.Stacks.IndexModel.StackRow r)
    {
        if (r.Containers.Count == 0)
        {
            <p class="mat-muted mat-small">No containers running for this stack.</p>
        }
        else
        {
            <div class="md-ctiles">
                @foreach (var c in r.Containers)
                {
                    var label = string.IsNullOrEmpty(c.Service) ? c.Name : c.Service;
                    <div class="md-ctile">
                        <div class="md-ctile__top">
                            <a class="md-ctile__name" href="/Containers/ContainerDetail?envId=@r.EnvId&id=@Uri.EscapeDataString(c.Id)" title="@label">@label</a>
                            <container-status state="@c.State" status="@c.Status" />
                        </div>
                        <div class="md-ctile__meta mat-mono" title="@c.Image">@c.Image</div>
                        <container-ports ports="@c.Ports" host="@r.EnvHost" />
                        <div class="mat-table__actions md-ctile__actions">
                            <a class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" href="/Containers/Logs?EnvId=@r.EnvId&id=@Uri.EscapeDataString(c.Id)" title="Logs" aria-label="Logs"><icon name="eye" /></a>
                            @if (c.IsRunning)
                            {
                                @if (User.IsInRole("Admin"))
                                {
                                    <a class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" href="/Terminal?envId=@r.EnvId&container=@Uri.EscapeDataString(c.Id)&name=@Uri.EscapeDataString(c.Name)" title="Shell" aria-label="Shell"><icon name="terminal" /></a>
                                }
                                <form method="post" asp-page-handler="ContainerAction">
                                    <input type="hidden" name="envId" value="@r.EnvId" /><input type="hidden" name="id" value="@c.Id" /><input type="hidden" name="name" value="@c.Name" /><input type="hidden" name="action" value="Restart" />
                                    <button type="submit" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" title="Restart" aria-label="Restart"><icon name="refresh" /></button>
                                </form>
                                <form method="post" asp-page-handler="ContainerAction" data-confirm="Stop container '@c.Name'?">
                                    <input type="hidden" name="envId" value="@r.EnvId" /><input type="hidden" name="id" value="@c.Id" /><input type="hidden" name="name" value="@c.Name" /><input type="hidden" name="action" value="Stop" />
                                    <button type="submit" class="mat-btn mat-btn--danger mat-btn--icon mat-btn--sm" title="Stop" aria-label="Stop"><icon name="stop" /></button>
                                </form>
                            }
                            else
                            {
                                <form method="post" asp-page-handler="ContainerAction">
                                    <input type="hidden" name="envId" value="@r.EnvId" /><input type="hidden" name="id" value="@c.Id" /><input type="hidden" name="name" value="@c.Name" /><input type="hidden" name="action" value="Start" />
                                    <button type="submit" class="mat-btn mat-btn--primary mat-btn--icon mat-btn--sm" title="Start" aria-label="Start"><icon name="play" /></button>
                                </form>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    }
}

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    if (Model.IsError)
    {
        <div class="mat-alert mat-alert--danger" role="alert"><icon name="x-circle" /><div class="mat-alert__body">@Model.StatusMessage</div></div>
    }
    else
    {
        <div data-toast="@Model.StatusMessage" data-tone="success" hidden></div>
    }
}
@if (!string.IsNullOrEmpty(Model.Output))
{
    <pre class="mat-code md-output">@Model.Output</pre>
}
@foreach (var err in Model.LoadErrors)
{
    <div class="mat-alert mat-alert--danger" role="alert"><icon name="x-circle" /><div class="mat-alert__body">@err</div></div>
}

<form method="get" id="stack-filter" class="js-autosubmit" hidden>
    <input type="hidden" name="view" value="@Model.View" />
</form>

<mat-table>
    <mat-table-toolbar>
        <div class="mat-input-icon mat-toolbar__search">
            <icon name="search" />
            <input type="search" name="Q" form="stack-filter" value="@Model.Q" class="mat-input" placeholder="Search (name, environment)…" aria-label="Search the stacks" data-shortcut="/" />
        </div>
        <label class="mat-sr-only" for="filter-status">Status</label>
        <select id="filter-status" name="Status" form="stack-filter" class="mat-select mat-w-auto">
            <option value="">All statuses</option>
            <option value="running" selected="@(Model.Status == "running")">Running</option>
            <option value="partial" selected="@(Model.Status == "partial")">Partial</option>
            <option value="stopped" selected="@(Model.Status == "stopped")">Stopped</option>
        </select>
        <label class="mat-sr-only" for="filter-type">Type</label>
        <select id="filter-type" name="Type" form="stack-filter" class="mat-select mat-w-auto">
            <option value="">All types</option>
            <option value="managed" selected="@(Model.Type == "managed")">Managed</option>
            <option value="external" selected="@(Model.Type == "external")">External</option>
        </select>
        <span class="mat-toolbar__spacer"></span>
        <span class="mat-toolbar__info" aria-live="polite">@(Model.Rows.Count != Model.TotalCount ? $"{Model.Rows.Count} of {Model.TotalCount} stacks" : $"{Model.Rows.Count} stacks")</span>
        <div class="mat-toolbar__end">
            <div class="mat-btn-group" role="group" aria-label="View">
                <a href="@ViewUrl("gallery")" class="mat-btn mat-btn--sm mat-btn--icon @(isGallery ? "is-active" : "")" aria-current="@(isGallery ? "true" : null)" title="Tiles" aria-label="Tiles"><icon name="grid" /></a>
                <a href="@ViewUrl("list")" class="mat-btn mat-btn--sm mat-btn--icon @(isGallery ? "" : "is-active")" aria-current="@(isGallery ? null : "true")" title="List" aria-label="List"><icon name="list" /></a>
            </div>
        </div>
    </mat-table-toolbar>

    <mat-table-body>
        @if (Model.Rows.Count == 0)
        {
            <div class="mat-empty @(Model.TotalCount > 0 ? "" : "mat-empty--first")">
                <div class="mat-empty__icon"><icon name="layers" /></div>
                <p class="mat-empty__title">@(Model.TotalCount > 0 ? "No stacks match the filter." : "No stacks yet.")</p>
                @if (Model.TotalCount == 0)
                {
                    <a href="/Stacks/Edit" class="mat-btn mat-btn--primary"><icon name="plus" /><span>New stack</span></a>
                }
            </div>
        }
        else if (isGallery)
        {
            <div class="mat-grid md-stacks">
                @foreach (var r in Model.Rows)
                {
                    var app = MatDock.Web.Support.AppView.Parse(r.AppMetaJson);
                    var appPort = app is null ? (int?)null : MatDock.Web.Support.AppView.PrimaryPort(r.Containers);
                    var agg = Agg(r);
                    <details class="mat-card md-stack" open="@(Model.Rows.Count <= 3)">
                        <summary class="mat-card__head md-stack__head">
                            <icon name="chevron-right" class="md-stack__chev" />
                            @if (app?.Icon is not null)
                            {
                                <partial name="_AppIcon" model="app" />
                            }
                            <div class="md-stack__title">
                                <div class="md-stack__name">
                                    <span class="mat-card__title">@r.Name</span>
                                    @if (r.GitBacked)
                                    {
                                        <span class="mat-tag" title="Git-backed"><icon name="git" /> Git</span>
                                    }
                                    @{ var updates = UpdateChecks.Updates(r.EnvId, r.Name); }
                                    @if (updates.Count > 0 && r.ManagedId is { } uid)
                                    {
                                        <a class="mat-pill mat-pill--info" href="/Stacks/Update?id=@uid" title="@string.Join(", ", updates.Select(u => u.Image))">Update</a>
                                    }
                                    <managed-badge value="@r.ManagedBy" />
                                    @if (r.Discovered)
                                    {
                                        <span class="mat-tag" title="Running on the host, not managed by MatDock">External</span>
                                    }
                                </div>
                                <span class="mat-card__sub"><icon name="server" /> @r.EnvName</span>
                            </div>
                            @if (r.Total > 0)
                            {
                                <span class="mat-pill @StatusPill(r)">@r.Running/@r.Total</span>
                            }
                            else
                            {
                                <span class="mat-pill mat-pill--plain">idle</span>
                            }
                        </summary>

                        <div class="mat-card__body mat-stack">
                            @if (agg.Mem is not null)
                            {
                                <usage mem="@agg.Mem" cpu="@agg.Cpu" mem-title="Aggregated RAM across the stack (% of host)" cpu-title="Aggregated CPU across the stack (% of host)" />
                            }
                            @{ await RenderTiles(r); }
                        </div>

                        <div class="mat-card__foot mat-actions md-actions">
                            @if (app is not null)
                            {
                                foreach (var act in app.Actions)
                                {
                                    var href = MatDock.Web.Support.AppView.ActionHref(act, r.EnvHost, appPort);
                                    if (href is not null)
                                    {
                                        var actIcon = !string.IsNullOrEmpty(act.Icon) && Toolkit.Names.Contains(act.Icon) ? act.Icon : "external";
                                        <a class="mat-btn mat-btn--sm mat-btn--primary" href="@href" target="_blank" rel="noopener" title="@act.Name"><icon name="@actIcon" /><span>@act.Name</span></a>
                                    }
                                }
                            }
                            @if (r.Managed && r.ManagedId is { } mid)
                            {
                                <form method="post" asp-page-handler="Deploy" data-confirm="@(r.GitBacked ? $"Fetch stack '{r.Name}' from Git and deploy?" : $"Deploy stack '{r.Name}' now (compose up)?")">
                                    <input type="hidden" name="id" value="@mid" />
                                    <button type="submit" class="mat-btn mat-btn--sm mat-btn--primary" title="@(r.GitBacked ? "Deploy/update from Git" : "Redeploy")"><icon name="@(r.GitBacked ? "git" : "refresh")" /><span>Redeploy</span></button>
                                </form>
                                @if (r.Total > 0 && r.Running < r.Total)
                                {
                                    <form method="post" asp-page-handler="Start">
                                        <input type="hidden" name="id" value="@mid" />
                                        <button type="submit" class="mat-btn mat-btn--sm mat-btn--secondary mat-btn--icon" title="Start (compose start)" aria-label="Start"><icon name="play" /></button>
                                    </form>
                                }
                                @if (r.Running > 0)
                                {
                                    <form method="post" asp-page-handler="Stop" data-confirm="Stop stack '@r.Name' (compose stop)?">
                                        <input type="hidden" name="id" value="@mid" />
                                        <button type="submit" class="mat-btn mat-btn--sm mat-btn--secondary mat-btn--icon" title="Stop (compose stop)" aria-label="Stop"><icon name="stop" /></button>
                                    </form>
                                }
                                <a class="mat-btn mat-btn--secondary mat-btn--sm" href="/Stacks/Edit?id=@mid" title="Edit stack definition"><icon name="edit" /><span>Edit</span></a>
                                <a class="mat-btn mat-btn--secondary mat-btn--sm" href="/Stacks/Update?id=@mid" title="Check for image updates"><icon name="image" /><span>Updates</span></a>
                            }
                            @if (r.Discovered && r.Total > 0 && r.Running < r.Total)
                            {
                                <form method="post" asp-page-handler="ProjectStart">
                                    <input type="hidden" name="envId" value="@r.EnvId" /><input type="hidden" name="project" value="@r.Name" />
                                    <button type="submit" class="mat-btn mat-btn--sm mat-btn--secondary mat-btn--icon" title="Start" aria-label="Start"><icon name="play" /></button>
                                </form>
                            }
                            @if (r.Discovered && r.Running > 0)
                            {
                                <form method="post" asp-page-handler="ProjectStop" data-confirm="Stop stack '@r.Name'?">
                                    <input type="hidden" name="envId" value="@r.EnvId" /><input type="hidden" name="project" value="@r.Name" />
                                    <button type="submit" class="mat-btn mat-btn--sm mat-btn--secondary mat-btn--icon" title="Stop" aria-label="Stop"><icon name="stop" /></button>
                                </form>
                                <form method="post" asp-page-handler="ProjectRestart" data-confirm="Restart stack '@r.Name'?">
                                    <input type="hidden" name="envId" value="@r.EnvId" /><input type="hidden" name="project" value="@r.Name" />
                                    <button type="submit" class="mat-btn mat-btn--sm mat-btn--secondary mat-btn--icon" title="Restart" aria-label="Restart"><icon name="refresh" /></button>
                                </form>
                            }
                            @if (r.Discovered)
                            {
                                <form method="post" asp-page-handler="Adopt" data-confirm="Adopt '@r.Name' into MatDock?">
                                    <input type="hidden" name="envId" value="@r.EnvId" /><input type="hidden" name="project" value="@r.Name" />
                                    <button type="submit" class="mat-btn mat-btn--sm mat-btn--primary" title="Adopt into MatDock (import compose, makes it editable)"><icon name="download" /><span>Adopt</span></button>
                                </form>
                            }
                            <a class="mat-btn mat-btn--secondary mat-btn--sm mat-btn--icon" href="/Containers/Stack?envId=@r.EnvId&project=@Uri.EscapeDataString(r.Name)" title="Containers" aria-label="Containers"><icon name="box" /></a>
                            <a class="mat-btn mat-btn--secondary mat-btn--sm" href="/Volumes?EnvId=@r.EnvId&Q=@Uri.EscapeDataString(r.Name)" title="Volumes of this stack"><icon name="volume" /><span>Volumes</span></a>
                            <form method="post" asp-page-handler="BundleBackup" data-confirm="Back up stack '@r.Name'?">
                                <input type="hidden" name="envId" value="@r.EnvId" />
                                <input type="hidden" name="project" value="@r.Name" />
                                <button type="submit" class="mat-btn mat-btn--secondary mat-btn--sm" title="Full backup (volumes + compose)"><icon name="save" /><span>Backup</span></button>
                            </form>
                            @if (r.Managed && r.ManagedId is { } did)
                            {
                                <span class="mat-btn-row__spacer"></span>
                                <form method="post" asp-page-handler="Down" data-confirm="Remove the containers of '@r.Name'? (compose down)">
                                    <input type="hidden" name="id" value="@did" />
                                    <button type="submit" class="mat-btn mat-btn--sm mat-btn--danger mat-btn--icon" title="Down (stop &amp; remove)" aria-label="Down"><icon name="x-circle" /></button>
                                </form>
                                <form method="post" asp-page-handler="Delete" data-confirm="Remove '@r.Name' from MatDock? Its containers keep running.">
                                    <input type="hidden" name="id" value="@did" />
                                    <button type="submit" class="mat-btn mat-btn--sm mat-btn--danger mat-btn--icon" title="Remove from MatDock" aria-label="Remove from MatDock"><icon name="trash" /></button>
                                </form>
                            }
                        </div>
                    </details>
                }
            </div>
        }
        else
        {
            <div class="mat-table-wrap">
                <table class="mat-table">
                    <thead>
                        <tr><th>Environment</th><th>Name</th><th>Source</th><th>Status</th><th class="mat-num">Containers</th><th class="mat-num">Volumes</th><th>Resources</th><th class="mat-table__cell-actions"><span class="mat-sr-only">Actions</span></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.Rows)
                        {
                            var agg = Agg(r);
                            <tr>
                                <td data-label="Environment">@r.EnvName</td>
                                <td data-label="Name">
                                    <div class="mat-table__name">
                                        <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm md-row-toggle" data-toggle-row aria-expanded="false" aria-label="Show the containers of @r.Name"><icon name="chevron-right" /></button>
                                        @if (r.Managed && r.ManagedId is { } mid)
                                        {
                                            <a href="/Stacks/Edit?id=@mid">@r.Name</a>
                                        }
                                        else
                                        {
                                            <span>@r.Name</span>
                                        }
                                        @{ var updates = UpdateChecks.Updates(r.EnvId, r.Name); }
                                        @if (updates.Count > 0 && r.ManagedId is { } uid)
                                        {
                                            <a class="mat-pill mat-pill--info" href="/Stacks/Update?id=@uid" title="@string.Join(", ", updates.Select(u => u.Image))">Update</a>
                                        }
                                        <managed-badge value="@r.ManagedBy" />
                                    </div>
                                </td>
                                <td data-label="Source">
                                    @if (r.Discovered)
                                    {
                                        <span class="mat-tag" title="Running on the host, not managed by MatDock">External</span>
                                    }
                                    else if (r.GitBacked)
                                    {
                                        <span class="mat-tag" title="Git-backed"><icon name="git" /> Git</span>
                                    }
                                    else
                                    {
                                        <span class="mat-muted">Managed</span>
                                    }
                                </td>
                                <td data-label="Status">
                                    @if (r.Total > 0)
                                    {
                                        var sb = StatusBadge(r);
                                        <span class="mat-pill @sb.Cls">@sb.Label</span>
                                    }
                                    else if (r.Managed)
                                    {
                                        <span class="mat-muted">@(r.LastStatus ?? "idle")</span>
                                    }
                                    else
                                    {
                                        <span class="mat-muted">–</span>
                                    }
                                </td>
                                <td class="mat-num" data-label="Containers"><a href="/Containers/Stack?envId=@r.EnvId&project=@Uri.EscapeDataString(r.Name)" title="Containers of this stack">@r.Containers.Count</a></td>
                                <td class="mat-num" data-label="Volumes"><a href="/Volumes?EnvId=@r.EnvId&Q=@Uri.EscapeDataString(r.Name)" title="Volumes of this stack">@r.VolumeCount</a></td>
                                <td data-label="Resources"><usage mem="@agg.Mem" cpu="@agg.Cpu" mem-title="Aggregated RAM across the stack (% of host)" cpu-title="Aggregated CPU across the stack (% of host)" /></td>
                                <td class="mat-table__cell-actions md-cell-wrap">
                                    <div class="mat-table__actions md-actions-wrap">
                                        @if (r.Managed && r.ManagedId is { } id)
                                        {
                                            <form method="post" asp-page-handler="Deploy" data-confirm="@(r.GitBacked ? $"Fetch stack '{r.Name}' from Git and deploy?" : $"Deploy stack '{r.Name}' now (compose up)?")">
                                                <input type="hidden" name="id" value="@id" />
                                                <button type="submit" class="mat-btn mat-btn--sm mat-btn--primary mat-btn--icon" title="@(r.GitBacked ? "Deploy/update from Git" : "Redeploy")" aria-label="Redeploy"><icon name="@(r.GitBacked ? "git" : "refresh")" /></button>
                                            </form>
                                            @if (r.Total > 0 && r.Running < r.Total)
                                            {
                                                <form method="post" asp-page-handler="Start">
                                                    <input type="hidden" name="id" value="@id" />
                                                    <button type="submit" class="mat-btn mat-btn--sm mat-btn--ghost mat-btn--icon" title="Start (compose start)" aria-label="Start"><icon name="play" /></button>
                                                </form>
                                            }
                                            @if (r.Running > 0)
                                            {
                                                <form method="post" asp-page-handler="Stop" data-confirm="Stop stack '@r.Name' (compose stop)?">
                                                    <input type="hidden" name="id" value="@id" />
                                                    <button type="submit" class="mat-btn mat-btn--sm mat-btn--ghost mat-btn--icon" title="Stop (compose stop)" aria-label="Stop"><icon name="stop" /></button>
                                                </form>
                                            }
                                            <a class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" href="/Stacks/Edit?id=@id" title="Edit stack definition" aria-label="Edit"><icon name="edit" /></a>
                                            <a class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" href="/Stacks/Update?id=@id" title="Check for image updates" aria-label="Updates"><icon name="image" /></a>
                                            <a class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" href="/Containers/Stack?envId=@r.EnvId&project=@Uri.EscapeDataString(r.Name)" title="Containers" aria-label="Containers"><icon name="box" /></a>
                                            <a class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" href="/Volumes?EnvId=@r.EnvId&Q=@Uri.EscapeDataString(r.Name)" title="Volumes of this stack" aria-label="Volumes"><icon name="volume" /></a>
                                            <form method="post" asp-page-handler="Down" data-confirm="Remove the containers of '@r.Name'? (compose down)">
                                                <input type="hidden" name="id" value="@id" />
                                                <button type="submit" class="mat-btn mat-btn--sm mat-btn--danger mat-btn--icon" title="Down (stop &amp; remove)" aria-label="Down"><icon name="x-circle" /></button>
                                            </form>
                                            <form method="post" asp-page-handler="Delete" data-confirm="Remove '@r.Name' from MatDock? Its containers keep running.">
                                                <input type="hidden" name="id" value="@id" />
                                                <button type="submit" class="mat-btn mat-btn--sm mat-btn--danger mat-btn--icon" title="Remove from MatDock" aria-label="Remove from MatDock"><icon name="trash" /></button>
                                            </form>
                                        }
                                        else
                                        {
                                            @if (r.Total > 0 && r.Running < r.Total)
                                            {
                                                <form method="post" asp-page-handler="ProjectStart">
                                                    <input type="hidden" name="envId" value="@r.EnvId" /><input type="hidden" name="project" value="@r.Name" />
                                                    <button type="submit" class="mat-btn mat-btn--sm mat-btn--ghost mat-btn--icon" title="Start" aria-label="Start"><icon name="play" /></button>
                                                </form>
                                            }
                                            @if (r.Running > 0)
                                            {
                                                <form method="post" asp-page-handler="ProjectStop" data-confirm="Stop stack '@r.Name'?">
                                                    <input type="hidden" name="envId" value="@r.EnvId" /><input type="hidden" name="project" value="@r.Name" />
                                                    <button type="submit" class="mat-btn mat-btn--sm mat-btn--ghost mat-btn--icon" title="Stop" aria-label="Stop"><icon name="stop" /></button>
                                                </form>
                                                <form method="post" asp-page-handler="ProjectRestart" data-confirm="Restart stack '@r.Name'?">
                                                    <input type="hidden" name="envId" value="@r.EnvId" /><input type="hidden" name="project" value="@r.Name" />
                                                    <button type="submit" class="mat-btn mat-btn--sm mat-btn--ghost mat-btn--icon" title="Restart" aria-label="Restart"><icon name="refresh" /></button>
                                                </form>
                                            }
                                            <form method="post" asp-page-handler="Adopt" data-confirm="Adopt '@r.Name' into MatDock?">
                                                <input type="hidden" name="envId" value="@r.EnvId" /><input type="hidden" name="project" value="@r.Name" />
                                                <button type="submit" class="mat-btn mat-btn--sm mat-btn--primary mat-btn--icon" title="Adopt into MatDock (import compose, makes it editable)" aria-label="Adopt"><icon name="download" /></button>
                                            </form>
                                            <a class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" href="/Containers/Stack?envId=@r.EnvId&project=@Uri.EscapeDataString(r.Name)" title="Containers" aria-label="Containers"><icon name="box" /></a>
                                            <a class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" href="/Volumes?EnvId=@r.EnvId&Q=@Uri.EscapeDataString(r.Name)" title="Volumes of this stack" aria-label="Volumes"><icon name="volume" /></a>
                                        }
                                    </div>
                                </td>
                            </tr>
                            <tr class="md-stack-detail" hidden>
                                <td colspan="8">@{ await RenderTiles(r); }</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </mat-table-body>

    <mat-table-actions>
        <a href="/Stacks/Edit" class="mat-btn mat-btn--primary"><icon name="plus" /><span>New stack</span></a>
        <a href="@ViewUrl(Model.View)" class="mat-btn mat-btn--secondary"><icon name="refresh" /><span>Refresh</span></a>
    </mat-table-actions>
</mat-table>
