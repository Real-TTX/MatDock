@page
@model MatDock.Web.Pages.Stacks.IndexModel
@{
    ViewData["Title"] = "Stacks";
}

<div class="page-head">
    <div class="page-head__title">
        <h1>Stacks</h1>
        <span class="page-head__subtitle">Compose-Stacks verwalten &amp; deployen</span>
    </div>
    <div class="mat-buttons">
        <a href="/Stacks/Edit" class="mat-btn mat-btn--primary"><icon name="plus" /><span>Neuer Stack</span></a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert @(Model.IsError ? "alert--error" : "alert--success")">
        <icon name="@(Model.IsError ? "x-circle" : "check-circle")" /><span>@Model.StatusMessage</span>
    </div>
}
@if (!string.IsNullOrEmpty(Model.Output))
{
    <pre style="background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:12px;overflow:auto;max-height:320px;font-family:var(--mono);font-size:.8rem;white-space:pre-wrap;word-break:break-word;margin-bottom:16px;">@Model.Output</pre>
}

<div class="card" style="padding:0;">
    <table class="data">
        <thead>
            <tr><th>Name</th><th>Environment</th><th>Zuletzt deployt</th><th>Status</th><th class="actions">Aktionen</th></tr>
        </thead>
        <tbody>
            @if (Model.Stacks.Count == 0)
            {
                <tr><td colspan="5"><div class="empty-state"><div><icon name="box" /></div><p>Noch keine Stacks. Lege einen an, um Compose-Dienste zu deployen.</p></div></td></tr>
            }
            @foreach (var s in Model.Stacks)
            {
                <tr>
                    <td>
                        <a href="/Stacks/Edit?id=@s.Id"><strong>@s.Name</strong></a>
                        @if (s.IsGitBacked)
                        {
                            <span class="pill" title="@s.GitRepoUrl" style="margin-left:6px;"><icon name="git" /> Git</span>
                        }
                    </td>
                    <td>@(Model.EnvNames.TryGetValue(s.EnvironmentId, out var n) ? n : $"#{s.EnvironmentId}")</td>
                    <td class="text-muted nowrap">@(s.LastDeployedAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "–")</td>
                    <td class="cell-sub">@(s.LastStatus ?? "–")</td>
                    <td class="actions">
                        <div class="row-actions">
                            <form method="post" asp-page-handler="Deploy" data-confirm="@(s.IsGitBacked ? $"Stack „{s.Name}“ aus Git holen und deployen?" : $"Stack „{s.Name}“ jetzt deployen (compose up)?")" style="display:inline;">
                                <input type="hidden" name="id" value="@s.Id" />
                                <button type="submit" class="mat-btn mat-btn--sm mat-btn--primary" title="@(s.IsGitBacked ? "Aus Git deployen/aktualisieren" : "Deployen")"><icon name="@(s.IsGitBacked ? "git" : "check-circle")" /><span>@(s.IsGitBacked ? "Git-Deploy" : "Deploy")</span></button>
                            </form>
                            <form method="post" asp-page-handler="Down" data-confirm="Stack „@s.Name“ stoppen (compose down)?" style="display:inline;">
                                <input type="hidden" name="id" value="@s.Id" />
                                <button type="submit" class="mat-btn mat-btn--sm" title="Stoppen"><icon name="x-circle" /></button>
                            </form>
                            <a class="mat-btn mat-btn--sm" href="/Stacks/Edit?id=@s.Id" title="Bearbeiten"><icon name="edit" /></a>
                            <a class="mat-btn mat-btn--sm" href="/Containers/Stack?envId=@s.EnvironmentId&project=@Uri.EscapeDataString(s.Name)" title="Container"><icon name="box" /></a>
                            <span style="width:8px;display:inline-block;"></span>
                            <form method="post" asp-page-handler="Delete" data-confirm="Stack „@s.Name“ aus MatDock löschen? (Container werden nicht gestoppt)" style="display:inline;">
                                <input type="hidden" name="id" value="@s.Id" />
                                <button type="submit" class="mat-btn mat-btn--sm mat-btn--danger" title="Löschen"><icon name="trash" /></button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
