@page
@model MatDock.Web.Pages.Stacks.IndexModel
@{
    ViewData["Title"] = "Stacks";
    var isGallery = !string.Equals(Model.View, "list", StringComparison.OrdinalIgnoreCase);

    string ViewUrl(string v) => $"/Stacks?view={v}"
        + $"&Q={Uri.EscapeDataString(Model.Q ?? string.Empty)}"
        + $"&Status={Uri.EscapeDataString(Model.Status ?? string.Empty)}"
        + $"&Type={Uri.EscapeDataString(Model.Type ?? string.Empty)}";

    string StatusPill(MatDock.Web.Pages.Stacks.IndexModel.StackRow r)
        => r.StatusKind switch { "running" => "pill--online", "partial" => "pill--offline", _ => "pill--unknown" };

    var ci = System.Globalization.CultureInfo.InvariantCulture;
    string Pct(double v) => Math.Clamp(v, 0, 100).ToString(ci);

    (double Cpu, double Mem, bool Any) Agg(MatDock.Web.Pages.Stacks.IndexModel.StackRow r)
    {
        double cpu = 0, mem = 0; bool any = false;
        foreach (var c in r.Containers)
        {
            if (c.CpuPercent is { } cv) { cpu += cv; any = true; }
            if (c.MemPercent is { } mv) { mem += mv; any = true; }
        }
        return (cpu, mem, any);
    }

    // Aggregated CPU/RAM across a stack's containers (sum of per-container % of host).
    void AggResources(MatDock.Web.Pages.Stacks.IndexModel.StackRow r)
    {
        var a = Agg(r);
        if (!a.Any)
        {
            <span class="text-muted">–</span>
            return;
        }
        <div class="res">
            <div class="res__row" title="Aggregated RAM across the stack (% of host)">
                <span class="res__k">RAM</span>
                <span class="ubar"><span class="ubar__fill" style="width:@(Pct(a.Mem))%"></span></span>
                <span class="res__v">@(Math.Round(a.Mem).ToString(ci))%</span>
            </div>
            <div class="res__row" title="Aggregated CPU across the stack (% of host)">
                <span class="res__k">CPU</span>
                <span class="ubar"><span class="ubar__fill" style="width:@(Pct(a.Cpu))%"></span></span>
                <span class="res__v">@(a.Cpu.ToString("0.0", ci))%</span>
            </div>
        </div>
    }

    // Container tiles for an expanded stack (shared by the gallery cards and the list detail rows).
    async Task RenderTiles(MatDock.Web.Pages.Stacks.IndexModel.StackRow r)
    {
        if (r.Containers.Count == 0)
        {
            <div class="text-muted" style="font-size:.85rem;padding:2px;">No containers running for this stack.</div>
        }
        else
        {
            <div class="ctile-grid">
                @foreach (var c in r.Containers)
                {
                    <div class="ctile">
                        <div class="ctile__top">
                            <a class="ctile__name" href="/Containers/ContainerDetail?envId=@r.EnvId&id=@Uri.EscapeDataString(c.Id)" title="@(string.IsNullOrEmpty(c.Service) ? c.Name : c.Service)">@(string.IsNullOrEmpty(c.Service) ? c.Name : c.Service)</a>
                            <container-status state="@c.State" status="@c.Status" />
                        </div>
                        <div class="ctile__img">@c.Image</div>
                        <div class="ctile__meta"><container-ports ports="@c.Ports" host="@r.EnvHost" /></div>
                        <div class="ctile__actions">
                            <a class="mat-btn mat-btn--sm" href="/Containers/Logs?EnvId=@r.EnvId&id=@Uri.EscapeDataString(c.Id)" title="Logs"><icon name="eye" /></a>
                            @if (c.IsRunning)
                            {
                                @if (User.IsInRole("Admin"))
                                {
                                    <a class="mat-btn mat-btn--sm" href="/Terminal?envId=@r.EnvId&container=@Uri.EscapeDataString(c.Id)&name=@Uri.EscapeDataString(c.Name)" title="Shell"><icon name="terminal" /></a>
                                }
                                <form method="post" asp-page-handler="ContainerAction" style="display:inline;">
                                    <input type="hidden" name="envId" value="@r.EnvId" /><input type="hidden" name="id" value="@c.Id" /><input type="hidden" name="action" value="Restart" />
                                    <button type="submit" class="mat-btn mat-btn--sm" title="Restart"><icon name="refresh" /></button>
                                </form>
                                <form method="post" asp-page-handler="ContainerAction" data-confirm="Stop container '@c.Name'?" style="display:inline;">
                                    <input type="hidden" name="envId" value="@r.EnvId" /><input type="hidden" name="id" value="@c.Id" /><input type="hidden" name="action" value="Stop" />
                                    <button type="submit" class="mat-btn mat-btn--sm mat-btn--danger" title="Stop"><icon name="stop" /></button>
                                </form>
                            }
                            else
                            {
                                <form method="post" asp-page-handler="ContainerAction" style="display:inline;">
                                    <input type="hidden" name="envId" value="@r.EnvId" /><input type="hidden" name="id" value="@c.Id" /><input type="hidden" name="action" value="Start" />
                                    <button type="submit" class="mat-btn mat-btn--sm mat-btn--primary" title="Start"><icon name="play" /></button>
                                </form>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    }
}

<div class="page-head">
    <div class="page-head__title">
        <h1>Stacks</h1>
        <span class="page-head__subtitle">Managed &amp; discovered Compose stacks</span>
    </div>
    <div class="mat-buttons">
        <a href="/Stacks/Edit" class="mat-btn mat-btn--primary"><icon name="plus" /><span>New Stack</span></a>
        <a href="/Stacks/Edit?source=git" class="mat-btn"><icon name="git" /><span>From Git</span></a>
        <a href="/Apps" class="mat-btn"><icon name="template" /><span>From App</span></a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert @(Model.IsError ? "alert--error" : "alert--success")">
        <icon name="@(Model.IsError ? "x-circle" : "check-circle")" /><span>@Model.StatusMessage</span>
    </div>
}
@if (!string.IsNullOrEmpty(Model.Output))
{
    <pre style="background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:12px;overflow:auto;max-height:320px;font-family:var(--mono);font-size:.8rem;white-space:pre-wrap;word-break:break-word;margin-bottom:16px;">@Model.Output</pre>
}
@foreach (var err in Model.LoadErrors)
{
    <div class="alert alert--error"><icon name="x-circle" /><span>@err</span></div>
}

<mat-table>
    <mat-table-toolbar>
        <form method="get" class="js-autosubmit" style="display:contents;">
            <input type="hidden" name="view" value="@Model.View" />
            <div class="search">
                <icon name="search" />
                <input type="search" name="Q" value="@Model.Q" class="mat-input" placeholder="Search (name, environment)…" />
            </div>
            <div class="toolbar-field">
                <label for="filter-status"><icon name="filter" /></label>
                <select id="filter-status" name="Status" class="mat-select">
                    <option value="">All statuses</option>
                    <option value="running" selected="@(Model.Status == "running")">Running</option>
                    <option value="partial" selected="@(Model.Status == "partial")">Partial</option>
                    <option value="stopped" selected="@(Model.Status == "stopped")">Stopped</option>
                </select>
            </div>
            <div class="toolbar-field">
                <label for="filter-type">Type</label>
                <select id="filter-type" name="Type" class="mat-select">
                    <option value="">All</option>
                    <option value="managed" selected="@(Model.Type == "managed")">Managed</option>
                    <option value="external" selected="@(Model.Type == "external")">External</option>
                </select>
            </div>
        </form>
        <span class="text-muted" style="font-size:.85rem;margin-left:6px;"><strong>@Model.Rows.Count</strong>@(Model.Rows.Count != Model.TotalCount ? $" / {Model.TotalCount}" : "")</span>
        <div class="view-toggle" role="group" aria-label="View" style="margin-left:auto;">
            <a href="@ViewUrl("gallery")" class="@(isGallery ? "is-active" : "")"><icon name="dashboard" /><span>Tiles</span></a>
            <a href="@ViewUrl("list")" class="@(isGallery ? "" : "is-active")"><icon name="menu" /><span>List</span></a>
        </div>
    </mat-table-toolbar>

    <mat-table-body>
        @if (Model.Rows.Count == 0)
        {
            <div class="empty-state">
                <div><icon name="layers" /></div>
                <p>No stacks. Create one or select an environment with Compose projects.</p>
            </div>
        }
        else if (isGallery)
        {
            <div class="stack-grid">
                @foreach (var r in Model.Rows)
                {
                    var app = MatDock.Web.Support.AppView.Parse(r.AppMetaJson);
                    var appPort = app is null ? (int?)null : MatDock.Web.Support.AppView.PrimaryPort(r.Containers);
                    <details class="stack-card" open="@(Model.Rows.Count <= 3)">
                        <summary class="stack-card__head">
                            <span class="stack-card__chev"><icon name="chevron-right" /></span>
                            @if (app?.Icon is not null)
                            {
                                <partial name="_AppIcon" model="app" />
                            }
                            <div class="stack-card__title">
                                <div class="stack-card__name">
                                    @r.Name
                                    @if (r.GitBacked)
                                    {
                                        <span class="pill" title="Git-backed"><icon name="git" /> Git</span>
                                    }
                                    @if (r.Discovered)
                                    {
                                        <span class="mat-badge" title="Running on the host, not managed by MatDock">External</span>
                                    }
                                </div>
                                <div class="stack-card__env"><icon name="server" /> @r.EnvName</div>
                            </div>
                            @if (r.Total > 0)
                            {
                                <span class="pill @StatusPill(r)">@r.Running/@r.Total</span>
                            }
                            else
                            {
                                <span class="pill pill--unknown">idle</span>
                            }
                        </summary>

                        <div class="stack-card__body">
                            <div style="margin:2px 0 10px;">@{ AggResources(r); }</div>
                            @{ await RenderTiles(r); }

                            <div class="stack-card__actions">
                                @if (app is not null)
                                {
                                    foreach (var act in app.Actions)
                                    {
                                        var href = MatDock.Web.Support.AppView.ActionHref(act, r.EnvHost, appPort);
                                        if (href is not null)
                                        {
                                            <a class="mat-btn mat-btn--sm mat-btn--primary" href="@href" target="_blank" rel="noopener" title="@act.Name"><icon name="@(string.IsNullOrEmpty(act.Icon) ? "external" : act.Icon)" /><span>@act.Name</span></a>
                                        }
                                    }
                                }
                                @if (r.Managed && r.ManagedId is { } mid)
                                {
                                    <form method="post" asp-page-handler="Deploy" data-confirm="@(r.GitBacked ? $"Fetch stack '{r.Name}' from Git and deploy?" : $"Deploy stack '{r.Name}' now (compose up)?")" style="display:inline;">
                                        <input type="hidden" name="id" value="@mid" />
                                        <button type="submit" class="mat-btn mat-btn--sm mat-btn--primary" title="@(r.GitBacked ? "Deploy/update from Git" : "Redeploy")"><icon name="@(r.GitBacked ? "git" : "refresh")" /><span>Redeploy</span></button>
                                    </form>
                                    <form method="post" asp-page-handler="Down" data-confirm="Stop stack '@r.Name' (compose down)?" style="display:inline;">
                                        <input type="hidden" name="id" value="@mid" />
                                        <button type="submit" class="mat-btn mat-btn--sm" title="Stop"><icon name="x-circle" /></button>
                                    </form>
                                    <a class="mat-btn mat-btn--sm" href="/Stacks/Edit?id=@mid" title="Open (edit definition)"><icon name="external" /><span>Open</span></a>
                                }
                                <a class="mat-btn mat-btn--sm" href="/Containers/Stack?envId=@r.EnvId&project=@Uri.EscapeDataString(r.Name)" title="Containers"><icon name="box" /></a>
                                <a class="mat-btn mat-btn--sm" href="/Volumes?EnvId=@r.EnvId&Q=@Uri.EscapeDataString(r.Name)" title="Volumes of this stack"><icon name="volume" /><span>Volumes</span></a>
                                <form method="post" asp-page-handler="BundleBackup" data-confirm="Full backup of '@r.Name' (all volumes + compose + image refs) to the default target?" style="display:inline;">
                                    <input type="hidden" name="envId" value="@r.EnvId" />
                                    <input type="hidden" name="project" value="@r.Name" />
                                    <button type="submit" class="mat-btn mat-btn--sm" title="Full backup (volumes + compose)"><icon name="save" /><span>Backup</span></button>
                                </form>
                                <span style="flex:1 1 auto;"></span>
                                @if (r.Managed && r.ManagedId is { } did)
                                {
                                    <form method="post" asp-page-handler="Delete" data-confirm="Delete stack '@r.Name' from MatDock? (Containers will not be stopped)" style="display:inline;">
                                        <input type="hidden" name="id" value="@did" />
                                        <button type="submit" class="mat-btn mat-btn--sm mat-btn--danger" title="Delete"><icon name="trash" /></button>
                                    </form>
                                }
                            </div>
                        </div>
                    </details>
                }
            </div>
        }
        else
        {
            <table class="data">
                <thead>
                    <tr><th>Name</th><th>Environment</th><th>Status</th><th>Resources</th><th>Last deployed</th><th class="actions">Actions</th></tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Rows)
                    {
                        <tr>
                            <td>
                                <button type="button" class="stack-toggle" onclick="matdockToggleRow(this)" aria-label="Expand containers"><icon name="chevron-right" /></button>
                                @if (r.Managed && r.ManagedId is { } mid)
                                {
                                    <a href="/Stacks/Edit?id=@mid"><strong>@r.Name</strong></a>
                                }
                                else
                                {
                                    <strong>@r.Name</strong>
                                }
                                @if (r.GitBacked)
                                {
                                    <span class="pill" title="Git-backed" style="margin-left:6px;"><icon name="git" /> Git</span>
                                }
                                @if (r.Discovered)
                                {
                                    <span class="mat-badge" title="Running on the host, not managed by MatDock" style="margin-left:6px;">External</span>
                                }
                            </td>
                            <td>@r.EnvName</td>
                            <td>
                                @if (r.Total > 0)
                                {
                                    <span class="pill @StatusPill(r)">@r.Running/@r.Total running</span>
                                }
                                else if (r.Managed)
                                {
                                    <span class="cell-sub">@(r.LastStatus ?? "–")</span>
                                }
                                else
                                {
                                    <span class="text-muted">–</span>
                                }
                            </td>
                            <td class="res-cell">@{ AggResources(r); }</td>
                            <td class="text-muted nowrap">@(r.LastDeployedAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "–")</td>
                            <td class="actions">
                                <div class="row-actions">
                                    @if (r.Managed && r.ManagedId is { } id)
                                    {
                                        <form method="post" asp-page-handler="Deploy" data-confirm="@(r.GitBacked ? $"Fetch stack '{r.Name}' from Git and deploy?" : $"Deploy stack '{r.Name}' now (compose up)?")" style="display:inline;">
                                            <input type="hidden" name="id" value="@id" />
                                            <button type="submit" class="mat-btn mat-btn--sm mat-btn--primary" title="@(r.GitBacked ? "Deploy/update from Git" : "Redeploy")"><icon name="@(r.GitBacked ? "git" : "refresh")" /></button>
                                        </form>
                                        <form method="post" asp-page-handler="Down" data-confirm="Stop stack '@r.Name' (compose down)?" style="display:inline;">
                                            <input type="hidden" name="id" value="@id" />
                                            <button type="submit" class="mat-btn mat-btn--sm" title="Stop"><icon name="stop" /></button>
                                        </form>
                                        <a class="mat-btn mat-btn--sm" href="/Stacks/Edit?id=@id" title="Open (edit definition)"><icon name="external" /></a>
                                        <a class="mat-btn mat-btn--sm" href="/Containers/Stack?envId=@r.EnvId&project=@Uri.EscapeDataString(r.Name)" title="Containers"><icon name="box" /></a>
                                        <a class="mat-btn mat-btn--sm" href="/Volumes?EnvId=@r.EnvId&Q=@Uri.EscapeDataString(r.Name)" title="Volumes of this stack"><icon name="volume" /></a>
                                        <span style="width:8px;display:inline-block;"></span>
                                        <form method="post" asp-page-handler="Delete" data-confirm="Delete stack '@r.Name' from MatDock? (Containers will not be stopped)" style="display:inline;">
                                            <input type="hidden" name="id" value="@id" />
                                            <button type="submit" class="mat-btn mat-btn--sm mat-btn--danger" title="Delete"><icon name="trash" /></button>
                                        </form>
                                    }
                                    else
                                    {
                                        <a class="mat-btn mat-btn--sm" href="/Containers/Stack?envId=@r.EnvId&project=@Uri.EscapeDataString(r.Name)" title="Containers"><icon name="box" /></a>
                                        <a class="mat-btn mat-btn--sm" href="/Volumes?EnvId=@r.EnvId&Q=@Uri.EscapeDataString(r.Name)" title="Volumes of this stack"><icon name="volume" /></a>
                                    }
                                </div>
                            </td>
                        </tr>
                        <tr class="stack-detail" hidden>
                            <td colspan="6">@{ await RenderTiles(r); }</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </mat-table-body>

    <mat-table-actions>
        <a href="/Stacks/Edit" class="mat-btn mat-btn--primary"><icon name="plus" /><span>New Stack</span></a>
        <a href="@ViewUrl(Model.View)" class="mat-btn"><icon name="refresh" /><span>Refresh</span></a>
    </mat-table-actions>
</mat-table>
