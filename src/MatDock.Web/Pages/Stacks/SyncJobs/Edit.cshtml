@page
@model MatDock.Web.Pages.Stacks.SyncJobs.EditModel
@{
    ViewData["Title"] = Model.IsEdit ? "Edit sync job" : "New sync job";
    ViewData["Crumbs"] = new List<(string Text, string? Url)> { ("Sync jobs", "/Stacks/SyncJobs") };
}

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="u-maxw-lg mat-alert mat-alert--success"><icon name="check-circle" /><span>@Model.StatusMessage</span></div>
}

<form method="post" class="u-maxw-lg mat-form">
    <input type="hidden" asp-for="Input.Id" />
    <partial name="_ValidationSummary" />

    <div class="mat-mb-4 mat-card">
        <div class="mat-card__head"><icon name="git" /><span>Repository</span></div>
        <div class="mat-card__body">
            @if (Model.SavedRepos.Count > 0)
            {
                <mat-field label="Saved repository (optional)">
                    <select id="repo-picker" class="mat-select">
                        <option value="">— manual entry —</option>
                        @foreach (var r in Model.SavedRepos)
                        {
                            <option value="@r.Id" data-url="@r.Url" data-ref="@r.Reference" data-cred="@r.GitCredentialId">@r.Name</option>
                        }
                    </select>
                </mat-field>
            }
            <mat-field label="Name" asp-for="Input.Name">
                <input asp-for="Input.Name" class="mat-input" placeholder="e.g. prod apps" />
            </mat-field>
            <div class="mat-form__grid">
                <mat-field label="Git repository URL" asp-for="Input.GitRepoUrl">
                    <input asp-for="Input.GitRepoUrl" class="mat-input" placeholder="https://github.com/org/repo.git" />
                </mat-field>
                <mat-field label="Branch / tag (optional)" asp-for="Input.GitReference">
                    <input asp-for="Input.GitReference" class="mat-input" placeholder="main" />
                </mat-field>
                <mat-field label="Subdirectory (optional)" asp-for="Input.Subdirectory">
                    <input asp-for="Input.Subdirectory" class="mat-input" placeholder="stacks" />
                </mat-field>
                <mat-field label="Credentials (private repos)" asp-for="Input.GitCredentialId">
                    <select asp-for="Input.GitCredentialId" class="mat-select">
                        <option value="">— none (public) —</option>
                        @foreach (var c in Model.Credentials)
                        {
                            <option value="@c.Id">@c.Name</option>
                        }
                    </select>
                </mat-field>
            </div>
            <div style="display:flex;gap:8px;align-items:center;">
                <button type="submit" asp-page-handler="Scan" class="mat-btn mat-btn--secondary" formnovalidate>
                    <icon name="refresh" /><span>Scan repository</span>
                </button>
                @if (Model.ScanError is not null)
                {
                    <span class="mat-error">@Model.ScanError</span>
                }
                else if (Model.ScannedCount >= 0)
                {
                    <span class="mat-hint">Found @Model.ScannedCount compose file(s).</span>
                }
            </div>
        </div>
    </div>

    <div class="mat-mb-4 mat-card">
        <div class="mat-card__head"><icon name="clock" /><span>Triggers</span></div>
        <div class="mat-card__body">
            <div class="mat-switches">
                <label class="mat-switch">
                    <input asp-for="Input.ScheduleEnabled" type="checkbox" />
                    <span class="mat-switch__track"></span>
                    <span class="">Scheduled</span>
                </label>
                <div data-show-when="Input_ScheduleEnabled=true">
                    <mat-field label="Cron (UTC)" asp-for="Input.Cron">
                        <input asp-for="Input.Cron" class="mat-input" placeholder="0 4 * * *" />
                    </mat-field>
                </div>
                <label class="mat-switch">
                    <input asp-for="Input.WebhookEnabled" type="checkbox" />
                    <span class="mat-switch__track"></span>
                    <span class="">Webhook</span>
                </label>
            </div>
            @if (Model.IsEdit)
            {
                <div style="margin-top:6px;">
                    <button type="submit" asp-page-handler="RunNow" name="id" value="@Model.Input.Id" class="mat-btn mat-btn--secondary" formnovalidate>
                        <icon name="refresh" /><span>Sync now</span>
                    </button>
                </div>
            }
        </div>
    </div>

    <div class="mat-mb-4 mat-card">
        <div class="mat-card__head"><icon name="settings" /><span>Deploy behavior</span></div>
        <div class="mat-card__body">
            <div class="mat-switches">
                <label class="mat-switch">
                    <input asp-for="Input.OnlyOnChange" type="checkbox" />
                    <span class="mat-switch__track"></span>
                    <span class="">Only deploy on change</span>
                </label>
                <label class="mat-switch">
                    <input asp-for="Input.PullImages" type="checkbox" />
                    <span class="mat-switch__track"></span>
                    <span class="">Pull images before deploy</span>
                </label>
                <label class="mat-switch">
                    <input asp-for="Input.PruneRemoved" type="checkbox" />
                    <span class="mat-switch__track"></span>
                    <span class="">Prune removed / deselected stacks</span>
                </label>
            </div>
        </div>
    </div>

    <div class="mat-mb-4 mat-card">
        <div class="mat-card__head"><icon name="layers" /><span>Compose files → environments</span></div>
        <div class="mat-card__body">
            @if (Model.Input.Rows.Count == 0)
            {
                <div class="mat-empty">
                    <div><icon name="git" /></div>
                    <p>Scan the repository to list its compose files.</p>
                </div>
            }
            else if (Model.Environments.Count == 0)
            {
                <div class="mat-alert mat-alert--warning"><icon name="alert" /><div class="mat-alert__body">No environments available — create one first.</div></div>
            }
            else
            {
                <div class="mat-table-wrap">
                    <table class="mat-table">
                        <thead>
                            <tr><th>Compose file</th><th>Stack name</th><th>Environments</th></tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Input.Rows.Count; i++)
                            {
                                var row = Model.Input.Rows[i];
                                <tr>
                                    <td class="mat-text-wrap">
                                        <span class="mat-mono">@row.ComposePath</span>
                                        @if (!row.InRepo)
                                        {
                                            <span class="tag-unused" title="No longer in the repo">removed</span>
                                        }
                                        <input type="hidden" name="Input.Rows[@i].ComposePath" value="@row.ComposePath" />
                                    </td>
                                    <td>
                                        <input name="Input.Rows[@i].StackName" value="@row.StackName" class="mat-input" style="min-width:150px;" />
                                    </td>
                                    <td>
                                        <div style="display:flex;flex-wrap:wrap;gap:10px;">
                                            @foreach (var env in Model.Environments)
                                            {
                                                <label class="mat-check">
                                                    <input type="checkbox" name="Input.Rows[@i].EnvironmentIds" value="@env.Id"
                                                           checked="@row.EnvironmentIds.Contains(env.Id)" />
                                                    <span>@env.Name</span>
                                                </label>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <mat-form-buttons>
        <button type="submit" asp-page-handler="Save" class="mat-btn mat-btn--primary"><icon name="save" /><span>Save</span></button>
        <a href="/Stacks/SyncJobs" class="mat-btn mat-btn--ghost"><icon name="back" /><span>Back</span></a>
        @if (Model.IsEdit)
        {
            <span class="mat-btn-row__spacer"></span>
            <button type="submit" form="delete-form" class="mat-btn mat-btn--danger" data-confirm="Delete sync job '@Model.Input.Name'? Its stacks keep running."><icon name="trash" /><span>Delete</span></button>
        }
    </mat-form-buttons>
</form>
@if (Model.IsEdit)
{
    <form method="post" asp-page-handler="Delete" id="delete-form"><input type="hidden" name="id" value="@Model.Input.Id" /></form>
}

@if (Model.IsEdit && Model.WebhookUrl is not null)
{
    <div class="mat-mt-4 u-maxw-lg mat-card">
        <div class="mat-card__head"><icon name="plug" /><span>Webhook</span></div>
        <div class="mat-card__body">
            <p class="mat-hint">Add as a <strong>push webhook</strong> in your Git host. Keep it secret.</p>
            <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
                <input class="mat-input mat-mono" style="min-width:420px;flex:1;" value="@Model.WebhookUrl" readonly data-select-on-click />
                <form method="post" asp-page-handler="Regenerate" data-confirm="Regenerate the webhook URL? The old URL stops working.">
                    <input type="hidden" name="id" value="@Model.Input.Id" />
                    <button type="submit" class="mat-btn mat-btn--secondary mat-btn--sm"><icon name="refresh" /><span>Regenerate</span></button>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        (function () {
            var picker = document.getElementById('repo-picker');
            if (!picker) { return; }
            picker.addEventListener('change', function () {
                var opt = picker.selectedOptions[0];
                if (!opt || !opt.value) { return; }
                var url = document.querySelector('[name="Input.GitRepoUrl"]');
                var ref = document.querySelector('[name="Input.GitReference"]');
                var cred = document.querySelector('[name="Input.GitCredentialId"]');
                if (url) { url.value = opt.getAttribute('data-url') || ''; }
                if (ref) { ref.value = opt.getAttribute('data-ref') || ''; }
                if (cred) { cred.value = opt.getAttribute('data-cred') || ''; }
            });
        })();
    </script>
}
