@page
@model MatDock.Web.Pages.Stacks.UpdateModel
@{
    ViewData["Title"] = "Updates";
    string Short(string? digest) => string.IsNullOrEmpty(digest) ? "–"
        : (digest.StartsWith("sha256:") ? digest[7..] : digest) is var h && h.Length > 12 ? h[..12] : h;
    ViewData["Heading"] = Model.Stack is null ? "Updates" : $"Updates · {Model.Stack.Name}";
    ViewData["Crumbs"] = new List<(string Text, string? Url)> { ("Stacks", "/Stacks") };
}

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    if (Model.IsError)
    {
        <div class="mat-alert mat-alert--danger" role="alert"><icon name="x-circle" /><div class="mat-alert__body">@Model.StatusMessage</div></div>
    }
    else
    {
        <div data-toast="@Model.StatusMessage" data-tone="success" hidden></div>
    }
}

@if (Model.Report?.Error is not null)
{
    <div class="mat-alert mat-alert--warning"><icon name="alert" /><div class="mat-alert__body">Could not check for updates: @Model.Report.Error</div></div>
}

@if (Model.Report is not null && Model.Report.Error is null)
{
    var updates = Model.Report.UpdatesAvailable;
    if (Model.Report.Images.Count == 0)
    {
        <div class="mat-empty mat-empty--framed"><div class="mat-empty__icon"><icon name="image" /></div><p>No running images found for this stack.</p></div>
    }
    else
    {
        <div class="mat-alert @(updates > 0 ? "mat-alert--warning" : "mat-alert--success")">
            <icon name="@(updates > 0 ? "alert" : "check-circle")" />
            <div class="mat-alert__body">@(updates > 0 ? $"{updates} update(s) available." : "All images are up to date.")</div>
        </div>

        <div class="mat-table-wrap">
            <table class="mat-table">
                <thead>
                    <tr><th>Service</th><th>Image</th><th>Status</th><th>Local</th><th>Registry</th></tr>
                </thead>
                <tbody>
                    @foreach (var img in Model.Report.Images)
                    {
                        <tr>
                            <td data-label="Service">@img.Service</td>
                            <td data-label="Image" class="mat-mono mat-text-break">@img.Image</td>
                            <td data-label="Status">
                                @if (img.UpdateAvailable)
                                {
                                    <span class="mat-pill mat-pill--warn">Update</span>
                                }
                                else if (img.Note is not null)
                                {
                                    <span class="mat-muted">@img.Note</span>
                                }
                                else
                                {
                                    <span class="mat-pill mat-pill--ok">Up to date</span>
                                }
                            </td>
                            <td data-label="Local" class="mat-mono mat-muted" title="@img.LocalDigest">@Short(img.LocalDigest)</td>
                            <td data-label="Registry" class="mat-mono mat-muted" title="@img.RegistryDigest">@Short(img.RegistryDigest)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <section class="mat-card">
        <div class="mat-card__head"><icon name="refresh" /><h2 class="mat-card__title">Run update</h2></div>
        <div class="mat-card__body">
            <form method="post" asp-page-handler="Update" class="mat-form" data-confirm="Update stack '@Model.Stack?.Name' now?">
                <p class="mat-hint">Pulls the new images and redeploys.</p>
                <input type="hidden" asp-for="Id" />
                <label class="mat-check">
                    <input asp-for="PreBackup" type="checkbox" />
                    <span>Back up the stack's volumes before updating</span>
                </label>
                <label class="mat-check">
                    <input asp-for="HealthGate" type="checkbox" />
                    <span>Roll back when the containers are not up and healthy within 90 s</span>
                </label>
                <mat-form-buttons>
                    <button type="submit" class="mat-btn mat-btn--primary"><icon name="refresh" /><span>Update now</span></button>
                </mat-form-buttons>
            </form>
        </div>
    </section>
}

@section Actions {
    <a href="/Stacks/Update?id=@Model.Id" class="mat-btn mat-btn--secondary"><icon name="refresh" /><span>Re-check</span></a>
}
