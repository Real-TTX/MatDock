@page
@model MatDock.Web.Pages.Stacks.UpdateModel
@{
    ViewData["Title"] = "Updates";
    string Short(string? digest) => string.IsNullOrEmpty(digest) ? "–"
        : (digest.StartsWith("sha256:") ? digest[7..] : digest) is var h && h.Length > 12 ? h[..12] : h;
    ViewData["Heading"] = Model.Stack is null ? "Updates" : $"Updates · {Model.Stack.Name}";
    ViewData["Crumbs"] = new List<(string Text, string? Url)> { ("Stacks", "/Stacks") };
}

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="mat-alert @(Model.IsError ? "mat-alert--danger" : "mat-alert--success")">
        <icon name="@(Model.IsError ? "x-circle" : "check-circle")" /><div class="mat-alert__body">@Model.StatusMessage</div>
    </div>
}

@if (Model.Report?.Error is not null)
{
    <div class="mat-alert mat-alert--warning"><icon name="alert" /><div class="mat-alert__body">Could not check for updates: @Model.Report.Error</div></div>
}

@if (Model.Report is not null && Model.Report.Error is null)
{
    var updates = Model.Report.UpdatesAvailable;
    if (Model.Report.Images.Count == 0)
    {
        <div class="mat-mb-4 mat-card">
            <div class="mat-empty"><div class="mat-empty__icon"><icon name="image" /></div><p>No running images found for this stack.</p></div>
        </div>
    }
    else
    {
    <div class="mat-alert @(updates > 0 ? "mat-alert--warning" : "mat-alert--success")">
        <icon name="@(updates > 0 ? "alert" : "check-circle")" />
        <span>@(updates > 0 ? $"{updates} update(s) available." : "All images are up to date.")</span>
    </div>

    <div class="mat-p-0 mat-mb-4 mat-card">
        <table class="mat-table">
            <thead>
                <tr><th>Service</th><th>Image</th><th>Status</th><th>Local</th><th>Registry</th></tr>
            </thead>
            <tbody>
                @foreach (var img in Model.Report.Images)
                {
                    <tr>
                        <td>@img.Service</td>
                        <td class="mat-text-wrap"><span class="mat-mono">@img.Image</span></td>
                        <td>
                            @if (img.UpdateAvailable)
                            {
                                <span class="mat-pill mat-pill--warn"><icon name="alert" /> Update</span>
                            }
                            else if (img.Note is not null)
                            {
                                <span class="cell-sub">@img.Note</span>
                            }
                            else
                            {
                                <span class="mat-pill mat-pill--ok"><icon name="check-circle" /> Up to date</span>
                            }
                        </td>
                        <td class="mat-mono cell-sub" title="@img.LocalDigest">@Short(img.LocalDigest)</td>
                        <td class="mat-mono cell-sub" title="@img.RegistryDigest">@Short(img.RegistryDigest)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    }

    <div class="u-maxw-sm mat-card">
        <div class="mat-card__head"><icon name="refresh" /><span>Run update</span></div>
        <div class="mat-card__body">
            <p class="mat-mb-3 mat-hint">Pulls the new images and redeploys.</p>
            <form method="post" asp-page-handler="Update" data-confirm="Update stack '@Model.Stack?.Name' now?">
                <input type="hidden" asp-for="Id" />
                <label class="mat-mb-3 mat-check">
                    <input asp-for="PreBackup" type="checkbox" />
                    <span>Back up the stack's volumes before updating</span>
                </label>
                <label class="mat-mb-3 mat-check">
                    <input asp-for="HealthGate" type="checkbox" />
                    <span>Roll back when the containers are not up and healthy within 90 s</span>
                </label>
                <mat-form-buttons>
                    <button type="submit" class="mat-btn mat-btn--primary"><icon name="refresh" /><span>Update now</span></button>
                </mat-form-buttons>
            </form>
        </div>
    </div>
}

@section Actions {
    <a href="/Stacks/Update?id=@Model.Id" class="mat-btn mat-btn--secondary"><icon name="refresh" /><span>Re-check</span></a>
}
