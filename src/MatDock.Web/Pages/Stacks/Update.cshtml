@page
@model MatDock.Web.Pages.Stacks.UpdateModel
@using MatDock.Core.Entities
@{
    ViewData["Title"] = "Updates";
    string Short(string? digest) => string.IsNullOrEmpty(digest) ? "–"
        : (digest.StartsWith("sha256:") ? digest[7..] : digest) is var h && h.Length > 12 ? h[..12] : h;
    ViewData["Heading"] = Model.Stack is null ? "Updates" : $"Updates · {Model.Stack.Name}";
    ViewData["Crumbs"] = new List<(string Text, string? Url)> { ("Stacks", "/Stacks") };
}

@if (Model.Stack is not null)
{
    <partial name="_StackTabs" model="Model.Stack.Id" />
}

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    if (Model.IsError)
    {
        <div class="mat-alert mat-alert--danger" role="alert"><icon name="x-circle" /><div class="mat-alert__body">@Model.StatusMessage</div></div>
    }
    else
    {
        <div data-toast="@Model.StatusMessage" data-tone="success" hidden></div>
    }
}
@if (Model.Running is { } updating)
{
    <section id="live-update" class="mat-card" data-live="@(updating.IsFinished ? null : "2")" data-live-done="reload">
        <div class="mat-card__head">
            <icon name="@(updating.IsFinished ? (updating.Error is null ? "check-circle" : "alert") : "refresh")" />
            <h2 class="mat-card__title">@(updating.IsFinished ? (updating.Error is null ? "Updated" : "Update failed") : "Updating…")</h2>
        </div>
        <div class="mat-card__body"><partial name="_RunSteps" model="updating" /></div>
    </section>
}



@if (Model.Report?.Error is not null)
{
    <div class="mat-alert mat-alert--warning"><icon name="alert" /><div class="mat-alert__body">Could not check for updates: @Model.Report.Error</div></div>
}

@if (Model.Report is not null && Model.Report.Error is null)
{
    // What an update would change: what the rule of the stack makes of the look (a newer version too), the same the overview shows.
    var planned = (Model.Plan?.Items ?? []).GroupBy(i => i.Service).ToDictionary(g => g.Key, g => g.First());
    var updates = Model.Report.Images.Count(i => i.UpdateAvailable || planned.ContainsKey(i.Service));
    if (Model.Report.Images.Count == 0)
    {
        <div class="mat-empty mat-empty--framed"><div class="mat-empty__icon"><icon name="image" /></div><p>No running images found for this stack.</p></div>
    }
    else
    {
        <div class="mat-alert @(updates > 0 ? "mat-alert--warning" : "mat-alert--success")">
            <icon name="@(updates > 0 ? "alert" : "check-circle")" />
            <div class="mat-alert__body">
                @(updates > 0 ? $"{updates} update(s) available." : "Up to date.")
                @if (Model.CheckedUtc is { } at)
                {
                    <span class="mat-muted">Checked @at.ToUserTime().ToString("dd.MM.yyyy HH:mm")</span>
                }
            </div>
        </div>

        <div class="mat-table-wrap">
            <table class="mat-table">
                <thead>
                    <tr><th>Service</th><th>Image</th><th>Status</th><th>Local</th><th>Registry</th><th><span class="mat-sr-only">Actions</span></th></tr>
                </thead>
                <tbody>
                    @foreach (var img in Model.Report.Images)
                    {
                        <tr>
                            <td data-label="Service">@img.Service</td>
                            <td data-label="Image" class="mat-mono mat-text-break">
                                @img.Image
                                @if (Model.Overrides.TryGetValue(img.Service, out var over))
                                {
                                    <div class="mat-muted" title="The compose file names this image; MatDock runs the one above.">Compose: @over.Base</div>
                                }
                                @if (Model.ComposeImages.ContainsKey(img.Service))
                                {
                                    <form method="post" asp-page-handler="Image" class="md-image-form">
                                        <input type="hidden" name="id" value="@Model.Id" />
                                        <input type="hidden" name="service" value="@img.Service" />
                                        <input name="image" class="mat-input mat-mono md-image-input" value="@(over is not null ? over.Image : Model.ComposeImages[img.Service])"
                                               aria-label="Image of @img.Service" title="The image MatDock runs for this service. The compose file stays as it is." spellcheck="false" autocomplete="off" />
                                        <button type="submit" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" title="Run this image" aria-label="Run this image for @img.Service"><icon name="save" /></button>
                                        @if (over is not null)
                                        {
                                            <button type="submit" name="reset" value="true" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" title="Back to the compose file's image" aria-label="Use the compose file's image for @img.Service"><icon name="refresh" /></button>
                                        }
                                    </form>
                                }
                            </td>
                            <td data-label="Status">
                                @if (img.Pinned)
                                {
                                    <span class="mat-pill mat-pill--plain"><icon name="lock" /> Pinned</span>
                                }
                                else if (planned.GetValueOrDefault(img.Service) is { Kind: MatDock.Core.Updates.PlannedKind.Version } version)
                                {
                                    <span class="mat-pill mat-pill--warn" title="@version.Target">Update → @(MatDock.Core.Updates.ImageRef.TryParse(version.Target)?.Tag ?? version.Target)</span>
                                }
                                else if (img.UpdateAvailable)
                                {
                                    <span class="mat-pill mat-pill--warn" title="The registry has a newer image under this tag.">Update</span>
                                }
                                else if (img.Note is not null)
                                {
                                    <span class="mat-muted">@img.Note</span>
                                }
                                else
                                {
                                    <span class="mat-pill mat-pill--ok">Up to date</span>
                                }
                                @if (Model.Overrides.ContainsKey(img.Service))
                                {
                                    <span class="mat-pill mat-pill--info" title="MatDock runs another image than the compose file names.">Override</span>
                                }
                                @if (img.NewerTag is not null && planned.GetValueOrDefault(img.Service) is not { Kind: MatDock.Core.Updates.PlannedKind.Version })
                                {
                                    <span class="mat-pill mat-pill--info" title="A newer version tag exists. Enter it in the image field to run it.">Newer: @img.NewerTag</span>
                                }
                                @if (img.Changelog is { } notes)
                                {
                                    <a class="mat-tag" href="@notes" target="_blank" rel="noopener noreferrer" title="The release notes of the image"><icon name="external" /> Release notes</a>
                                }
                                @if (img.TagInclude is not null || img.TagExclude is not null)
                                {
                                    <span class="mat-tag" title="Version tags from the container's labels: @(img.TagInclude is null ? string.Empty : $"only {img.TagInclude}") @(img.TagExclude is null ? string.Empty : $"never {img.TagExclude}")"><icon name="filter" /> Tag filter</span>
                                }
                            </td>
                            <td data-label="Local" class="mat-mono mat-muted" title="@img.LocalDigest">@Short(img.LocalDigest)</td>
                            <td data-label="Registry" class="mat-mono mat-muted" title="@img.RegistryDigest">@Short(img.RegistryDigest)</td>
                            <td class="mat-table__cell-actions">
                                <div class="mat-table__actions">
                                    <form method="post" asp-page-handler="Pin">
                                        <input type="hidden" name="id" value="@Model.Id" />
                                        <input type="hidden" name="service" value="@img.Service" />
                                        <input type="hidden" name="pin" value="@(img.Pinned ? "false" : "true")" />
                                        <button type="submit" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm"
                                                title="@(img.Pinned ? "Unpin: updates may change this service again" : "Pin: updates skip this service")"
                                                aria-label="@(img.Pinned ? "Unpin" : "Pin") @img.Service"><icon name="@(img.Pinned ? "x-circle" : "lock")" /></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <section class="mat-card">
        <div class="mat-card__head"><icon name="refresh" /><h2 class="mat-card__title">Run update</h2></div>
        <div class="mat-card__body">
            <form method="post" asp-page-handler="Update" class="mat-form" data-confirm="Update stack '@Model.Stack?.Name' now?">
                <p class="mat-hint">@(planned.Values.Any(i => i.Kind == MatDock.Core.Updates.PlannedKind.Version) ? "Sets the new versions, pulls the images and redeploys." : "Pulls the new images and redeploys.")</p>
                <input type="hidden" asp-for="Id" />
                <label class="mat-check">
                    <input asp-for="PreBackup" type="checkbox" />
                    <span>Back up the stack's volumes before updating</span>
                </label>
                <label class="mat-check">
                    <input asp-for="HealthGate" type="checkbox" />
                    <span>Roll back when the containers are not up and healthy within 90 s</span>
                </label>
                <mat-form-buttons>
                    <button type="submit" class="mat-btn mat-btn--primary"><icon name="refresh" /><span>Update now</span></button>
                </mat-form-buttons>
            </form>
        </div>
    </section>
}

@if (Model.History.Count > 0)
{
    string OutcomePill(UpdateRunOutcome o) => o switch
    {
        UpdateRunOutcome.Updated => "mat-pill--ok",
        UpdateRunOutcome.NoChange => "mat-pill--plain",
        UpdateRunOutcome.RolledBack => "mat-pill--warn",
        _ => "mat-pill--error",
    };

    <section class="mat-card">
        <div class="mat-card__head"><icon name="clock" /><h2 class="mat-card__title">History</h2><span class="mat-badge">@Model.History.Count</span></div>
        <div class="mat-table-wrap">
            <table class="mat-table">
                <thead>
                    <tr><th>When</th><th>By</th><th>Result</th><th>Changed</th></tr>
                </thead>
                <tbody>
                    @foreach (var run in Model.History)
                    {
                        var changes = MatDock.Core.Updates.UpdateService.ChangesOf(run);
                        <tr>
                            <td class="mat-nowrap" data-label="When">@run.CreateDate.ToUserTime().ToString("dd.MM.yyyy HH:mm")</td>
                            <td data-label="By">@run.Trigger</td>
                            <td data-label="Result">
                                <span class="mat-pill @OutcomePill(run.Outcome)" title="@run.Message">@run.Outcome</span>
                            </td>
                            <td data-label="Changed" class="mat-mono">
                                @if (changes.Count == 0)
                                {
                                    <span class="mat-muted">–</span>
                                }
                                else
                                {
                                    @foreach (var c in changes)
                                    {
                                        <div title="@c.Image">@c.Service: @c.Before → @c.After</div>
                                    }
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}

@if (Model.Stack is not null)
{
    <section class="mat-card">
        <div class="mat-card__head"><icon name="link" /><h2 class="mat-card__title">@(Model.Stack.IsGitBacked ? "Push webhook" : "Redeploy webhook")</h2></div>
        <div class="mat-card__body mat-stack">
            @if (Model.WebhookUrl is { } url)
            {
                if (Model.Stack.IsGitBacked)
                {
                    <p class="mat-hint">Add it as the push webhook of the repository (GitHub, Gitea, Forgejo, GitLab): a push syncs the stack, it deploys only when the compose file's folder changed. As the webhook's secret use the last part of the address.</p>
                }
                else
                {
                    <p class="mat-hint">A POST to this address pulls and redeploys the stack with the backup and the health check of its rule, for example from a CI after it pushed a new image. The address is the secret.</p>
                }
                <div class="md-image-form">
                    <input class="mat-input mat-mono md-image-input" value="@url" readonly aria-label="Webhook address" id="webhook-url" />
                    <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" data-copy="#webhook-url" title="Copy" aria-label="Copy the address"><icon name="copy" /></button>
                </div>
                <pre class="mat-code">curl -X POST @url</pre>
            }
            <div class="mat-actions">
                <form method="post" asp-page-handler="Webhook" data-confirm="@(Model.WebhookUrl is null ? null : "A new address? The old one stops working.")">
                    <input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="enabled" value="true" />
                    <button type="submit" class="mat-btn mat-btn--secondary"><icon name="@(Model.WebhookUrl is null ? "link" : "refresh")" /><span>@(Model.WebhookUrl is null ? "Switch on" : "New address")</span></button>
                </form>
                @if (Model.WebhookUrl is not null)
                {
                    <form method="post" asp-page-handler="Webhook" data-confirm="Switch the webhook off?">
                        <input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="enabled" value="false" />
                        <button type="submit" class="mat-btn mat-btn--danger"><icon name="x-circle" /><span>Switch off</span></button>
                    </form>
                }
            </div>
        </div>
    </section>
}

@section Actions {
    <a href="/Stacks/Copy?id=@Model.Id" class="mat-btn mat-btn--secondary"><icon name="copy" /><span>Copy</span></a>
    <a href="/Updates/Rules?scope=Stack&id=@Model.Id" class="mat-btn mat-btn--secondary"><icon name="sliders" /><span>Rule</span></a>
    <form method="post" asp-page-handler="Check" class="md-inline-form">
        <input type="hidden" name="id" value="@Model.Id" />
        <button type="submit" class="mat-btn mat-btn--secondary"><icon name="refresh" /><span>Re-check</span></button>
    </form>
}
