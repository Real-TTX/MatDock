@page
@model MatDock.Web.Pages.Users.EditModel
@{
    ViewData["Title"] = Model.IsEdit ? "Edit user" : "New user";
    ViewData["Width"] = "narrow";
    var pwHint = Model.IsEdit ? "Leave blank to keep the current password." : null;
    ViewData["Crumbs"] = new List<(string Text, string? Url)> { ("Users", "/Users") };
}

<partial name="_SystemTabs" />

<div class="mat-card">
    <div class="mat-card__body">
        <form method="post" class="mat-form">
            <input type="hidden" asp-for="Input.Id" />

            <div class="mat-form__grid">
                <mat-field label="Username" asp-for="Input.Username">
                    <input asp-for="Input.Username" class="mat-input" autocomplete="off" readonly="@Model.IsEdit" />
                </mat-field>

                <mat-field label="Display name" asp-for="Input.DisplayName">
                    <input asp-for="Input.DisplayName" class="mat-input" />
                </mat-field>

                <mat-field label="Role" asp-for="Input.Role">
                    <select asp-for="Input.Role" id="Input_Role" class="mat-select">
                        <option value="Admin">Admin</option>
                        <option value="User">User</option>
                    </select>
                </mat-field>

                <mat-field label="Status">
                    <label class="mat-check">
                        <input asp-for="Input.IsActive" type="checkbox" />
                        <span>Account is active</span>
                    </label>
                </mat-field>

                <mat-field label="Password" asp-for="Input.Password" hint="@pwHint">
                    <input asp-for="Input.Password" type="password" class="mat-input" autocomplete="new-password" />
                </mat-field>

                <mat-field label="Confirm password" asp-for="Input.ConfirmPassword">
                    <input asp-for="Input.ConfirmPassword" type="password" class="mat-input" autocomplete="new-password" />
                </mat-field>
            </div>

            @* An admin always sees every environment; a user can be limited to some. *@
            <div class="mat-stack" data-show-if="#Input_Role" data-show-value="User">
                <label class="mat-check">
                    <input asp-for="Input.RestrictEnvironments" type="checkbox" />
                    <span>Only these environments</span>
                </label>
                <div class="mat-stack" data-show-if="#Input_RestrictEnvironments" data-show-value="true">
                    @if (Model.Environments.Count == 0)
                    {
                        <p class="mat-hint">There are no environments yet: until you add some this user sees nothing.</p>
                    }
                    @foreach (var env in Model.Environments)
                    {
                        <label class="mat-check">
                            <input type="checkbox" name="Input.EnvironmentIds" value="@env.Id" checked="@Model.Input.EnvironmentIds.Contains(env.Id)" />
                            <span>@env.Name</span>
                        </label>
                    }
                </div>
            </div>

            <mat-form-buttons>
                <button type="submit" class="mat-btn mat-btn--primary"><icon name="save" /><span>Save</span></button>
                <a href="/Users" class="mat-btn mat-btn--secondary">Cancel</a>
                @if (Model.IsEdit && !Model.IsSelf)
                {
                    <span class="mat-btn-row__spacer"></span>
                    <button type="submit" form="delete-form" class="mat-btn mat-btn--danger" data-confirm="Delete user '@Model.Input.Username'?"><icon name="trash" /><span>Delete</span></button>
                }
            </mat-form-buttons>
        </form>
        @if (Model.IsEdit && !Model.IsSelf)
        {
            <form method="post" asp-page-handler="Delete" id="delete-form"><input type="hidden" name="id" value="@Model.Input.Id" /></form>
        }
    </div>
</div>
