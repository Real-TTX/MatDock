@page
@model MatDock.Web.Pages.Users.IndexModel
@{
    ViewData["Title"] = "Users";
}

<partial name="_SystemTabs" />

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="mat-alert @(Model.IsError ? "mat-alert--danger" : "mat-alert--success")">
        <icon name="@(Model.IsError ? "x-circle" : "check-circle")" /><div class="mat-alert__body">@Model.StatusMessage</div>
    </div>
}

<mat-table>
    <mat-table-toolbar>
        <form method="get" class="u-contents js-autosubmit">
            <div class="mat-input-icon mat-toolbar__search">
                <icon name="search" />
                <input type="search" name="Q" value="@Model.Q" class="mat-input" placeholder="Search…" />
            </div>
            <div class="mat-row mat-row--nowrap">
                <label for="sort-field">Sort</label>
                <select id="sort-field" name="SortKey" class="mat-select">
                    <option value="UsernameAsc" selected="@(Model.SortKey == "UsernameAsc")">A–Z: Username</option>
                    <option value="UsernameDesc" selected="@(Model.SortKey == "UsernameDesc")">Z–A: Username</option>
                    <option value="DisplayNameAsc" selected="@(Model.SortKey == "DisplayNameAsc")">A–Z: Display name</option>
                    <option value="DisplayNameDesc" selected="@(Model.SortKey == "DisplayNameDesc")">Z–A: Display name</option>
                    <option value="RoleAsc" selected="@(Model.SortKey == "RoleAsc")">A–Z: Role</option>
                    <option value="RoleDesc" selected="@(Model.SortKey == "RoleDesc")">Z–A: Role</option>
                    <option value="LastLoginDesc" selected="@(Model.SortKey == "LastLoginDesc")">9–0: Last login</option>
                    <option value="LastLoginAsc" selected="@(Model.SortKey == "LastLoginAsc")">0–9: Last login</option>
                </select>
            </div>
        </form>
    </mat-table-toolbar>

    <mat-table-body>
        @if (Model.Items.Count == 0)
        {
            <div class="mat-empty"><div class="mat-empty__icon"><icon name="users" /></div><p>No users found.</p></div>
        }
        else
        {
            <table class="mat-table">
                <thead>
                    <tr><th>Username</th><th>Display name</th><th>Role</th><th>Status</th><th>Last login</th></tr>
                </thead>
                <tbody>
                    @foreach (var u in Model.Items)
                    {
                        <tr>
                            <td><a href="/Users/Edit?id=@u.Id"><strong>@u.Username</strong></a></td>
                            <td>@u.DisplayName</td>
                            <td><span class="mat-tag">@u.Role</span></td>
                            <td>
                                @if (u.IsActive)
                                {
                                    <span class="mat-pill mat-pill--ok"><icon name="check-circle" /><span>Active</span></span>
                                }
                                else
                                {
                                    <span class="mat-pill mat-pill--plain"><span>Inactive</span></span>
                                }
                            </td>
                            <td class="mat-muted mat-nowrap">@(u.LastLoginAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "–")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </mat-table-body>

    <mat-table-pagination>
        <pagination model="Model.Pagination" />
    </mat-table-pagination>

    <mat-table-actions>
        <a href="/Users/Edit" class="mat-btn mat-btn--primary"><icon name="plus" /><span>New user</span></a>
    </mat-table-actions>
</mat-table>
