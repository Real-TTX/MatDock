@page
@model MatDock.Web.Pages.Users.IndexModel
@{
    ViewData["Title"] = "Users";
    var currentUserId = User.GetUserId();
}

<partial name="_SystemTabs" />

<div class="page-head">
    <div class="page-head__title">
        <h1>Users</h1>
        <span class="page-head__subtitle">Local accounts &amp; roles</span>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert @(Model.IsError ? "alert--error" : "alert--success")">
        <icon name="@(Model.IsError ? "x-circle" : "check-circle")" /><span>@Model.StatusMessage</span>
    </div>
}

<mat-table>
    <mat-table-toolbar>
        <form method="get" class="js-autosubmit" style="display:contents;">
            <div class="search">
                <icon name="search" />
                <input type="search" name="Q" value="@Model.Q" class="mat-input" placeholder="Search…" />
            </div>
            <div class="toolbar-field">
                <label for="sort-field">Sort</label>
                <select id="sort-field" name="Sort" class="mat-select">
                    <option value="username" selected="@(Model.Sort == "username")">Username</option>
                    <option value="displayname" selected="@(Model.Sort == "displayname")">Display name</option>
                    <option value="role" selected="@(Model.Sort == "role")">Role</option>
                    <option value="lastlogin" selected="@(Model.Sort == "lastlogin")">Last login</option>
                </select>
                <select name="Dir" class="mat-select" aria-label="Direction">
                    <option value="asc" selected="@(Model.Dir == "asc")">↑</option>
                    <option value="desc" selected="@(Model.Dir == "desc")">↓</option>
                </select>
            </div>
        </form>
    </mat-table-toolbar>

    <mat-table-body>
        @if (Model.Items.Count == 0)
        {
            <div class="empty-state"><div><icon name="users" /></div><p>No users found.</p></div>
        }
        else
        {
            <table class="data">
                <thead>
                    <tr><th>Username</th><th>Display name</th><th>Role</th><th>Status</th><th>Last login</th><th class="actions">Actions</th></tr>
                </thead>
                <tbody>
                    @foreach (var u in Model.Items)
                    {
                        <tr>
                            <td><a href="/Users/Edit?id=@u.Id"><strong>@u.Username</strong></a></td>
                            <td>@u.DisplayName</td>
                            <td><span class="mat-badge">@u.Role</span></td>
                            <td>
                                @if (u.IsActive)
                                {
                                    <span class="pill pill--online"><icon name="check-circle" /><span>Active</span></span>
                                }
                                else
                                {
                                    <span class="pill pill--unknown"><span>Inactive</span></span>
                                }
                            </td>
                            <td class="text-muted nowrap">@(u.LastLoginAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "–")</td>
                            <td class="actions">
                                <div class="row-actions">
                                    @if (u.Id != currentUserId)
                                    {
                                        <form method="post" asp-page-handler="Delete" data-confirm="Really delete user @u.Username?" style="display:inline;">
                                            <input type="hidden" name="id" value="@u.Id" />
                                            <button type="submit" class="mat-btn mat-btn--sm mat-btn--danger" title="Delete"><icon name="trash" /></button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </mat-table-body>

    <mat-table-pagination>
        <pagination model="Model.Pagination" />
    </mat-table-pagination>

    <mat-table-actions>
        <a href="/Users/Edit" class="mat-btn mat-btn--primary"><icon name="plus" /><span>New user</span></a>
    </mat-table-actions>
</mat-table>
