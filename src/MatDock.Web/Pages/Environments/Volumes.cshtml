@page
@model MatDock.Web.Pages.Environments.VolumesModel
@{
    ViewData["Title"] = $"Volumes · {Model.Environment?.Name}";
}

<div class="page-head">
    <div class="page-head__title">
        <h1>Volumes</h1>
        <span class="page-head__subtitle">
            @Model.Environment?.Name — <span class="mono">@Model.Environment?.Username@@@Model.Environment?.Host</span>
        </span>
    </div>
    <div class="mat-buttons">
        <a href="/Environments" class="mat-btn mat-btn--ghost"><icon name="back" /><span>Zurück</span></a>
    </div>
</div>

@{
    var envId = Model.Environment?.Id;
    var tabs = new TabBarModel
    {
        Tabs =
        {
            new TabItem { Title = "Details", Href = $"/Environments/Edit?id={envId}", Icon = "server" },
            new TabItem { Title = "Volumes", Href = $"/Environments/Volumes?id={envId}", Icon = "volume", Active = true }
        }
    };
}
<tab-bar model="tabs" />

@if (Model.ErrorMessage is not null)
{
    <div class="alert alert--error"><icon name="x-circle" /><span>@Model.ErrorMessage</span></div>
    <a class="mat-btn" href="/Environments/Volumes?id=@Model.Environment?.Id"><icon name="refresh" /><span>Erneut versuchen</span></a>
}
else
{
    <div class="mat-table__toolbar" style="border-radius:var(--radius);border:1px solid var(--border);background:var(--surface);margin-bottom:16px;">
        <div class="search">
            <icon name="search" />
            <input type="search" class="mat-input" placeholder="Volumes filtern…"
                   data-filter-table="#vol-grid" data-filter-count="#vol-count" />
        </div>
        <span class="toolbar-spacer"></span>
        <span class="text-muted"><strong id="vol-count">@Model.Volumes.Count</strong> Volumes</span>
    </div>

    @if (Model.Volumes.Count == 0)
    {
        <div class="card"><div class="empty-state">
            <div><icon name="volume" /></div>
            <p>Keine Volumes auf diesem Host.</p>
        </div></div>
    }
    else
    {
        <div class="vol-grid" id="vol-grid">
            @foreach (var vol in Model.Volumes)
            {
                <div class="vol-card" data-filter-row>
                    <div class="vol-card__head">
                        <div class="vol-card__icon"><icon name="volume" /></div>
                        <div>
                            <div class="vol-card__name">@vol.Name</div>
                            <div class="vol-card__meta">@vol.Driver · @vol.Scope</div>
                        </div>
                    </div>
                    <div class="vol-card__rows">
                        <div><span class="k">Mountpoint</span><br><span class="v">@vol.Mountpoint</span></div>
                    </div>
                    <div class="vol-card__foot">
                        <a class="mat-btn mat-btn--primary mat-btn--sm"
                           href="/Environments/Migrate?sourceId=@Model.Environment?.Id&volume=@Uri.EscapeDataString(vol.Name)">
                            <icon name="server" /><span>Migrieren</span>
                        </a>
                    </div>
                </div>
            }
        </div>
    }
}
