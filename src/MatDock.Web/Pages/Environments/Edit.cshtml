@page
@model MatDock.Web.Pages.Environments.EditModel
@{
    ViewData["Title"] = Model.IsEdit ? "Edit environment" : "New environment";
}

<div class="page-head">
    <div class="page-head__title">
        <h1>@ViewData["Title"]</h1>
        <span class="page-head__subtitle">SSH connection to a Docker host</span>
    </div>
</div>

@if (Model.TestResult is not null)
{
    <div class="alert @(Model.TestResult.Success ? "alert--success" : "alert--error")">
        <icon name="@(Model.TestResult.Success ? "check-circle" : "x-circle")" />
        <span>@Model.TestResult.Message</span>
    </div>
}

<div class="card" style="max-width:760px;">
    <div class="card__body">
        <form method="post" class="mat-form">
            <input type="hidden" asp-for="Input.Id" />
            <div asp-validation-summary="ModelOnly"></div>

            <div class="form-grid">
                <mat-field label="Name" asp-for="Input.Name" class="span-2">
                    <input asp-for="Input.Name" class="mat-input" placeholder="e.g. Production" />
                </mat-field>

                <mat-field label="Description" asp-for="Input.Description" class="span-2">
                    <input asp-for="Input.Description" class="mat-input" placeholder="Optional" />
                </mat-field>

                <mat-field label="Base URL" asp-for="Input.BaseUrl" class="span-2" hint="Optional, e.g. https://host – Open link on containers; overridable per container via the matdock.openurl label.">
                    <input asp-for="Input.BaseUrl" class="mat-input" placeholder="https://host.example.com" />
                </mat-field>

                <mat-field label="Connection type" asp-for="Input.ConnectionType" class="span-2" hint="SSH = remote host. Local = the Docker socket of this MatDock host (socket must be mounted).">
                    <select asp-for="Input.ConnectionType" id="ConnectionType" class="mat-select">
                        <option value="Ssh">SSH (remote host)</option>
                        <option value="Local">Local (Docker socket)</option>
                    </select>
                </mat-field>
            </div>

            <div data-show-when="ConnectionType=Local">
                <div class="alert alert--info">
                    <icon name="server" /><span>Local environment: MatDock talks directly to the mounted Docker socket – no host/SSH required. Prerequisite: container started with <code>-v /var/run/docker.sock:/var/run/docker.sock</code>.</span>
                </div>
            </div>

            <div data-show-when="ConnectionType=Ssh">
                <div class="form-grid">
                    <mat-field label="Host" asp-for="Input.Host">
                        <input asp-for="Input.Host" class="mat-input" placeholder="host.example.com or 10.0.0.5" />
                    </mat-field>

                    <mat-field label="Port" asp-for="Input.Port">
                        <input asp-for="Input.Port" type="number" min="1" max="65535" class="mat-input" />
                    </mat-field>

                    <mat-field label="SSH user" asp-for="Input.Username">
                        <input asp-for="Input.Username" class="mat-input" autocomplete="off" placeholder="e.g. root" />
                    </mat-field>

                    <mat-field label="Authentication" asp-for="Input.AuthType">
                        <select asp-for="Input.AuthType" id="AuthType" class="mat-select">
                            <option value="Password">Password</option>
                            <option value="PrivateKey">SSH key</option>
                        </select>
                    </mat-field>
                </div>

            @{
                var secretHint = Model.IsEdit ? "Leave blank to keep the stored secret." : null;
            }

            <div data-show-when="AuthType=Password">
                <mat-field label="Password" asp-for="Input.Password" hint="@secretHint">
                    <input asp-for="Input.Password" type="password" class="mat-input" autocomplete="new-password" />
                </mat-field>
            </div>

            <div data-show-when="AuthType=PrivateKey">
                @if (!string.IsNullOrEmpty(Model.GeneratedPublicKey))
                {
                    <div class="alert alert--success" style="flex-direction:column;align-items:stretch;gap:8px;">
                        <div><icon name="key" /> <strong>Install the public key on the host:</strong> run once on <code>@Model.Input.Host</code> as <code>@Model.Input.Username</code> (then <em>Save</em> below):</div>
                        <textarea class="mat-textarea" rows="2" readonly onclick="this.select()">mkdir -p ~/.ssh &amp;&amp; chmod 700 ~/.ssh &amp;&amp; echo '@Model.GeneratedPublicKey' &gt;&gt; ~/.ssh/authorized_keys &amp;&amp; chmod 600 ~/.ssh/authorized_keys</textarea>
                    </div>
                }
                <mat-field label="Private SSH key (PEM)" asp-for="Input.PrivateKeyPem" hint="@secretHint">
                    <textarea asp-for="Input.PrivateKeyPem" class="mat-textarea" rows="6" placeholder="-----BEGIN OPENSSH PRIVATE KEY-----"></textarea>
                </mat-field>
                <mat-field label="Key passphrase" asp-for="Input.PrivateKeyPassphrase" hint="Optional, if the key is encrypted.">
                    <input asp-for="Input.PrivateKeyPassphrase" type="password" class="mat-input" autocomplete="new-password" />
                </mat-field>
                <mat-form-buttons>
                    <button type="submit" asp-page-handler="GenerateKey" class="mat-btn" formnovalidate><icon name="key" /><span>Generate key pair</span></button>
                </mat-form-buttons>
                <p class="mat-hint">For hosts that only allow root login via key (<code>PermitRootLogin prohibit-password</code>). MatDock generates the pair, and you install the public key on the host.</p>
            </div>
            </div>

            <mat-form-buttons>
                <button type="submit" asp-page-handler="Save" class="mat-btn mat-btn--primary"><icon name="save" /><span>Save</span></button>
                <button type="submit" asp-page-handler="Test" class="mat-btn" formnovalidate><icon name="plug" /><span>Test connection</span></button>
                <a href="/Environments" class="mat-btn mat-btn--ghost"><icon name="back" /><span>Back</span></a>
            </mat-form-buttons>
        </form>

        @if (Model.IsEdit)
        {
            <div class="mat-buttons" style="margin-top:16px;border-top:1px solid var(--border);padding-top:16px;">
                <form method="post" asp-page-handler="Toggle" style="display:inline;">
                    <input type="hidden" name="id" value="@Model.Input.Id" />
                    <input type="hidden" name="enable" value="@((!Model.IsEnabled).ToString().ToLowerInvariant())" />
                    <button type="submit" class="mat-btn" formnovalidate>
                        <icon name="@(Model.IsEnabled ? "lock" : "check-circle")" /><span>@(Model.IsEnabled ? "Disable" : "Enable")</span>
                    </button>
                </form>
                <form method="post" asp-page-handler="Delete" data-confirm="Really delete environment '@Model.Input.Name'? This cannot be undone." style="display:inline;">
                    <input type="hidden" name="id" value="@Model.Input.Id" />
                    <button type="submit" class="mat-btn mat-btn--danger"><icon name="trash" /><span>Delete</span></button>
                </form>
            </div>
        }
    </div>
</div>
