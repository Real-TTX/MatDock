@page
@model MatDock.Web.Pages.Environments.EditModel
@{
    ViewData["Title"] = Model.IsEdit ? "Edit environment" : "New environment";
    ViewData["Crumbs"] = new List<(string Text, string? Url)> { ("Environments", "/Environments") };
    ViewData["Width"] = "narrow";
}

@if (Model.TestResult is not null)
{
    <div class="mat-alert @(Model.TestResult.Success ? "mat-alert--success" : "mat-alert--danger")">
        <icon name="@(Model.TestResult.Success ? "check-circle" : "x-circle")" />
        <div class="mat-alert__body">@Model.TestResult.Message</div>
    </div>
}

<div class="mat-card">
    <div class="mat-card__body">
        <form method="post" class="mat-form">
            <input type="hidden" asp-for="Input.Id" />
            <partial name="_ValidationSummary" />

            <div class="mat-form__grid">
                <mat-field label="Name" asp-for="Input.Name" class="mat-field--full">
                    <input asp-for="Input.Name" class="mat-input" placeholder="e.g. Production" />
                </mat-field>

                <mat-field label="Description" asp-for="Input.Description" class="mat-field--full">
                    <input asp-for="Input.Description" class="mat-input" placeholder="Optional" />
                </mat-field>

                <mat-field label="Base URL" asp-for="Input.BaseUrl" class="mat-field--full" hint="Optional. Used for 'Open' links; a container can override it with the label matdock.openurl.">
                    <input asp-for="Input.BaseUrl" class="mat-input" placeholder="https://host.example.com" />
                </mat-field>

                <mat-field label="Connection type" asp-for="Input.ConnectionType" class="mat-field--full">
                    <select asp-for="Input.ConnectionType" id="ConnectionType" class="mat-select">
                        <option value="Ssh">SSH (remote host)</option>
                        <option value="Local">Local (Docker socket)</option>
                        <option value="Tcp">Docker API (TCP/TLS)</option>
                    </select>
                </mat-field>
            </div>

            <div data-show-when="ConnectionType=Local">
                <div class="mat-alert mat-alert--info">
                    <icon name="server" /><div class="mat-alert__body">Requires <code>-v /var/run/docker.sock:/var/run/docker.sock</code>.</div>
                </div>
            </div>

            <div data-show-when="ConnectionType=Ssh,Tcp">
                <div class="mat-form__grid">
                    <mat-field label="Host" asp-for="Input.Host">
                        <input asp-for="Input.Host" class="mat-input" placeholder="host.example.com or 10.0.0.5" />
                    </mat-field>

                    <mat-field label="Port" asp-for="Input.Port" hint="SSH: 22. Docker API: 2376 with TLS, 2375 without.">
                        <input asp-for="Input.Port" type="number" min="1" max="65535" class="mat-input" />
                    </mat-field>
                </div>
            </div>

            <div data-show-when="ConnectionType=Tcp">
                <div class="mat-alert mat-alert--warning"><icon name="alert" /><div class="mat-alert__body">Without TLS anyone who reaches the port controls Docker on that host. Use the certificates of the daemon (<code>--tlsverify</code>).</div></div>
                <mat-field label="CA certificate (ca.pem)" asp-for="Input.TlsCa">
                    <textarea asp-for="Input.TlsCa" class="mat-textarea mat-mono" rows="4" spellcheck="false" placeholder="-----BEGIN CERTIFICATE-----"></textarea>
                </mat-field>
                <mat-field label="Client certificate (cert.pem)" asp-for="Input.TlsCert">
                    <textarea asp-for="Input.TlsCert" class="mat-textarea mat-mono" rows="4" spellcheck="false" placeholder="-----BEGIN CERTIFICATE-----"></textarea>
                </mat-field>
                <mat-field label="Client key (key.pem)" asp-for="Input.TlsKey" hint="@(Model.IsEdit ? "Leave empty to keep the stored key." : null)">
                    <textarea asp-for="Input.TlsKey" class="mat-textarea mat-mono" rows="4" spellcheck="false" placeholder="-----BEGIN PRIVATE KEY-----"></textarea>
                </mat-field>
            </div>

            <div data-show-when="ConnectionType=Ssh">
                <div class="mat-form__grid">
                    <mat-field label="SSH user" asp-for="Input.Username">
                        <input asp-for="Input.Username" class="mat-input" autocomplete="off" placeholder="e.g. root" />
                    </mat-field>

                    <mat-field label="Authentication" asp-for="Input.AuthType">
                        <select asp-for="Input.AuthType" id="AuthType" class="mat-select">
                            <option value="Password">Password</option>
                            <option value="PrivateKey">SSH key</option>
                        </select>
                    </mat-field>
                </div>

            @{
                var secretHint = Model.IsEdit ? "Leave empty to keep the stored one (only while host, port and user stay the same)." : null;
            }

            <div data-show-when="AuthType=Password">
                <mat-field label="Password" asp-for="Input.Password" hint="@secretHint">
                    <input asp-for="Input.Password" type="password" class="mat-input" autocomplete="new-password" />
                </mat-field>
            </div>

            <div data-show-when="AuthType=PrivateKey">
                @if (!string.IsNullOrEmpty(Model.GeneratedPublicKey))
                {
                    <div class="mat-alert mat-alert--success">
                        <icon name="key" />
                        <div class="mat-alert__body mat-stack mat-stack--sm">
                        <div><strong>Install the public key on the host:</strong> run once on <code>@Model.Input.Host</code> as <code>@Model.Input.Username</code> (then <em>Save</em> below):</div>
                        <textarea class="mat-textarea mat-mono" rows="2" readonly data-select-on-click>mkdir -p ~/.ssh &amp;&amp; chmod 700 ~/.ssh &amp;&amp; echo '@Model.GeneratedPublicKey' &gt;&gt; ~/.ssh/authorized_keys &amp;&amp; chmod 600 ~/.ssh/authorized_keys</textarea>
                        </div>
                    </div>
                }
                <mat-field label="Private SSH key (PEM)" asp-for="Input.PrivateKeyPem" hint="@secretHint">
                    <textarea asp-for="Input.PrivateKeyPem" class="mat-textarea" rows="6" placeholder="-----BEGIN OPENSSH PRIVATE KEY-----"></textarea>
                </mat-field>
                <mat-field label="Key passphrase" asp-for="Input.PrivateKeyPassphrase" hint="Optional, if the key is encrypted.">
                    <input asp-for="Input.PrivateKeyPassphrase" type="password" class="mat-input" autocomplete="new-password" />
                </mat-field>
                <mat-form-buttons>
                    <button type="submit" asp-page-handler="GenerateKey" class="mat-btn mat-btn--secondary" formnovalidate><icon name="key" /><span>Generate key pair</span></button>
                </mat-form-buttons>
                <p class="mat-hint">MatDock generates the pair; you install the public key on the host.</p>
            </div>

            @if (Model.IsEdit)
            {
                <mat-field label="Host key" hint="Saved at the first connection; a server that shows another key is refused.">
                    <div class="mat-row">
                        <code class="mat-mono">@(Model.HostKeyFingerprint ?? "not saved yet")</code>
                        @if (Model.HostKeyFingerprint is not null)
                        {
                            <button type="submit" form="forget-key-form" class="mat-btn mat-btn--secondary mat-btn--sm" data-confirm="Forget the saved host key? Only do this when the server was reinstalled."><icon name="key" /><span>Forget</span></button>
                        }
                    </div>
                </mat-field>
            }
            </div>

            <mat-form-buttons>
                <button type="submit" asp-page-handler="Save" class="mat-btn mat-btn--primary"><icon name="save" /><span>Save</span></button>
                <button type="submit" asp-page-handler="Test" class="mat-btn mat-btn--secondary" formnovalidate><icon name="plug" /><span>Test connection</span></button>
                @if (Model.IsEdit)
                {
                    <button type="submit" form="toggle-form" class="mat-btn mat-btn--secondary">
                        <icon name="@(Model.IsEnabled ? "lock" : "check-circle")" /><span>@(Model.IsEnabled ? "Disable" : "Enable")</span>
                    </button>
                }
                <a href="/Environments" class="mat-btn mat-btn--ghost"><icon name="back" /><span>Back</span></a>
                @if (Model.IsEdit)
                {
                    <span class="mat-btn-row__spacer"></span>
                    <button type="submit" form="delete-form" class="mat-btn mat-btn--danger" data-confirm="Delete environment '@Model.Input.Name'?"><icon name="trash" /><span>Delete</span></button>
                }
            </mat-form-buttons>
        </form>

        @if (Model.IsEdit)
        {
            <form method="post" asp-page-handler="Toggle" id="toggle-form">
                <input type="hidden" name="id" value="@Model.Input.Id" />
                <input type="hidden" name="enable" value="@((!Model.IsEnabled).ToString().ToLowerInvariant())" />
            </form>
            <form method="post" asp-page-handler="ForgetHostKey" id="forget-key-form"><input type="hidden" name="id" value="@Model.Input.Id" /></form>
            <form method="post" asp-page-handler="Delete" id="delete-form"><input type="hidden" name="id" value="@Model.Input.Id" /></form>
        }
    </div>
</div>
