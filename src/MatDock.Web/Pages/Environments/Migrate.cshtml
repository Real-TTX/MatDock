@page
@model MatDock.Web.Pages.Environments.MigrateModel
@{
    ViewData["Title"] = "Migrate volumes";
    var selected = new HashSet<string>(Model.Input.SourceVolumes, StringComparer.Ordinal);
    var selCount = Model.Input.SourceVolumes.Count;
}

<div class="page-head">
    <div class="page-head__title">
        <h1>Migrate volumes</h1>
        <span class="page-head__subtitle">Transfer one or more volumes from one environment to another</span>
    </div>
    <div class="mat-buttons">
        <a href="/Volumes?EnvId=@Model.Input.SourceEnvId" class="mat-btn mat-btn--ghost"><icon name="back" /><span>Back</span></a>
    </div>
</div>

@if (Model.Results.Count > 0)
{
    var okCount = Model.Results.Count(r => r.Success);
    <div class="result-banner @(okCount == Model.Results.Count ? "result-banner--ok" : "result-banner--fail")">
        <icon name="@(okCount == Model.Results.Count ? "check-circle" : "alert")" />
        <div>
            <div class="result-banner__big">@okCount / @Model.Results.Count migrated</div>
            <div class="result-banner__sub">Result of the migration</div>
        </div>
    </div>
    <ul class="result-steps">
        @foreach (var r in Model.Results)
        {
            <li>
                <icon name="@(r.Success ? "check-circle" : "x-circle")" />
                <span><strong>@r.Label</strong> — @r.Message</span>
            </li>
        }
    </ul>
    <a href="/Volumes?EnvId=@Model.Input.SourceEnvId" class="mat-btn mat-btn--primary"><icon name="volume" /><span>Go to volumes</span></a>
}

@if (Model.SourceEnvironment is null)
{
    <div class="alert alert--error"><icon name="x-circle" /><span>Source environment not found.</span></div>
}
else if (Model.TargetEnvironments.Count == 0)
{
    <div class="alert alert--warning">
        <icon name="alert" />
        <span>A migration requires at least two environments. Create another environment first.</span>
    </div>
}
else if (Model.Results.Count == 0)
{
    <form method="post" data-confirm="Start migration now?">
        <input type="hidden" asp-for="Input.SourceEnvId" />
        <div asp-validation-summary="ModelOnly"></div>

        <div class="migrate">
            <div class="migrate__side migrate__side--source">
                <h3><icon name="server" /><span>Source</span></h3>
                <div class="migrate__env">@Model.SourceEnvironment.Name</div>
                <div class="migrate__host">@Model.SourceEnvironment.Username@@@Model.SourceEnvironment.Host</div>

                <label class="mat-label" style="display:block;margin-bottom:6px;">Volumes to migrate</label>
                @if (Model.LoadError is not null)
                {
                    <div class="alert alert--error"><icon name="x-circle" /><span>@Model.LoadError</span></div>
                }
                else if (Model.AvailableVolumes.Count == 0)
                {
                    <div class="alert alert--warning"><icon name="alert" /><span>No volumes on this environment.</span></div>
                }
                else
                {
                    <div class="vol-picker" data-migrate-volumes>
                        <div class="vol-picker__head">
                            <a href="#" class="mat-link" data-vol-all>Select all</a>
                            <span class="text-muted">·</span>
                            <a href="#" class="mat-link" data-vol-none>None</a>
                        </div>
                        <div class="vol-picker__list">
                            @foreach (var v in Model.AvailableVolumes)
                            {
                                <label class="mat-check vol-picker__row">
                                    <input type="checkbox" class="mig-vol" name="Input.SourceVolumes" value="@v" checked="@selected.Contains(v)" />
                                    <span><icon name="volume" /> @v</span>
                                </label>
                            }
                        </div>
                    </div>
                }
            </div>

            <div class="migrate__arrow"><icon name="chevron-right" /></div>

            <div class="migrate__side migrate__side--target">
                <h3><icon name="server" /><span>Target</span></h3>
                <div class="mat-form">
                    <mat-field label="Target environment" asp-for="Input.TargetEnvId">
                        <select asp-for="Input.TargetEnvId" class="mat-select">
                            @foreach (var env in Model.TargetEnvironments)
                            {
                                <option value="@env.Id">@env.Name — @env.Host</option>
                            }
                        </select>
                    </mat-field>
                    <mat-field id="mig-rename" hidden="@(selCount != 1)" label="Target volume name" asp-for="Input.TargetVolume" hint="Rename on the target (single volume only).">
                        <input asp-for="Input.TargetVolume" class="mat-input" />
                    </mat-field>
                    <div id="mig-multi-note" class="alert alert--info" hidden="@(selCount <= 1)">
                        <icon name="volume" />
                        <span>Each selected volume is created on the target with the same name.</span>
                    </div>
                    <label class="mat-check">
                        <input asp-for="Input.Overwrite" type="checkbox" />
                        <span>Overwrite if a target volume already contains data</span>
                    </label>
                </div>
            </div>
        </div>

        <div class="mat-form" style="margin-top:20px;">
            <mat-field label="Migration type" asp-for="Input.Mode">
                <select asp-for="Input.Mode" id="MigrationMode" class="mat-select">
                    <option value="Direct">Direct (streaming) — fast, no intermediate storage</option>
                    <option value="ViaBackup">Via backup (with safety copy) — Backup → Restore</option>
                </select>
            </mat-field>
        </div>

        <div data-show-when="MigrationMode=Direct">
            <div class="alert alert--info">
                <icon name="alert" />
                <span>The data is streamed directly over SSH via <code>tar</code> (source → target), without intermediate storage. The source is mounted read-only. Prerequisite: Docker + the helper image (<code>busybox</code>) on both hosts.</span>
            </div>
        </div>

        <div data-show-when="MigrationMode=ViaBackup">
            <div class="mat-form">
                <mat-field label="Backup target (intermediate storage)" asp-for="Input.BackupTargetId">
                    <select asp-for="Input.BackupTargetId" class="mat-select">
                        <option value="0">Local (MatDock /data)</option>
                        @foreach (var t in Model.BackupTargets)
                        {
                            <option value="@t.Id">@t.Name</option>
                        }
                    </select>
                </mat-field>
                <label class="mat-check">
                    <input asp-for="Input.KeepBackup" type="checkbox" />
                    <span>Keep backups after a successful migration (safety net)</span>
                </label>
            </div>
            <div class="alert alert--info">
                <icon name="save" />
                <span>Each volume is first saved as a backup and then restored into the target. The backup is always kept if an error occurs and can be restored again. Requires free space (~volume size) at the backup target.</span>
            </div>
        </div>

        <div class="mat-form" style="margin-top:16px;">
            @if (Model.AffectedContainers.Count > 0)
            {
                <div class="alert alert--info" style="flex-direction:column;align-items:stretch;gap:8px;">
                    <div><icon name="box" /> <strong>@Model.AffectedContainers.Count container(s)</strong> use the selected volume(s):</div>
                    <div style="display:flex;flex-wrap:wrap;gap:6px;">
                        @foreach (var c in Model.AffectedContainers)
                        {
                            <span class="pill @(c.IsRunning ? "pill--online" : "pill--unknown")">@c.Name</span>
                        }
                    </div>
                </div>
            }
            <label class="mat-check">
                <input asp-for="Input.StopContainers" type="checkbox" />
                <span>Stop containers during the operation and restart them afterwards (consistent snapshot)</span>
            </label>
        </div>

        <mat-form-buttons>
            <button type="submit" id="mig-start" class="mat-btn mat-btn--primary" disabled="@(selCount == 0)">
                <icon name="server" /><span>Start migration (<span id="mig-count">@selCount</span>)</span>
            </button>
            <a href="/Volumes?EnvId=@Model.Input.SourceEnvId" class="mat-btn mat-btn--ghost"><icon name="back" /><span>Cancel</span></a>
        </mat-form-buttons>
    </form>
}
