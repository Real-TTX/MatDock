@page
@model MatDock.Web.Pages.Environments.MigrateModel
@{
    ViewData["Title"] = "Migrate volumes";
    var selected = new HashSet<string>(Model.Input.SourceVolumes, StringComparer.Ordinal);
    var selCount = Model.Input.SourceVolumes.Count;
    ViewData["Crumbs"] = new List<(string Text, string? Url)> { ("Volumes", $"/Volumes?EnvId={Model.Input.SourceEnvId}") };
}

@if (Model.Results.Count > 0)
{
    var okCount = Model.Results.Count(r => r.Success);
    <div class="mat-alert @(okCount == Model.Results.Count ? "mat-alert--success" : "mat-alert--danger")" role="status">
        <icon name="@(okCount == Model.Results.Count ? "check-circle" : "alert")" />
        <div class="mat-alert__body">
            <strong class="mat-alert__title">@okCount / @Model.Results.Count migrated</strong>
            <ul class="mat-alert__list">
                @foreach (var r in Model.Results)
                {
                    <li><strong>@r.Label</strong> — @(r.Success ? "" : "failed: ")@r.Message</li>
                }
            </ul>
            <div class="mat-alert__actions">
                <a href="/Volumes?EnvId=@Model.Input.SourceEnvId" class="mat-btn mat-btn--primary mat-btn--sm"><icon name="volume" /><span>Go to volumes</span></a>
            </div>
        </div>
    </div>
}

@if (Model.SourceEnvironment is null)
{
    <div class="mat-alert mat-alert--danger"><icon name="x-circle" /><div class="mat-alert__body">Source environment not found.</div></div>
}
else if (Model.TargetEnvironments.Count == 0)
{
    <div class="mat-alert mat-alert--warning">
        <icon name="alert" />
        <div class="mat-alert__body">A migration requires at least two environments. Create another environment first.</div>
    </div>
}
else if (Model.Results.Count == 0)
{
    <form method="post" data-confirm="Start migration now?">
        <input type="hidden" asp-for="Input.SourceEnvId" />
        <partial name="_ValidationSummary" />

        <div class="md-migrate">
            <div class="mat-card md-migrate__side">
                <div class="mat-card__head"><icon name="server" /><h2 class="mat-card__title">Source</h2></div>
                <div class="mat-card__body mat-stack">
                <select class="mat-select" data-nav-select="/Environments/Migrate?sourceId={v}" aria-label="Source environment">
                    @foreach (var env in Model.SourceEnvironments)
                    {
                        <option value="@env.Id" selected="@(env.Id == Model.Input.SourceEnvId)">@env.Name — @env.Host</option>
                    }
                </select>

                <span class="mat-label">Volumes to migrate</span>
                @if (Model.LoadError is not null)
                {
                    <div class="mat-alert mat-alert--danger"><icon name="x-circle" /><div class="mat-alert__body">@Model.LoadError</div></div>
                }
                else if (Model.AvailableVolumes.Count == 0)
                {
                    <div class="mat-alert mat-alert--warning"><icon name="alert" /><div class="mat-alert__body">No volumes on this environment.</div></div>
                }
                else
                {
                    <div class="md-vol-picker" data-migrate-volumes>
                        <div class="mat-input-icon">
                            <icon name="search" />
                            <input type="search" class="mat-input" data-vol-filter placeholder="Filter volumes…" autocomplete="off" aria-label="Filter volumes" />
                        </div>
                        <div class="mat-row">
                            <a href="#" class="" data-vol-all>Select all</a>
                            <span class="mat-muted">·</span>
                            <a href="#" class="" data-vol-none>None</a>
                            <span class="mat-small mat-muted"><span data-vol-shown>@Model.AvailableVolumes.Count</span> / @Model.AvailableVolumes.Count</span>
                        </div>
                        <div class="md-vol-picker__list">
                            @foreach (var v in Model.AvailableVolumes)
                            {
                                <label class="mat-check" data-vol-row data-name="@v">
                                    <input type="checkbox" data-vol-check name="Input.SourceVolumes" value="@v" checked="@selected.Contains(v)" />
                                    <span class="mat-text-break"><icon name="volume" /> @v</span>
                                </label>
                            }
                        </div>
                    </div>
                }
                </div>
            </div>

            <div class="md-migrate__arrow" aria-hidden="true"><icon name="arrow-right" /></div>

            <div class="mat-card md-migrate__side">
                <div class="mat-card__head"><icon name="server" /><h2 class="mat-card__title">Target</h2></div>
                <div class="mat-card__body mat-form">
                    <mat-field label="Target environment" asp-for="Input.TargetEnvId">
                        <select asp-for="Input.TargetEnvId" class="mat-select">
                            @foreach (var env in Model.TargetEnvironments)
                            {
                                <option value="@env.Id">@env.Name — @env.Host</option>
                            }
                        </select>
                    </mat-field>
                    <mat-field id="mig-rename" hidden="@(selCount != 1)" label="Target volume name" asp-for="Input.TargetVolume" hint="Rename on the target (single volume only).">
                        <input asp-for="Input.TargetVolume" class="mat-input" />
                    </mat-field>
                    <div id="mig-multi-note" class="mat-alert mat-alert--info" hidden="@(selCount <= 1)">
                        <icon name="volume" />
                        <div class="mat-alert__body">Each selected volume is created on the target with the same name.</div>
                    </div>
                    <label class="mat-check">
                        <input asp-for="Input.Overwrite" type="checkbox" />
                        <span>Overwrite if a target volume already contains data</span>
                    </label>
                </div>
            </div>
        </div>

        <div class="mat-form mat-mt-6">
            <mat-field label="Migration type" asp-for="Input.Mode">
                <select asp-for="Input.Mode" id="MigrationMode" class="mat-select">
                    <option value="Direct">Direct (streaming) — fast, no intermediate storage</option>
                    <option value="ViaBackup">Via backup (with safety copy) — Backup → Restore</option>
                </select>
            </mat-field>
        </div>

        <div data-show-when="MigrationMode=Direct">
            <div class="mat-alert mat-alert--info">
                <icon name="info" />
                <div class="mat-alert__body">Streams the data over SSH with <code>tar</code>; needs <code>busybox</code> on both hosts.</div>
            </div>
        </div>

        <div data-show-when="MigrationMode=ViaBackup">
            <div class="mat-form">
                <mat-field label="Backup target (intermediate storage)" asp-for="Input.BackupTargetId">
                    <select asp-for="Input.BackupTargetId" class="mat-select">
                        <option value="0">Local (MatDock /data)</option>
                        @foreach (var t in Model.BackupTargets)
                        {
                            <option value="@t.Id">@t.Name</option>
                        }
                    </select>
                </mat-field>
                <label class="mat-check">
                    <input asp-for="Input.KeepBackup" type="checkbox" />
                    <span>Keep backups after a successful migration (safety net)</span>
                </label>
            </div>
            <div class="mat-alert mat-alert--info">
                <icon name="save" />
                <div class="mat-alert__body">Backs up each volume, then restores it on the target; needs free space at the backup target.</div>
            </div>
        </div>

        <div class="mat-mt-4 mat-form">
            @if (Model.AffectedContainers.Count > 0)
            {
                <div class="mat-alert mat-alert--info">
                    <icon name="box" />
                    <div class="mat-alert__body">
                    <strong>@Model.AffectedContainers.Count container(s)</strong> use the selected volume(s):
                    <div class="mat-row mat-gap-2 mat-mt-2">
                        @foreach (var c in Model.AffectedContainers)
                        {
                            <span class="mat-pill @(c.IsRunning ? "mat-pill--ok" : "mat-pill--plain")">@c.Name</span>
                        }
                    </div>
                    </div>
                </div>
            }
            <label class="mat-check">
                <input asp-for="Input.StopContainers" type="checkbox" />
                <span>Stop containers during migration</span>
            </label>
        </div>

        <mat-form-buttons>
            <button type="submit" id="mig-start" class="mat-btn mat-btn--primary" disabled="@(selCount == 0)">
                <icon name="server" /><span>Start migration (<span id="mig-count">@selCount</span>)</span>
            </button>
            <a href="/Volumes?EnvId=@Model.Input.SourceEnvId" class="mat-btn mat-btn--ghost"><icon name="back" /><span>Back</span></a>
        </mat-form-buttons>
    </form>
}
