@page
@model MatDock.Web.Pages.Environments.MigrateModel
@{
    ViewData["Title"] = "Migrate volume";
}

<div class="page-head">
    <div class="page-head__title">
        <h1>Migrate volume</h1>
        <span class="page-head__subtitle">Transfer a volume from one environment to another</span>
    </div>
    <div class="mat-buttons">
        <a href="/Volumes?EnvId=@Model.Input.SourceEnvId" class="mat-btn mat-btn--ghost"><icon name="back" /><span>Back</span></a>
    </div>
</div>

@if (Model.Result is not null)
{
    <div class="result-banner @(Model.Result.Success ? "result-banner--ok" : "result-banner--fail")">
        <icon name="@(Model.Result.Success ? "check-circle" : "x-circle")" />
        <div>
            <div class="result-banner__big">@(Model.Result.Success ? "Migration successful" : "Migration failed")</div>
            <div class="result-banner__sub">@Model.Result.Message</div>
        </div>
    </div>
    @if (Model.Result.Steps.Count > 0)
    {
        <ul class="result-steps">
            @foreach (var step in Model.Result.Steps)
            {
                <li><icon name="check-circle" /><span>@step</span></li>
            }
        </ul>
    }
}

@if (Model.SourceEnvironment is null)
{
    <div class="alert alert--error"><icon name="x-circle" /><span>Source environment not found.</span></div>
}
else if (Model.TargetEnvironments.Count == 0)
{
    <div class="alert alert--warning">
        <icon name="alert" />
        <span>A migration requires at least two environments. Create another environment first.</span>
    </div>
}
else
{
    <form method="post" data-confirm="Start migration now?">
        <input type="hidden" asp-for="Input.SourceEnvId" />
        <input type="hidden" asp-for="Input.SourceVolume" />
        <div asp-validation-summary="ModelOnly"></div>

        <div class="migrate">
            <div class="migrate__side migrate__side--source">
                <h3><icon name="server" /><span>Source</span></h3>
                <div class="migrate__env">@Model.SourceEnvironment.Name</div>
                <div class="migrate__host">@Model.SourceEnvironment.Username@@@Model.SourceEnvironment.Host</div>
                <div class="migrate__vol"><icon name="volume" /><span>@Model.Input.SourceVolume</span></div>
            </div>

            <div class="migrate__arrow"><icon name="chevron-right" /></div>

            <div class="migrate__side migrate__side--target">
                <h3><icon name="server" /><span>Target</span></h3>
                <div class="mat-form">
                    <mat-field label="Target environment" asp-for="Input.TargetEnvId">
                        <select asp-for="Input.TargetEnvId" class="mat-select">
                            @foreach (var env in Model.TargetEnvironments)
                            {
                                <option value="@env.Id">@env.Name — @env.Host</option>
                            }
                        </select>
                    </mat-field>
                    <mat-field label="Target volume" asp-for="Input.TargetVolume">
                        <input asp-for="Input.TargetVolume" class="mat-input" />
                    </mat-field>
                    <label class="mat-check">
                        <input asp-for="Input.Overwrite" type="checkbox" />
                        <span>Overwrite if the target volume already contains data</span>
                    </label>
                </div>
            </div>
        </div>

        <div class="mat-form" style="margin-top:20px;">
            <mat-field label="Migration type" asp-for="Input.Mode">
                <select asp-for="Input.Mode" id="MigrationMode" class="mat-select">
                    <option value="Direct">Direct (streaming) — fast, no intermediate storage</option>
                    <option value="ViaBackup">Via backup (with safety copy) — Backup → Restore</option>
                </select>
            </mat-field>
        </div>

        <div data-show-when="MigrationMode=Direct">
            <div class="alert alert--info">
                <icon name="alert" />
                <span>The data is streamed directly over SSH via <code>tar</code> (source → target), without intermediate storage. The source is mounted read-only. Prerequisite: Docker + the helper image (<code>busybox</code>) on both hosts.</span>
            </div>
        </div>

        <div data-show-when="MigrationMode=ViaBackup">
            <div class="mat-form">
                <mat-field label="Backup target (intermediate storage)" asp-for="Input.BackupTargetId">
                    <select asp-for="Input.BackupTargetId" class="mat-select">
                        <option value="0">Local (MatDock /data)</option>
                        @foreach (var t in Model.BackupTargets)
                        {
                            <option value="@t.Id">@t.Name</option>
                        }
                    </select>
                </mat-field>
                <label class="mat-check">
                    <input asp-for="Input.KeepBackup" type="checkbox" />
                    <span>Keep backup after a successful migration (safety net)</span>
                </label>
            </div>
            <div class="alert alert--info">
                <icon name="save" />
                <span>The source is first saved as a backup and then restored into the target. The backup is always kept if an error occurs and can be restored again. Requires free space (~volume size) at the backup target.</span>
            </div>
        </div>

        <div class="mat-form" style="margin-top:16px;">
            @if (Model.AffectedContainers.Count > 0)
            {
                <div class="alert alert--info" style="flex-direction:column;align-items:stretch;gap:8px;">
                    <div><icon name="box" /> <strong>@Model.AffectedContainers.Count container(s)</strong> use this volume:</div>
                    <div style="display:flex;flex-wrap:wrap;gap:6px;">
                        @foreach (var c in Model.AffectedContainers)
                        {
                            <span class="pill @(c.IsRunning ? "pill--online" : "pill--unknown")">@c.Name</span>
                        }
                    </div>
                </div>
            }
            <label class="mat-check">
                <input asp-for="Input.StopContainers" type="checkbox" />
                <span>Stop containers during the operation and restart them afterwards (consistent snapshot)</span>
            </label>
        </div>

        <mat-form-buttons>
            <button type="submit" class="mat-btn mat-btn--primary">
                <icon name="server" /><span>Start migration</span>
            </button>
            <a href="/Volumes?EnvId=@Model.Input.SourceEnvId" class="mat-btn mat-btn--ghost"><icon name="back" /><span>Cancel</span></a>
        </mat-form-buttons>
    </form>
}
