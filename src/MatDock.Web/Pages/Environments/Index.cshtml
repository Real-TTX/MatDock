@page
@model MatDock.Web.Pages.Environments.IndexModel
@{
    ViewData["Title"] = "Environments";
    var isGallery = string.Equals(Model.View, "gallery", StringComparison.OrdinalIgnoreCase);
    string Fb(long b) => MatDock.Core.Volumes.VolumeMigrationResult.FormatBytes(b);
    string ViewUrl(string v) => $"/Environments?view={v}"
        + $"&Q={Uri.EscapeDataString(Model.Q ?? string.Empty)}"
        + $"&Status={Uri.EscapeDataString(Model.Status ?? string.Empty)}"
        + $"&SortKey={Uri.EscapeDataString(Model.SortKey)}";
}

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    if (Model.IsError)
    {
        <div class="mat-alert mat-alert--danger" role="alert"><icon name="x-circle" /><div class="mat-alert__body">@Model.StatusMessage</div></div>
    }
    else
    {
        <div data-toast="@Model.StatusMessage" data-tone="success" hidden></div>
    }
}

<mat-table>
    <mat-table-toolbar>
        <form method="get" class="mat-row mat-flex-grow js-autosubmit">
            <input type="hidden" name="view" value="@Model.View" />
            <div class="mat-input-icon mat-toolbar__search">
                <icon name="search" />
                <input type="search" name="Q" value="@Model.Q" class="mat-input" placeholder="Search (name, host, user)…" aria-label="Search environments" />
            </div>
            <label class="mat-sr-only" for="filter-status">Status</label>
            <select id="filter-status" name="Status" class="mat-select mat-w-auto">
                <option value="">All statuses</option>
                @foreach (var st in new[] { EnvironmentStatus.Online, EnvironmentStatus.Offline, EnvironmentStatus.Error, EnvironmentStatus.Unknown })
                {
                    <option value="@st" selected="@(Model.Status == st.ToString())">@st</option>
                }
            </select>
            <label class="mat-sr-only" for="sort-field">Sort</label>
            <select id="sort-field" name="SortKey" class="mat-select mat-w-auto">
                <option value="NameAsc" selected="@(Model.SortKey == "NameAsc")">A–Z: Name</option>
                <option value="NameDesc" selected="@(Model.SortKey == "NameDesc")">Z–A: Name</option>
                <option value="HostAsc" selected="@(Model.SortKey == "HostAsc")">A–Z: Host</option>
                <option value="HostDesc" selected="@(Model.SortKey == "HostDesc")">Z–A: Host</option>
                <option value="StatusAsc" selected="@(Model.SortKey == "StatusAsc")">A–Z: Status</option>
                <option value="StatusDesc" selected="@(Model.SortKey == "StatusDesc")">Z–A: Status</option>
                <option value="CheckedDesc" selected="@(Model.SortKey == "CheckedDesc")">9–0: Last checked</option>
                <option value="CheckedAsc" selected="@(Model.SortKey == "CheckedAsc")">0–9: Last checked</option>
            </select>
        </form>
        <div class="mat-toolbar__end mat-btn-group" role="group" aria-label="View">
            <a href="@ViewUrl("list")" class="mat-btn mat-btn--secondary mat-btn--icon mat-btn--sm @(isGallery ? "" : "is-active")" aria-current="@(isGallery ? null : "true")" title="List" aria-label="List"><icon name="list" /></a>
            <a href="@ViewUrl("gallery")" class="mat-btn mat-btn--secondary mat-btn--icon mat-btn--sm @(isGallery ? "is-active" : "")" aria-current="@(isGallery ? "true" : null)" title="Gallery" aria-label="Gallery"><icon name="grid" /></a>
        </div>
    </mat-table-toolbar>

    <mat-table-body>
        <div id="live-environments" data-live="30">
        @if (Model.Items.Count == 0)
        {
            <div class="mat-empty mat-empty--framed">
                <div class="mat-empty__icon"><icon name="server" /></div>
                <p>No environments found.</p>
            </div>
        }
        else if (isGallery)
        {
            <div class="mat-grid">
                @foreach (var env in Model.Items)
                {
                    var st = Model.Stats.TryGetValue(env.Id, out var s) ? s : new MatDock.Core.Docker.HostStats();
                    <partial name="_EnvCard" model="new EnvCardModel(env, st, st.RunningContainers, OnDashboard: false)" />
                }
            </div>
        }
        else
        {
            <div class="mat-table-wrap">
            <table class="mat-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Connection</th>
                        <th>Status</th>
                        <th>Resources</th>
                        <th class="mat-num">Containers</th>
                        <th>Docker</th>
                        <th>Last checked</th>
                        <th><span class="mat-sr-only">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var env in Model.Items)
                    {
                        var st = Model.Stats.TryGetValue(env.Id, out var s) ? s : new MatDock.Core.Docker.HostStats();
                        var usage = new[]
                        {
                            ("RAM", st.MemPercent, st.MemTotalBytes is not null, $"RAM: {Fb(st.MemUsedBytes ?? 0)} / {Fb(st.MemTotalBytes ?? 0)}"),
                            ("CPU", st.CpuPercent, st.Cores is not null, $"CPU: load {st.Load1?.ToString("0.00") ?? "?"} / {st.Cores?.ToString() ?? "?"} cores"),
                            ("Disk", st.DiskPercent, st.DiskTotalBytes is not null, $"Disk: {Fb(st.DiskUsedBytes ?? 0)} / {Fb(st.DiskTotalBytes ?? 0)}"),
                        };
                        <tr>
                            <td data-label="Name">
                                <a href="/Environments/Detail?id=@env.Id"><strong>@env.Name</strong></a>
                                @if (!env.IsEnabled)
                                {
                                    <span class="mat-pill mat-pill--plain">Disabled</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(env.Description))
                                {
                                    <div class="mat-small mat-muted">@env.Description</div>
                                }
                            </td>
                            <td data-label="Connection" class="mat-mono">@MatDock.Web.Support.EnvironmentView.Address(env)</td>
                            <td data-label="Status"><partial name="_StatusPill" model="env.Status" /></td>
                            <td data-label="Resources">
                                @if (st.Cores is null && st.MemTotalBytes is null && st.DiskTotalBytes is null)
                                {
                                    <span class="mat-muted">–</span>
                                }
                                else
                                {
                                    <div class="md-res">
                                        @foreach (var (label, pct, known, tip) in usage)
                                        {
                                            <div class="md-res__row" title="@tip">
                                                <span class="mat-muted">@label</span>
                                                <div class="mat-meter mat-meter--sm"><div class="mat-meter__fill" data-value="@EnvironmentView.Percent(pct)" data-tone="@EnvironmentView.Tone(pct)"></div></div>
                                                <span class="mat-num">@(known ? EnvironmentView.Percent(pct) + "%" : "–")</span>
                                            </div>
                                        }
                                    </div>
                                }
                            </td>
                            <td data-label="Containers" class="mat-num">@(st.RunningContainers?.ToString() ?? "–")</td>
                            <td data-label="Docker" class="mat-muted">@(env.DockerVersion ?? "–")</td>
                            <td data-label="Last checked" class="mat-muted mat-nowrap">@(env.LastCheckedAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "–")</td>
                            <td class="mat-table__cell-actions">
                                <div class="mat-table__actions">
                                    @if (env.IsEnabled)
                                    {
                                        @if (User.IsInRole("Admin"))
                                        {
                                            <a class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" href="/Stacks?EnvId=@env.Id" title="Stacks" aria-label="Stacks"><icon name="layers" /></a>
                                        }
                                        <a class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" href="/Containers?EnvId=@env.Id" title="Containers" aria-label="Containers"><icon name="box" /></a>
                                        <a class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" href="/Volumes?EnvId=@env.Id" title="Volumes" aria-label="Volumes"><icon name="volume" /></a>
                                        @if (User.IsInRole("Admin"))
                                        {
                                            <a class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" href="/Terminal?envId=@env.Id&name=@Uri.EscapeDataString(env.Name)" title="Shell" aria-label="Shell"><icon name="terminal" /></a>
                                        }
                                    }
                                    @if (User.IsAdmin()) { <a class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" href="/Environments/Edit?id=@env.Id" title="Edit" aria-label="Edit"><icon name="edit" /></a> }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        }
        </div>
    </mat-table-body>

    <mat-table-pagination>
        <pagination model="Model.Pagination" />
    </mat-table-pagination>

    <mat-table-actions>
        @if (User.IsAdmin())
        {
            <a href="/Environments/Edit" class="mat-btn mat-btn--primary"><icon name="plus" /><span>New environment</span></a>
        }
        <a href="@ViewUrl(Model.View)" class="mat-btn mat-btn--secondary"><icon name="refresh" /><span>Refresh</span></a>
    </mat-table-actions>
</mat-table>
