@page
@model MatDock.Web.Pages.Environments.IndexModel
@{
    ViewData["Title"] = "Environments";
    var isGallery = string.Equals(Model.View, "gallery", StringComparison.OrdinalIgnoreCase);
    string GaugeClass(double p) => p >= 90 ? "gauge__fill--crit" : p >= 70 ? "gauge__fill--warn" : "";
    string Fb(long b) => MatDock.Core.Volumes.VolumeMigrationResult.FormatBytes(b);
    string ViewUrl(string v) => $"/Environments?view={v}"
        + $"&Q={Uri.EscapeDataString(Model.Q ?? string.Empty)}"
        + $"&Status={Uri.EscapeDataString(Model.Status ?? string.Empty)}"
        + $"&Sort={Uri.EscapeDataString(Model.Sort)}&Dir={Uri.EscapeDataString(Model.Dir)}";
}

<div class="page-head">
    <div class="page-head__title">
        <h1>Environments</h1>
        <span class="page-head__subtitle">Docker-Umgebungen über SSH verwalten</span>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert @(Model.IsError ? "alert--error" : "alert--success")">
        <icon name="@(Model.IsError ? "x-circle" : "check-circle")" /><span>@Model.StatusMessage</span>
    </div>
}

<mat-table>
    <mat-table-toolbar>
        <form method="get" class="js-autosubmit" style="display:contents;">
            <input type="hidden" name="view" value="@Model.View" />
            <div class="search">
                <icon name="search" />
                <input type="search" name="Q" value="@Model.Q" class="mat-input" placeholder="Suchen (Name, Host, Benutzer)…" />
            </div>
            <div class="toolbar-field">
                <label for="filter-status"><icon name="filter" /></label>
                <select id="filter-status" name="Status" class="mat-select">
                    <option value="">Alle Status</option>
                    @foreach (var st in new[] { EnvironmentStatus.Online, EnvironmentStatus.Offline, EnvironmentStatus.Error, EnvironmentStatus.Unknown })
                    {
                        <option value="@st" selected="@(Model.Status == st.ToString())">@st</option>
                    }
                </select>
            </div>
            <div class="toolbar-field">
                <label for="sort-field">Sortieren</label>
                <select id="sort-field" name="Sort" class="mat-select">
                    <option value="name" selected="@(Model.Sort == "name")">Name</option>
                    <option value="host" selected="@(Model.Sort == "host")">Host</option>
                    <option value="status" selected="@(Model.Sort == "status")">Status</option>
                    <option value="checked" selected="@(Model.Sort == "checked")">Zuletzt geprüft</option>
                </select>
                <select name="Dir" class="mat-select" aria-label="Richtung">
                    <option value="asc" selected="@(Model.Dir == "asc")">↑</option>
                    <option value="desc" selected="@(Model.Dir == "desc")">↓</option>
                </select>
            </div>
        </form>
        <div class="view-toggle" role="group" aria-label="Ansicht" style="margin-left:auto;">
            <a href="@ViewUrl("list")" class="@(isGallery ? "" : "is-active")"><icon name="menu" /><span>Liste</span></a>
            <a href="@ViewUrl("gallery")" class="@(isGallery ? "is-active" : "")"><icon name="dashboard" /><span>Gallery</span></a>
        </div>
    </mat-table-toolbar>

    <mat-table-body>
        @if (Model.Items.Count == 0)
        {
            <div class="empty-state">
                <div><icon name="server" /></div>
                <p>Keine Environments gefunden.</p>
            </div>
        }
        else if (isGallery)
        {
            <div class="env-gallery">
                @foreach (var env in Model.Items)
                {
                    var st = Model.Stats.TryGetValue(env.Id, out var s) ? s : new MatDock.Core.Docker.HostStats();
                    var cpuPct = (int)Math.Round(st.CpuPercent);
                    var memPct = (int)Math.Round(st.MemPercent);
                    var diskPct = (int)Math.Round(st.DiskPercent);
                    <div class="env-card">
                        <div class="env-card__head">
                            <div>
                                <div class="env-card__name">
                                    <a href="/Environments/Edit?id=@env.Id">@env.Name</a>
                                    @if (!env.IsEnabled)
                                    {
                                        <span class="pill pill--unknown" style="margin-left:6px;">Deaktiviert</span>
                                    }
                                </div>
                                <div class="env-card__host">@env.Username@@@env.Host:@env.Port</div>
                            </div>
                            <partial name="_StatusPill" model="env.Status" />
                        </div>

                        <div class="env-card__gauges">
                            <div class="gauge">
                                <span class="gauge__label">CPU</span>
                                <span class="gauge__track"><span class="gauge__fill @GaugeClass(st.CpuPercent)" style="width:@(cpuPct)%"></span></span>
                                <span class="gauge__value @(st.Cores is null ? "gauge__value--muted" : "")">@(st.Cores is null ? "–" : $"Load {st.Load1:0.00}/{st.Cores}")</span>
                            </div>
                            <div class="gauge">
                                <span class="gauge__label">RAM</span>
                                <span class="gauge__track"><span class="gauge__fill @GaugeClass(st.MemPercent)" style="width:@(memPct)%"></span></span>
                                <span class="gauge__value @(st.MemTotalBytes is null ? "gauge__value--muted" : "")">@(st.MemTotalBytes is null ? "–" : $"{MatDock.Core.Volumes.VolumeMigrationResult.FormatBytes(st.MemUsedBytes ?? 0)}/{MatDock.Core.Volumes.VolumeMigrationResult.FormatBytes(st.MemTotalBytes.Value)}")</span>
                            </div>
                            <div class="gauge">
                                <span class="gauge__label">Disk</span>
                                <span class="gauge__track"><span class="gauge__fill @GaugeClass(st.DiskPercent)" style="width:@(diskPct)%"></span></span>
                                <span class="gauge__value @(st.DiskTotalBytes is null ? "gauge__value--muted" : "")">@(st.DiskTotalBytes is null ? "–" : $"{MatDock.Core.Volumes.VolumeMigrationResult.FormatBytes(st.DiskUsedBytes ?? 0)}/{MatDock.Core.Volumes.VolumeMigrationResult.FormatBytes(st.DiskTotalBytes.Value)}")</span>
                            </div>
                        </div>

                        <div class="env-card__foot">
                            <span class="mat-badge"><icon name="box" /> @(st.RunningContainers?.ToString() ?? "–") Container</span>
                            @if (!string.IsNullOrEmpty(env.DockerVersion))
                            {
                                <span class="text-muted" style="font-size:.78rem;">Docker @env.DockerVersion</span>
                            }
                            <span class="text-muted" style="font-size:.72rem;">geprüft @(env.LastCheckedAt?.ToLocalTime().ToString("dd.MM. HH:mm") ?? "nie")</span>
                            <span style="flex:1 1 auto;"></span>
                            @if (env.IsEnabled)
                            {
                                <a class="mat-btn mat-btn--sm" href="/Volumes?EnvId=@env.Id" title="Volumes"><icon name="volume" /></a>
                                @if (User.IsInRole("Admin"))
                                {
                                    <a class="mat-btn mat-btn--sm" href="/Terminal?envId=@env.Id&name=@Uri.EscapeDataString(env.Name)" title="Shell"><icon name="terminal" /></a>
                                }
                            }
                            <form method="post" asp-page-handler="Test" asp-route-view="@Model.View" style="display:inline;">
                                <input type="hidden" name="id" value="@env.Id" />
                                <button type="submit" class="mat-btn mat-btn--sm" title="Verbindung testen"><icon name="plug" /></button>
                            </form>
                            <form method="post" asp-page-handler="Toggle" asp-route-view="@Model.View" style="display:inline;">
                                <input type="hidden" name="id" value="@env.Id" />
                                <input type="hidden" name="enable" value="@((!env.IsEnabled).ToString().ToLowerInvariant())" />
                                <button type="submit" class="mat-btn mat-btn--sm" title="@(env.IsEnabled ? "Deaktivieren" : "Aktivieren")">
                                    <icon name="@(env.IsEnabled ? "lock" : "check-circle")" />
                                </button>
                            </form>
                            <a class="mat-btn mat-btn--sm" href="/Environments/Edit?id=@env.Id" title="Bearbeiten"><icon name="edit" /></a>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <table class="data">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Verbindung</th>
                        <th>Status</th>
                        <th>CPU</th>
                        <th>RAM</th>
                        <th>Disk</th>
                        <th>Container</th>
                        <th>Docker</th>
                        <th>Zuletzt geprüft</th>
                        <th class="actions">Aktionen</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var env in Model.Items)
                    {
                        var st = Model.Stats.TryGetValue(env.Id, out var s) ? s : new MatDock.Core.Docker.HostStats();
                        <tr>
                            <td>
                                <a href="/Environments/Edit?id=@env.Id"><strong>@env.Name</strong></a>
                                @if (!env.IsEnabled)
                                {
                                    <span class="pill pill--unknown" style="margin-left:6px;">Deaktiviert</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(env.Description))
                                {
                                    <div class="text-muted" style="font-size:.8rem;">@env.Description</div>
                                }
                            </td>
                            <td class="mono">@env.Username@@@env.Host:@env.Port</td>
                            <td><partial name="_StatusPill" model="env.Status" /></td>
                            <td class="num">
                                @if (st.Cores is not null)
                                {
                                    <div>@((int)Math.Round(st.CpuPercent))%</div>
                                    <span class="ubar"><span class="ubar__fill" style="width:@((int)Math.Round(st.CpuPercent))%"></span></span>
                                }
                                else { <span class="text-muted">–</span> }
                            </td>
                            <td class="num">
                                @if (st.MemTotalBytes is not null)
                                {
                                    <div class="cell-sub" style="white-space:nowrap;">@Fb(st.MemUsedBytes ?? 0) / @Fb(st.MemTotalBytes.Value)</div>
                                    <span class="ubar"><span class="ubar__fill" style="width:@((int)Math.Round(st.MemPercent))%"></span></span>
                                }
                                else { <span class="text-muted">–</span> }
                            </td>
                            <td class="num">
                                @if (st.DiskTotalBytes is not null)
                                {
                                    <div class="cell-sub" style="white-space:nowrap;">@Fb(st.DiskUsedBytes ?? 0) / @Fb(st.DiskTotalBytes.Value)</div>
                                    <span class="ubar"><span class="ubar__fill" style="width:@((int)Math.Round(st.DiskPercent))%"></span></span>
                                }
                                else { <span class="text-muted">–</span> }
                            </td>
                            <td class="num">@(st.RunningContainers?.ToString() ?? "–")</td>
                            <td class="text-muted">@(env.DockerVersion ?? "–")</td>
                            <td class="text-muted nowrap">@(env.LastCheckedAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "–")</td>
                            <td class="actions">
                                <div class="row-actions">
                                    @if (env.IsEnabled)
                                    {
                                        <a class="mat-btn mat-btn--sm" href="/Volumes?EnvId=@env.Id" title="Volumes"><icon name="volume" /></a>
                                        @if (User.IsInRole("Admin"))
                                        {
                                            <a class="mat-btn mat-btn--sm" href="/Terminal?envId=@env.Id&name=@Uri.EscapeDataString(env.Name)" title="Shell"><icon name="terminal" /></a>
                                        }
                                    }
                                    <form method="post" asp-page-handler="Test" asp-route-view="@Model.View" style="display:inline;">
                                        <input type="hidden" name="id" value="@env.Id" />
                                        <button type="submit" class="mat-btn mat-btn--sm" title="Verbindung testen"><icon name="plug" /></button>
                                    </form>
                                    <form method="post" asp-page-handler="Toggle" asp-route-view="@Model.View" style="display:inline;">
                                        <input type="hidden" name="id" value="@env.Id" />
                                        <input type="hidden" name="enable" value="@((!env.IsEnabled).ToString().ToLowerInvariant())" />
                                        <button type="submit" class="mat-btn mat-btn--sm" title="@(env.IsEnabled ? "Deaktivieren" : "Aktivieren")">
                                            <icon name="@(env.IsEnabled ? "lock" : "check-circle")" />
                                        </button>
                                    </form>
                                    <a class="mat-btn mat-btn--sm" href="/Environments/Edit?id=@env.Id" title="Bearbeiten"><icon name="edit" /></a>
                                    <span style="width:8px;display:inline-block;"></span>
                                    <form method="post" asp-page-handler="Delete" data-confirm="Environment „@env.Name“ wirklich löschen?" style="display:inline;">
                                        <input type="hidden" name="id" value="@env.Id" />
                                        <button type="submit" class="mat-btn mat-btn--sm mat-btn--danger" title="Löschen"><icon name="trash" /></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </mat-table-body>

    <mat-table-pagination>
        <pagination model="Model.Pagination" />
    </mat-table-pagination>

    <mat-table-actions>
        <a href="/Environments/Edit" class="mat-btn mat-btn--primary"><icon name="plus" /><span>Neues Environment</span></a>
        <a href="@ViewUrl(Model.View)" class="mat-btn"><icon name="refresh" /><span>Aktualisieren</span></a>
    </mat-table-actions>
</mat-table>
