@page
@model MatDock.Web.Pages.Volumes.FilesModel
@{
    ViewData["Title"] = "Dateien";
    string Target(string name) => Model.Path.Length == 0 ? name : Model.Path + "/" + name;
    string Fmt(long b)
    {
        string[] u = { "B", "KB", "MB", "GB" };
        double v = b; int i = 0;
        while (v >= 1024 && i < u.Length - 1) { v /= 1024; i++; }
        return $"{v:0.#} {u[i]}";
    }
}

<div class="page-head">
    <div class="page-head__title">
        <h1>Dateien</h1>
        <span class="page-head__subtitle mono">@Model.Volume · @Model.Environment?.Name</span>
    </div>
    <div class="mat-buttons">
        <a href="/Volumes/Detail?envId=@Model.EnvId&volume=@Uri.EscapeDataString(Model.Volume)" class="mat-btn mat-btn--ghost"><icon name="back" /><span>Zurück</span></a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert @(Model.IsError ? "alert--error" : "alert--success")">
        <icon name="@(Model.IsError ? "x-circle" : "check-circle")" /><span>@Model.StatusMessage</span>
    </div>
}

<div class="mat-table__toolbar" style="border:1px solid var(--border);border-radius:var(--radius);background:var(--surface);margin-bottom:16px;flex-wrap:wrap;gap:10px;">
    <nav class="mono" style="display:flex;flex-wrap:wrap;gap:4px;align-items:center;">
        @foreach (var (name, rel) in Model.Crumbs)
        {
            <a href="/Volumes/Files?envId=@Model.EnvId&volume=@Uri.EscapeDataString(Model.Volume)&path=@Uri.EscapeDataString(rel)">@name</a>
            <span class="text-muted">/</span>
        }
    </nav>
    <span class="toolbar-spacer"></span>
    <form method="post" asp-page-handler="NewFolder" style="display:inline-flex;gap:4px;">
        <input type="hidden" name="envId" value="@Model.EnvId" /><input type="hidden" name="volume" value="@Model.Volume" /><input type="hidden" name="path" value="@Model.Path" />
        <input name="name" class="mat-input" placeholder="Ordnername" style="width:130px;" required />
        <button type="submit" class="mat-btn mat-btn--sm" title="Ordner erstellen"><icon name="plus" /></button>
    </form>
    <form method="post" asp-page-handler="NewFile" style="display:inline-flex;gap:4px;">
        <input type="hidden" name="envId" value="@Model.EnvId" /><input type="hidden" name="volume" value="@Model.Volume" /><input type="hidden" name="path" value="@Model.Path" />
        <input name="name" class="mat-input" placeholder="Dateiname" style="width:130px;" required />
        <button type="submit" class="mat-btn mat-btn--sm" title="Datei erstellen"><icon name="plus" /></button>
    </form>
</div>

@if (Model.Error is not null)
{
    <div class="alert alert--error"><icon name="x-circle" /><span>@Model.Error</span></div>
}
else
{
    <div class="card" style="padding:0;">
        <table class="data">
            <thead><tr><th>Name</th><th>Größe</th><th class="actions">Aktionen</th></tr></thead>
            <tbody>
                @if (Model.Entries.Count == 0)
                {
                    <tr><td colspan="3"><div class="empty-state"><p>Leeres Verzeichnis.</p></div></td></tr>
                }
                @foreach (var e in Model.Entries)
                {
                    var target = Target(e.Name);
                    <tr>
                        <td class="wrap">
                            @if (e.IsDirectory)
                            {
                                <a href="/Volumes/Files?envId=@Model.EnvId&volume=@Uri.EscapeDataString(Model.Volume)&path=@Uri.EscapeDataString(target)"><icon name="volume" /> <strong>@e.Name</strong></a>
                            }
                            else
                            {
                                <a href="/Volumes/FileEdit?envId=@Model.EnvId&volume=@Uri.EscapeDataString(Model.Volume)&path=@Uri.EscapeDataString(target)">@e.Name</a>
                            }
                        </td>
                        <td class="cell-sub">@(e.IsDirectory ? "" : Fmt(e.Size))</td>
                        <td class="actions">
                            <div class="row-actions">
                                <form method="post" asp-page-handler="Rename" style="display:inline-flex;gap:3px;">
                                    <input type="hidden" name="envId" value="@Model.EnvId" /><input type="hidden" name="volume" value="@Model.Volume" /><input type="hidden" name="path" value="@Model.Path" />
                                    <input type="hidden" name="target" value="@target" />
                                    <input name="newName" value="@e.Name" class="mat-input" style="width:120px;" aria-label="Neuer Name" />
                                    <button type="submit" class="mat-btn mat-btn--sm" title="Umbenennen"><icon name="edit" /></button>
                                </form>
                                <form method="post" asp-page-handler="Copy" style="display:inline;">
                                    <input type="hidden" name="envId" value="@Model.EnvId" /><input type="hidden" name="volume" value="@Model.Volume" /><input type="hidden" name="path" value="@Model.Path" />
                                    <input type="hidden" name="target" value="@target" />
                                    <input type="hidden" name="newName" value="@(e.Name)-kopie" />
                                    <button type="submit" class="mat-btn mat-btn--sm" title="Duplizieren"><icon name="save" /></button>
                                </form>
                                <form method="post" asp-page-handler="Delete" data-confirm="„@e.Name“ wirklich löschen?" style="display:inline;">
                                    <input type="hidden" name="envId" value="@Model.EnvId" /><input type="hidden" name="volume" value="@Model.Volume" /><input type="hidden" name="path" value="@Model.Path" />
                                    <input type="hidden" name="target" value="@target" />
                                    <button type="submit" class="mat-btn mat-btn--sm mat-btn--danger" title="Löschen"><icon name="trash" /></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
