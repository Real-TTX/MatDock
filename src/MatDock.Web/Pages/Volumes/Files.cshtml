@page
@model MatDock.Web.Pages.Volumes.FilesModel
@{
    ViewData["Title"] = "Files";
    string Target(string name) => Model.Path.Length == 0 ? name : Model.Path + "/" + name;
    string Url(string rel) => $"/Volumes/Files?envId={Model.EnvId}&volume={Uri.EscapeDataString(Model.Volume)}&path={Uri.EscapeDataString(rel)}";
    string Fmt(long b)
    {
        string[] u = { "B", "KB", "MB", "GB" };
        double v = b; int i = 0;
        while (v >= 1024 && i < u.Length - 1) { v /= 1024; i++; }
        return $"{v:0.#} {u[i]}";
    }
}

<div class="page-head">
    <div class="page-head__title">
        <h1>Files</h1>
        <span class="page-head__subtitle mono">@Model.Volume · @Model.Environment?.Name</span>
    </div>
    <div class="mat-buttons">
        <a href="/Volumes/Detail?envId=@Model.EnvId&volume=@Uri.EscapeDataString(Model.Volume)" class="mat-btn mat-btn--ghost"><icon name="back" /><span>Back</span></a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert @(Model.IsError ? "alert--error" : "alert--success")">
        <icon name="@(Model.IsError ? "x-circle" : "check-circle")" /><span>@Model.StatusMessage</span>
    </div>
}

<div class="fs-toolbar">
    <nav class="fs-crumbs mono" aria-label="Path">
        @for (int i = 0; i < Model.Crumbs.Count; i++)
        {
            var c = Model.Crumbs[i];
            var last = i == Model.Crumbs.Count - 1;
            if (i > 0)
            {
                <span class="fs-crumbs__sep">/</span>
            }
            if (last)
            {
                <span class="fs-crumbs__cur">@if (i == 0) { <icon name="home" /> } else { @c.Name }</span>
            }
            else
            {
                <a href="@Url(c.Rel)">@if (i == 0) { <icon name="home" /> } else { @c.Name }</a>
            }
        }
    </nav>

    <span class="toolbar-spacer"></span>

    <div class="fs-ops">
        <form method="post" asp-page-handler="NewFolder">
            <input type="hidden" name="envId" value="@Model.EnvId" /><input type="hidden" name="volume" value="@Model.Volume" /><input type="hidden" name="path" value="@Model.Path" />
            <input type="hidden" name="name" data-prompt-target />
            <button type="button" class="mat-btn mat-btn--sm" onclick="matdockPromptSubmit(this,'New folder name','')"><icon name="folder" /><span>New folder</span></button>
        </form>
        <form method="post" asp-page-handler="NewFile">
            <input type="hidden" name="envId" value="@Model.EnvId" /><input type="hidden" name="volume" value="@Model.Volume" /><input type="hidden" name="path" value="@Model.Path" />
            <input type="hidden" name="name" data-prompt-target />
            <button type="button" class="mat-btn mat-btn--sm" onclick="matdockPromptSubmit(this,'New file name','')"><icon name="file" /><span>New file</span></button>
        </form>
        <form method="post" asp-page-handler="Upload" enctype="multipart/form-data" class="fs-upload">
            <input type="hidden" name="envId" value="@Model.EnvId" /><input type="hidden" name="volume" value="@Model.Volume" /><input type="hidden" name="path" value="@Model.Path" />
            <input type="file" name="file" required aria-label="File to upload" />
            <button type="submit" class="mat-btn mat-btn--sm mat-btn--primary"><icon name="upload" /><span>Upload</span></button>
        </form>
    </div>
</div>

@if (Model.Error is not null)
{
    <div class="alert alert--error"><icon name="x-circle" /><span>@Model.Error</span></div>
}
else
{
    <div class="card" style="padding:0;">
        <table class="data">
            <thead><tr><th>Name</th><th>Size</th><th class="actions">Actions</th></tr></thead>
            <tbody>
                @if (Model.Entries.Count == 0)
                {
                    <tr><td colspan="3"><div class="empty-state"><div><icon name="folder" /></div><p>Empty folder.</p></div></td></tr>
                }
                @foreach (var e in Model.Entries)
                {
                    var target = Target(e.Name);
                    <tr>
                        <td class="wrap">
                            @if (e.IsDirectory)
                            {
                                <a class="fs-entry" href="@Url(target)"><span class="fs-entry__icon fs-entry__icon--dir"><icon name="folder" /></span><strong>@e.Name</strong></a>
                            }
                            else
                            {
                                <a class="fs-entry" href="/Volumes/FileEdit?envId=@Model.EnvId&volume=@Uri.EscapeDataString(Model.Volume)&path=@Uri.EscapeDataString(target)"><span class="fs-entry__icon"><icon name="file" /></span>@e.Name</a>
                            }
                        </td>
                        <td class="cell-sub">@(e.IsDirectory ? "—" : Fmt(e.Size))</td>
                        <td class="actions">
                            <div class="row-actions">
                                @if (!e.IsDirectory)
                                {
                                    <a class="mat-btn mat-btn--sm" href="/Volumes/Files?handler=Download&envId=@Model.EnvId&volume=@Uri.EscapeDataString(Model.Volume)&target=@Uri.EscapeDataString(target)" title="Download"><icon name="download" /></a>
                                }
                                <form method="post" asp-page-handler="Rename">
                                    <input type="hidden" name="envId" value="@Model.EnvId" /><input type="hidden" name="volume" value="@Model.Volume" /><input type="hidden" name="path" value="@Model.Path" />
                                    <input type="hidden" name="target" value="@target" />
                                    <input type="hidden" name="newName" data-prompt-target />
                                    <button type="button" class="mat-btn mat-btn--sm" title="Rename" onclick="matdockPromptSubmit(this,'Rename to:','@e.Name')"><icon name="edit" /></button>
                                </form>
                                <form method="post" asp-page-handler="Copy" style="display:inline;">
                                    <input type="hidden" name="envId" value="@Model.EnvId" /><input type="hidden" name="volume" value="@Model.Volume" /><input type="hidden" name="path" value="@Model.Path" />
                                    <input type="hidden" name="target" value="@target" />
                                    <input type="hidden" name="newName" value="@(e.Name)-copy" />
                                    <button type="submit" class="mat-btn mat-btn--sm" title="Duplicate"><icon name="copy" /></button>
                                </form>
                                <form method="post" asp-page-handler="Delete" data-confirm="Really delete @e.Name?" style="display:inline;">
                                    <input type="hidden" name="envId" value="@Model.EnvId" /><input type="hidden" name="volume" value="@Model.Volume" /><input type="hidden" name="path" value="@Model.Path" />
                                    <input type="hidden" name="target" value="@target" />
                                    <button type="submit" class="mat-btn mat-btn--sm mat-btn--danger" title="Delete"><icon name="trash" /></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
