@page
@model MatDock.Web.Pages.Volumes.FilesModel
@{
    ViewData["Title"] = Model.Target.IsContainer ? $"Files · {Model.Container}" : $"Files · {Model.Volume}";
    string Target(string name) => Model.Path.Length == 0 ? name : Model.Path + "/" + name;
    string Url(string rel) => $"{Model.BasePath}?envId={Model.EnvId}&{Model.TargetQuery}&path={Uri.EscapeDataString(rel)}";
    var backUrl = Model.Target.IsContainer
        ? $"/Containers/ContainerDetail?envId={Model.EnvId}&id={Uri.EscapeDataString(Model.Container)}"
        : $"/Volumes/Detail?envId={Model.EnvId}&volume={Uri.EscapeDataString(Model.Volume)}";
    string Fmt(long b)
    {
        string[] u = { "B", "KB", "MB", "GB" };
        double v = b; int i = 0;
        while (v >= 1024 && i < u.Length - 1) { v /= 1024; i++; }
        return $"{v:0.#} {u[i]}";
    }
    ViewData["Crumbs"] = new List<(string Text, string? Url)> { (Model.Target.IsContainer ? Model.Container : Model.Volume, backUrl) };
}

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="mat-alert @(Model.IsError ? "mat-alert--danger" : "mat-alert--success")">
        <icon name="@(Model.IsError ? "x-circle" : "check-circle")" /><div class="mat-alert__body">@Model.StatusMessage</div>
    </div>
}

<div class="fs-toolbar">
    @if (!Model.Target.IsContainer)
    {
        <select class="mat-select fs-volswitch" aria-label="Switch volume"
                data-nav-select="/Volumes/Files?envId=@Model.EnvId&volume={v}">
            @foreach (var v in Model.VolumeNames)
            {
                <option value="@v" selected="@(v == Model.Volume)">@v</option>
            }
        </select>
        }
    <nav class="fs-crumbs mat-mono" aria-label="Path">
        @for (int i = 0; i < Model.Crumbs.Count; i++)
        {
            var c = Model.Crumbs[i];
            var last = i == Model.Crumbs.Count - 1;
            if (i > 0)
            {
                <span class="fs-crumbs__sep">/</span>
            }
            if (last)
            {
                <span class="fs-crumbs__cur">@if (i == 0) { <icon name="home" /> } else { @c.Name }</span>
            }
            else
            {
                <a href="@Url(c.Rel)">@if (i == 0) { <icon name="home" /> } else { @c.Name }</a>
            }
        }
    </nav>

    <span class="mat-toolbar__spacer"></span>

    <div class="fs-ops">
        <form method="post" asp-page-handler="NewFolder">
            <input type="hidden" name="envId" value="@Model.EnvId" /><input type="hidden" name="volume" value="@Model.Volume" /><input type="hidden" name="container" value="@Model.Container" /><input type="hidden" name="path" value="@Model.Path" />
            <input type="hidden" name="name" data-prompt-target />
            <button type="button" class="mat-btn mat-btn--secondary mat-btn--sm" data-prompt="New folder name"><icon name="folder" /><span>New folder</span></button>
        </form>
        <form method="post" asp-page-handler="NewFile">
            <input type="hidden" name="envId" value="@Model.EnvId" /><input type="hidden" name="volume" value="@Model.Volume" /><input type="hidden" name="container" value="@Model.Container" /><input type="hidden" name="path" value="@Model.Path" />
            <input type="hidden" name="name" data-prompt-target />
            <button type="button" class="mat-btn mat-btn--secondary mat-btn--sm" data-prompt="New file name"><icon name="file" /><span>New file</span></button>
        </form>
        <form method="post" asp-page-handler="Upload" enctype="multipart/form-data" class="fs-upload">
            <input type="hidden" name="envId" value="@Model.EnvId" /><input type="hidden" name="volume" value="@Model.Volume" /><input type="hidden" name="container" value="@Model.Container" /><input type="hidden" name="path" value="@Model.Path" />
            <input type="file" name="file" required aria-label="File to upload" />
            <button type="submit" class="mat-btn mat-btn--sm mat-btn--primary"><icon name="upload" /><span>Upload</span></button>
        </form>
    </div>
</div>

@if (Model.Error is not null)
{
    <div class="mat-alert mat-alert--danger"><icon name="x-circle" /><div class="mat-alert__body">@Model.Error</div></div>
}
else
{
    <div class="mat-p-0 mat-card">
        <table class="mat-table">
            <thead><tr><th>Name</th><th>Size</th><th class="mat-table__cell-actions">Actions</th></tr></thead>
            <tbody>
                @if (Model.Entries.Count == 0)
                {
                    <tr><td colspan="3"><div class="mat-empty"><div class="mat-empty__icon"><icon name="folder" /></div><p>Empty folder.</p></div></td></tr>
                }
                @foreach (var e in Model.Entries)
                {
                    var target = Target(e.Name);
                    <tr>
                        <td class="mat-text-wrap">
                            @if (e.IsDirectory)
                            {
                                <a class="fs-entry" href="@Url(target)"><span class="fs-entry__icon fs-entry__icon--dir"><icon name="folder" /></span><strong>@e.Name</strong></a>
                            }
                            else
                            {
                                <a class="fs-entry" href="@(Model.Target.IsContainer ? "/Containers/FileEdit" : "/Volumes/FileEdit")?envId=@Model.EnvId&@Model.TargetQuery&path=@Uri.EscapeDataString(target)"><span class="fs-entry__icon"><icon name="file" /></span>@e.Name</a>
                            }
                        </td>
                        <td class="cell-sub">@(e.IsDirectory ? "—" : Fmt(e.Size))</td>
                        <td class="mat-table__cell-actions">
                            <div class="mat-table__actions">
                                @if (!e.IsDirectory)
                                {
                                    <a class="mat-btn mat-btn--secondary mat-btn--sm" href="@Model.BasePath?handler=Download&envId=@Model.EnvId&@Model.TargetQuery&target=@Uri.EscapeDataString(target)" title="Download"><icon name="download" /></a>
                                }
                                <form method="post" asp-page-handler="Rename">
                                    <input type="hidden" name="envId" value="@Model.EnvId" /><input type="hidden" name="volume" value="@Model.Volume" /><input type="hidden" name="container" value="@Model.Container" /><input type="hidden" name="path" value="@Model.Path" />
                                    <input type="hidden" name="target" value="@target" />
                                    <input type="hidden" name="newName" data-prompt-target />
                                    <button type="button" class="mat-btn mat-btn--secondary mat-btn--sm" title="Rename" data-prompt="Rename to:" data-prompt-value="@e.Name"><icon name="edit" /></button>
                                </form>
                                <form method="post" asp-page-handler="Copy" class="mat-d-inline">
                                    <input type="hidden" name="envId" value="@Model.EnvId" /><input type="hidden" name="volume" value="@Model.Volume" /><input type="hidden" name="container" value="@Model.Container" /><input type="hidden" name="path" value="@Model.Path" />
                                    <input type="hidden" name="target" value="@target" />
                                    <input type="hidden" name="newName" value="@(e.Name)-copy" />
                                    <button type="submit" class="mat-btn mat-btn--secondary mat-btn--sm" title="Duplicate"><icon name="copy" /></button>
                                </form>
                                <form method="post" asp-page-handler="Delete" data-confirm="Really delete @e.Name?" class="mat-d-inline">
                                    <input type="hidden" name="envId" value="@Model.EnvId" /><input type="hidden" name="volume" value="@Model.Volume" /><input type="hidden" name="container" value="@Model.Container" /><input type="hidden" name="path" value="@Model.Path" />
                                    <input type="hidden" name="target" value="@target" />
                                    <button type="submit" class="mat-btn mat-btn--sm mat-btn--danger" title="Delete"><icon name="trash" /></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
