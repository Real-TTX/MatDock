@page
@model MatDock.Web.Pages.Volumes.FileEditModel
@{
    ViewData["Title"] = "File";
    var backUrl = $"/Volumes/Files?envId={Model.EnvId}&volume={Uri.EscapeDataString(Model.Volume)}&path={Uri.EscapeDataString(Model.ParentPath)}";
    var downloadUrl = $"/Volumes/Files?handler=Download&envId={Model.EnvId}&volume={Uri.EscapeDataString(Model.Volume)}&target={Uri.EscapeDataString(Model.Path)}";
}

<div class="page-head">
    <div class="page-head__title">
        <h1>@Model.FileName</h1>
        <span class="page-head__subtitle mono">@Model.Volume · @Model.Environment?.Name</span>
    </div>
    <div class="mat-buttons">
        <a href="@downloadUrl" class="mat-btn"><icon name="download" /><span>Download</span></a>
        <a href="@backUrl" class="mat-btn mat-btn--ghost"><icon name="back" /><span>Back</span></a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert @(Model.IsError ? "alert--error" : "alert--success")">
        <icon name="@(Model.IsError ? "x-circle" : "check-circle")" /><span>@Model.StatusMessage</span>
    </div>
}

@if (Model.Error is not null)
{
    <div class="alert alert--error"><icon name="x-circle" /><span>@Model.Error</span></div>
}
else if (Model.IsImage)
{
    <div class="card">
        <div class="card__header"><icon name="eye" /><span>Preview</span></div>
        <div class="card__body file-preview">
            <img src="@downloadUrl" alt="@Model.FileName" />
        </div>
    </div>
}
else if (Model.IsBinary)
{
    <div class="card">
        <div class="empty-state">
            <div><icon name="file" /></div>
            <p>Binary file – no text preview available.</p>
            <a href="@downloadUrl" class="mat-btn mat-btn--primary"><icon name="download" /><span>Download</span></a>
        </div>
    </div>
}
else
{
    var editable = !Model.Truncated && !Model.NonUtf8;
    @if (Model.Truncated)
    {
        <div class="alert alert--warning"><icon name="alert" /><span>The file is larger than @(MatDock.Core.Volumes.VolumeFileCommands.MaxReadBytes / 1024) KB – only the beginning is shown, saving is disabled (no data loss).</span></div>
    }
    else if (Model.NonUtf8)
    {
        <div class="alert alert--warning"><icon name="alert" /><span>The file is not UTF-8 encoded – read-only to avoid corruption.</span></div>
    }
    <form method="post" asp-page-handler="Save">
        <input type="hidden" asp-for="EnvId" /><input type="hidden" asp-for="Volume" /><input type="hidden" asp-for="Path" />
        <textarea name="FileContent" class="mat-textarea mono" rows="24" spellcheck="false" style="width:100%;font-size:.85rem;" readonly="@(editable ? null : "readonly")">@Model.FileContent</textarea>
        <mat-form-buttons>
            @if (editable)
            {
                <button type="submit" class="mat-btn mat-btn--primary"><icon name="save" /><span>Save</span></button>
            }
            <a href="@downloadUrl" class="mat-btn"><icon name="download" /><span>Download</span></a>
            <a href="@backUrl" class="mat-btn mat-btn--ghost"><icon name="back" /><span>@(editable ? "Cancel" : "Back")</span></a>
        </mat-form-buttons>
    </form>
}
