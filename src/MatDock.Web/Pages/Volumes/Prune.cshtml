@page
@model MatDock.Web.Pages.Volumes.PruneModel
@{
    ViewData["Title"] = "Prune volumes";
    ViewData["Width"] = "narrow";
    ViewData["Crumbs"] = new List<(string Text, string? Url)> { ("Volumes", "/Volumes") };
}

<div class="mat-field">
    <label class="mat-label" for="prune-env">Environment</label>
    <select id="prune-env" class="mat-select" data-nav-select="/Volumes/Prune?env={v}">
        <option value="0" selected="@(Model.EnvId == 0)">All environments</option>
        @foreach (var env in Model.Environments)
        {
            <option value="@env.Id" selected="@(Model.EnvId == env.Id)">@env.Name</option>
        }
    </select>
</div>

@if (Model.Results is not null)
{
    var removed = Model.Results.Sum(r => r.Removed);
    var ok = Model.Results.All(r => r.Success);
    <div class="mat-alert @(ok ? "mat-alert--success" : "mat-alert--danger")" role="status">
        <icon name="@(ok ? "check-circle" : "alert")" />
        <div class="mat-alert__body">
            <strong class="mat-alert__title">@removed volume(s) removed</strong>
            Prune finished@(ok ? "" : " with errors").
            <ul class="mat-alert__list">
                @foreach (var r in Model.Results)
                {
                    <li><strong>@r.Environment</strong> — @(r.Success ? $"{r.Removed} removed" : "failed")@(string.IsNullOrWhiteSpace(r.Detail) ? "" : $" · {r.Detail}")</li>
                }
            </ul>
        </div>
    </div>
    <div class="mat-actions">
        <a href="/Volumes" class="mat-btn mat-btn--primary"><icon name="volume" /><span>Back to volumes</span></a>
    </div>
}

@if (Model.Errors.Count > 0)
{
    <div class="mat-alert mat-alert--warning">
        <icon name="alert" />
        <div class="mat-alert__body">Unreachable: @string.Join(" · ", Model.Errors.Select(e => $"{e.Environment} ({e.Message})"))</div>
    </div>
}

@if (Model.Results is null)
{
    if (Model.TotalUnused == 0)
    {
        <div class="mat-alert mat-alert--success"><icon name="check-circle" /><div class="mat-alert__body">No unused volumes — nothing to prune.</div></div>
        <div class="mat-actions">
            <a href="/Volumes" class="mat-btn mat-btn--secondary"><icon name="back" /><span>Back to volumes</span></a>
        </div>
    }
    else
    {
        <div class="mat-alert mat-alert--warning">
            <icon name="alert" />
            <div class="mat-alert__body">
                <strong>@Model.LocalCount</strong> local volume(s) and <strong>@Model.ShareCount</strong> network share(s) are unused.
                Deleted permanently. Network shares are excluded unless you include them.
            </div>
        </div>

        @foreach (var g in Model.Groups)
        {
            <section class="mat-card">
                <div class="mat-card__head">
                    <icon name="server" /><h2 class="mat-card__title">@g.Environment.Name</h2>
                    <span class="mat-badge">@g.Volumes.Count</span>
                </div>
                <ul class="md-plain-list md-scroll-list">
                    @foreach (var v in g.Volumes)
                    {
                        <li class="mat-mono">
                            @v.Name
                            @if (v.IsNetworkShare)
                            {
                                <span class="mat-tag" title="NFS/CIFS network share">share</span>
                            }
                        </li>
                    }
                </ul>
            </section>
        }

        <form method="post" class="mat-form" data-confirm="Permanently delete the selected unused volumes? This cannot be undone." data-confirm-danger>
            <input type="hidden" name="Env" value="@Model.EnvId" />
            <fieldset class="mat-field mat-fieldset">
                <legend class="mat-label">Include</legend>
                <label class="mat-check">
                    <input asp-for="IncludeLocal" type="checkbox" />
                    <span>Local volumes (@Model.LocalCount)</span>
                </label>
                <label class="mat-check">
                    <input asp-for="IncludeShares" type="checkbox" />
                    <span>Network shares — NFS/CIFS (@Model.ShareCount) — off by default</span>
                </label>
            </fieldset>
            <mat-form-buttons>
                <a href="/Volumes" class="mat-btn mat-btn--secondary">Cancel</a>
                <span class="mat-btn-row__spacer"></span>
                <button type="submit" class="mat-btn mat-btn--danger">
                    <icon name="broom" /><span>Prune selected volumes</span>
                </button>
            </mat-form-buttons>
        </form>
    }
}
