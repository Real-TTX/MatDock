@page
@model MatDock.Web.Pages.Volumes.PruneModel
@{
    ViewData["Title"] = "Prune volumes";
}

<div class="page-head">
    <div class="page-head__title">
        <h1>Prune volumes</h1>
        <span class="page-head__subtitle">Permanently remove unused (dangling) volumes@(Model.EnvId > 0 ? " of the selected environment" : " across all environments")</span>
    </div>
    <div class="mat-buttons">
        <a href="/Volumes" class="mat-btn mat-btn--ghost"><icon name="back" /><span>Back</span></a>
    </div>
</div>

<div class="mat-form" style="max-width:420px;margin-bottom:16px;">
    <label class="mat-label" for="prune-env">Environment</label>
    <select id="prune-env" class="mat-select" data-nav-select="/Volumes/Prune?env={v}">
        <option value="0" selected="@(Model.EnvId == 0)">All environments</option>
        @foreach (var env in Model.Environments)
        {
            <option value="@env.Id" selected="@(Model.EnvId == env.Id)">@env.Name</option>
        }
    </select>
</div>

@if (Model.Results is not null)
{
    var removed = Model.Results.Sum(r => r.Removed);
    var ok = Model.Results.All(r => r.Success);
    <div class="result-banner @(ok ? "result-banner--ok" : "result-banner--fail")">
        <icon name="@(ok ? "check-circle" : "alert")" />
        <div>
            <div class="result-banner__big">@removed volume(s) removed</div>
            <div class="result-banner__sub">Prune finished@(ok ? "" : " with errors")</div>
        </div>
    </div>
    <ul class="result-steps">
        @foreach (var r in Model.Results)
        {
            <li>
                <icon name="@(r.Success ? "check-circle" : "x-circle")" />
                <span><strong>@r.Environment</strong> — @(r.Success ? $"{r.Removed} removed" : "failed")@(string.IsNullOrWhiteSpace(r.Detail) ? "" : $" · {r.Detail}")</span>
            </li>
        }
    </ul>
    <a href="/Volumes" class="mat-btn mat-btn--primary"><icon name="volume" /><span>Back to volumes</span></a>
}

@if (Model.Errors.Count > 0)
{
    <div class="alert alert--warning">
        <icon name="alert" />
        <span>Unreachable: @string.Join(" · ", Model.Errors.Select(e => $"{e.Environment} ({e.Message})"))</span>
    </div>
}

@if (Model.Results is null)
{
    @if (Model.TotalUnused == 0)
    {
        <div class="alert alert--success"><icon name="check-circle" /><span>No unused volumes — nothing to prune.</span></div>
        <a href="/Volumes" class="mat-btn"><icon name="back" /><span>Back to volumes</span></a>
    }
    else
    {
        <div class="alert alert--warning">
            <icon name="alert" />
            <span>
                <strong>@Model.LocalCount</strong> local volume(s) and <strong>@Model.ShareCount</strong> network share(s) are unused.
                Selected volumes are <strong>permanently deleted</strong> (cannot be undone). Network shares are excluded by default.
            </span>
        </div>

        @foreach (var g in Model.Groups)
        {
            <div class="card" style="margin-bottom:16px;">
                <div class="card__header">
                    <icon name="server" /><span>@g.Environment.Name</span>
                    <span class="mat-badge">@g.Volumes.Count</span>
                </div>
                <div class="mat-table__scroll" style="max-height:320px;">
                    <table class="data">
                        <tbody>
                            @foreach (var v in g.Volumes)
                            {
                                <tr>
                                    <td class="mono">
                                        @v.Name
                                        @if (v.IsNetworkShare)
                                        {
                                            <span class="tag-system" title="NFS/CIFS network share">share</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <form method="post" data-confirm="Permanently delete the selected unused volumes? This cannot be undone.">
            <input type="hidden" name="Env" value="@Model.EnvId" />
            <div class="card" style="margin-bottom:16px;">
                <div class="card__body">
                    <label class="mat-check">
                        <input asp-for="IncludeLocal" type="checkbox" />
                        <span>Local volumes (@Model.LocalCount)</span>
                    </label>
                    <label class="mat-check" style="margin-top:8px;">
                        <input asp-for="IncludeShares" type="checkbox" />
                        <span>Network shares — NFS/CIFS (@Model.ShareCount) — off by default</span>
                    </label>
                </div>
            </div>
            <mat-form-buttons>
                <button type="submit" class="mat-btn mat-btn--danger">
                    <icon name="broom" /><span>Prune selected volumes</span>
                </button>
                <a href="/Volumes" class="mat-btn mat-btn--ghost"><icon name="back" /><span>Cancel</span></a>
            </mat-form-buttons>
        </form>
    }
}
