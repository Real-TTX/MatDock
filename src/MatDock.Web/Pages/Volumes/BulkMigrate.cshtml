@page
@model MatDock.Web.Pages.Volumes.BulkMigrateModel
@{
    ViewData["Title"] = "Migrate volumes (selection)";
}

<div class="page-head">
    <div class="page-head__title">
        <h1>Migrate volumes</h1>
        <span class="page-head__subtitle">Transfer @Model.Selection.Count volume(s) to a target environment</span>
    </div>
    <div class="mat-buttons">
        <a href="/Volumes" class="mat-btn mat-btn--ghost"><icon name="back" /><span>Back</span></a>
    </div>
</div>

@if (Model.Results is not null)
{
    var okCount = Model.Results.Count(r => r.Ok);
    <div class="result-banner @(okCount == Model.Results.Count ? "result-banner--ok" : "result-banner--fail")">
        <icon name="@(okCount == Model.Results.Count ? "check-circle" : "alert")" />
        <div>
            <div class="result-banner__big">@okCount / @Model.Results.Count migrated</div>
            <div class="result-banner__sub">Result of the bulk migration</div>
        </div>
    </div>
    <ul class="result-steps">
        @foreach (var r in Model.Results)
        {
            <li><icon name="@(r.Ok ? "check-circle" : "x-circle")" /><span>@r.Label — @r.Message</span></li>
        }
    </ul>
    <a href="/Volumes" class="mat-btn mat-btn--primary"><icon name="volume" /><span>Go to volumes</span></a>
}
else if (Model.Selection.Count == 0)
{
    <div class="alert alert--warning"><icon name="alert" /><span>No volumes selected.</span></div>
}
else
{
    <form method="post">
        @foreach (var item in Model.Items)
        {
            <input type="hidden" name="Items" value="@item" />
        }
        <div asp-validation-summary="ModelOnly"></div>

        <div class="card" style="max-width:820px;">
            <div class="card__body">
                <div class="mat-field">
                    <label class="mat-label">Selected volumes (@Model.Selection.Count)</label>
                    <div class="mat-table__scroll" style="max-height:240px;">
                        <table class="data">
                            <thead><tr><th>Environment</th><th>Volume</th></tr></thead>
                            <tbody>
                                @foreach (var s in Model.Selection)
                                {
                                    <tr><td><span class="mat-badge">@s.EnvName</span></td><td class="mono">@s.Volume</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="mat-field">
                    <label class="mat-label" for="TargetEnvId">Target environment</label>
                    <select name="TargetEnvId" id="TargetEnvId" class="mat-select">
                        <option value="0">— select —</option>
                        @foreach (var env in Model.Environments.Where(e => e.IsEnabled))
                        {
                            <option value="@env.Id">@env.Name — @env.Host</option>
                        }
                    </select>
                    <span asp-validation-for="TargetEnvId" class="mat-validation"></span>
                </div>

                <label class="mat-check">
                    <input asp-for="Overwrite" type="checkbox" />
                    <span>Overwrite if target volumes already contain data</span>
                </label>
                <label class="mat-check">
                    <input asp-for="StopContainers" type="checkbox" />
                    <span>Stop containers during the operation and restart them afterwards (consistent snapshot)</span>
                </label>

                <div class="mat-field">
                    <label class="mat-label" for="MigrationMode">Migration type</label>
                    <select asp-for="Mode" id="MigrationMode" class="mat-select">
                        <option value="Direct">Direct (streaming) — fast, no intermediate storage</option>
                        <option value="ViaBackup">Via backup (with a safety copy) — backup → restore</option>
                    </select>
                </div>

                <div data-show-when="MigrationMode=Direct">
                    <div class="alert alert--info">
                        <icon name="alert" />
                        <span>Each volume is transferred via <code>tar</code> directly over SSH to the target environment with the same name (no intermediate storage).</span>
                    </div>
                </div>

                <div data-show-when="MigrationMode=ViaBackup">
                    <div class="mat-field">
                        <label class="mat-label" for="BackupTargetId">Backup target (intermediate storage)</label>
                        <select asp-for="BackupTargetId" id="BackupTargetId" class="mat-select">
                            <option value="0">Local (MatDock /data)</option>
                            @foreach (var t in Model.BackupTargets)
                            {
                                <option value="@t.Id">@t.Name</option>
                            }
                        </select>
                        <span asp-validation-for="BackupTargetId" class="mat-validation"></span>
                    </div>
                    <label class="mat-check">
                        <input asp-for="KeepBackup" type="checkbox" />
                        <span>Keep backups after a successful migration (safety net)</span>
                    </label>
                    <div class="alert alert--info">
                        <icon name="save" />
                        <span>Each volume is first backed up and then restored to the target. If an error occurs, the backup is kept. Requires free space (~volume size) on the backup target.</span>
                    </div>
                </div>

                <mat-form-buttons>
                    <button type="submit" asp-page-handler="Run" class="mat-btn mat-btn--primary" data-confirm="Migrate @(Model.Selection.Count) volume(s) now?">
                        <icon name="server" /><span>Start migration</span>
                    </button>
                    <a href="/Volumes" class="mat-btn mat-btn--ghost"><icon name="back" /><span>Cancel</span></a>
                </mat-form-buttons>
            </div>
        </div>
    </form>
}
