@page
@model MatDock.Web.Pages.Volumes.IndexModel
@{
    ViewData["Title"] = "Volumes";
    var isAdmin = User.IsInRole("Admin");
}

<div class="page-head">
    <div class="page-head__title">
        <h1>Volumes</h1>
        <span class="page-head__subtitle">@(Model.EnvId > 0 ? "Docker volumes of the selected environment" : "All Docker volumes across all environments")</span>
    </div>
    <div class="mat-buttons">
        <a href="/Backups" class="mat-btn"><icon name="save" /><span>Backups</span></a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert @(Model.IsError ? "alert--error" : "alert--success")">
        <icon name="@(Model.IsError ? "x-circle" : "check-circle")" /><span>@Model.StatusMessage</span>
    </div>
}

@if (Model.Errors.Count > 0)
{
    <div class="alert alert--warning">
        <icon name="alert" />
        <span>
            Unreachable:
            @string.Join(" · ", Model.Errors.Select(e => $"{e.Environment} ({e.Message})"))
        </span>
    </div>
}

<mat-table>
    <mat-table-toolbar>
        <form method="get" class="js-autosubmit" style="display:contents;">
            <div class="search">
                <icon name="search" />
                <input type="search" name="Q" value="@Model.Q" class="mat-input" placeholder="Search (volume, mountpoint, environment)…" />
            </div>
            <span class="toolbar-spacer"></span>
            <span class="text-muted"><strong>@Model.Rows.Count</strong> Volumes</span>
        </form>
    </mat-table-toolbar>

    <mat-table-body>
        @if (Model.Rows.Count == 0)
        {
            <div class="empty-state">
                <div><icon name="volume" /></div>
                <p>No volumes found.@(Model.Environments.Count == 0 ? " Create an environment first." : "")</p>
            </div>
        }
        else
        {
            <form method="post" id="bulk-form">
                <input type="hidden" name="EnvId" value="@Model.EnvId" />
                <input type="hidden" name="Q" value="@Model.Q" />
                <div class="bulk-bar">
                    <span class="bulk-bar__count"><strong id="sel-count">0</strong> selected</span>
                    <button type="submit" asp-page-handler="BulkBackup" class="mat-btn mat-btn--sm" data-bulk disabled
                            data-confirm="Back up the selected volumes now?"><icon name="save" /><span>Backup (selection)</span></button>
                    <button type="submit" formaction="/Volumes/BulkMigrate" formmethod="post" class="mat-btn mat-btn--sm" data-bulk disabled><icon name="server" /><span>Migrate (selection)</span></button>
                    <label class="mat-check" style="margin-left:auto;font-size:.85rem;white-space:nowrap;">
                        <input type="checkbox" name="stopContainers" value="true" />
                        <span>Stop containers for the backup</span>
                    </label>
                </div>
                <table class="data">
                    <thead>
                        <tr>
                            <th style="width:36px;"><input type="checkbox" id="select-all" aria-label="Select all" /></th>
                            <th>Environment</th>
                            <th>Volume</th>
                            <th class="actions">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Rows)
                        {
                            <tr>
                                <td><input type="checkbox" class="row-check" name="selected" value="@row.Environment.Id|@row.Volume.Name" aria-label="select" /></td>
                                <td><span class="mat-badge">@row.Environment.Name</span></td>
                                <td class="wrap">
                                    <a href="/Volumes/Detail?envId=@row.Environment.Id&volume=@Uri.EscapeDataString(row.Volume.Name)"><strong>@row.Volume.Name</strong></a>
                                    @if (!string.IsNullOrEmpty(row.Volume.Mountpoint))
                                    {
                                        <div class="cell-sub">@row.Volume.Mountpoint</div>
                                    }
                                </td>
                                <td class="actions">
                                    <div class="row-actions">
                                        <a class="mat-btn mat-btn--sm" href="/Volumes/Detail?envId=@row.Environment.Id&volume=@Uri.EscapeDataString(row.Volume.Name)" title="Open"><icon name="external" /></a>
                                        @if (isAdmin)
                                        {
                                            <a class="mat-btn mat-btn--sm" href="/Volumes/Files?envId=@row.Environment.Id&volume=@Uri.EscapeDataString(row.Volume.Name)" title="File explorer"><icon name="edit" /></a>
                                        }
                                        <button type="submit" asp-page-handler="Backup" name="single" value="@row.Environment.Id|@row.Volume.Name"
                                                class="mat-btn mat-btn--sm" title="Create backup"><icon name="save" /></button>
                                        <a class="mat-btn mat-btn--sm" href="/Backups?Volume=@Uri.EscapeDataString(row.Volume.Name)" title="Restore from backup"><icon name="refresh" /></a>
                                        <a class="mat-btn mat-btn--sm"
                                           href="/Environments/Migrate?sourceId=@row.Environment.Id&volume=@Uri.EscapeDataString(row.Volume.Name)"
                                           title="Migrate"><icon name="server" /></a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </form>
        }
    </mat-table-body>

    <mat-table-actions>
        @if (Model.Environments.Count > 0)
        {
            <form method="post" asp-page-handler="CreateVolume" style="display:inline-flex;gap:6px;align-items:center;">
                <select name="createEnvId" class="mat-select" aria-label="Target environment">
                    @foreach (var env in Model.Environments)
                    {
                        <option value="@env.Id" selected="@(Model.EnvId == env.Id)">@env.Name</option>
                    }
                </select>
                <input name="newVolumeName" class="mat-input" placeholder="New volume" required style="width:160px;" />
                <button type="submit" class="mat-btn mat-btn--primary"><icon name="plus" /><span>Create</span></button>
            </form>
        }
        <span class="toolbar-spacer"></span>
        <a href="/Volumes?EnvId=@Model.EnvId&Q=@Uri.EscapeDataString(Model.Q ?? string.Empty)&Refresh=true" class="mat-btn"><icon name="refresh" /><span>Refresh</span></a>
    </mat-table-actions>
</mat-table>
