@page
@model MatDock.Web.Pages.Volumes.IndexModel
@{
    ViewData["Title"] = "Volumes";
    var isAdmin = User.IsInRole("Admin");
}

<div class="page-head">
    <div class="page-head__title">
        <h1>Volumes</h1>
        <span class="page-head__subtitle">@(Model.EnvId > 0 ? "Docker volumes of the selected environment" : "All Docker volumes across all environments")</span>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert @(Model.IsError ? "alert--error" : "alert--success")">
        <icon name="@(Model.IsError ? "x-circle" : "check-circle")" /><span>@Model.StatusMessage</span>
    </div>
}

@if (Model.Errors.Count > 0)
{
    <div class="alert alert--warning">
        <icon name="alert" />
        <span>
            Unreachable:
            @string.Join(" · ", Model.Errors.Select(e => $"{e.Environment} ({e.Message})"))
        </span>
    </div>
}

<mat-table>
    <mat-table-toolbar>
        <form method="get" class="js-autosubmit" style="display:contents;">
            <div class="search">
                <icon name="search" />
                <input type="search" name="Q" value="@Model.Q" class="mat-input" placeholder="Search (volume, mountpoint, environment)…" />
            </div>
            <span class="toolbar-spacer"></span>
            <span class="text-muted"><strong>@Model.Rows.Count</strong> Volumes</span>
        </form>
    </mat-table-toolbar>

    <mat-table-body>
        @if (Model.Rows.Count == 0)
        {
            <div class="empty-state">
                <div><icon name="volume" /></div>
                <p>No volumes found.@(Model.Environments.Count == 0 ? " Create an environment first." : "")</p>
            </div>
        }
        else
        {
            <table class="data">
                <thead>
                    <tr>
                        <th>Environment</th>
                        <th>Volume</th>
                        <th class="actions">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        <tr>
                            <td><span class="mat-badge">@row.Environment.Name</span></td>
                            <td class="wrap">
                                <a href="/Volumes/Detail?envId=@row.Environment.Id&volume=@Uri.EscapeDataString(row.Volume.Name)"><strong>@row.Volume.Name</strong></a>
                                @if (row.Unused)
                                {
                                    <span class="tag-unused" title="Not used by any container">unused</span>
                                }
                                @if (!string.IsNullOrEmpty(row.Volume.Mountpoint))
                                {
                                    <div class="cell-sub">@row.Volume.Mountpoint</div>
                                }
                            </td>
                            <td class="actions">
                                <div class="row-actions">
                                    <a class="mat-btn mat-btn--sm" href="/Volumes/Detail?envId=@row.Environment.Id&volume=@Uri.EscapeDataString(row.Volume.Name)" title="Open"><icon name="external" /></a>
                                    @if (isAdmin)
                                    {
                                        <a class="mat-btn mat-btn--sm" href="/Volumes/Files?envId=@row.Environment.Id&volume=@Uri.EscapeDataString(row.Volume.Name)" title="File explorer"><icon name="folder" /></a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </mat-table-body>

    <mat-table-actions>
        @if (Model.Environments.Count > 0)
        {
            <a href="/Volumes/Create" class="mat-btn mat-btn--primary"><icon name="plus" /><span>New volume</span></a>
        }
        <span class="toolbar-spacer"></span>
        @if (Model.Environments.Count > 0)
        {
            <a href="/Environments/Migrate?sourceId=@Model.EnvId" class="mat-btn"><icon name="server" /><span>Migrate</span></a>
        }
        <a href="/Backups" class="mat-btn"><icon name="save" /><span>Backups</span></a>
        <a href="/Volumes?EnvId=@Model.EnvId&Q=@Uri.EscapeDataString(Model.Q ?? string.Empty)&Refresh=true" class="mat-btn"><icon name="refresh" /><span>Refresh</span></a>
    </mat-table-actions>
</mat-table>
