@page
@model MatDock.Web.Pages.Volumes.DetailModel
@{
    var oic = StringComparison.OrdinalIgnoreCase;
    bool IsSecret(string k) => k.Contains("pass", oic) || k.Contains("secret", oic) || k.Contains("cred", oic) || k.Contains("token", oic);
    string Redact(string key, string value)
    {
        // The CIFS/NFS "o" option is a comma-list that may carry password=… — never render secrets.
        // Track the current sub-key so a comma INSIDE a secret value is redacted too, not just the head.
        if (key.Equals("o", oic))
        {
            var outParts = new List<string>();
            var lastWasSecret = false;
            foreach (var p in value.Split(','))
            {
                var eq = p.IndexOf('=');
                if (eq > 0)
                {
                    var k = p[..eq];
                    lastWasSecret = IsSecret(k);
                    outParts.Add(lastWasSecret ? k + "=***" : p);
                }
                else
                {
                    outParts.Add(lastWasSecret ? "***" : p);
                }
            }
            return string.Join(",", outParts);
        }
        return IsSecret(key) ? "***" : value;
    }
    ViewData["Title"] = Model.VolumeName;
    ViewData["Crumbs"] = new List<(string Text, string? Url)> { ("Volumes", $"/Volumes?EnvId={Model.EnvId}") };
}

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="mat-alert @(Model.IsError ? "mat-alert--danger" : "mat-alert--success")">
        <icon name="@(Model.IsError ? "x-circle" : "check-circle")" /><div class="mat-alert__body">@Model.StatusMessage</div>
    </div>
}

@if (Model.Error is not null)
{
    <div class="mat-alert mat-alert--danger"><icon name="x-circle" /><div class="mat-alert__body">@Model.Error</div></div>
}
else if (Model.Detail is null)
{
    <div class="mat-alert mat-alert--warning"><icon name="alert" /><div class="mat-alert__body">Volume "@Model.VolumeName" was not found on this host.</div></div>
}
else
{
    var d = Model.Detail;

    var volInUse = Model.UsedBy.Count > 0;

    <div class="mat-mb-4 mat-btn-row">
        @if (User.IsAdmin())
        {
            <a class="mat-btn mat-btn--secondary" href="/Volumes/Files?envId=@Model.EnvId&volume=@Uri.EscapeDataString(d.Name)"><icon name="edit" /><span>Files</span></a>
            <a class="mat-btn mat-btn--secondary" href="/Environments/Migrate?sourceId=@Model.EnvId&volume=@Uri.EscapeDataString(d.Name)"><icon name="server" /><span>Migrate</span></a>
            <form method="post" asp-page-handler="Backup" data-confirm="Back up volume &quot;@d.Name&quot; now (to the local backup store)?" class="mat-d-inline">
                <input type="hidden" name="envId" value="@Model.EnvId" />
                <input type="hidden" name="volume" value="@d.Name" />
                <button type="submit" class="mat-btn mat-btn--secondary"><icon name="save" /><span>Back up now</span></button>
            </form>
            <a class="mat-btn mat-btn--secondary" href="/Backups?Volume=@Uri.EscapeDataString(d.Name)"><icon name="clock" /><span>Backups</span></a>
            <span class="mat-btn-row__spacer"></span>
            <form method="post" asp-page-handler="Remove" data-confirm="Delete volume &quot;@d.Name&quot;? This cannot be undone." class="mat-d-inline">
                <input type="hidden" name="envId" value="@Model.EnvId" />
                <input type="hidden" name="volume" value="@d.Name" />
                <button type="submit" class="mat-btn mat-btn--danger" disabled="@volInUse"
                        title="@(volInUse ? $"In use by {Model.UsedBy.Count} container(s)" : "Delete volume")">
                    <icon name="trash" /><span>Delete</span>
                </button>
            </form>
        }
    </div>

    <div class="mat-mb-4 mat-card">
        <div class="mat-card__head"><icon name="volume" /><span>Details</span></div>
        <div class="mat-table-wrap">
            <table class="mat-table">
                <tbody>
                    <tr><th style="width:180px;">Name</th><td class="mat-mono">@d.Name</td></tr>
                    <tr><th>Driver</th><td>@d.Driver</td></tr>
                    <tr><th>Scope</th><td>@(d.Scope ?? "–")</td></tr>
                    <tr><th>Created</th><td>@(d.CreatedAt ?? "–")</td></tr>
                    <tr><th>Mountpoint (local)</th><td class="mat-mono">@(d.Mountpoint ?? "–")</td></tr>
                    @if (d.Device is not null)
                    {
                        <tr><th>Remote share</th><td class="mat-mono">@d.Device</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (d.Options.Count > 0)
    {
        <div class="mat-mb-4 mat-card">
            <div class="mat-card__head"><icon name="settings" /><span>Driver options</span></div>
            <div class="mat-table-wrap">
                <table class="mat-table">
                    <thead><tr><th style="width:180px;">Key</th><th>Value</th></tr></thead>
                    <tbody>
                        @foreach (var kv in d.Options)
                        {
                            <tr><td class="mat-mono">@kv.Key</td><td class="mat-mono">@Redact(kv.Key, kv.Value)</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @if (d.Labels.Count > 0)
    {
        <div class="mat-mb-4 mat-card">
            <div class="mat-card__head"><icon name="filter" /><span>Labels</span></div>
            <div class="mat-table-wrap">
                <table class="mat-table">
                    <thead><tr><th style="width:280px;">Key</th><th>Value</th></tr></thead>
                    <tbody>
                        @foreach (var kv in d.Labels)
                        {
                            <tr><td class="mat-mono">@kv.Key</td><td class="mat-mono">@Redact(kv.Key, kv.Value)</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <div class="mat-card">
        <div class="mat-card__head"><icon name="box" /><span>Used by</span><span class="mat-tag">@Model.UsedBy.Count</span></div>
        @if (Model.UsedBy.Count == 0)
        {
            <div class="mat-empty"><div class="mat-empty__icon"><icon name="box" /></div><p>No container uses this volume.</p></div>
        }
        else
        {
            <div class="mat-table-wrap">
                <table class="mat-table">
                    <thead><tr><th>Container</th><th>Stack</th><th>Status</th><th>Ports</th><th class="mat-table__cell-actions"></th></tr></thead>
                    <tbody>
                        @foreach (var c in Model.UsedBy)
                        {
                            <tr>
                                <td><strong>@c.Name</strong>@if (!string.IsNullOrEmpty(c.Service)) {<div class="cell-sub">@c.Service</div>}</td>
                                <td class="cell-sub">@(c.Project ?? "–")</td>
                                <td>
                                    @if (c.IsRunning)
                                    {
                                        <span class="mat-pill mat-pill--ok"><icon name="check-circle" /><span>@c.Status</span></span>
                                    }
                                    else
                                    {
                                        <span class="mat-pill mat-pill--plain"><span>@c.Status</span></span>
                                    }
                                </td>
                                <td class="cell-sub">@c.Ports</td>
                                <td class="mat-table__cell-actions">
                                    <a class="mat-btn mat-btn--secondary mat-btn--sm" href="/Containers/Logs?EnvId=@Model.EnvId&id=@Uri.EscapeDataString(c.Id)" title="Logs"><icon name="eye" /></a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}
