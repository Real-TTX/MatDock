@page
@model MatDock.Web.Pages.Volumes.DetailModel
@{
    var oic = StringComparison.OrdinalIgnoreCase;
    bool IsSecret(string k) => k.Contains("pass", oic) || k.Contains("secret", oic) || k.Contains("cred", oic) || k.Contains("token", oic);
    string Redact(string key, string value)
    {
        // The CIFS/NFS "o" option is a comma-list that may carry password=… — never render secrets.
        // Track the current sub-key so a comma INSIDE a secret value is redacted too, not just the head.
        if (key.Equals("o", oic))
        {
            var outParts = new List<string>();
            var lastWasSecret = false;
            foreach (var p in value.Split(','))
            {
                var eq = p.IndexOf('=');
                if (eq > 0)
                {
                    var k = p[..eq];
                    lastWasSecret = IsSecret(k);
                    outParts.Add(lastWasSecret ? k + "=***" : p);
                }
                else
                {
                    outParts.Add(lastWasSecret ? "***" : p);
                }
            }
            return string.Join(",", outParts);
        }
        return IsSecret(key) ? "***" : value;
    }
    ViewData["Title"] = Model.VolumeName;
    ViewData["Crumbs"] = new List<(string Text, string? Url)> { ("Volumes", $"/Volumes?EnvId={Model.EnvId}") };
}

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    if (Model.IsError)
    {
        <div class="mat-alert mat-alert--danger" role="alert"><icon name="x-circle" /><div class="mat-alert__body">@Model.StatusMessage</div></div>
    }
    else
    {
        <div data-toast="@Model.StatusMessage" data-tone="success" hidden></div>
    }
}

@if (Model.Error is not null)
{
    <div class="mat-alert mat-alert--danger" role="alert"><icon name="x-circle" /><div class="mat-alert__body">@Model.Error</div></div>
}
else if (Model.Detail is null)
{
    <div class="mat-alert mat-alert--warning"><icon name="alert" /><div class="mat-alert__body">Volume "@Model.VolumeName" was not found on this host.</div></div>
}
else
{
    var d = Model.Detail;

    var volInUse = Model.UsedBy.Count > 0;

    if (User.IsAdmin())
    {
        <div class="mat-row">
            <a class="mat-btn mat-btn--secondary" href="/Volumes/Files?envId=@Model.EnvId&volume=@Uri.EscapeDataString(d.Name)"><icon name="folder" /><span>Files</span></a>
            <a class="mat-btn mat-btn--secondary" href="/Environments/Migrate?sourceId=@Model.EnvId&volume=@Uri.EscapeDataString(d.Name)"><icon name="server" /><span>Migrate</span></a>
            <form method="post" asp-page-handler="Backup" data-confirm="Back up volume &quot;@d.Name&quot; now (to the local backup store)?">
                <input type="hidden" name="envId" value="@Model.EnvId" />
                <input type="hidden" name="volume" value="@d.Name" />
                <button type="submit" class="mat-btn mat-btn--secondary"><icon name="save" /><span>Back up now</span></button>
            </form>
            <a class="mat-btn mat-btn--secondary" href="/Backups?Volume=@Uri.EscapeDataString(d.Name)"><icon name="clock" /><span>Backups</span></a>
            <span class="mat-flex-grow"></span>
            <form method="post" asp-page-handler="Remove" data-confirm="Delete volume &quot;@d.Name&quot;? This cannot be undone." data-confirm-danger>
                <input type="hidden" name="envId" value="@Model.EnvId" />
                <input type="hidden" name="volume" value="@d.Name" />
                <button type="submit" class="mat-btn mat-btn--danger" disabled="@volInUse"
                        title="@(volInUse ? $"In use by {Model.UsedBy.Count} container(s)" : "Delete volume")">
                    <icon name="trash" /><span>Delete</span>
                </button>
            </form>
        </div>
    }

    <section class="mat-card">
        <div class="mat-card__head"><icon name="volume" /><h2 class="mat-card__title">Details</h2></div>
        <div class="mat-card__body">
            <dl class="mat-kv">
                <dt>Name</dt><dd class="mat-mono">@d.Name</dd>
                <dt>Driver</dt><dd>@d.Driver</dd>
                <dt>Scope</dt><dd>@(d.Scope ?? "–")</dd>
                <dt>Created</dt><dd>@(d.CreatedAt ?? "–")</dd>
                <dt>Mountpoint (local)</dt><dd class="mat-mono">@(d.Mountpoint ?? "–")</dd>
                @if (d.Device is not null)
                {
                    <dt>Remote share</dt><dd class="mat-mono">@d.Device</dd>
                }
            </dl>
        </div>
    </section>

    if (d.Options.Count > 0)
    {
        <section class="mat-card">
            <div class="mat-card__head"><icon name="settings" /><h2 class="mat-card__title">Driver options</h2></div>
            <div class="mat-card__body">
                <dl class="mat-kv">
                    @foreach (var kv in d.Options)
                    {
                        <dt class="mat-mono">@kv.Key</dt><dd class="mat-mono">@Redact(kv.Key, kv.Value)</dd>
                    }
                </dl>
            </div>
        </section>
    }

    if (d.Labels.Count > 0)
    {
        <section class="mat-card">
            <div class="mat-card__head"><icon name="tag" /><h2 class="mat-card__title">Labels</h2></div>
            <div class="mat-card__body">
                <dl class="mat-kv">
                    @foreach (var kv in d.Labels)
                    {
                        <dt class="mat-mono">@kv.Key</dt><dd class="mat-mono">@Redact(kv.Key, kv.Value)</dd>
                    }
                </dl>
            </div>
        </section>
    }

    <section class="mat-card">
        <div class="mat-card__head"><icon name="box" /><h2 class="mat-card__title">Used by</h2><span class="mat-badge">@Model.UsedBy.Count</span></div>
        @if (Model.UsedBy.Count == 0)
        {
            <div class="mat-empty"><div class="mat-empty__icon"><icon name="box" /></div><p>No container uses this volume.</p></div>
        }
        else
        {
            <div class="mat-table-wrap">
                <table class="mat-table">
                    <thead><tr><th>Container</th><th>Stack</th><th>Status</th><th>Ports</th><th><span class="mat-sr-only">Actions</span></th></tr></thead>
                    <tbody>
                        @foreach (var c in Model.UsedBy)
                        {
                            <tr>
                                <td data-label="Container">
                                    <div class="mat-table__name"><span>@c.Name@if (!string.IsNullOrEmpty(c.Service)) {<small>@c.Service</small>}</span></div>
                                </td>
                                <td class="mat-muted" data-label="Stack">@(c.Project ?? "–")</td>
                                <td data-label="Status">
                                    @if (c.IsRunning)
                                    {
                                        <span class="mat-pill mat-pill--ok"><icon name="check-circle" /><span>@c.Status</span></span>
                                    }
                                    else
                                    {
                                        <span class="mat-pill mat-pill--plain"><span>@c.Status</span></span>
                                    }
                                </td>
                                <td class="mat-muted mat-mono mat-text-wrap" data-label="Ports">@c.Ports</td>
                                <td class="mat-table__cell-actions">
                                    <div class="mat-table__actions">
                                        <a class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" href="/Containers/Logs?EnvId=@Model.EnvId&id=@Uri.EscapeDataString(c.Id)" title="Logs" aria-label="Logs of @c.Name"><icon name="eye" /></a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
}
