@page
@model MatDock.Web.Pages.Launchpad.IndexModel
@{
    ViewData["Title"] = "Apps";
    var isAdmin = User.IsInRole("Admin");
}

@if (Model.TotalApps == 0)
{
    <div class="card">
        <div class="empty-state">
            <div><icon name="template" /></div>
            <p>No apps yet.</p>
            @if (isAdmin)
            {
                <a href="/Apps" class="mat-btn mat-btn--primary"><icon name="plus" /><span>Add app</span></a>
            }
        </div>
    </div>
}
else if (isAdmin)
{
    <div class="launch-grid" style="margin-bottom:20px;">
        <a class="launch-tile launch-tile--add" href="/Apps">
            <span class="launch-add__plus"><icon name="plus" /></span>
            <span class="launch-add__label">Add app</span>
        </a>
    </div>
}

@if (Model.TotalApps > 0)
{
    <div class="fs-toolbar">
        <div class="mat-input-icon mat-toolbar__search">
            <icon name="search" />
            <input type="search" class="mat-input" placeholder="Search apps…" data-filter-table="#apps-wrap" autocomplete="off" />
        </div>
    </div>
}

<div id="apps-wrap">
    @foreach (var group in Model.Groups)
    {
        <h2 class="launch-cat">@group.Category <span class="text-muted">(@group.Apps.Count)</span></h2>
        <div class="launch-grid">
            @foreach (var t in group.Apps)
            {
                <partial name="_AppTile" model="t" />
            }
        </div>
    }
</div>
