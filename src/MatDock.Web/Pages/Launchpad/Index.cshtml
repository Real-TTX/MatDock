@page
@model MatDock.Web.Pages.Launchpad.IndexModel
@{
    ViewData["Title"] = "Apps";
    var isAdmin = User.IsInRole("Admin");
}

@if (Model.TotalApps == 0)
{
    <div class="mat-empty mat-empty--framed">
        <div class="mat-empty__icon"><icon name="template" /></div>
        <p class="mat-empty__title">No apps yet.</p>
        @if (isAdmin)
        {
            <a href="/Apps" class="mat-btn mat-btn--primary"><icon name="plus" /><span>Add app</span></a>
        }
    </div>
}
else
{
    <div class="mat-toolbar" role="toolbar" aria-label="Apps tools">
        <div class="mat-input-icon mat-toolbar__search">
            <icon name="search" />
            <input type="search" class="mat-input" placeholder="Search apps…" aria-label="Search apps" data-filter-table="#apps-wrap" autocomplete="off" />
        </div>
        @if (isAdmin)
        {
            <div class="mat-toolbar__end">
                <a href="/Apps" class="mat-btn mat-btn--primary"><icon name="plus" /><span>Add app</span></a>
            </div>
        }
    </div>
}

<div id="apps-wrap" class="mat-stack mat-stack--lg">
    @foreach (var group in Model.Groups)
    {
        <section class="mat-section">
            <h2 class="md-section-title">@group.Category <span class="mat-muted">(@group.Apps.Count)</span></h2>
            <div class="mat-grid">
                @foreach (var t in group.Apps)
                {
                    <partial name="_AppTile" model="t" />
                }
            </div>
        </section>
    }
</div>
