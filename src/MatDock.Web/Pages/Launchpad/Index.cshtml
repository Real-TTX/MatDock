@page
@model MatDock.Web.Pages.Launchpad.IndexModel
@{
    ViewData["Title"] = "Apps";
    var isAdmin = User.IsInRole("Admin");
}

<div class="page-head">
    <div class="page-head__title">
        <h1>Apps</h1>
        <span class="page-head__subtitle">@(Model.EnvId > 0 ? "Apps of the selected environment" : "Apps across all environments")</span>
    </div>
</div>

@if (isAdmin)
{
    <div class="launch-grid" style="margin-bottom:20px;">
        <a class="launch-tile launch-tile--add" href="/Apps">
            <span class="launch-add__plus"><icon name="plus" /></span>
            <span class="launch-add__label">Add app</span>
            <span class="launch-add__sub">Browse the Store &amp; install in one click</span>
        </a>
    </div>
}

@if (Model.TotalApps == 0)
{
    <div class="empty-state">
        <div><icon name="apps" /></div>
        <p>No apps yet.@(isAdmin ? " Install one from the Store above, or" : "") add an <code>x-matdock:</code> block (icon, actions) to a compose file — or a <code>matdock.yml</code> next to it — and deploy it as a stack.</p>
    </div>
}

@foreach (var group in Model.Groups)
{
    <h2 class="launch-cat">@group.Category <span class="text-muted">(@group.Apps.Count)</span></h2>
    <div class="launch-grid">
        @foreach (var t in group.Apps)
        {
            <partial name="_AppTile" model="t" />
        }
    </div>
}
