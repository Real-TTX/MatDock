@page
@using MatDock.Core.Volumes
@model MatDock.Web.Pages.Backups.RestoreModel
@{
    ViewData["Title"] = "Restore";
    ViewData["Crumbs"] = new List<(string Text, string? Url)> { ("Backups", "/Backups") };
}

@if (Model.Result is not null)
{
    <div class="mat-alert @(Model.Result.Success ? "mat-alert--success" : "mat-alert--danger")" role="status">
        <icon name="@(Model.Result.Success ? "check-circle" : "x-circle")" />
        <div class="mat-alert__body">
            <strong class="mat-alert__title">@(Model.Result.Success ? "Restore successful" : "Restore failed")</strong>
            @Model.Result.Message
        </div>
    </div>
}

@if (Model.Backup is null)
{
    <div class="mat-alert mat-alert--danger" role="alert"><icon name="x-circle" /><div class="mat-alert__body">Backup not found.</div></div>
}
else if (Model.Environments.Count == 0)
{
    <div class="mat-alert mat-alert--warning"><icon name="alert" /><div class="mat-alert__body">No target environment available.</div></div>
}
else
{
    <form method="post" class="mat-form" data-confirm="Start restore now?">
        <input type="hidden" asp-for="Input.BackupId" />
        <partial name="_ValidationSummary" />

        <div class="mat-grid mat-grid--2">
            <div class="mat-card">
                <div class="mat-card__head"><icon name="save" /><span class="mat-card__title">Backup</span></div>
                <div class="mat-card__body">
                    <dl class="mat-kv">
                        <dt>Volume</dt><dd><strong>@Model.Backup.VolumeName</strong></dd>
                        <dt>From</dt><dd>@Model.Backup.SourceEnvironmentName</dd>
                        <dt>Size</dt><dd>@VolumeMigrationResult.FormatBytes(Model.Backup.SizeBytes)</dd>
                        <dt>Created</dt><dd>@Model.Backup.CreateDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</dd>
                    </dl>
                </div>
            </div>

            <div class="mat-card">
                <div class="mat-card__head"><icon name="server" /><span class="mat-card__title">Target</span></div>
                <div class="mat-card__body mat-form">
                    <mat-field label="Target environment" asp-for="Input.TargetEnvId">
                        <select asp-for="Input.TargetEnvId" class="mat-select">
                            @foreach (var env in Model.Environments)
                            {
                                <option value="@env.Id">@env.Name — @env.Host</option>
                            }
                        </select>
                    </mat-field>
                    <mat-field label="Target volume" asp-for="Input.TargetVolume">
                        <input asp-for="Input.TargetVolume" class="mat-input" />
                    </mat-field>
                    <label class="mat-check">
                        <input asp-for="Input.Overwrite" type="checkbox" />
                        <span>Overwrite if the target volume already contains data</span>
                    </label>
                    <label class="mat-check">
                        <input asp-for="Input.StopContainers" type="checkbox" />
                        <span>Stop containers during restore</span>
                    </label>
                </div>
            </div>
        </div>

        <mat-form-buttons>
            <button type="submit" class="mat-btn mat-btn--primary"><icon name="restore" /><span>Start restore</span></button>
            <a href="/Backups" class="mat-btn mat-btn--secondary">Cancel</a>
        </mat-form-buttons>
    </form>
}
