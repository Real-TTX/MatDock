@page
@using MatDock.Core.Volumes
@model MatDock.Web.Pages.Backups.IndexModel
@{
    ViewData["Title"] = "Backups";
}

<div class="page-head">
    <div class="page-head__title">
        <h1>Backups</h1>
        <span class="page-head__subtitle">Gesicherte Volume-Archive@(string.IsNullOrEmpty(Model.Volume) ? "" : $" · gefiltert: {Model.Volume}")</span>
    </div>
    <div class="mat-buttons">
        <a href="/Volumes" class="mat-btn mat-btn--ghost"><icon name="volume" /><span>Zu den Volumes</span></a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert @(Model.IsError ? "alert--error" : "alert--success")">
        <icon name="@(Model.IsError ? "x-circle" : "check-circle")" /><span>@Model.StatusMessage</span>
    </div>
}

<mat-table>
    <mat-table-toolbar>
        <form method="get" class="js-autosubmit" style="display:contents;">
            @if (!string.IsNullOrEmpty(Model.Volume))
            {
                <input type="hidden" name="Volume" value="@Model.Volume" />
            }
            <div class="search">
                <icon name="search" />
                <input type="search" name="Q" value="@Model.Q" class="mat-input" placeholder="Suchen (Volume, Environment)…" />
            </div>
            <span class="toolbar-spacer"></span>
            <span class="text-muted"><strong>@Model.Items.Count</strong> Backups</span>
        </form>
    </mat-table-toolbar>

    <mat-table-body>
        @if (Model.Items.Count == 0)
        {
            <div class="empty-state">
                <div><icon name="save" /></div>
                <p>Keine Backups vorhanden. Erstelle eines über die Volumes-Liste.</p>
            </div>
        }
        else
        {
            <table class="data">
                <thead>
                    <tr><th>Volume</th><th>Environment (Quelle)</th><th class="num">Größe</th><th>Erstellt</th><th class="actions">Aktionen</th></tr>
                </thead>
                <tbody>
                    @foreach (var b in Model.Items)
                    {
                        <tr>
                            <td><strong>@b.VolumeName</strong></td>
                            <td>@b.SourceEnvironmentName</td>
                            <td class="num">@VolumeMigrationResult.FormatBytes(b.SizeBytes)</td>
                            <td class="text-muted nowrap">@b.CreateDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                            <td class="actions">
                                <div class="row-actions">
                                    <a class="mat-btn mat-btn--sm mat-btn--primary" href="/Backups/Restore?id=@b.Id" title="Restore"><icon name="refresh" /><span>Restore</span></a>
                                    <span style="width:8px;display:inline-block;"></span>
                                    <form method="post" asp-page-handler="Delete" data-confirm="Backup „@b.VolumeName“ vom @b.CreateDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm") löschen?" style="display:inline;">
                                        <input type="hidden" name="id" value="@b.Id" />
                                        <button type="submit" class="mat-btn mat-btn--sm mat-btn--danger" title="Löschen"><icon name="trash" /></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </mat-table-body>
</mat-table>
