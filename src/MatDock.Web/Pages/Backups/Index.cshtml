@page
@using MatDock.Core.Volumes
@model MatDock.Web.Pages.Backups.IndexModel
@{
    ViewData["Title"] = "Backups";
}

<partial name="_BackupTabs" />
<partial name="_StatusMessage" model="(Model.StatusMessage, Model.IsError)" />

@if (Model.Jobs.Count > 0)
{
    <section class="mat-section" id="live-backup-jobs" data-live="@(Model.Runs.Running.Count > 0 ? "10" : "60")">
        <h2>Backup jobs</h2>
        <mat-table>
            <mat-table-body>
                <div class="mat-table-wrap">
                    <table class="mat-table">
                        <thead>
                            <tr><th>Environment</th><th>Job</th><th>What → where</th><th>When</th><th>Status</th><th>Next run</th><th><span class="mat-sr-only">Actions</span></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var t in Model.Jobs)
                            {
                                var run = Model.Runs.Of(t.Id);
                                var (tone, label, title) = MatDock.Web.Support.ScheduleView.State(t, run);
                                <tr>
                                    <td class="mat-nowrap" data-label="Environment">@(t.EnvironmentId is { } eid && Model.JobEnvNames.TryGetValue(eid, out var en) ? en : "All")</td>
                                    <td data-label="Job">
                                        <div class="mat-table__name">
                                            <a href="/Schedules/Edit?id=@t.Id"><strong>@t.Name</strong></a>
                                            @if (!t.Enabled)
                                            {
                                                <span class="mat-tag" title="Disabled">off</span>
                                            }
                                        </div>
                                    </td>
                                    <td data-label="What → where">@MatDock.Web.Support.ScheduleView.Scope(t, Model.TargetNames)</td>
                                    <td data-label="When"><span title="@t.Cron">@MatDock.Core.Schedules.CronText.Describe(t.Cron)</span></td>
                                    <td data-label="Status">
                                        <span class="mat-pill @tone" title="@title">@label</span>
                                        @if (run is null && t.LastRunAt is { } last)
                                        {
                                            <small class="mat-muted" title="@last.ToUserTime().ToString("dd.MM.yyyy HH:mm")">@MatDock.Web.Support.ScheduleView.Relative(last)</small>
                                        }
                                    </td>
                                    <td class="mat-muted mat-nowrap" data-label="Next run" title="@t.NextRunAt?.ToUserTime().ToString("dd.MM.yyyy HH:mm")">@(t.Enabled ? MatDock.Web.Support.ScheduleView.Relative(t.NextRunAt) : "–")</td>
                                    <td class="mat-table__cell-actions">
                                        <div class="mat-table__actions md-acts">
                                            @if (run is not null)
                                            {
                                                <form method="post" asp-page-handler="CancelJob" data-confirm="Cancel the running backup '@t.Name'?">
                                                    <input type="hidden" name="id" value="@t.Id" />
                                                    <button type="submit" class="mat-btn mat-btn--danger mat-btn--solid mat-btn--sm" disabled="@(run.Cancelling ? "disabled" : null)"><icon name="x" /><span>Cancel</span></button>
                                                </form>
                                            }
                                            else
                                            {
                                                <form method="post" asp-page-handler="RunJob">
                                                    <input type="hidden" name="id" value="@t.Id" />
                                                    <button type="submit" class="mat-btn md-btn--go mat-btn--sm mat-btn--icon" data-tip="Back up now" aria-label="Run @t.Name now"><icon name="play" /></button>
                                                </form>
                                            }
                                            <a class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" href="/Schedules/Edit?id=@t.Id" data-tip="Edit" aria-label="Edit @t.Name"><icon name="edit" /></a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </mat-table-body>
        </mat-table>
    </section>
}

@if (Model.Bundles.Count > 0)
{
    <section class="mat-section">
        <h2>Stack bundles</h2>
        <mat-table>
            <mat-table-body>
                <div class="mat-table-wrap">
                    <table class="mat-table">
                        <thead>
                            <tr><th>Environment</th><th>Stack</th><th>Kind</th><th>Status</th><th>Target</th><th class="mat-num">Volumes</th><th class="mat-num">Size</th><th>Created</th><th><span class="mat-sr-only">Actions</span></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var b in Model.Bundles)
                            {
                                var (statusTone, statusLabel) = b.Status switch
                                {
                                    StackBackupStatus.Succeeded => ("mat-pill--ok", "ok"),
                                    StackBackupStatus.Failed => ("mat-pill--error", "failed"),
                                    _ => ("mat-pill--warn", "running"),
                                };
                                <tr>
                                    <td class="mat-nowrap" data-label="Environment">@b.EnvironmentName</td>
                                    <td data-label="Stack">
                                        <div class="mat-table__name">
                                            <span>@b.StackName
                                                @if (!string.IsNullOrEmpty(b.Note))
                                                {
                                                    <small>@b.Note</small>
                                                }
                                            </span>
                                        </div>
                                    </td>
                                    <td class="mat-muted mat-nowrap" data-label="Kind">@(b.Kind switch { StackBackupKind.Scheduled => "scheduled", StackBackupKind.PreUpdate => "before update", _ => "manual" })@(b.Consistent ? " · stopped" : "")</td>
                                    <td data-label="Status"><span class="mat-pill @statusTone" title="@b.Message">@statusLabel</span></td>
                                    <td data-label="Target"><span class="mat-tag">@(b.BackupTargetName ?? "Local")</span></td>
                                    <td class="mat-num" data-label="Volumes">@b.VolumeCount</td>
                                    <td class="mat-num" data-label="Size">@VolumeMigrationResult.FormatBytes(b.SizeBytes)</td>
                                    <td class="mat-muted mat-nowrap" data-label="Created">@b.CreateDate.ToUserTime().ToString("dd.MM.yyyy HH:mm")</td>
                                    <td class="mat-table__cell-actions">
                                        <div class="mat-table__actions">
                                            @if (b.Status == StackBackupStatus.Succeeded)
                                            {
                                                <form method="post" asp-page-handler="RestoreBundle" data-confirm="Restore stack '@b.StackName' from @b.CreateDate.ToUserTime().ToString("dd.MM.yyyy HH:mm")? The current state is backed up first.">
                                                    <input type="hidden" name="id" value="@b.Id" />
                                                    <button type="submit" class="mat-btn mat-btn--sm mat-btn--secondary"><icon name="restore" /><span>Restore</span></button>
                                                </form>
                                            }
                                            <form method="post" asp-page-handler="DeleteBundle" data-confirm-danger data-confirm="Delete the stack backup of '@b.StackName' from @b.CreateDate.ToUserTime().ToString("dd.MM.yyyy HH:mm") (manifest and volume archives)?">
                                                <input type="hidden" name="id" value="@b.Id" />
                                                <button type="submit" class="mat-btn mat-btn--sm mat-btn--ghost mat-btn--icon" title="Delete" aria-label="Delete"><icon name="trash" /></button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </mat-table-body>
        </mat-table>
    </section>
}

<section class="mat-section">
    @if (Model.Bundles.Count > 0)
    {
        <h2>Volume backups</h2>
    }
    <mat-table>
        <mat-table-toolbar>
            <form method="get" class="mat-row js-autosubmit md-toolbar-form">
                @if (!string.IsNullOrEmpty(Model.Volume))
                {
                    <input type="hidden" name="Volume" value="@Model.Volume" />
                }
                <div class="mat-input-icon mat-toolbar__search">
                    <icon name="search" />
                    <input type="search" name="Q" value="@Model.Q" class="mat-input" placeholder="Search (volume, environment)…" aria-label="Search backups" />
                </div>
                @if (Model.EnvNames.Count > 1)
                {
                    <select id="filter-env" name="Env" class="mat-select mat-w-auto" aria-label="Environment">
                        <option value="">All environments</option>
                        @foreach (var n in Model.EnvNames)
                        {
                            <option value="@n" selected="@(Model.Env == n)">@n</option>
                        }
                    </select>
                }
                <span class="mat-toolbar__spacer"></span>
                <span class="mat-toolbar__info">@Model.Items.Count backups</span>
            </form>
        </mat-table-toolbar>

        <mat-table-body>
            @if (Model.Items.Count == 0)
            {
                <div class="mat-empty">
                    <div class="mat-empty__icon"><icon name="save" /></div>
                    <p class="mat-empty__title">No backups yet</p>
                </div>
            }
            else
            {
                <div class="mat-table-wrap">
                    <table class="mat-table">
                        <thead>
                            <tr><th>Environment</th><th>Volume</th><th>Target</th><th class="mat-num">Size</th><th>Created</th><th><span class="mat-sr-only">Actions</span></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var b in Model.Items)
                            {
                                <tr>
                                    <td class="mat-nowrap" data-label="Environment">@b.SourceEnvironmentName</td>
                                    <td data-label="Volume"><strong>@b.VolumeName</strong></td>
                                    <td data-label="Target"><span class="mat-tag">@(b.BackupTargetName ?? "Local")</span></td>
                                    <td class="mat-num" data-label="Size">@VolumeMigrationResult.FormatBytes(b.SizeBytes)</td>
                                    <td class="mat-muted mat-nowrap" data-label="Created">@b.CreateDate.ToUserTime().ToString("dd.MM.yyyy HH:mm")</td>
                                    <td class="mat-table__cell-actions">
                                        <div class="mat-table__actions">
                                            <a class="mat-btn mat-btn--sm mat-btn--secondary" href="/Backups/Restore?id=@b.Id"><icon name="restore" /><span>Restore</span></a>
                                            <form method="post" asp-page-handler="Delete" data-confirm-danger data-confirm="Delete backup '@b.VolumeName' from @b.CreateDate.ToUserTime().ToString("dd.MM.yyyy HH:mm")?">
                                                <input type="hidden" name="id" value="@b.Id" />
                                                <button type="submit" class="mat-btn mat-btn--sm mat-btn--ghost mat-btn--icon" title="Delete" aria-label="Delete"><icon name="trash" /></button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </mat-table-body>
    </mat-table>
</section>
