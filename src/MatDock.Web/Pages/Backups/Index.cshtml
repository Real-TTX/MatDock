@page
@using MatDock.Core.Volumes
@model MatDock.Web.Pages.Backups.IndexModel
@{
    ViewData["Title"] = "Backups";
}

<partial name="_BackupTabs" />

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="mat-alert @(Model.IsError ? "mat-alert--danger" : "mat-alert--success")">
        <icon name="@(Model.IsError ? "x-circle" : "check-circle")" /><div class="mat-alert__body">@Model.StatusMessage</div>
    </div>
}

@if (Model.Bundles.Count > 0)
{
    <h2 style="font-size:1rem;margin:4px 0 8px;">Stack bundles</h2>
    <mat-table>
        <mat-table-body>
            <table class="mat-table">
                <thead>
                    <tr><th>Environment</th><th>Stack</th><th>Kind</th><th>Status</th><th>Target</th><th class="mat-num">Volumes</th><th class="mat-num">Size</th><th>Created</th><th class="mat-table__cell-actions">Actions</th></tr>
                </thead>
                <tbody>
                    @foreach (var b in Model.Bundles)
                    {
                        var (statusCls, statusLabel) = b.Status switch
                        {
                            StackBackupStatus.Succeeded => ("pill--online", "ok"),
                            StackBackupStatus.Failed => ("pill--error", "failed"),
                            _ => ("pill--offline", "running"),
                        };
                        <tr>
                            <td class="mat-nowrap">@b.EnvironmentName</td>
                            <td>
                                <strong>@b.StackName</strong>
                                @if (!string.IsNullOrEmpty(b.Note))
                                {
                                    <div class="cell-sub">@b.Note</div>
                                }
                            </td>
                            <td class="cell-sub mat-nowrap">@(b.Kind switch { StackBackupKind.Scheduled => "scheduled", StackBackupKind.PreUpdate => "before update", _ => "manual" })@(b.Consistent ? " · stopped" : "")</td>
                            <td><span class="mat-pill @statusCls" title="@b.Message">@statusLabel</span></td>
                            <td><span class="mat-tag">@(b.BackupTargetName ?? "Local")</span></td>
                            <td class="mat-num">@b.VolumeCount</td>
                            <td class="mat-num">@VolumeMigrationResult.FormatBytes(b.SizeBytes)</td>
                            <td class="mat-muted mat-nowrap">@b.CreateDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                            <td class="mat-table__cell-actions">
                                <div class="mat-table__actions">
                                    @if (b.Status == StackBackupStatus.Succeeded)
                                    {
                                        <form method="post" asp-page-handler="RestoreBundle" data-confirm="Restore stack '@b.StackName' from @b.CreateDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")? The current state is backed up first." class="mat-d-inline">
                                            <input type="hidden" name="id" value="@b.Id" />
                                            <button type="submit" class="mat-btn mat-btn--sm mat-btn--primary" title="Restore"><icon name="refresh" /><span>Restore</span></button>
                                        </form>
                                    }
                                    <span class="u-gap"></span>
                                    <form method="post" asp-page-handler="DeleteBundle" data-confirm="Delete the stack backup of '@b.StackName' from @b.CreateDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm") (manifest and volume archives)?" class="mat-d-inline">
                                        <input type="hidden" name="id" value="@b.Id" />
                                        <button type="submit" class="mat-btn mat-btn--sm mat-btn--danger" title="Delete"><icon name="trash" /></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </mat-table-body>
    </mat-table>
    <h2 style="font-size:1rem;margin:18px 0 8px;">Volume backups</h2>
}

<mat-table>
    <mat-table-toolbar>
        <form method="get" class="u-contents js-autosubmit">
            @if (!string.IsNullOrEmpty(Model.Volume))
            {
                <input type="hidden" name="Volume" value="@Model.Volume" />
            }
            <div class="mat-input-icon mat-toolbar__search">
                <icon name="search" />
                <input type="search" name="Q" value="@Model.Q" class="mat-input" placeholder="Search (volume, environment)…" />
            </div>
            @if (Model.EnvNames.Count > 1)
            {
                <div class="mat-row mat-row--nowrap">
                    <label for="filter-env"><icon name="filter" /></label>
                    <select id="filter-env" name="Env" class="mat-select">
                        <option value="">All environments</option>
                        @foreach (var n in Model.EnvNames)
                        {
                            <option value="@n" selected="@(Model.Env == n)">@n</option>
                        }
                    </select>
                </div>
            }
            <span class="mat-toolbar__spacer"></span>
            <span class="mat-muted"><strong>@Model.Items.Count</strong> Backups</span>
        </form>
    </mat-table-toolbar>

    <mat-table-body>
        @if (Model.Items.Count == 0)
        {
            <div class="mat-empty">
                <div><icon name="save" /></div>
                <p>No backups yet.</p>
            </div>
        }
        else
        {
            <table class="mat-table">
                <thead>
                    <tr><th>Environment</th><th>Volume</th><th>Target</th><th class="mat-num">Size</th><th>Created</th><th class="mat-table__cell-actions">Actions</th></tr>
                </thead>
                <tbody>
                    @foreach (var b in Model.Items)
                    {
                        <tr>
                            <td class="mat-nowrap">@b.SourceEnvironmentName</td>
                            <td><strong>@b.VolumeName</strong></td>
                            <td><span class="mat-tag">@(b.BackupTargetName ?? "Local")</span></td>
                            <td class="mat-num">@VolumeMigrationResult.FormatBytes(b.SizeBytes)</td>
                            <td class="mat-muted mat-nowrap">@b.CreateDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                            <td class="mat-table__cell-actions">
                                <div class="mat-table__actions">
                                    <a class="mat-btn mat-btn--sm mat-btn--primary" href="/Backups/Restore?id=@b.Id" title="Restore"><icon name="refresh" /><span>Restore</span></a>
                                    <span class="u-gap"></span>
                                    <form method="post" asp-page-handler="Delete" data-confirm="Delete backup '@b.VolumeName' from @b.CreateDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")?" class="mat-d-inline">
                                        <input type="hidden" name="id" value="@b.Id" />
                                        <button type="submit" class="mat-btn mat-btn--sm mat-btn--danger" title="Delete"><icon name="trash" /></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </mat-table-body>
</mat-table>
