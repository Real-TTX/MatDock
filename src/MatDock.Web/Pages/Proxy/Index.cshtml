@page
@model MatDock.Web.Pages.Proxy.IndexModel
@{
    ViewData["Title"] = "Proxy";
    ViewData["Heading"] = "Proxy routes";
}

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="mat-alert @(Model.IsError ? "mat-alert--danger" : "mat-alert--success")">
        <icon name="@(Model.IsError ? "x-circle" : "check-circle")" /><div class="mat-alert__body">@Model.StatusMessage</div>
    </div>
}

@if (Model.Connections.Count == 0)
{
    <div class="mat-empty">
        <div><icon name="route" /></div>
        <p>No proxy configured. Add one under <a href="/Settings/Proxies">System → Proxies</a>.</p>
    </div>
    return;
}

@if (Model.Connections.Count > 1)
{
    <div class="u-maxw-xs mat-mb-4 mat-form">
        <label class="mat-label" for="conn-picker">Proxy</label>
        <select id="conn-picker" class="mat-select" data-nav-select="/Proxy?ConnId={v}">
            @foreach (var c in Model.Connections)
            {
                <option value="@c.Id" selected="@(Model.Selected?.Id == c.Id)">@c.Name (@c.Provider)</option>
            }
        </select>
    </div>
}

@if (Model.Selected is not null)
{
    <div class="mat-mb-4 u-maxw mat-card">
        <div class="mat-card__head"><icon name="plus" /><span>Add route on @Model.Selected.Name</span></div>
        <div class="mat-card__body">
            <form method="post" asp-page-handler="Add" class="mat-form">
                <input type="hidden" name="connId" value="@Model.Selected.Id" />
                <div class="mat-form__grid">
                    <mat-field label="Hostname">
                        <input name="host" class="mat-input" placeholder="app.example.com" required />
                    </mat-field>
                    <mat-field label="Upstream (host:port)">
                        <input name="upstream" class="mat-input" placeholder="10.0.0.5:8080" required />
                    </mat-field>
                </div>
                <label class="mat-check">
                    <input type="checkbox" name="tls" value="true" checked />
                    <span>TLS / HTTPS</span>
                </label>
                <mat-form-buttons>
                    <button type="submit" class="mat-btn mat-btn--primary"><icon name="plus" /><span>Add route</span></button>
                </mat-form-buttons>
            </form>
        </div>
    </div>

    @if (Model.RouteError is not null)
    {
        <div class="mat-alert mat-alert--warning"><icon name="alert" /><div class="mat-alert__body">Could not load routes: @Model.RouteError</div></div>
    }

    <div class="mat-p-0 mat-card">
        <table class="mat-table">
            <thead>
                <tr><th>Hostname</th><th>Upstream</th><th>TLS</th><th class="mat-table__cell-actions">Actions</th></tr>
            </thead>
            <tbody>
                @if (Model.Routes.Count == 0)
                {
                    <tr><td colspan="4"><div class="mat-empty"><div class="mat-empty__icon"><icon name="route" /></div><p>No MatDock-managed routes on this proxy yet.</p></div></td></tr>
                }
                @foreach (var r in Model.Routes)
                {
                    <tr>
                        <td class="mat-text-wrap"><strong>@r.Host</strong></td>
                        <td class="mat-mono">@r.Upstream</td>
                        <td>@(r.Tls ? "yes" : "–")</td>
                        <td class="mat-table__cell-actions">
                            <div class="mat-table__actions">
                                <form method="post" asp-page-handler="Remove" data-confirm="Delete route @r.Host?" class="mat-d-inline">
                                    <input type="hidden" name="connId" value="@Model.Selected.Id" />
                                    <input type="hidden" name="routeId" value="@r.Id" />
                                    <button type="submit" class="mat-btn mat-btn--sm mat-btn--danger" title="Delete"><icon name="trash" /></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@section Actions {
    <a href="/Settings/Proxies" class="mat-btn mat-btn--secondary"><icon name="settings" /><span>Proxies</span></a>
}
