@page
@model MatDock.Web.Pages.Proxy.IndexModel
@{
    ViewData["Title"] = "Proxy";
    ViewData["Heading"] = "Proxy routes";
}

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    if (Model.IsError)
    {
        <div class="mat-alert mat-alert--danger" role="alert"><icon name="x-circle" /><div class="mat-alert__body">@Model.StatusMessage</div></div>
    }
    else
    {
        <div data-toast="@Model.StatusMessage" data-tone="success" hidden></div>
    }
}

@if (Model.Connections.Count == 0)
{
    <div class="mat-empty mat-empty--framed">
        <div class="mat-empty__icon"><icon name="route" /></div>
        <p>No proxy configured. Add one under <a href="/Settings/Proxies">System → Proxies</a>.</p>
    </div>
    return;
}

@if (Model.Connections.Count > 1)
{
    <div class="mat-field mat-w-fit">
        <label class="mat-label" for="conn-picker">Proxy</label>
        <select id="conn-picker" class="mat-select" data-nav-select="/Proxy?ConnId={v}">
            @foreach (var c in Model.Connections)
            {
                <option value="@c.Id" selected="@(Model.Selected?.Id == c.Id)">@c.Name (@c.Provider)</option>
            }
        </select>
    </div>
}

@if (Model.Selected is not null)
{
    if (Model.RouteError is not null)
    {
        <div class="mat-alert mat-alert--warning"><icon name="alert" /><div class="mat-alert__body">Could not load routes: @Model.RouteError</div></div>
    }

    <div class="mat-list">
        @if (Model.Routes.Count == 0)
        {
            <div class="mat-empty"><div class="mat-empty__icon"><icon name="route" /></div><p>No MatDock-managed routes on this proxy yet.</p></div>
        }
        else
        {
            <div class="mat-table-wrap">
                <table class="mat-table">
                    <thead>
                        <tr><th>Hostname</th><th>Upstream</th><th>TLS</th><th><span class="mat-sr-only">Actions</span></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.Routes)
                        {
                            <tr>
                                <td class="mat-text-wrap" data-label="Hostname"><strong>@r.Host</strong></td>
                                <td class="mat-mono" data-label="Upstream">@r.Upstream</td>
                                <td data-label="TLS">@(r.Tls ? "yes" : "–")</td>
                                <td class="mat-table__cell-actions">
                                    <div class="mat-table__actions">
                                        <form method="post" asp-page-handler="Remove" data-confirm="Delete route @r.Host?" data-confirm-danger>
                                            <input type="hidden" name="connId" value="@Model.Selected.Id" />
                                            <input type="hidden" name="routeId" value="@r.Id" />
                                            <button type="submit" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" title="Delete" aria-label="Delete route @r.Host"><icon name="trash" /></button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <section class="mat-card">
        <div class="mat-card__head"><icon name="plus" /><h2 class="mat-card__title">Add route on @Model.Selected.Name</h2></div>
        <div class="mat-card__body">
            <form method="post" asp-page-handler="Add" class="mat-form">
                <input type="hidden" name="connId" value="@Model.Selected.Id" />
                <div class="mat-form__grid">
                    <mat-field label="Hostname" for-id="route-host" required="true">
                        <input id="route-host" name="host" class="mat-input" placeholder="app.example.com" required />
                    </mat-field>
                    <mat-field label="Upstream (host:port)" for-id="route-upstream" required="true">
                        <input id="route-upstream" name="upstream" class="mat-input" placeholder="10.0.0.5:8080" required />
                    </mat-field>
                </div>
                <label class="mat-check">
                    <input type="checkbox" name="tls" value="true" checked />
                    <span>TLS / HTTPS</span>
                </label>
                <mat-form-buttons>
                    <button type="submit" class="mat-btn mat-btn--primary"><icon name="plus" /><span>Add route</span></button>
                </mat-form-buttons>
            </form>
        </div>
    </section>
}

@section Actions {
    <a href="/Settings/Proxies" class="mat-btn mat-btn--secondary"><icon name="settings" /><span>Proxies</span></a>
}
