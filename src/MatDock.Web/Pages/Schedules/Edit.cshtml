@page
@model MatDock.Web.Pages.Schedules.EditModel
@{
    ViewData["Title"] = Model.IsEdit ? "Edit schedule" : "New schedule";
}

<div class="page-head">
    <div class="page-head__title">
        <h1>@ViewData["Title"]</h1>
        <span class="page-head__subtitle">A cron- or event-triggered task (prune, status summary, …)</span>
    </div>
    <div class="mat-buttons">
        <a href="/Schedules" class="mat-btn mat-btn--ghost"><icon name="back" /><span>Back</span></a>
    </div>
</div>

<div class="card" style="max-width:820px;">
    <div class="card__body">
        <form method="post" class="mat-form">
            <input type="hidden" asp-for="Input.Id" />
            <div asp-validation-summary="ModelOnly"></div>

            <mat-field label="Name" asp-for="Input.Name">
                <input asp-for="Input.Name" class="mat-input" placeholder="e.g. Nightly prune" />
            </mat-field>

            <div class="form-grid">
                <mat-field label="Action" asp-for="Input.Action">
                    <select asp-for="Input.Action" id="Input_Action" class="mat-select">
                        <option value="Summary">Status summary (notification)</option>
                        <option value="PruneVolumes">Prune volumes</option>
                        <option value="PruneImages">Prune images</option>
                        <option value="PruneNetworks">Prune networks</option>
                    </select>
                </mat-field>
                <mat-field label="Environment" asp-for="Input.EnvironmentId" hint="Applies to all enabled environments when left on 'All'">
                    <select asp-for="Input.EnvironmentId" class="mat-select">
                        <option value="">All environments</option>
                        @foreach (var env in Model.Environments)
                        {
                            <option value="@env.Id">@env.Name</option>
                        }
                    </select>
                </mat-field>
            </div>

            <div data-show-when="Input_Action=PruneImages">
                <label class="mat-check">
                    <input asp-for="Input.OptionAll" type="checkbox" />
                    <span>Prune <strong>all</strong> unused images (not just dangling)</span>
                </label>
            </div>
            <div data-show-when="Input_Action=PruneVolumes">
                <label class="mat-check">
                    <input asp-for="Input.OptionIncludeShares" type="checkbox" />
                    <span>Also remove unused <strong>network shares</strong> (NFS/CIFS), not just local volumes</span>
                </label>
            </div>

            <div class="form-grid">
                <mat-field label="Trigger" asp-for="Input.Trigger">
                    <select asp-for="Input.Trigger" id="Input_Trigger" class="mat-select">
                        <option value="Cron">Time (cron)</option>
                        <option value="Event">Event</option>
                    </select>
                </mat-field>
                <div data-show-when="Input_Trigger=Cron">
                    <mat-field label="Schedule (cron, UTC)" asp-for="Input.Cron" hint="min hour day month weekday · e.g. 0 4 * * * = daily at 04:00">
                        <input asp-for="Input.Cron" class="mat-input" placeholder="0 4 * * *" />
                    </mat-field>
                </div>
                <div data-show-when="Input_Trigger=Event">
                    <mat-field label="On event" asp-for="Input.Event" hint="Event triggers are being rolled out (Phase 2)">
                        <select asp-for="Input.Event" class="mat-select">
                            <option value="DeployFailed">Deploy failed</option>
                            <option value="BackupFailed">Backup failed</option>
                            <option value="SyncFailed">Sync failed</option>
                            <option value="EnvironmentOffline">Environment offline</option>
                            <option value="ContainerDied">Container died</option>
                        </select>
                    </mat-field>
                </div>
            </div>

            <label class="mat-check">
                <input asp-for="Input.NotifyOnResult" type="checkbox" />
                <span>Send a notification with the run result</span>
            </label>
            <label class="mat-check">
                <input asp-for="Input.Enabled" type="checkbox" />
                <span>Enabled</span>
            </label>

            <mat-form-buttons>
                <button type="submit" asp-page-handler="Save" class="mat-btn mat-btn--primary"><icon name="save" /><span>Save</span></button>
                @if (Model.IsEdit)
                {
                    <button type="submit" asp-page-handler="RunNow" class="mat-btn" formnovalidate><icon name="refresh" /><span>Run now</span></button>
                }
                <a href="/Schedules" class="mat-btn mat-btn--ghost"><icon name="back" /><span>Back</span></a>
            </mat-form-buttons>
        </form>
    </div>
</div>
