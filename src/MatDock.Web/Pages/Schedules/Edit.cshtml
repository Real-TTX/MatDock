@page
@model MatDock.Web.Pages.Schedules.EditModel
@{
    ViewData["Title"] = Model.IsEdit ? "Edit schedule" : "New schedule";
    ViewData["Crumbs"] = new List<(string Text, string? Url)> { ("Schedules", "/Schedules") };
}

@if (ManagedBadgeTagHelper.DisplayName(Model.ManagedBy) is { } owner)
{
    <div class="mat-alert mat-alert--info" style="max-width:820px;">
        <icon name="plug" /><div class="mat-alert__body"><managed-badge value="@Model.ManagedBy" /> This schedule was created by @owner. Manual changes may be overwritten the next time @owner updates it.</div>
    </div>
}

<div class="mat-card" style="max-width:820px;">
    <div class="mat-card__body">
        <form method="post" class="mat-form">
            <input type="hidden" asp-for="Input.Id" />
            <partial name="_ValidationSummary" />

            <mat-field label="Name" asp-for="Input.Name">
                <input asp-for="Input.Name" class="mat-input" placeholder="e.g. Nightly prune" />
            </mat-field>

            <div class="mat-form__grid">
                <mat-field label="Action" asp-for="Input.Action">
                    <select asp-for="Input.Action" id="Input_Action" class="mat-select">
                        <option value="Summary">Status summary (notification)</option>
                        <option value="HealthAlert">Health alert (notify on problems)</option>
                        <option value="PruneVolumes">Prune volumes</option>
                        <option value="PruneImages">Prune images</option>
                        <option value="PruneNetworks">Prune networks</option>
                        <option value="Backup">Backup volumes</option>
                        <option value="BundleBackup">Backup stacks (bundle: volumes + compose + .env)</option>
                        <option value="UpdateStacks">Update stacks (newer images)</option>
                        <option value="ScanImages">Scan images for vulnerabilities</option>
                        <option value="Notify">Send a notification (event)</option>
                    </select>
                </mat-field>
                <mat-field label="Environment" asp-for="Input.EnvironmentId" hint="Empty = all environments.">
                    <select asp-for="Input.EnvironmentId" class="mat-select">
                        <option value="">All environments</option>
                        @foreach (var env in Model.Environments)
                        {
                            <option value="@env.Id">@env.Name</option>
                        }
                    </select>
                </mat-field>
            </div>

            <div data-show-when="Input_Action=PruneImages">
                <label class="mat-check">
                    <input asp-for="Input.OptionAll" type="checkbox" />
                    <span>Prune <strong>all</strong> unused images (not just dangling)</span>
                </label>
            </div>
            <div data-show-when="Input_Action=PruneVolumes">
                <label class="mat-check">
                    <input asp-for="Input.OptionIncludeShares" type="checkbox" />
                    <span>Also remove unused <strong>network shares</strong> (NFS/CIFS), not just local volumes</span>
                </label>
            </div>
            <div data-show-when="Input_Action=Backup">
                <mat-field label="Volumes" asp-for="Input.VolumesCsv" hint="One volume name per line. Requires a target environment above.">
                    <textarea asp-for="Input.VolumesCsv" class="mat-input" rows="3" placeholder="pgdata&#10;redis-data"></textarea>
                </mat-field>
            </div>
            <div data-show-when="Input_Action=UpdateStacks">
                <label class="mat-check">
                    <input asp-for="Input.UpdateApply" type="checkbox" id="Input_UpdateApply" />
                    <span>Pull and redeploy the stacks with newer images (otherwise only notify)</span>
                </label>
                <div data-show-when="Input_UpdateApply=true">
                    <label class="mat-check">
                        <input asp-for="Input.UpdateBackupFirst" type="checkbox" />
                        <span>Back up each stack before its update</span>
                    </label>
                    <label class="mat-check">
                        <input asp-for="Input.UpdateRollback" type="checkbox" />
                        <span>Roll back when the containers are not up and healthy within 90 s</span>
                    </label>
                </div>
            </div>
            <div data-show-when="Input_Action=BundleBackup,UpdateStacks">
                <mat-field label="Stack" asp-for="Input.BundleStack" hint="Empty = all managed stacks.">
                    <input asp-for="Input.BundleStack" class="mat-input" placeholder="e.g. media-stack" />
                </mat-field>
            </div>
            <div data-show-when="Input_Action=Backup,BundleBackup">
                <div class="mat-form__grid">
                    <mat-field label="Backup target" asp-for="Input.BackupTargetId" hint="Where archives are stored">
                        <select asp-for="Input.BackupTargetId" class="mat-select">
                            <option value="">Local (/data/backups)</option>
                            @foreach (var t in Model.BackupTargets)
                            {
                                <option value="@t.Id">@t.Name</option>
                            }
                        </select>
                    </mat-field>
                    <mat-field label="Keep newest (0 = unlimited)" asp-for="Input.RetentionCount">
                        <input asp-for="Input.RetentionCount" type="number" min="0" class="mat-input" />
                    </mat-field>
                    <mat-field label="Delete older than N days (0 = off)" asp-for="Input.RetentionDays">
                        <input asp-for="Input.RetentionDays" type="number" min="0" class="mat-input" />
                    </mat-field>
                </div>
                <label class="mat-check">
                    <input asp-for="Input.StopContainers" type="checkbox" />
                    <span>Stop the containers during backup (consistent snapshot)</span>
                </label>
            </div>

            <div class="mat-form__grid">
                <mat-field label="Trigger" asp-for="Input.Trigger">
                    <select asp-for="Input.Trigger" id="Input_Trigger" class="mat-select">
                        <option value="Cron">Time (cron)</option>
                        <option value="Event">Event</option>
                    </select>
                </mat-field>
                <div data-show-when="Input_Trigger=Cron">
                    <mat-field label="Schedule (cron, UTC)" asp-for="Input.Cron" hint="min hour day month weekday · e.g. 0 4 * * * = daily at 04:00">
                        <input asp-for="Input.Cron" class="mat-input" placeholder="0 4 * * *" />
                    </mat-field>
                </div>
                <div data-show-when="Input_Trigger=Event">
                    <mat-field label="On event" asp-for="Input.Event" hint="Runs when this event occurs.">
                        <select asp-for="Input.Event" class="mat-select">
                            <option value="DeployFailed">Deploy failed</option>
                            <option value="BackupFailed">Backup failed</option>
                            <option value="SyncFailed">Sync failed</option>
                            <option value="EnvironmentOffline">Environment offline</option>
                            <option value="ContainerDied">Container died (error exit)</option>
                            <option value="ContainerUnhealthy">Container unhealthy</option>
                        </select>
                    </mat-field>
                </div>
            </div>

            <label class="mat-check">
                <input asp-for="Input.NotifyOnResult" type="checkbox" />
                <span>Send a notification with the run result</span>
            </label>
            <label class="mat-check">
                <input asp-for="Input.Enabled" type="checkbox" />
                <span>Enabled</span>
            </label>

            <mat-form-buttons>
                <button type="submit" asp-page-handler="Save" class="mat-btn mat-btn--primary"><icon name="save" /><span>Save</span></button>
                @if (Model.IsEdit)
                {
                    <button type="submit" asp-page-handler="RunNow" class="mat-btn mat-btn--secondary" formnovalidate><icon name="refresh" /><span>Run now</span></button>
                }
                <a href="/Schedules" class="mat-btn mat-btn--ghost"><icon name="back" /><span>Back</span></a>
                @if (Model.IsEdit && !Model.IsSyncSchedule)
                {
                    <span class="mat-btn-row__spacer"></span>
                    <button type="submit" form="delete-form" class="mat-btn mat-btn--danger" data-confirm="Delete schedule '@Model.Input.Name'?"><icon name="trash" /><span>Delete</span></button>
                }
            </mat-form-buttons>
        </form>
        @if (Model.IsEdit && !Model.IsSyncSchedule)
        {
            <form method="post" asp-page-handler="Delete" id="delete-form"><input type="hidden" name="id" value="@Model.Input.Id" /></form>
        }
    </div>
</div>
