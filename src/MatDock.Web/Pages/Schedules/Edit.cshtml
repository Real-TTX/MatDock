@page
@model MatDock.Web.Pages.Schedules.EditModel
@{
    ViewData["Title"] = Model.IsEdit ? "Edit schedule" : "New schedule";
}

<div class="page-head">
    <div class="page-head__title">
        <h1>@ViewData["Title"]</h1>
        <span class="page-head__subtitle">Automatic backup of selected volumes</span>
    </div>
</div>

<div class="card" style="max-width:820px;">
    <div class="card__body">
        <form method="post" class="mat-form">
            <input type="hidden" asp-for="Input.Id" />
            <div asp-validation-summary="ModelOnly"></div>

            <mat-field label="Name" asp-for="Input.Name">
                <input asp-for="Input.Name" class="mat-input" placeholder="e.g. Nightly prod backup" />
            </mat-field>

            <div class="form-grid">
                <mat-field label="Environment (source)" asp-for="Input.EnvironmentId">
                    <select asp-for="Input.EnvironmentId" id="EnvironmentId" class="mat-select">
                        <option value="0">— select —</option>
                        @foreach (var env in Model.Environments)
                        {
                            <option value="@env.Id">@env.Name</option>
                        }
                    </select>
                </mat-field>
                <mat-field label="Target">
                    <select asp-for="Input.BackupTargetId" class="mat-select">
                        <option value="">Local (MatDock)</option>
                        @foreach (var t in Model.Targets)
                        {
                            <option value="@t.Id">@t.Name</option>
                        }
                    </select>
                </mat-field>
            </div>

            @{
                // Show live host volumes plus any already-selected ones (so volumes that are offline or
                // were entered manually still render and round-trip instead of being silently dropped).
                var shownVolumes = Model.AvailableVolumes
                    .Union(Model.Input.SelectedVolumes, StringComparer.Ordinal)
                    .OrderBy(v => v, StringComparer.OrdinalIgnoreCase)
                    .ToList();
            }
            <div class="mat-field">
                <label class="mat-label">Volumes</label>
                <div style="display:flex;gap:8px;align-items:center;margin-bottom:8px;">
                    <button type="submit" asp-page-handler="LoadVolumes" class="mat-btn mat-btn--sm" formnovalidate><icon name="refresh" /><span>Load environment's volumes</span></button>
                    @if (Model.VolumeLoadError is not null)
                    {
                        <span class="mat-validation">Live list unavailable (@Model.VolumeLoadError) – saved volumes are retained.</span>
                    }
                </div>
                @if (shownVolumes.Count > 0)
                {
                    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:6px;">
                        @foreach (var vol in shownVolumes)
                        {
                            <label class="mat-check">
                                <input type="checkbox" name="Input.SelectedVolumes" value="@vol"
                                       checked="@(Model.Input.SelectedVolumes.Contains(vol))" />
                                <span>@vol</span>
                            </label>
                        }
                    </div>
                }
                else
                {
                    <span class="mat-hint">Select an environment and click 'Load volumes' – or enter them manually below.</span>
                }
                <span asp-validation-for="Input.SelectedVolumes" class="mat-validation"></span>
            </div>

            <mat-field label="Additional volumes (one per line)" asp-for="Input.ExtraVolumes" hint="For hosts that are currently unreachable.">
                <textarea asp-for="Input.ExtraVolumes" class="mat-textarea" rows="3"></textarea>
            </mat-field>

            <div class="form-grid">
                <mat-field label="Schedule (cron, UTC)" asp-for="Input.Cron" hint="min hour day month weekday · e.g. 0 3 * * * = daily at 03:00">
                    <input asp-for="Input.Cron" class="mat-input" placeholder="0 3 * * *" />
                </mat-field>
                <mat-field label="Enabled">
                    <label class="mat-check" style="margin-top:8px;">
                        <input asp-for="Input.Enabled" type="checkbox" />
                        <span>Schedule enabled</span>
                    </label>
                </mat-field>
                <mat-field label="Container">
                    <label class="mat-check" style="margin-top:8px;">
                        <input asp-for="Input.StopContainers" type="checkbox" />
                        <span>Stop containers during the backup, then restart them (consistent snapshot)</span>
                    </label>
                </mat-field>
                <mat-field label="Retention: count" asp-for="Input.RetentionCount" hint="Keep the newest N per volume (0 = unlimited)">
                    <input asp-for="Input.RetentionCount" type="number" min="0" class="mat-input" />
                </mat-field>
                <mat-field label="Retention: days" asp-for="Input.RetentionDays" hint="Delete older ones (0 = off)">
                    <input asp-for="Input.RetentionDays" type="number" min="0" class="mat-input" />
                </mat-field>
            </div>

            <mat-form-buttons>
                <button type="submit" asp-page-handler="Save" class="mat-btn mat-btn--primary"><icon name="save" /><span>Save</span></button>
                <a href="/Schedules" class="mat-btn mat-btn--ghost"><icon name="back" /><span>Back</span></a>
            </mat-form-buttons>
        </form>
    </div>
</div>
