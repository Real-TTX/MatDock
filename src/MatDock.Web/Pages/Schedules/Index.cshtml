@page
@using MatDock.Core.Entities
@model MatDock.Web.Pages.Schedules.IndexModel
@{
    ViewData["Title"] = "Schedules";

    string ActionLabel(ScheduleAction a) => a switch
    {
        ScheduleAction.PruneVolumes => "Prune volumes",
        ScheduleAction.PruneImages => "Prune images",
        ScheduleAction.PruneNetworks => "Prune networks",
        ScheduleAction.Summary => "Status summary",
        ScheduleAction.HealthAlert => "Health alert",
        ScheduleAction.Backup => "Backup",
        ScheduleAction.Sync => "Sync",
        _ => a.ToString()
    };

    string Ago(DateTime? utc)
    {
        if (utc is not { } t) { return "–"; }
        var d = DateTime.UtcNow - t;
        if (d < TimeSpan.Zero) { d = TimeSpan.Zero; }
        if (d.TotalMinutes < 1) { return "just now"; }
        if (d.TotalMinutes < 60) { return $"{(int)d.TotalMinutes} min ago"; }
        if (d.TotalHours < 24) { return $"{(int)d.TotalHours} h ago"; }
        return $"{(int)d.TotalDays} d ago";
    }
}

<div class="page-head">
    <div class="page-head__title">
        <h1>Schedules</h1>
        <span class="page-head__subtitle">Automated tasks — prune, reports and more, on a cron or event trigger</span>
    </div>
    <div class="mat-buttons">
        <a href="/Schedules/Edit" class="mat-btn mat-btn--primary"><icon name="plus" /><span>New schedule</span></a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert @(Model.IsError ? "alert--error" : "alert--success")">
        <icon name="@(Model.IsError ? "x-circle" : "check-circle")" /><span>@Model.StatusMessage</span>
    </div>
}

<div class="card" style="padding:0;">
    <table class="data">
        <thead>
            <tr><th>Name</th><th>Trigger</th><th>Action</th><th>Environment</th><th>Next run</th><th>Last run</th><th class="actions">Actions</th></tr>
        </thead>
        <tbody>
            @if (Model.Tasks.Count == 0)
            {
                <tr><td colspan="7"><div class="empty-state"><div><icon name="clock" /></div><p>No schedules yet. Create one to prune unused resources or send a status summary automatically.</p></div></td></tr>
            }
            @foreach (var t in Model.Tasks)
            {
                <tr>
                    <td>
                        <a href="/Schedules/Edit?id=@t.Id"><strong>@t.Name</strong></a>
                        @if (!t.Enabled)
                        {
                            <span class="tag-unused" title="Disabled">disabled</span>
                        }
                    </td>
                    <td>
                        @if (t.Trigger == ScheduleTrigger.Cron)
                        {
                            <span class="mono">@t.Cron</span>
                        }
                        else
                        {
                            <span class="mat-badge"><icon name="alert" /> @t.Event</span>
                        }
                    </td>
                    <td>@ActionLabel(t.Action)</td>
                    <td class="nowrap">@(t.EnvironmentId is { } eid && Model.EnvNames.TryGetValue(eid, out var n) ? n : "All environments")</td>
                    <td class="cell-sub nowrap">@(t.Trigger == ScheduleTrigger.Cron ? (t.NextRunAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "–") : "on event")</td>
                    <td class="cell-sub" title="@t.LastStatus">@Ago(t.LastRunAt)</td>
                    <td class="actions">
                        <div class="row-actions">
                            <form method="post" asp-page-handler="RunNow" style="display:inline;">
                                <input type="hidden" name="id" value="@t.Id" />
                                <button type="submit" class="mat-btn mat-btn--sm" title="Run now"><icon name="refresh" /></button>
                            </form>
                            <form method="post" asp-page-handler="Delete" data-confirm="Delete schedule '@t.Name'?" style="display:inline;">
                                <input type="hidden" name="id" value="@t.Id" />
                                <button type="submit" class="mat-btn mat-btn--sm mat-btn--danger" title="Delete"><icon name="trash" /></button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
