@page
@using MatDock.Core.Entities
@model MatDock.Web.Pages.Schedules.IndexModel
@{
    ViewData["Title"] = "Schedules";

    string ActionLabel(ScheduleAction a) => a switch
    {
        ScheduleAction.PruneVolumes => "Prune volumes",
        ScheduleAction.PruneImages => "Prune images",
        ScheduleAction.PruneNetworks => "Prune networks",
        ScheduleAction.Summary => "Status summary",
        ScheduleAction.HealthAlert => "Health alert",
        ScheduleAction.Backup => "Backup",
        ScheduleAction.Sync => "Sync",
        ScheduleAction.BundleBackup => "Stack backup (bundle)",
        ScheduleAction.UpdateStacks => "Update stacks",
        ScheduleAction.ScanImages => "Scan images",
        ScheduleAction.Notify => "Notification",
        _ => a.ToString()
    };

    string Ago(DateTime? utc)
    {
        if (utc is not { } t) { return "–"; }
        var d = DateTime.UtcNow - t;
        if (d < TimeSpan.Zero) { d = TimeSpan.Zero; }
        if (d.TotalMinutes < 1) { return "just now"; }
        if (d.TotalMinutes < 60) { return $"{(int)d.TotalMinutes} min ago"; }
        if (d.TotalHours < 24) { return $"{(int)d.TotalHours} h ago"; }
        return $"{(int)d.TotalDays} d ago";
    }
}

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="mat-alert @(Model.IsError ? "mat-alert--danger" : "mat-alert--success")">
        <icon name="@(Model.IsError ? "x-circle" : "check-circle")" /><div class="mat-alert__body">@Model.StatusMessage</div>
    </div>
}

<mat-table>
    <mat-table-toolbar>
        <div class="mat-input-icon mat-toolbar__search">
            <icon name="search" />
            <input type="search" class="mat-input" placeholder="Search schedules…" data-filter-table="#sched-table" autocomplete="off" />
        </div>
        <span class="mat-toolbar__spacer"></span>
        <span class="mat-muted"><strong>@Model.Tasks.Count</strong> schedules</span>
    </mat-table-toolbar>
    <mat-table-body>
    @if (Model.Tasks.Count == 0)
    {
        <div class="mat-empty"><div class="mat-empty__icon"><icon name="clock" /></div><p>No schedules yet.</p></div>
    }
    else
    {
    <table class="mat-table" id="sched-table">
        <thead>
            <tr><th>Name</th><th>Trigger</th><th>Action</th><th>Environment</th><th>Next run</th><th>Last run</th><th class="mat-table__cell-actions">Actions</th></tr>
        </thead>
        <tbody>
            @foreach (var t in Model.Tasks)
            {
                <tr>
                    <td>
                        <a href="/Schedules/Edit?id=@t.Id"><strong>@t.Name</strong></a>
                        <managed-badge value="@t.ManagedBy" />
                        @if (!t.Enabled)
                        {
                            <span class="tag-unused" title="Disabled">disabled</span>
                        }
                    </td>
                    <td>
                        @if (t.Trigger == ScheduleTrigger.Cron)
                        {
                            <span class="mat-mono">@t.Cron</span>
                        }
                        else
                        {
                            <span class="mat-tag"><icon name="alert" /> @MatDock.Core.Schedules.ScheduleService.EventLabel(t.Event)</span>
                        }
                    </td>
                    <td>@ActionLabel(t.Action)</td>
                    <td class="mat-nowrap">@(t.EnvironmentId is { } eid && Model.EnvNames.TryGetValue(eid, out var n) ? n : "All environments")</td>
                    <td class="cell-sub mat-nowrap">@(t.Trigger == ScheduleTrigger.Cron ? (t.NextRunAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "–") : "on event")</td>
                    <td class="cell-sub" title="@t.LastStatus">@Ago(t.LastRunAt)</td>
                    <td class="mat-table__cell-actions">
                        <div class="mat-table__actions">
                            <form method="post" asp-page-handler="RunNow" class="mat-d-inline">
                                <input type="hidden" name="id" value="@t.Id" />
                                <button type="submit" class="mat-btn mat-btn--secondary mat-btn--sm" title="Run now"><icon name="refresh" /></button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    }
    </mat-table-body>
    <mat-table-actions>
        <a href="/Schedules/Edit" class="mat-btn mat-btn--primary"><icon name="plus" /><span>New schedule</span></a>
    </mat-table-actions>
</mat-table>
