@page
@using MatDock.Core.Entities
@model MatDock.Web.Pages.Schedules.IndexModel
@{
    ViewData["Title"] = "Schedules";

    string ActionLabel(ScheduleAction a) => a switch
    {
        ScheduleAction.PruneVolumes => "Prune volumes",
        ScheduleAction.PruneImages => "Prune images",
        ScheduleAction.PruneNetworks => "Prune networks",
        ScheduleAction.Summary => "Status summary",
        ScheduleAction.HealthAlert => "Health alert",
        ScheduleAction.Backup => "Backup",
        ScheduleAction.Sync => "Sync",
        ScheduleAction.BundleBackup => "Stack backup (bundle)",
        ScheduleAction.UpdateStacks => "Update stacks",
        ScheduleAction.ScanImages => "Scan images",
        ScheduleAction.ResticMaintenance => "Restic maintenance",
        ScheduleAction.SelfBackup => "MatDock backup",
        ScheduleAction.GitSync => "Git sync",
        ScheduleAction.StartStacks => "Start stacks",
        ScheduleAction.StopStacks => "Stop stacks",
        ScheduleAction.Notify => "Notification",
        _ => a.ToString()
    };

    string Ago(DateTime? utc)
    {
        if (utc is not { } t) { return "–"; }
        var d = DateTime.UtcNow - t;
        if (d < TimeSpan.Zero) { d = TimeSpan.Zero; }
        if (d.TotalMinutes < 1) { return "just now"; }
        if (d.TotalMinutes < 60) { return $"{(int)d.TotalMinutes} min ago"; }
        if (d.TotalHours < 24) { return $"{(int)d.TotalHours} h ago"; }
        return $"{(int)d.TotalDays} d ago";
    }
}

<partial name="_StatusMessage" model="(Model.StatusMessage, Model.IsError)" />

<mat-table>
    <mat-table-toolbar>
        <div class="mat-input-icon mat-toolbar__search">
            <icon name="search" />
            <input type="search" class="mat-input" placeholder="Search schedules…" data-filter-table="#sched-table" aria-label="Search schedules" autocomplete="off" />
        </div>
        <span class="mat-toolbar__spacer"></span>
        <span class="mat-toolbar__info">@Model.Tasks.Count schedules</span>
    </mat-table-toolbar>
    <mat-table-body>
        @if (Model.Tasks.Count == 0)
        {
            <div class="mat-empty mat-empty--first">
                <div class="mat-empty__icon"><icon name="clock" /></div>
                <p class="mat-empty__title">No schedules yet</p>
                <a href="/Schedules/Edit" class="mat-btn mat-btn--primary"><icon name="plus" /><span>New schedule</span></a>
            </div>
        }
        else
        {
            <div class="mat-table-wrap" id="live-schedules" data-live="@(Model.Runs.Running.Count > 0 ? "10" : "60")">
                <table class="mat-table" id="sched-table">
                    <thead>
                        <tr><th>Environment</th><th>Name</th><th>What</th><th>When</th><th>Status</th><th>Next run</th><th><span class="mat-sr-only">Actions</span></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var t in Model.Tasks)
                        {
                            var run = Model.Runs.Of(t.Id);
                            var (tone, label, title) = MatDock.Web.Support.ScheduleView.State(t, run);
                            var scope = MatDock.Web.Support.ScheduleView.Scope(t, Model.TargetNames);
                            <tr>
                                <td class="mat-nowrap" data-label="Environment">@(t.EnvironmentId is { } eid && Model.EnvNames.TryGetValue(eid, out var n) ? n : "All")</td>
                                <td data-label="Name">
                                    <div class="mat-table__name">
                                        <span>
                                            <a href="/Schedules/Edit?id=@t.Id"><strong>@t.Name</strong></a>
                                            <small>@ActionLabel(t.Action)</small>
                                        </span>
                                        <managed-badge value="@t.ManagedBy" />
                                        @if (!t.Enabled)
                                        {
                                            <span class="mat-tag" title="Disabled">off</span>
                                        }
                                    </div>
                                </td>
                                <td data-label="What">@(string.IsNullOrEmpty(scope) ? "–" : scope)</td>
                                <td data-label="When">
                                    @if (t.Trigger == ScheduleTrigger.Cron)
                                    {
                                        <span title="@t.Cron">@MatDock.Core.Schedules.CronText.Describe(t.Cron)</span>
                                    }
                                    else
                                    {
                                        <span class="mat-tag"><icon name="alert" /> @MatDock.Core.Schedules.ScheduleService.EventLabel(t.Event)</span>
                                    }
                                </td>
                                <td data-label="Status">
                                    <span class="mat-pill @tone" title="@title">@label</span>
                                    @if (run is null && t.LastRunAt is { } last)
                                    {
                                        <small class="mat-muted" title="@last.ToUserTime().ToString("dd.MM.yyyy HH:mm")">@MatDock.Web.Support.ScheduleView.Relative(last)</small>
                                    }
                                </td>
                                <td class="mat-muted mat-nowrap" data-label="Next run" title="@t.NextRunAt?.ToUserTime().ToString("dd.MM.yyyy HH:mm")">@(t.Trigger == ScheduleTrigger.Cron && t.Enabled ? MatDock.Web.Support.ScheduleView.Relative(t.NextRunAt) : "–")</td>
                                <td class="mat-table__cell-actions">
                                    <div class="mat-table__actions md-acts">
                                        @if (run is not null)
                                        {
                                            <form method="post" asp-page-handler="Cancel" data-confirm="Cancel the running '@t.Name'?">
                                                <input type="hidden" name="id" value="@t.Id" />
                                                <button type="submit" class="mat-btn mat-btn--danger mat-btn--solid mat-btn--sm mat-btn--icon" data-tip="Cancel" aria-label="Cancel @t.Name" disabled="@(run.Cancelling ? "disabled" : null)"><icon name="x" /></button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form method="post" asp-page-handler="RunNow">
                                                <input type="hidden" name="id" value="@t.Id" />
                                                <button type="submit" class="mat-btn md-btn--go mat-btn--sm mat-btn--icon" data-tip="Run now" aria-label="Run @t.Name now"><icon name="play" /></button>
                                            </form>
                                        }
                                        <a class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" href="/Schedules/Edit?id=@t.Id" data-tip="Edit" aria-label="Edit @t.Name"><icon name="edit" /></a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </mat-table-body>
    <mat-table-actions>
        <a href="/Schedules/Edit" class="mat-btn mat-btn--primary"><icon name="plus" /><span>New schedule</span></a>
    </mat-table-actions>
</mat-table>
