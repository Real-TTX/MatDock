@page
@model MatDock.Web.Pages.GitRepos.EditModel
@{
    ViewData["Title"] = Model.IsEdit ? "Edit git repository" : "New git repository";
    ViewData["Width"] = "narrow";
    ViewData["Crumbs"] = new List<(string Text, string? Url)> { ("Git repositories", "/GitRepos") };
}

<partial name="_SystemTabs" />

@if (Model.TestMessage is not null)
{
    <div class="mat-alert @(Model.TestOk ? "mat-alert--success" : "mat-alert--danger")">
        <icon name="@(Model.TestOk ? "check-circle" : "x-circle")" /><div class="mat-alert__body">@Model.TestMessage</div>
    </div>
}

<div class="mat-card">
    <div class="mat-card__body">
        <form method="post" class="mat-form">
            <input type="hidden" asp-for="Input.Id" />
            <partial name="_ValidationSummary" />

            <mat-field label="Name" asp-for="Input.Name">
                <input asp-for="Input.Name" class="mat-input" placeholder="e.g. prod apps repo" />
            </mat-field>

            <div class="mat-form__grid">
                <mat-field label="Repository URL" asp-for="Input.Url">
                    <input asp-for="Input.Url" class="mat-input" placeholder="https://github.com/org/repo.git" />
                </mat-field>
                <mat-field label="Branch / tag (optional)" asp-for="Input.Reference">
                    <input asp-for="Input.Reference" class="mat-input" placeholder="main" />
                </mat-field>
                <mat-field label="Credentials (private repos)" asp-for="Input.GitCredentialId">
                    <select asp-for="Input.GitCredentialId" class="mat-select">
                        <option value="">— none (public) —</option>
                        @foreach (var c in Model.Credentials)
                        {
                            <option value="@c.Id">@c.Name</option>
                        }
                    </select>
                </mat-field>
            </div>

            <mat-form-buttons>
                <button type="submit" asp-page-handler="Save" class="mat-btn mat-btn--primary"><icon name="save" /><span>Save</span></button>
                <button type="submit" asp-page-handler="Test" class="mat-btn mat-btn--secondary" formnovalidate><icon name="plug" /><span>Test connection</span></button>
                <a href="/GitRepos" class="mat-btn mat-btn--secondary">Cancel</a>
                @if (Model.IsEdit)
                {
                    <span class="mat-btn-row__spacer"></span>
                    <button type="submit" form="delete-form" class="mat-btn mat-btn--danger" data-confirm="Delete git repository '@Model.Input.Name'?"><icon name="trash" /><span>Delete</span></button>
                }
            </mat-form-buttons>
        </form>
        @if (Model.IsEdit)
        {
            <form method="post" asp-page-handler="Delete" id="delete-form"><input type="hidden" name="id" value="@Model.Input.Id" /></form>
        }
    </div>
</div>
