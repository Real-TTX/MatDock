@page
@model MatDock.Web.Pages.GitRepos.IndexModel
@{
    ViewData["Title"] = "Git repositories";
}

<partial name="_SystemTabs" />

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="mat-alert @(Model.IsError ? "mat-alert--danger" : "mat-alert--success")">
        <icon name="@(Model.IsError ? "x-circle" : "check-circle")" /><div class="mat-alert__body">@Model.StatusMessage</div>
    </div>
}

<mat-table>
    <mat-table-body>
    @if (Model.Repos.Count == 0)
    {
        <div class="mat-empty"><div class="mat-empty__icon"><icon name="git" /></div><p>No git repositories yet.</p></div>
    }
    else
    {
    <table class="mat-table">
        <thead>
            <tr><th>Name</th><th>Repository</th><th>Branch/tag</th><th>Credentials</th></tr>
        </thead>
        <tbody>
            @foreach (var r in Model.Repos)
            {
                <tr>
                    <td><a href="/GitRepos/Edit?id=@r.Id"><strong>@r.Name</strong></a></td>
                    <td class="mat-text-wrap"><span class="mat-mono">@r.Url</span></td>
                    <td class="mat-muted">@(string.IsNullOrEmpty(r.Reference) ? "default" : r.Reference)</td>
                    <td class="mat-muted">@(r.GitCredentialId is > 0 && Model.CredentialNames.TryGetValue(r.GitCredentialId.Value, out var n) ? n : "public")</td>
                </tr>
            }
        </tbody>
    </table>
    }
    </mat-table-body>
    <mat-table-actions>
        <a href="/GitRepos/Edit" class="mat-btn mat-btn--primary"><icon name="plus" /><span>New git repository</span></a>
    </mat-table-actions>
</mat-table>
