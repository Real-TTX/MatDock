@page
@model MatDock.Web.Pages.GitRepos.IndexModel
@{
    ViewData["Title"] = "Git repositories";
}

<partial name="_SystemTabs" />

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert @(Model.IsError ? "alert--error" : "alert--success")">
        <icon name="@(Model.IsError ? "x-circle" : "check-circle")" /><span>@Model.StatusMessage</span>
    </div>
}

<mat-table>
    <mat-table-body>
    @if (Model.Repos.Count == 0)
    {
        <div class="empty-state"><div><icon name="git" /></div><p>No git repositories yet.</p></div>
    }
    else
    {
    <table class="mat-table">
        <thead>
            <tr><th>Name</th><th>Repository</th><th>Branch/tag</th><th>Credentials</th></tr>
        </thead>
        <tbody>
            @foreach (var r in Model.Repos)
            {
                <tr>
                    <td><a href="/GitRepos/Edit?id=@r.Id"><strong>@r.Name</strong></a></td>
                    <td class="wrap"><span class="mono">@r.Url</span></td>
                    <td class="text-muted">@(string.IsNullOrEmpty(r.Reference) ? "default" : r.Reference)</td>
                    <td class="text-muted">@(r.GitCredentialId is > 0 && Model.CredentialNames.TryGetValue(r.GitCredentialId.Value, out var n) ? n : "public")</td>
                </tr>
            }
        </tbody>
    </table>
    }
    </mat-table-body>
    <mat-table-actions>
        <a href="/GitRepos/Edit" class="mat-btn mat-btn--primary"><icon name="plus" /><span>New git repository</span></a>
    </mat-table-actions>
</mat-table>
