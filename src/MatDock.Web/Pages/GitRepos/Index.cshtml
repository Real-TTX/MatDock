@page
@model MatDock.Web.Pages.GitRepos.IndexModel
@{
    ViewData["Title"] = "Git repositories";
}

<partial name="_SystemTabs" />

<partial name="_StatusMessage" model="(Model.StatusMessage, Model.IsError)" />

<mat-table>
    <mat-table-body>
    @if (Model.Repos.Count == 0)
    {
        <div class="mat-empty"><div class="mat-empty__icon"><icon name="git" /></div><p class="mat-empty__title">No git repositories yet.</p></div>
    }
    else
    {
    <div class="mat-table-wrap">
    <table class="mat-table">
        <thead>
            <tr><th>Name</th><th>Repository</th><th>Branch/tag</th><th>Credentials</th></tr>
        </thead>
        <tbody>
            @foreach (var r in Model.Repos)
            {
                <tr>
                    <td data-label="Name"><a href="/GitRepos/Edit?id=@r.Id"><strong>@r.Name</strong></a></td>
                    <td class="mat-text-wrap" data-label="Repository"><span class="mat-mono">@r.Url</span></td>
                    <td class="mat-muted" data-label="Branch/tag">@(string.IsNullOrEmpty(r.Reference) ? "default" : r.Reference)</td>
                    <td class="mat-muted" data-label="Credentials">@(r.GitCredentialId is > 0 && Model.CredentialNames.TryGetValue(r.GitCredentialId.Value, out var n) ? n : "public")</td>
                </tr>
            }
        </tbody>
    </table>
    </div>
    }
    </mat-table-body>
    <mat-table-actions>
        <a href="/GitRepos/Edit" class="mat-btn mat-btn--primary"><icon name="plus" /><span>New git repository</span></a>
    </mat-table-actions>
</mat-table>
