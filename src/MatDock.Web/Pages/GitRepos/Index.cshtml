@page
@model MatDock.Web.Pages.GitRepos.IndexModel
@{
    ViewData["Title"] = "Git repositories";
}

<partial name="_SystemTabs" />

<div class="page-head">
    <div class="page-head__title">
        <h1>Git repositories</h1>
        <span class="page-head__subtitle">Saved repositories to reuse in sync jobs and Git-backed stacks</span>
    </div>
    <div class="mat-buttons">
        <a href="/GitRepos/Edit" class="mat-btn mat-btn--primary"><icon name="plus" /><span>New git repository</span></a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert @(Model.IsError ? "alert--error" : "alert--success")">
        <icon name="@(Model.IsError ? "x-circle" : "check-circle")" /><span>@Model.StatusMessage</span>
    </div>
}

<div class="card" style="padding:0;">
    <table class="data">
        <thead>
            <tr><th>Name</th><th>Repository</th><th>Branch/tag</th><th>Credentials</th><th class="actions">Actions</th></tr>
        </thead>
        <tbody>
            @if (Model.Repos.Count == 0)
            {
                <tr><td colspan="5"><div class="empty-state"><div><icon name="git" /></div><p>No git repositories yet. Add one to reuse it in sync jobs.</p></div></td></tr>
            }
            @foreach (var r in Model.Repos)
            {
                <tr>
                    <td><a href="/GitRepos/Edit?id=@r.Id"><strong>@r.Name</strong></a></td>
                    <td class="wrap"><span class="mono">@r.Url</span></td>
                    <td class="text-muted">@(string.IsNullOrEmpty(r.Reference) ? "default" : r.Reference)</td>
                    <td class="text-muted">@(r.GitCredentialId is > 0 && Model.CredentialNames.TryGetValue(r.GitCredentialId.Value, out var n) ? n : "public")</td>
                    <td class="actions">
                        <div class="row-actions">
                            <form method="post" asp-page-handler="Delete" data-confirm="Delete git repository @r.Name?" style="display:inline;">
                                <input type="hidden" name="id" value="@r.Id" />
                                <button type="submit" class="mat-btn mat-btn--sm mat-btn--danger" title="Delete"><icon name="trash" /></button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
