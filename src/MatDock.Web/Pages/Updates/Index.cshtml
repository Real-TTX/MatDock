@page
@model MatDock.Web.Pages.Updates.IndexModel
@using MatDock.Core.Entities
@using MatDock.Core.Updates
@{
    ViewData["Title"] = "Updates";
    ViewData["Heading"] = "Updates";
    string ModePill(UpdateMode m) => m switch { UpdateMode.Auto => "mat-pill--ok", UpdateMode.Notify => "mat-pill--info", _ => "mat-pill--plain" };
    string Window(EffectiveUpdatePolicy p) => p.WindowStartHour is { } s && p.WindowEndHour is { } e && s != e ? $" · {s:00}–{e:00} h" : string.Empty;
}

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    if (Model.IsError)
    {
        <div class="mat-alert mat-alert--danger" role="alert"><icon name="x-circle" /><div class="mat-alert__body">@Model.StatusMessage</div></div>
    }
    else
    {
        <div data-toast="@Model.StatusMessage" data-tone="success" hidden></div>
    }
}

@* The background run (checking or updating many stacks) refreshes itself every 2 s while it runs, and with it the hosts and the rows below, so each
   result shows as soon as it is there; at its end the page is read once more (the buttons count what can be updated). *@
@{ var live = Model.Running is { IsFinished: false } ? "2" : null; }
<section id="live-run" class="mat-card" data-live="@live" data-live-done="reload" hidden="@(Model.Running is null ? "hidden" : null)">
    @if (Model.Running is { } op)
    {
        <div class="mat-card__head">
            <icon name="@(op.IsFinished ? (op.Error is null ? "check-circle" : "alert") : "refresh")" />
            <h2 class="mat-card__title">@(op.IsFinished
                ? op.Kind switch { "updates-check" => "Checked", "host-upgrade" => op.Error is null ? $"Docker updated on {op.Target}" : $"Docker update failed on {op.Target}", _ => op.Error is null ? "Updated" : "Update failed" }
                : op.Kind switch { "updates-check" => "Checking…", "host-upgrade" => $"Updating Docker on {op.Target}…", _ => "Updating…" })</h2>
        </div>
        <div class="mat-card__body mat-stack">
            <partial name="_RunSteps" model="op" />
        </div>
    }
</section>

@* The hosts: Docker Engine and the system's packages (apt), looked at by a throwaway container on each host. *@
@if (Model.HostRows.Count > 0)
{
    <section class="mat-card" id="hosts" data-live="@live">
        <div class="mat-card__head"><icon name="server" /><h2 class="mat-card__title">Hosts</h2></div>
        <div class="mat-table-wrap">
            <table class="mat-table">
                <thead>
                    <tr><th>Environment</th><th>System</th><th>Docker</th><th>Packages</th><th>Package lists</th><th>Checked</th><th><span class="mat-sr-only">Actions</span></th></tr>
                </thead>
                <tbody>
                    @foreach (var host in Model.HostRows)
                    {
                        var report = host.Report;
                        <tr>
                            <td data-label="Environment"><a href="/Environments/Detail?id=@host.Env.Id">@host.Env.Name</a></td>
                            <td data-label="System" class="mat-muted">@(report?.OsName ?? "–")</td>
                            <td data-label="Docker" class="mat-mono">
                                @if (report?.DockerTarget is { } target)
                                {
                                    <span class="mat-pill mat-pill--info" title="@string.Join(", ", report.DockerPackages.Select(p => p.Name))">@(host.Env.DockerVersion ?? "?") → @target</span>
                                }
                                else
                                {
                                    <span>@(host.Env.DockerVersion ?? "–")</span>
                                }
                            </td>
                            <td data-label="Packages">
                                @if (report is null)
                                {
                                    <span class="mat-muted">–</span>
                                }
                                else if (report.Error is not null)
                                {
                                    <span class="mat-pill mat-pill--error" title="@report.Error">Check failed</span>
                                    <div class="mat-muted">@report.Error</div>
                                }
                                else if (!report.AptAvailable)
                                {
                                    <span class="mat-muted">No apt on this host</span>
                                }
                                else if (report.Packages.Count == 0)
                                {
                                    <span class="mat-pill mat-pill--ok">Up to date</span>
                                }
                                else
                                {
                                    <details>
                                        <summary>
                                            @report.Packages.Count packages
                                            @if (report.SecurityCount > 0)
                                            {
                                                <span class="mat-pill mat-pill--warn">@report.SecurityCount security</span>
                                            }
                                        </summary>
                                        <ul class="mat-mono">
                                            @foreach (var p in report.Packages.OrderByDescending(p => p.IsSecurity).ThenBy(p => p.Name, StringComparer.Ordinal))
                                            {
                                                <li title="@p.Origin">@p.Name @(p.From ?? "new") → @p.To@(p.IsSecurity ? " (security)" : string.Empty)</li>
                                            }
                                        </ul>
                                    </details>
                                }
                                @if (report?.RebootRequired == true)
                                {
                                    <span class="mat-pill mat-pill--warn">Reboot required</span>
                                }
                            </td>
                            <td data-label="Package lists" class="mat-nowrap">
                                @if (report?.ListsUpdatedUtc is { } lists)
                                {
                                    <span class="@(report.ListsStale(DateTime.UtcNow) ? "mat-pill mat-pill--warn" : "mat-muted")" title="When the host last fetched its package lists">@lists.ToUserTime().ToString("dd.MM.yyyy HH:mm")</span>
                                }
                                else
                                {
                                    <span class="mat-muted">–</span>
                                }
                            </td>
                            <td data-label="Checked" class="mat-nowrap mat-muted">@(host.CheckedUtc is { } at ? at.ToUserTime().ToString("dd.MM.yyyy HH:mm") : "–")</td>
                            <td class="mat-table__cell-actions">
                                <div class="mat-table__actions">
                                    <form method="post" asp-page-handler="CheckHost">
                                        <input type="hidden" name="id" value="@host.Env.Id" />
                                        <button type="submit" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" title="Look at the host (refreshes its package lists)" aria-label="Look at the host of @host.Env.Name"><icon name="search" /></button>
                                    </form>
                                    @if (host.DockerPending)
                                    {
                                        <form method="post" asp-page-handler="UpgradeDocker" data-confirm="Update Docker on @host.Env.Name to @report!.DockerTarget? Docker restarts at the end, and with it every container on this host.">
                                            <input type="hidden" name="id" value="@host.Env.Id" />
                                            <button type="submit" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" title="Update Docker" aria-label="Update Docker on @host.Env.Name"><icon name="arrow-up" /></button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}

<mat-table>
<mat-table-toolbar><partial name="_ListToolbar" model="Model.Toolbar" /></mat-table-toolbar>
<mat-table-body>
@if (Model.Rows.Count == 0)
{
    <div class="mat-empty"><div class="mat-empty__icon"><icon name="layers" /></div><p class="mat-empty__title">@(Model.Total == 0 ? "No stack is managed by MatDock yet." : "No stacks found.")</p></div>
}
else
{
    <div class="mat-table-wrap" id="live-update-rows" data-live="@live">
        <table class="mat-table">
            <thead>
                <tr><th>Environment</th><th>Stack</th><th>Rule</th><th>Updates</th><th>Checked</th><th><span class="mat-sr-only">Actions</span></th></tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Rows)
                {
                    <tr>
                        <td data-label="Environment">@row.EnvName</td>
                        <td data-label="Stack"><a href="/Stacks/Update?id=@row.Stack.Id">@row.Stack.Name</a></td>
                        <td data-label="Rule">
                            <span class="mat-pill @ModePill(row.Policy.Mode)">@row.Policy.Mode</span>
                            @if (row.Policy.Mode != UpdateMode.Off)
                            {
                                <span class="mat-muted">@row.Policy.Strategy@Window(row.Policy)</span>
                            }
                        </td>
                        <td data-label="Updates" class="mat-mono">
                            @if (row.Plan is null)
                            {
                                <span class="mat-muted">–</span>
                            }
                            else if (row.Plan.Items.Count == 0)
                            {
                                <span class="mat-pill mat-pill--ok">Up to date</span>
                            }
                            else
                            {
                                @foreach (var item in row.Plan.Items)
                                {
                                    <div title="@item.Current">
                                        @item.Service:
                                        @if (item.Kind == PlannedKind.Version)
                                        {
                                            <span>@item.Current → @item.Target</span>
                                        }
                                        else
                                        {
                                            <span>@item.Current <span class="mat-muted">(new digest)</span></span>
                                        }
                                    </div>
                                }
                            }
                        </td>
                        <td data-label="Checked" class="mat-nowrap mat-muted">@(row.CheckedUtc is { } at ? at.ToUserTime().ToString("dd.MM.yyyy HH:mm") : "–")</td>
                        <td class="mat-table__cell-actions">
                            <div class="mat-table__actions">
                                <form method="post" asp-page-handler="CheckOne">
                                    <input type="hidden" name="id" value="@row.Stack.Id" />
                                    <button type="submit" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" title="Look for updates" aria-label="Look for updates in @row.Stack.Name"><icon name="search" /></button>
                                </form>
                                @if (row.Pending > 0)
                                {
                                    <form method="post" asp-page-handler="UpdateOne" data-confirm="Update stack '@row.Stack.Name' now?">
                                        <input type="hidden" name="id" value="@row.Stack.Id" />
                                        <button type="submit" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" title="Update now" aria-label="Update @row.Stack.Name"><icon name="arrow-up" /></button>
                                    </form>
                                }
                                <a href="/Updates/Rules?scope=Stack&id=@row.Stack.Id" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" title="Rule of this stack" aria-label="Rule of @row.Stack.Name"><icon name="sliders" /></a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
</mat-table-body>
<mat-table-actions>
    @if (Model.PendingStacks > 0)
    {
        <form method="post" asp-page-handler="UpdateAll" class="md-inline-form" data-confirm="Update @Model.PendingStacks stack(s) now? Each gets the backup and the health check of its rule.">
            <button type="submit" class="mat-btn mat-btn--primary"><icon name="arrow-up" /><span>Update all (@Model.PendingStacks)</span></button>
        </form>
    }
    <form method="post" asp-page-handler="Check" class="md-inline-form">
        <button type="submit" class="mat-btn mat-btn--secondary"><icon name="search" /><span>Check all</span></button>
    </form>
    <a href="/Updates/Rules?scope=Global" class="mat-btn mat-btn--secondary"><icon name="sliders" /><span>Default rule</span></a>
    @if (Model.EnvId > 0)
    {
        <a href="/Updates/Rules?scope=Environment&id=@Model.EnvId" class="mat-btn mat-btn--secondary"><icon name="server" /><span>Rule of @Model.EnvName</span></a>
    }
</mat-table-actions>
</mat-table>

